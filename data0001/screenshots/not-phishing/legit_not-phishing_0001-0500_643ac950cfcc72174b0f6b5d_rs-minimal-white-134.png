function SetEntranceURL() {
        var EntranceURL = sessionStorage.getItem("EntranceURL");

        if (!EntranceURL) {
            var currentURL = window.location.href;;
            sessionStorage.setItem("EntranceURL",currentURL);
            //console.log(currentURL + " new entrance! " + Date.now());
            document.getElementById("OriginalReferrer").value = currentURL;
        } else {
            //console.log(EntranceURL + " entrance exist! " + Date.now());
            document.getElementById("OriginalReferrer").value = EntranceURL;
        }
    }</script>
                
