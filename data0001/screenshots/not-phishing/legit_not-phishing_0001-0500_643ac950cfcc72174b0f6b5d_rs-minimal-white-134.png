<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$Cmp" id="Cmp" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$OriginalReferrer" id="OriginalReferrer" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$PpcCampaign" id="PpcCampaign" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$PageLanguage" id="PageLanguage" value="English" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$HeaderSpecialCases" id="HeaderSpecialCases" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$Site_" id="Site_" value="_siteUs" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$AutocompleteOn" id="AutocompleteOn" value="true" />
<input type="hidden" name="ctl00$HeaderPlaceHolder$T981C7CEC019$DynamicYieldOn" id="DynamicYieldOn" value="true" />



<script type="text/javascript" charset="utf-8">

    var _debug = true;

    var hdr_autocompleteObj = null;
    var hdr_autocompleteListener = null;
    var hdr_autocompleteAddress = false;
    var mainFormData = {};
    var secondaryFormSelections = new Array();
    var secondaryFormData = {};
    var firstFormSubmitted = false;
    var url = window.location.href;
    var data = {};
    var serviceOptionListElem = document.getElementById("ServiceOptions");
    var secondaryThankYouContainer = document.getElementById("SecondaryThankYouContainer");
    var site = document.getElementById("Site_").getAttribute("value");
    var ThankYouErr = document.getElementById("ThankYouOptionsError");
    var language = document.getElementById("PageLanguage");

    var thankYouText = document.getElementById("ThankYouText");
    var thankYouMessage = document.getElementById("ThankYouMessage");
    var thankYouDetailMessage = document.getElementById("ThankYouDetailMessage");
    var thankYouFormSubmit = document.getElementById("ThankYouFormSubmit");
    var thanksButNoThanks = document.getElementById("ThanksButNoThanks");
    var thankYouOptionsError = document.getElementById("ThankYouOptionsError");
    var thankYou = document.getElementById("ThankYouContainer");
    var selectedEncoded = [];
    var hiddenEncoded = [];
    var hiddenDecoded = [];
    var topContactForm = document.getElementById("topContactForm");
    var careersForm = document.getElementById("careersForm");
    var autocompleteOn = document.getElementById("AutocompleteOn").value;
    var dynamicYieldOn = document.getElementById("DynamicYieldOn").value;

    function hdr_main() {
        hdr_setupFormEvents();
        hdr_setupThankYouText();
        hdr_setupCareers();
    }

    function hdr_setupCareers() {
        if (url.indexOf("careers") !== -1) {
            topContactForm.style.display = "none";
            // careersForm.style.display = "none";
            var careerThankYouContainer = document.getElementById("CareerThankYouContainer");
            careerThankYouContainer.style.display = "none";
        }
        else {
            careersForm.style.display = "none";
        }
    }

    function hdr_validateCareers() {
        var career_valid = true;
        var defaultValue = "";

        var careersFirstNameElem = document.getElementById("careers_firstname");
        defaultValue = careersFirstNameElem.getAttribute("default-value");
        if (careersFirstNameElem.value.length == 0
            || careersFirstNameElem.value == defaultValue) {
            careersFirstNameElem.style.border = "2px solid #FF0000";
            career_valid = false;
        } else {
            careersFirstNameElem.style.border = "";
        }

        var careersLastNameElem = document.getElementById("careers_lastname");
        defaultValue = careersLastNameElem.getAttribute("default-value");
        if (careersLastNameElem.value.length == 0
            || careersLastNameElem.value == defaultValue) {
            careersLastNameElem.style.border = "2px solid #FF0000";
            career_valid = false;
        } else {
            careersLastNameElem.style.border = "";
        }

        var careersEmailElem = document.getElementById("careers_email");
        defaultValue = careersEmailElem.getAttribute("default-value");
        if (careersEmailElem.value.length == 0
            || careersEmailElem.value == defaultValue
            || !hdr_validEmail(careersEmailElem.value)) {
            careersEmailElem.style.border = "2px solid #FF0000";
            career_valid = false;
        } else {
            careersEmailElem.style.border = "";
        }

        if (!career_valid) {
            return;
        } else {
            hdr_submitCareerForm();
        }
    }

    function hdr_submitCareerForm() {
        var careerData = hdr_getCareerFormData();
        var req = new XMLHttpRequest();
        req.onreadystatechange = function () {
            if (req.readyState === XMLHttpRequest.DONE) {
                //  document.getElementById("careersForm").style.display = "none"; 
                document.getElementById("careersFormWrapper").style.display = "none";
                document.getElementById("CareerThankYouContainer").style.display = "block";
            }
        };

        var url = "/sitefinity/public/services/leadgenservice.svc/career-email/submit";
        req.open("POST", url, true);
        req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
        req.send(JSON.stringify(careerData));
    }

    function hdr_getCareerFormData() {
        careerData = {
            FirstName: "",
            LastName: "",
            Email: "",
            Comments: ""
        };

        var defaultValue = "";

        var careersFirstNameElem = document.getElementById("careers_firstname");
        careerData.FirstName = careersFirstNameElem.value;

        var careersLastNameElem = document.getElementById("careers_lastname");
        careerData.LastName = careersLastNameElem.value;

        var careersEmail = document.getElementById("careers_email");
        careerData.Email = careersEmail.value;

        var careersComments = document.getElementById("careers_comments");
        careerData.Comments = careersComments.value;

        return careerData;
    }

   

    function hdr_setupThankYouText() {
        if (language.value == "French") {
            thankYouText.innerHTML = "Nous avons bien re\u00E7u votre demande et un repr\u00E9sentant communiquera avec vous sous peu. Merci de l'int\u00E9r\u00EAt que vous portez \u00E0 Cintas. Il nous fera plaisir de parler avec vous.";
            thankYouMessage.innerHTML = "";
            thankYouDetailMessage.innerHTML = "Nous avons bien re\u00E7u votre demande et un repr\u00E9sentant communiquera avec vous sous peu.";
            thankYouFormSubmit.innerHTML = "Envoyez-moi plus d\u2019information";
            thanksButNoThanks.innerHTML = "Non merci";
            thankYouOptionsError.innerHTML = "Veuillez s\u00E9lectionner au moins un domaine qui vous int\u00E9resse.";

        } else {
            thankYouText.innerHTML = "We have received your request and a representative will be contacting you shortly.  " +
                "Thank you for your interest in Cintas.  We look forward to speaking with you.";

            var careerThankYouText = document.getElementById("CareerThankYouText");
            careerThankYouText.innerHTML =
                "Let us know how we can help you and the Cintas Talent Acquisition Team will contact you shortly.";

            thankYouMessage.innerHTML = "";
            thankYouDetailMessage.innerHTML = "We have received your request and a representative will be contacting you shortly." +
                "  Are you also interested in our other services? If so, please check them below and click 'Send Me Additional Info'.";
            thankYouFormSubmit.innerHTML = "Send Me Additional Info";
            thanksButNoThanks.innerHTML = "No Thanks";
            thankYouOptionsError.innerHTML = "Please select at least one area you are interested in.";
        }
    }

    function hdr_autocompleteAvailable() {
        var available = false;
        var serviceOptionListElem = document.getElementById("ServiceOptions");
        if (serviceOptionListElem) {
            var serviceOptions = serviceOptionListElem.getElementsByTagName("input");
            available = serviceOptions[0].checked;
        }

        return available;
    }

    function hdr_disableAutocomplete() {
        if (hdr_autocompleteObj == null)
            return;

        google.maps.event.removeListener(hdr_autocompleteListener);
        google.maps.event.clearInstanceListeners(hdr_autocompleteObj);
        hdr_autocompleteObj.unbindAll();
        hdr_autocompleteObj = null;

        var nodes = document.querySelectorAll(".pac-container");
        for (var x = 0; x < nodes.length; x++) {
            var node = nodes[x];
            var parent = node.parentElement;
            parent.removeChild(node);
        }
    }


    function hdr_enableAutocomplete() {

        if (autocompleteOn == "true") {
            
            if (!hdr_autocompleteAvailable())
                return;

            hdr_disableAutocomplete(); // Better safe than sorry.

            var addressElem = document.getElementById("InputAddress");
            hdr_autocompleteObj = new google.maps.places.Autocomplete(addressElem, {
                types: ["geocode"],
                componentRestrictions: { country: [hdr_pageCountryCode()] }
            });

            document.getElementById("HeaderContactUs").addEventListener("click", function () {
                if (navigator.geolocation) {
                    navigator.geolocation.getCurrentPosition(function (position) {
                        var geolocation = {
                            lat: position.coords.latitude,
                            lng: position.coords.longitude
                        };
                        var circle = new google.maps.Circle({
                            center: geolocation,
                            radius: position.coords.accuracy
                        });
                        hdr_autocompleteObj.setBounds(circle.getBounds());
                    });
                }
            });

            hdr_autocompleteListener = hdr_autocompleteObj.addListener("place_changed", hdr_populateAddress);
        }
    }

    function hdr_getFormData() {
        data = {
            FirstName: "",
            LastName: "",
            Company: "",
            Address: "",
            PostalCode: "",
            Phone: "",
            PhoneExt: "",
            Email: "",
            Comments: "",
            NewServices: false,
            ExistingServices: false,
            Interests: [],
            PageUrl: window.location.href,
            Cmp: "",
            OriginalReferrer: "",
            PpcCampaign: "",
            Language: "",
            WaterBreakInfo: ""
        };

        var defaultValue = "";

        var firstNameElem = document.getElementById("InputFirstName");
        data.FirstName = firstNameElem.value;

        var lastNameElem = document.getElementById("InputLastName");
        data.LastName = lastNameElem.value;

        var companyElem = document.getElementById("InputCompany");
        data.Company = companyElem.value;

        var addressElem = document.getElementById("InputAddress");
        data.Address = addressElem.value;

        var postalCodeElem = document.getElementById("InputPostalCode");
        data.PostalCode = postalCodeElem.value;

        var phoneElem = document.getElementById("InputPhone");
        data.Phone = phoneElem.value;

        var phoneExtElem = document.getElementById("InputPhoneExt");
        defaultValue = phoneExtElem.getAttribute("default-value");
        if (phoneExtElem.value != defaultValue)
            data.PhoneExt = phoneExtElem.value;

        var emailElem = document.getElementById("InputEmail");
        defaultValue = emailElem.getAttribute("default-value");
        if (emailElem.value != defaultValue)
            data.Email = emailElem.value;

        var commentsElem = document.getElementById("InputComments");
        defaultValue = commentsElem.getAttribute("default-value");
        if (commentsElem.value != defaultValue)
            data.Comments = commentsElem.value;

        //if offer exists in params, send with comments
        var incomingURL = window.location.search;
        var offer = incomingURL.replace("?", "");
        if (offer.indexOf("offer") >= 0) {
            offer = offer.replace("offer=", "");
            offer = decodeURIComponent(offer);
            data.Comments += "\r\n\r\nOffer: " + offer;
        }

        //if from 360 model, append unique value to url and send in PageUrl
        if (localStorage.getItem("from360") == "yes") {
            data.PageUrl = document.location.href + "?f=360-image";
            localStorage.clear();
        }

        // Options only need to be added when the main interest is Interested In New Services
        var serviceOptionListElem = document.getElementById("ServiceOptions");
        if (serviceOptionListElem) {
            var serviceOptions = serviceOptionListElem.getElementsByTagName("input");
            data.NewServices = serviceOptions[0].checked;
            data.ExistingServices = serviceOptions[1].checked;
        }

        var contactInterestListElem = document.getElementById("ContactInterestOptions");
        var contactInterestOptions = contactInterestListElem.getElementsByTagName("input");
        for (var x = 0; x < contactInterestOptions.length; x++) {
            var option = contactInterestOptions[x];
            //TODO ugly
            if (option.value.includes("Disinfectant")) {
                option.value = "Disinfectant & Sanitizer Spray";
            }
            if (option.checked)
                data.Interests.push(option.value);
        }

        var cmpElem = document.getElementById("Cmp");
        if (typeof (cmpElem.value) !== "undefined")
            data.Cmp = cmpElem.value;

        var OriginalReferrerElem = document.getElementById("OriginalReferrer");
        if (typeof (OriginalReferrerElem.value) !== "undefined")
            data.OriginalReferrer = OriginalReferrerElem.value;

        var ppcCampaignElem = document.getElementById("PpcCampaign");
        if (typeof (ppcCampaignElem.value) !== "undefined")
            data.PpcCampaign = ppcCampaignElem.value;

        var language = document.getElementById("PageLanguage");
        data.Language = language.value;

        //does this page contain waterbreak widget?
        if (document.querySelector('.hidden_annualCostWaterbreakService') !== null) {
            data.WaterBreakInfo = getWaterBreakInfo();
        } 

        //store main form data to go with thank you form data
        mainFormData = data;
      
        return data;
    }

    function getWaterBreakInfo() {

        var toReturn = "";

        var coolerSlider      = document.getElementById("coolers-number");
        var usersSlider       = document.getElementById("users-number");
        var perJugSlider      = document.getElementById("jugs-number");
        var dollarSaveSlider  = document.getElementById("save");
        var percentSaveSlider = document.getElementById("percentage");

        if (coolerSlider){toReturn += " Cooler Val = " + coolerSlider.innerHTML + ", ";}
        if (usersSlider){toReturn += "Users Val = " + usersSlider.innerHTML + ", ";}
        if (perJugSlider){toReturn += "Per Jug Val = " + perJugSlider.innerHTML + ", ";}
        if (dollarSaveSlider){toReturn += "Cost Save Value = " + dollarSaveSlider.innerHTML + ", ";}
        if (percentSaveSlider){toReturn += "Percent Save Value = " + percentSaveSlider.innerHTML;}
        return toReturn;
    }

    function hdr_handleSmartyStreetsResponse(res) {
        if (res.status != 200) {
            alert("An error has occured, please contact the webmaster.");
            return;
        }

        var data = JSON.parse(res.response);
        if (!data) {
            alert("An error has occured, please contact the webmaster.");
            return;
        }

        if (!data.length) {
            hdr_showAddressInvalid();
            return;
        }

        var addressKey = null;
        var cityKey = null;
        var stateKey = null;
        var postalKey = null;
        var lang = null;
        var addressInput = "";
        var addressReturned = "";
        var postalReturned = "";
        var country = hdr_pageCountryCode();
        if (country == "us") {
            addressKey = "delivery_line_1";
            cityKey = "city_name";
            stateKey = "state_abbreviation";
            postalKey = "zipcode";
        } else {
            addressKey = "address1";
            cityKey = "locality";
            stateKey = "administrative_area";
            postalKey = "postal_code_short";
        }

        var addressElem = document.getElementById("InputAddress");

        addressInput = addressElem.value;
        addressReturned = data[0][addressKey]
            + ", " + data[0].components[cityKey]
            + ", " + data[0].components[stateKey];

        var maxDistance = 10;
        var lDist = util_levenshtein(addressInput, addressReturned);

        if (lDist > 0) {
            var postalReturned = data[0].components[postalKey];
            hdr_showAddressSuggestion(addressReturned, postalReturned);
            return;
        }

        hdr_submitForm();
    }

    function hdr_handleSubmitResponse(res) {
        if (res.status != 200) {
            alert("An error has occured, please contact the webmaster.");
            return;
        }

        var contactUsForm = document.getElementById("ContactUsForm");
        var thankYou = document.getElementById("ThankYouContainer");

        //if "interested in new services", fire thank you form	
        if (serviceOptionListElem) {
            var serviceOptions = serviceOptionListElem.getElementsByTagName("input");

            if (serviceOptions[0].checked) {
                hdr_setupThankYouForm();
            }
            if (serviceOptions[1].checked) {
                contactUsForm.style.display = "none";
                thankYou.style.display = "block";
            }
        }
        else {
            hdr_setupThankYouForm();
        }


        window.uetq = window.uetq || [];
        window.uetq.push({
            'ec': 'Button',
            'ea': 'Click',
            'el': 'Submit',
            'ev': '1'
        });

        goog_report_conversion();

        var data = hdr_getFormData();
        var label = "N/A";
        if (data.ExistingServices)
            label = "I have a question about my existing service";
        else if (data.NewServices)
            label = "I am interested in new services";

        ga("create", "UA-13074057-2", { "name": "contactUsTracker" });
        ga("contactUsTracker.send", "event", "Contact Us Form Submit", location.href, label);


        // SEND FLOODLIGHT TAGS
        tag_floodlight();

        var newServicesName = "Contact_Us_Form_Submit_New_Services";
        var existingServiceName = "Contact_Us_Form_Submit_Existing_Customer";

        var newServices = document.getElementById("ServiceOptions_0");
        var existingServices = document.getElementById("ServiceOptions_1");

        if (newServices) {
            if (newServices.checked) {
                tag_dynamicYield(newServicesName);
            }
        }
        if (existingServices) {
            if (existingServices.checked) {
                tag_dynamicYield(existingServiceName);
            }
        }
    }

    function hdr_onBlur(txt) {
        if (txt.value == "")
            txt.value = txt.getAttribute("default-value");
    }

    function hdr_onFocus(txt) {
        txt.style.color = "#222222";
        if (txt.value == txt.getAttribute("default-value"))
            txt.value = "";
    }

    function hdr_pageCountryCode() {
        var code = "DEFUALT_COUNTRY";
        var site = document.getElementById("GlobalSite");
        if (site.value == "Cintas 2015")
            code = "us";
        else if (site.value == "Cintas 2015 - Canada")
            code = "ca";

        return code;
    }

    function hdr_populateAddress() {
        var place = hdr_autocompleteObj.getPlace();
        if (!(place && ("address_components" in place))) {
            return;
        }

        function findAddressComponent(name) {
            var c = "NOT_FOUND";
            for (var x = 0; x < place.address_components.length; x++) {
                var component = place.address_components[x];
                for (var y = 0; y < component.types.length; y++) {
                    var type = component.types[y];
                    if (type == name) {
                        c = component.short_name;
                        break;
                    }
                }
            }

            return c;
        }

        function createAddress(streetNumber, route, locality, adminAreaLvl1) {
            var address = "";
            if (streetNumber != "NOT_FOUND")
                address += streetNumber + " ";
            if (route != "NOT_FOUND")
                address += route + ", ";
            if (locality != "NOT_FOUND")
                address += locality + ", ";
            if (adminAreaLvl1 != "NOT_FOUND")
                address += adminAreaLvl1;

            return address;
        }

        var streetNumber = findAddressComponent("street_number");
        var route = findAddressComponent("route");
        var locality = findAddressComponent("locality");
        var adminAreaLvl1 = findAddressComponent("administrative_area_level_1");
        var address = createAddress(streetNumber, route, locality, adminAreaLvl1);

        var addressElem = document.getElementById("InputAddress");
        addressElem.value = address;

        var postalCode = findAddressComponent("postal_code");

        var postalCodeElem = document.getElementById("InputPostalCode");
        postalCodeElem.value = postalCode;

        hdr_autocompleteAddress = true;
    }

    function reset() {
        var submitBtnElem = document.getElementById("InputSubmitButton");
        submitBtnElem.value = 'submit >';
        submitBtnElem.disabled = false;
    }

    function hdr_setupFormEvents() {

        //hide checkbox elements for thank you form
        var hidden = document.getElementById("hiddenDiv");
        hidden.style.display = "none";

        var submitBtnElem = document.getElementById("InputSubmitButton");
        submitBtnElem.onclick = function (event) {

            event.preventDefault();

            submitBtnElem.disabled = true
            submitBtnElem.value = 'Please Wait...';

            hdr_validateForm(reset);
            //console.log("click" + Date.now());

            //submitBtnElem.value = 'submit';
            //submitBtnElem.disabled = false;

        };

        var serviceOptionListElem = document.getElementById("ServiceOptions");
        if (serviceOptionListElem) {

            var serviceOptions = serviceOptionListElem.getElementsByTagName("input");
            var container = document.getElementById("ContactInterestContainer");
            var errMsg = document.getElementById("ContactInterestErrorMsg");

            //these two onclick events are (nearly 100%) redundant and the things that are fired should fire regardless
            //of which radio button is selected, but if they don't happen within the click events,
            //the google autocomplete fails, check the console log while testing
            serviceOptions[0].onclick = function (event) {
                container.style.visibility = "visible";
                hdr_enableAutocomplete();

                var commentsElem = document.getElementById("InputComments");
                var langElem = document.getElementById("GlobalLanguage");
                if (langElem.value == "English") {
                    commentsElem.value = "Comments";
                    commentsElem.setAttribute("default-value", "Comments");
                    commentsElem.style.color = "#222222";
                } else if (langElem.value == "French") {
                    commentsElem.value = "Commentaires";
                    commentsElem.setAttribute("default-value", "Commentaires");
                    commentsElem.style.color = "#222222";
                }
            };

            serviceOptions[1].onclick = function (event) {
                container.style.visibility = "visible";
                hdr_disableAutocomplete();

                var commentsElem = document.getElementById("InputComments");
                var langElem = document.getElementById("GlobalLanguage");
                if (langElem.value == "English") {
                    commentsElem.value = "Comments*";
                    commentsElem.setAttribute("default-value", "Comments*");
                    commentsElem.style.color = "#222222";
                } else if (langElem.value == "French") {
                    commentsElem.value = "Commentaires*";
                    commentsElem.setAttribute("default-value", "Commentaires*");
                    commentsElem.style.color = "#222222";
                }
            };
        }

        var addressElem = document.getElementById("InputAddress");
        addressElem.onkeydown = function (event) {
            hdr_autocompleteAddress = false;
        };

        var postalCodeElem = document.getElementById("InputPostalCode");
        postalCodeElem.onkeydown = function (event) {
            hdr_autocompleteAddress = false;
        };

        //disable enter key on all input fields
        var inputElems = document.querySelectorAll(".inputField");
        for (var i = 0; i < inputElems.length; i++) {
            inputElems[i].addEventListener('keydown', function (event) {
                if (event.which === 13) {
                    event.preventDefault();
                }
            });
        }

        var allInputs = document.querySelectorAll("input");
        for (var i = 0; i < allInputs.length; i++) {
            if (allInputs[i].type == "checkbox" || allInputs[i].type == "radio") {
                allInputs[i].addEventListener('keydown', function (event) {
                    if (event.which === 13) {
                        event.preventDefault();
                    }
                });
            }
        }



        setTimeout(hdr_enableAutocomplete, 500);

        //if 'offer' exists in params, fire contact form
        var incomingURL = window.location.search;
        var incomingParams = incomingURL.replace("?", "");
        if (incomingParams.indexOf("offer") >= 0) {
            setTimeout(function () {
                var contactElem = document.getElementById("HeaderContactUs");
                contactElem.click();
            }, 500);
        }

        var ThankYouFormSubmit = document.getElementById("ThankYouFormSubmit");
        ThankYouFormSubmit.onclick = function (event) {
            event.preventDefault();
            hdr_handleThankYouFormSubmit();
        };

        var NoThanks = document.getElementById("ThanksButNoThanks");
        NoThanks.onclick = function (event) {
            event.preventDefault();
            var thankYou = document.getElementById("ThankYouContainer");
            thankYou.style.display = "block";
            thankYouText.style.display = "block";
            secondaryThankYouContainer.style.display = "none";
        };

        var careersSubmitElem = document.getElementById("careers_submit");
        careersSubmitElem.onclick = function (event) {
            hdr_validateCareers();
        };
    }

    function hdr_showAddressInvalid() {
        var addressElem = document.getElementById("InputAddress");
        var postalElem = document.getElementById("InputPostalCode");
        var langElem = document.getElementById("PageLanguage");
        lang = langElem.value;

        var msgStr = "msgStr-DEFAULT";
        var addressStr = "addressStr-DEFAULT";
        var confirmStr = "confirmStr-DEFAULT";
        var denyStr = "denyStr-DEFAULT";

        if (lang == "English") {
            msgStr = "We couldn't locate the company address you entered.";
            addressStr = addressElem.value + ", " + postalElem.value;
            confirmStr = "Try Again";
            denyStr = "Submit Original";
        } else if (lang == "French") {
            msgStr = "Nous n\u2019avons pas \u00E9t\u00E9 en mesure de localiser l\u2019adresse entr\u00E9e.";
            addressStr = addressElem.value + ", " + postalElem.value;
            confirmStr = "Veuillez essayer \u00E0 nouveau";
            denyStr = "Envoyer l\u2019adresse initiale";
        }

        hdr_showModal(msgStr, addressStr, confirmStr, denyStr);
    }

    function hdr_showAddressSuggestion(address, postal) {
        var langElem = document.getElementById("PageLanguage");
        lang = langElem.value;

        var msgStr = "msgStr-DEFAULT";
        var addressStr = "addressStr-DEFAULT";
        var confirmStr = "confirmStr-DEFAULT";
        var denyStr = "denyStr-DEFAULT";

        if (lang == "English") {
            msgStr = "We found an address that is close to yours, use this one instead?";
            addressStr = address + ", " + postal;
            confirmStr = "Update Address";
            denyStr = "Submit Original";
        } else if (lang == "French") {
            msgStr = "Nous avons trouv\u00E9 une adresse \u00E0 proximit\u00E9 de la v\u00F4tre; voulez-vous l\u2019utiliser?";
            addressStr = address + ", " + postal;
            confirmStr = "Utiliser la nouvelle adresse";
            denyStr = "Envoyer l\u2019adresse initiale";
        }

        hdr_showModal(msgStr, addressStr, confirmStr, denyStr);
    }

    function hdr_showModal(msgStr, addressStr, confirmStr, denyStr) {
        var modalElem = document.getElementById("addr-val-modal");

        var msgElem = document.getElementById("modal-msg");
        msgElem.textContent = msgStr;

        var addressElem = document.getElementById("modal-addr");
        addressElem.textContent = addressStr;

        var confirmBtn = document.getElementById("modal-confirm");
        confirmBtn.textContent = confirmStr;

        var denyBtn = document.getElementById("modal-deny");
        denyBtn.textContent = denyStr;
        denyBtn.onclick = function (event) {
            event.preventDefault();
            modalElem.style.display = "none";
            hdr_submitForm();
        };

        var closeBtn = document.getElementById("modal-close");
        closeBtn.onclick = function (event) {
            event.preventDefault();
            modalElem.style.display = "none";
            reset();
        };

        if (confirmStr.indexOf("Update Address") > -1
            || confirmStr.indexOf("Utiliser la nouvelle adresse") > -1) {
            confirmBtn.onclick = function (event) {
                event.preventDefault();

                var splitStr = addressStr.split(", ");
                var postal = splitStr[(splitStr.length - 1)];
                var addr = "";
                for (var x = 0; x < splitStr.length - 1; x++)
                    addr += splitStr[x] + ", ";

                addr = addr.substring(0, addr.length - 2);

                var addressInputElem = document.getElementById("InputAddress");
                addressInputElem.value = addr;

                var postalInputElem = document.getElementById("InputPostalCode");
                postalInputElem.value = postal;

                modalElem.style.display = "none";
                hdr_submitForm();
                reset();
            };
        } else {
            confirmBtn.onclick = function (event) {
                event.preventDefault();
                modalElem.style.display = "none";
                reset();
            };
        }

        modalElem.style.display = "block";
    }

    function hdr_submitForm() {
        var data = hdr_getFormData();
        var req = new XMLHttpRequest();
        req.onreadystatechange = function () {
            if (req.readyState === XMLHttpRequest.DONE) {
                hdr_handleSubmitResponse(req);
            }
        };

        var url = "/sitefinity/public/services/leadgenservice.svc/contact-us/submit";
        req.open("POST", url, true);
        req.setRequestHeader("Content-Type", "application/json; charset=utf-8");
        req.send(JSON.stringify(data));
    }

    function hdr_validEmail(email) {
        var re = /^(([^<>()\[\]\\.,;:\s@"]+(\.[^<>()\[\]\\.,;:\s@"]+)*)|(".+"))@((\[[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}])|(([a-zA-Z\-0-9]+\.)+[a-zA-Z]{2,}))$/;
        return re.test(email);
    }

    function hdr_validateForm() {
        var valid = true;
        var defaultValue = "";

        var firstNameElem = document.getElementById("InputFirstName");
        defaultValue = firstNameElem.getAttribute("default-value");
        if (firstNameElem.value.length == 0
            || firstNameElem.value == defaultValue) {
            firstNameElem.style.color = "#FF0000";
            valid = false;
        } else {
            firstNameElem.style.color = "#222222";
        }

        var lastNameElem = document.getElementById("InputLastName");
        defaultValue = lastNameElem.getAttribute("default-value");
        if (lastNameElem.value.length == 0 || lastNameElem.value == defaultValue) {
            lastNameElem.style.color = "#FF0000";
            valid = false;
        } else {
            lastNameElem.style.color = "#222222";
        }

        var companyElem = document.getElementById("InputCompany");
        defaultValue = companyElem.getAttribute("default-value");
        if (companyElem.value.length == 0 || companyElem.value == defaultValue) {
            companyElem.style.color = "#FF0000";
            valid = false;
        } else {
            companyElem.style.color = "#222222";
        }

        var addressElem = document.getElementById("InputAddress");
        defaultValue = addressElem.getAttribute("default-value");
        if (addressElem.value.length == 0 || addressElem.value == defaultValue) {
            addressElem.style.color = "#FF0000";
            valid = false;
        } else {
            addressElem.style.color = "#222222";
        }

        var postalCodeElem = document.getElementById("InputPostalCode");
        defaultValue = postalCodeElem.getAttribute("default-value");
        if (postalCodeElem.value.length == 0
            || postalCodeElem.value.length > 7 // Covers both US and CA postal
            || postalCodeElem.value == defaultValue) {
            postalCodeElem.style.color = "#FF0000";
            valid = false;
        } else {
            postalCodeElem.style.color = "#222222";
        }

        var phoneElem = document.getElementById("InputPhone");
        defaultValue = phoneElem.getAttribute("default-value");
        if (phoneElem.value == defaultValue
            || phoneElem.value.match(/\d/g).length < 10
            || phoneElem.value.match(/\d/g).length > 10) {
            phoneElem.style.color = "#FF0000";
            valid = false;
        } else {
            phoneElem.style.color = "#222222";
        }

        var emailElem = document.getElementById("InputEmail");
        defaultValue = emailElem.getAttribute("default-value");
        if (emailElem.value.length > 0 && emailElem.value != defaultValue) {
            if (!hdr_validEmail(emailElem.value)) {
                emailElem.style.color = "#FF0000";
                valid = false;
            } else {
                emailElem.style.color = "#222222";
            }
        }

        var serviceOptionListElem = document.getElementById("ServiceOptions");

        if (serviceOptionListElem) {

            var serviceOptions = serviceOptionListElem.getElementsByTagName("input");

            if (serviceOptions[1].checked) {

                var commentsElem = document.getElementById("InputComments");
                defaultValue = commentsElem.getAttribute("default-value");
                if (commentsElem.value.length > 0 && commentsElem.value == defaultValue) {
                    commentsElem.style.color = "#FF0000";
                    valid = false;
                } else {
                    commentsElem.style.color = "#222222";
                }
            }

        }

        var optionsSelected = 0;
        var contactInterestListElem = document.getElementById("ContactInterestOptions");
        var contactInterestOptions = contactInterestListElem.getElementsByTagName("input");
        var contactInterestValues = contactInterestListElem.getElementsByTagName("span");
        for (var x = 0; x < contactInterestOptions.length; x++) {
            var option = contactInterestOptions[x];
            if (option.checked)
                optionsSelected += 1;
        }

        var interestErrElem = document.getElementById("ContactInterestErrorMsg");
        if (optionsSelected == 0) {
            interestErrElem.style.visibility = "visible";
            valid = false;
        } else {
            interestErrElem.style.visibility = "hidden";
        }
        
        var hPotElem = document.getElementById("hPot");
        if (hPotElem) {
            if (hPotElem.value != "") {
                valid = false;
            }
        }
        
        if (!valid) {
            reset();
            return;
        }

        if (valid && !hdr_autocompleteAvailable()) {
            reset();
            hdr_submitForm();
            return;
        }

        if (!hdr_autocompleteAddress) {
            hdr_validateSmartyStreets();
        }
        else {
            document.getElementById("InputSubmitButton").disabled = true;
            hdr_submitForm();
        }
    }

    function hdr_validateSmartyStreets() {
        var url = null;
        var freeform = null;
        var params = { "auth-id": "12274395174198370" };

        var countryCode = hdr_pageCountryCode();
        if (countryCode == "us") {
            url = "https://us-street.api.smartystreets.com/street-address";
            freeform = "street";
            address = "delivery_line_1";
            city = "city_name";
            state = "state_abbreviation";
            postal = "zipcode";
        } else {
            url = "https://international-street.api.smartystreets.com/verify";
            freeform = "freeform";
            address = "address1";
            city = "localcity";
            state = "administrative_area";
            postal = "postal_code_short";

            params.country = countryCode;
        }

        var addressElem = document.getElementById("InputAddress");
        var postalElem = document.getElementById("InputPostalCode");
        params[freeform] = addressElem.value + " " + postalElem.value;

        var req = new XMLHttpRequest();
        req.onreadystatechange = function () {
            if (req.readyState === XMLHttpRequest.DONE)
                hdr_handleSmartyStreetsResponse(req);
        };

        url = url + "?";
        for (var key in params)
            url = url + key + "=" + encodeURIComponent(params[key]) + "&";

        req.open("GET", url, true);
        req.send();
    }

    function hdr_setupThankYouForm() {
        document.getElementById("ContactUsPhone").style.display = 'none';
        ContactTitleText.style.display = "none";
        ContactThankYouText.style.display = "block";

        var thankYouTable = document.getElementById("ThankYouFormOptions");
        var html = "";
        var hiddenCheckboxes = new Array();
        var selectedCheckboxes = Object.values(data.Interests);
        var hiddenOptions = document.querySelectorAll("#hiddenDiv tbody tr td input");

        for (var i = 0; i < hiddenOptions.length; i++) {
            hiddenCheckboxes.push(hiddenOptions[i].getAttribute("value"));
        }
        var selected = JSON.stringify(selectedCheckboxes);

        if (site == "_siteUs") {

            if (url.includes("uniform-work-apparel") && !url.includes("cleanroom")) {
                if (selected.includes("Flame Resistant Clothing")) {
                    var index = hiddenCheckboxes.indexOf("Flame Resistant Clothing");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
                }
                if (selected.includes("Uniform Purchase") || selected.includes("Custom Tailored Apparel") ||
                    selected.includes("Carhartt Rental Workwear") || selected.includes("Women's Workwear") ||
                    selected.includes("Cleanroom/ESD/GMP Gowning") || selected.includes("Chef Works Apparel") ||
                    selected.includes("Uniform Rental")) {
                    var index = hiddenCheckboxes.indexOf("Uniforms and Apparel");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
                }
            }
            else if (url.includes("facilityservices")) {
                if (selected.includes("Mats, Mops, Towels")) {
                    var index = hiddenCheckboxes.indexOf("Mats, Mops, Towels");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
                }
                if (selected.includes("Restroom and Hygiene Service")) {
                    var index = hiddenCheckboxes.indexOf("Restroom and Hygiene Service");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
                }
                if (selected.includes("Cleaning Chemical Service")) {
                    var index = hiddenCheckboxes.indexOf("Cleaning Chemical Service");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
                }
                if (selected.includes("Hand Sanitizer &#38; Stands")) {
                    var index = hiddenCheckboxes.indexOf("Hand Sanitizer &#38; Stands");
                    if (index > -1) {
                        hiddenCheckboxes.splice(index, 1);
                    }
