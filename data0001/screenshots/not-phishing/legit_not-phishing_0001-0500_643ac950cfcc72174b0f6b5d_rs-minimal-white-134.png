                    }
                }
                else {
                    hiddenEncoded = hiddenEncoded.filter(function (el) {
                        return selectedEncoded.indexOf(el) < 0;
                    });
                }
                if (selectedEncoded.includes("Service De Pulv\u00E8risation De D\u00E9sinfectant Et D\u2019assainissant")) {                        
                    var index = hiddenEncoded.indexOf("Service De Pulv\u00E8risation De D\u00E9sinfectant Et D\u2019assainissant");
                    if (index > -1) {
                        hiddenEncoded.splice(index, 1);
                    }
                }

            }
        }

        if (language.value == "French") {
            //convert unicode back to char
            for (var i = 0; i < hiddenEncoded.length; i++) {
                hiddenDecoded.push(unicodeToChar(hiddenEncoded[i]));
            }
            hiddenDecoded.forEach(function (element) {
                html += '<tr><td><input type="checkbox" name="' + element + '"value="' +
                    element + '" /><label for="' + element + '">' + element + '</label></td></tr>';
            });
        }
        else {
            hiddenCheckboxes.forEach(function (element) {
                html += '<tr><td><input type="checkbox" name="' + element + '"value="' +
                    element + '" /><label for="' + element + '">' + element + '</label></td></tr>';
            });
        }

        var contactUsForm = document.getElementById("ContactUsForm");

        //if all boxes in second form have been exluded, go to final thank you message
        if (language.value == "French" && hiddenDecoded.length == 0) {
            thankYou.style.display = "block";
            thankYouText.style.display = "block";
            secondaryThankYouContainer.style.display = "none";
            contactUsForm.style.display = "none";
        }
        else {
            thankYouTable.innerHTML = html;
            contactUsForm.style.display = "none";
            secondaryThankYouContainer.style.display = "block";
        }
    }

    function hdr_handleThankYouFormSubmit() {

        if (hdr_validateThankYouForm()) {
            document.getElementById("ThankYouFormSubmit").disabled = true;

            ThankYouErr.style.visibility = "hidden";

            var language = document.getElementById("PageLanguage");
            if (language.value == "French") {
                var thankyouMessageSecond = "Nous avons bien reçu votre demande et un représentant communiquera avec vous sous peu. Merci de l'intérêt que vous portez à Cintas. Il nous fera plaisir de parler avec vous.";
                if (document.getElementById("mThankYouText")) {
                    document.getElementById("mThankYouText").innerHTML = thankyouMessageSecond;
                }
                if (document.getElementById("ThankYouDetailMessage")) {
                    document.getElementById("ThankYouDetailMessage").innerHTML = thankyouMessageSecond;
                }
            }

            mainFormData.Interests = null;
            secondaryFormData = mainFormData;
            secondaryFormData.Interests = secondaryFormSelections;

            var urlData = secondaryFormData.PageUrl + "?thankyou=yes";
            secondaryFormData.PageUrl = urlData;

            var thankYouReq = new XMLHttpRequest();
            thankYouReq.onreadystatechange = function () {
                if (thankYouReq.readyState === XMLHttpRequest.DONE) {

                    var thankYou = document.getElementById("ThankYouContainer");
                    thankYou.style.display = "block";
                    thankYouText.style.display = "block";
                    secondaryThankYouContainer.style.display = "none";
                }
            };

            hdr_thankyouGAtracking();

            var url = "/sitefinity/public/services/leadgenservice.svc/contact-us/submit";
            thankYouReq.open("POST", url, true);
            thankYouReq.setRequestHeader("Content-Type", "application/json; charset=utf-8");
            thankYouReq.send(JSON.stringify(secondaryFormData));

        } else {
            ThankYouErr.style.visibility = "visible";
        }

    }

    function hdr_validateThankYouForm() {
        var isValid = false;
        var thankYouOptions = document.querySelectorAll("#ThankYouFormOptions input");
        secondaryFormSelections = [];
        for (var x = 0; x < thankYouOptions.length; x++) {
            if (thankYouOptions[x].checked) {
                secondaryFormSelections.push(thankYouOptions[x].value);
                isValid = true;
            }
        }
        return isValid;
    }

    function convertSpecialCharsToUnicodeLiteral(string) {
        let i,
            result = '';

        for (let i = 0; i < string.length; i++) {
            if (string.charCodeAt(i) > 126 || string.charCodeAt(i) < 32) {
                result += '\\u' + getFixedHexForChar(string.charCodeAt(i), 4);
            } else {
                result += string[i];
            }
        }

        return result;
    }

    function getFixedHexForChar(num, length) {
        let str = num.toString(16).toUpperCase();
        while (str.length < length) {
            str = "0" + str;
        }

        return str;
    }

    //separate by what is in between double quotes, return array
    function extractAllText(str) {
        const re = /"(.*?)"/g;
        const result = [];
        let current;
        while (current = re.exec(str)) {
            result.push(current.pop());
        }
        return result.length > 0
            ? result
            : [str];
    }

    function unicodeToChar(text) {
        return text.replace(/\\u[\dA-F]{4}/gi,
            function (match) {
                return String.fromCharCode(parseInt(match.replace(/\\u/g, ''), 16));
            });
    }

    function hdr_thankyouGAtracking() {

        if (dynamicYieldOn == "true") {
            tag_dynamicYield('DY_Contact_Us_Thank_You_Form');
            ga('send', 'event', 'SecondaryThankYouForm', 'click');
        }         
    }

    hdr_main();
</script>


            
