<script>
    $('#slider-6651').on('slide.bs.carousel', function (slide) {
        $('#slider-content-6651-' + slide.from).animateCss('fadeOutLeft', function() {
            $('#slider-content-6651-' + slide.from).addClass('d-none');
            $('#slider-content-6651-' + slide.to).removeClass('d-none');
            $('#slider-content-6651-' + slide.to).animateCss('fadeInRight');
        });
    })
    $(function() {
        return $(".carousel.lazy").on("slide.bs.carousel", function(slide) {
            var lazy;
            lazy = $(slide.relatedTarget).find("img[data-src]");
            lazy.attr("src", lazy.data('src'));
            lazy.removeAttr("data-src");
        });
    });
</script>

