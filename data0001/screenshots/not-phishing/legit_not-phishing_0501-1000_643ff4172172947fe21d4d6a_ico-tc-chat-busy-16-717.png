  <style>
    * {
      box-sizing: border-box;
      font-family: sans-serif;
    }

    .maxWidthContainer {
      position: relative;
      margin: auto;
      max-width: 1600px;
    }

    .row {
      align-items: flex-start;
      display: flex;
      flex: 0 1 auto;
      width: 100%;
      padding: 0px;
      margin: 0px;
    }

    .header {
      padding: 10px;
      max-width: 1324px !important;
      margin: 0 auto !important;
    }

    .footer {
      background-color: rgb(220, 223, 227);
      height: auto;
      width: 100%;
      padding: 20px;
      font-size: 10px !important;
      font-weight: 400 !important;
      color: #1d2329 !important;
    }

    .footer a {
      text-decoration: none;
      color: #1d2329 !important;
    }

    .footer_1 {
      max-width: 1324px !important;
      margin: 0 auto !important;
    }

    .footer_1 span {
      margin-right: 15px;
      margin-bottom: 25px;
      display: inline-block;
    }

    .footer_2 {
      display: none;
    }

    .icons_container {
      max-width: 1324px !important;
      margin: 0 auto !important;
      display: flex;
      flex-direction: row;
      justify-content: space-evenly;
      align-items: start;
    }

    .category {
      padding: 20px 20px 40px 20px;
      background-color: #0057b8;
      text-align: center;
      color: white;
    }

    .category h1 {
      font-weight: 100;
    }

    .headband_item {
      padding-top: 16px;
      padding-bottom: 16px;
      width: 120px;
      height: auto;
    }

    .headband_item:hover div {
      text-decoration: underline;
    }

    .category_blob_item {
      padding-top: 20px;
      padding-bottom: 20px;
      width: 150px;
      height: auto;
    }

    .svgIcon {
      display: flex;
      justify-content: center;
      margin-bottom: 10px;
    }

    .svgIcon>svg {
      height: 36px;
      width: 36px;
    }

    .svgIcon+div {
      text-align: center;
      color: black;
      font-size: 13px;
    }

    .svgIcon2 {
      display: flex;
      justify-content: center;
      margin-bottom: 10px;
    }

    .svgIcon2>svg {
      height: 50px;
      width: 50px;
    }

    .svgIcon2+div {
      color: white;
      text-align: center;
      font-size: 13px;
    }


    @media (max-width:1024px) and (min-width:768px) {
      .row {
        overflow-x: hidden;
        overflow-x: scroll;
      }

      .headband_item {
        width: 118px;
      }

      .category_blob_item {
        width: 130px;
      }

    }

    @media (max-width:767px) {
      .row {
        overflow-x: hidden;
        overflow-x: scroll;
      }

      .header {
        justify-content: center;
      }

      .category {
        padding: 20px 0px 40px 30px;
        text-align: left;
      }

      .headband_item {
        width: 80px;
      }

      .category_blob_item {
        width: 110px;
      }

      .footer_1 {
        display: none;
      }

      .footer_2 {
        display: flex;
        flex-direction: row;
      }

      .footer_2 ul {
        list-style: none;
        text-align: center;
        width: 50%;
      }

      .footer_2 li {
        margin-bottom: 40px;
      }
    }

    /* button */
    .btn-large,
    [class*=btn-] {
      font-size: 1.4rem;
      height: 48px;
      min-width: 200px;
      padding-left: 48px;
      padding-right: 48px;
    }

    .btn-primary-2,
    .btn-primary-2:active {
      background-color: #0057b8;
      border-color: #0057b8;
      box-shadow: 0px 0px 0px 3px transparent inset, 0px 0px 0px 4px transparent inset;
      color: #fff;
    }

    .btn-primary-2:hover {
      background-color: #007ae2;
      border-color: #007ae2;
      color: #fff;
      outline: none;
      transition: background-color .3s linear;
    }

    .btn img {
      position: relative;
      animation-duration: 1s;
      animation-iteration-count: 1;
      transform-origin: bottom;
    }

    .btn img:hover {
      animation-name: arrow;
      animation-timing-function: linear;
    }

    @keyframes arrow {
      0% {
        transform: translateX(0px);
      }

      60% {
        transform: translateX(40px);
      }

      70% {
        transform: translateX(-40px);
        z-index: -100
      }

      100% {
        transform: translateX(0px);
      }
    }

    [class*=btn-],
    a[class*=btn]:hover {
      text-decoration: none;
    }

    [class*=btn-] {
      align-items: center;
      border: 1px solid transparent;
      border-radius: 3px;
      display: inline-flex;
      font-family: font-medium;
      justify-content: center;
      line-height: 1.2;
      outline: none;
      text-align: center;
      user-select: none;
    }

    .cta {
      display: inline-flex;
      flex-direction: column;
    }

    .cta_arrow {
      height: 30px;
      width: 40px;
      overflow: hidden;
    }

    .cta_text {
      font-size: 15px
    }

    /* storyOffer */
    .storyOffer {
      display: flex;
      flex-direction: row;
      margin-left: auto;
      margin-right: auto;
      margin-top: 20px;
      margin-bottom: 60px;
      max-width: 1024px !important;
    }

    .storyOffer_content {
      width: 100%;
      padding-top: 60px;
      padding-bottom: 60px;
      padding-right: 40px
    }

    .storyOffer_eyebrow {
      color: grey;
      font-size: 18px;
      display: block
    }

    .storyOffer_heading {
      font-size: 41px;
      display: block
    }

    .storyOffer_subHeading {
      color: grey;
    }

    @media(max-width:1024px) {
      .storyOffer {
        display: flex;
        flex-direction: row;
        margin-left: 40px;
        margin-right: 40px;
      }

      .storyOffer_content {
        padding-top: 40px;
        padding-bottom: 40px;
        padding-right: 20px
      }
    }

    @media(max-width:767px) {
      .storyOffer {
        display: flex;
        flex-direction: column;
        margin-top: 0px;
        margin-left: 20px;
        margin-right: 20px;
      }

      .storyOffer_content {
        padding-right: 0px
      }
    }
  </style>
</head>

