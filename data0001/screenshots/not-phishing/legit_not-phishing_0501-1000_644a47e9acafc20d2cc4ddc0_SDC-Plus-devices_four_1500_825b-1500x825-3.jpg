    <script>
        if (typeof(_analytics) == "undefined") {
            var _analytics = {"page":{"pageInfo":{"templateName":"tfb-content","pageTitle":"Business Phones, Plans, Wireless Solutions | T-Mobile for Business","variant":"","pageURL":"","language":"en","pageID":"/content/tfb/en/index","pageName":"index","version":"","TFN":{}},"category":{},"modules":{"moduleList":[],"moduleCount":0,"moduleListAll":[]}}};
