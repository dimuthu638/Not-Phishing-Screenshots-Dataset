</tmo-digital-header>

<script>
window.addEventListener('load', (event) => {
    var headerComponent = document.querySelector('tmo-digital-header');
    var cartElement = $(headerComponent).find('div[id*="cart"]');
    var cartCountElement = cartElement.find('.mat-badge-content');
    var counterBadgeElement =  cartElement.find('.mat-badge');

    var getCookieVal = function(name) {
        var nameEQ = name + "=";
        var ca = document.cookie.split(';');
        for(var i=0;i < ca.length;i++) {
            var c = ca[i];
            while (c.charAt(0)==' ') c = c.substring(1,c.length);
            if (c.indexOf(nameEQ) == 0) return c.substring(nameEQ.length,c.length);
        }
        return null;
    }

    var cartCountNumber = JSON.parse(decodeURIComponent(getCookieVal('CART_COOKIE_ACTIVATION')));
    if (cartCountNumber && cartCountNumber['cartCounter'] > 0) {
        counterBadgeElement.removeClass('mat-badge-hidden');
        cartCountElement.text(cartCountNumber.cartCounter);
    }

    headerComponent.addEventListener('digitalUnavEvent', function (event) {
        if (event.detail === 'getStartedModalEvent') {
            var globalFormModelPath = '/content/tfb/en/model-repository/GetStarted-CC'
            // trackGenericClick(currentTarget, CTAName, modalName, url)
            trackGenericClick(event.currentTarget, event.detail, '', globalFormModelPath, globalFormModelPath);
            openGlobalFormModal(globalFormModelPath);
        }
    });
    });
</script></div>
