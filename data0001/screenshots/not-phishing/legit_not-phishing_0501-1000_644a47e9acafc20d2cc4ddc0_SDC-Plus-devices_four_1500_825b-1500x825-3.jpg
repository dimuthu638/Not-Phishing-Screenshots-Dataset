    <div class="smallarticle_1.2">






<div class="article " data-action="article" id="9886f59d27dc972196f8e00f1f277411e4f4424a" data-analytics-id="9886f59d27dc972196f8e00f1f277411e4f4424a" data-analytics-title-text="Small Article">
    
    
        
        
        
        
        
        
    
    
    
        
            <a target="_self" href="https://www.t-mobile.com/business/cell-phone/apple-iphone-14-pro?&icid=TFB_TMO_P_23TBIP14US_0CL2X3X0FJV62Y7434025" class="article__image  " onclick="trackGenericClick(this)" style="background-image: url('/content/dam/tfb/assets/foreground/article/iPhone_14_Pro_Desktop_640x352.png')" aria-label="iPhone 14 Pro">
                
                    <div class="article__image__copy-wrapper">
                        
                        
                    </div>
                
                <img src="/content/dam/tfb/assets/foreground/article/iPhone_14_Pro_Desktop_640x352.png" alt="iPhone 14 Pro"/>
            </a>
            
        
        
    
    <div class="article__text">
        
        
            
