        <video style="/*position:fixed;right: 0;bottom:0;min-width: 100%; min-height: 100%;*/position: absolute; top:0;bottom:0;right:0;left:0;margin: auto;min-width: 50%; min-height: 50%;" playsinline autoplay loop muted>
