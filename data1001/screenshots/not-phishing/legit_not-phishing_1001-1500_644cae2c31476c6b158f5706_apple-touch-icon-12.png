 <style amp-custom>
/*false*/
@font-face{font-family:SR;src:url(//static.s-sfr.fr/assets/fonts/Poppins-Regular.woff2)}
@font-face{font-family:SB;src:url(//static.s-sfr.fr/assets/fonts/Poppins-Bold.woff2)}
@font-face{font-family:SD;src:url(//static.s-sfr.fr/assets/fonts/Poppins-Black.woff2)}
html,body{overflow-x:hidden}
body{margin:0;padding:0}
body:before{height:0}
body.hS:before,body.Home:not(.basket-displayed):before{display:block;content:''}
body.hS #eThS,body.Home:not(.basket-displayed) #eThS{position:fixed;top:0}
#eThS,#eThS *{margin:0;padding:0;font:inherit;color:inherit;outline:0;box-sizing:border-box;text-align:left;vertical-align:top;height:auto}
#eThS{position:relative;z-index:62100;font:0/1.2 SR,Arial;color:#222;background:#fff;width:100%;word-break:normal}
body:not(.Media) #eThS{box-shadow:0 4px 9px 0 #2222}
#eThS a{text-decoration:none;user-select:none}
#eThS label,#eThS button,#eThS .ho,#eThS>.N>ul{cursor:pointer}
#eThS b{font-family:SB,Arial}
#eThS .A,#eTpa:checked~ul.M [for=eTpa]{text-shadow:0 0 1px}
#eThS>ul{display:block;width:100%;padding:12px 32px;position:relative;background:#fff}
#eThS>ul *{display:inline-block}
#eThS>.T>li{color:#6e6e6e}
#eThPa:checked~.T>.hPa,#eThPr:checked~.T>.hPr{color:#222;text-shadow:0 0 1px #000}
#eThS>.T{background:#f2f2f2;padding:7px 32px 0;height:40px}
#eThS>.T>form{font-size:12px;padding:0 0 0 1.3%;width:240px;max-width:calc(60% - 328px)}
#eThS form>input{display:inline-block}
#eThS [name=q]{display:inline-block;width:100%;padding:4px 6px 4px 28px;border:1px solid #dedede;border-radius:4px;background:url(//static.s-sfr.fr/assets/pictos/rechercher_40_noir.svg) no-repeat #fff 5px;background-size:16px}
#eThS>ul>a{margin:0 12px 0 0;height:48px;width:48px;background:no-repeat;background-size:contain}
#eThS>ul li{font-size:16px;position:relative}
#eThS>ul li>a{padding:4px 16px 4px 0}
#eThS>ul li~li{border-left:1px solid #c8c8c8}
#eThS>ul li~li>a{padding:4px 16px}
#eThS>ul>span{position:absolute;top:9px;right:32px;max-height:50px}
#eThS>ul>span>li{font-size:12px;background:12px center no-repeat;background-size:24px}
#eThS>.T>span>li>*{position:relative;z-index:1;padding:5px 8px 5px 38px}
#eThS>.T>span>li:last-child>a{padding-right:0}
#eThS>.T>span>li>i{position:absolute;z-index:0;padding:0;width:24px;height:24px;left:12px}
#eThS>.M>li{border:0;font-size:16px;margin:8px 0 0}
#eThS>.M>li>a{padding:7px 12px}
#eThS>.M>div li li{border-color:#dedede}

#eThS>.M>span>li{border:0;background-position:50% 3px;background-size:32px}
#eThS>.M>span>li>*{text-align:center;padding:36px 12px 0}
#eThS .red{color:#d0021b;font-weight:700}
#eThS .hE{letter-spacing:-.5px}
#eThS>.E>.N,#eThS input,#eThS .hX,#eThS>label,#eThS .hB,#eThS [id^=eThM],#eThS [for^=eThM],#eThS>.E .C,#eThS>#eTpaT{display:none}
#eThS>ul div>ul>li{border:none}
#eThS>ul.T div{top:31px;left:-8px;padding:20px 0 0;width:168px}
#eThS>.T div li{padding:0;text-align:center;width:50%;font-size:12px;background:50% 0 no-repeat;background-size:40px}
#eThS>.T div li>a{padding:44px 0 8px}
#eThS>.T div img{height:40px}
#eThS>.M ul,#eThS>.M>div li li{display:block}
#eThS>.M>div li li>b{margin:0 0 12px}
#eThS>.M>div li li>a{padding:4px 12px}
#eThS>.M>div li li+li{font-size:14px}
#eThS>.M>div>ul+ul>li{margin:20px 12px 0 0;width:auto;font-size:12px;padding:4px 12px;border:1px solid #a0a0a0;border-radius:12px}
#eThS>.M>div>ul+ul a{padding:0}
#eThS>.M>div>ul+ul p:after{display:none}

.Media #eThS,.Media #eThS>.T ul>li,.Media #eThS>.T ul>li>a,.Media #eThS>.E>.B,.Media #eThS>.M>a,.Media #eThS .red>a,.Media #eThS>.T div img,.Media #eThS .A>p:after,.Media #eThS>label,
.Media #eThS :not(.G)>i,.Media #eThS [style*="-cc"],.Media #eThS [style*="-cc"] label,.Media #eThS label>b,.Media #eThS>.E>.CN,.Media #eThS>.E>.N{filter:invert(1)}
.Media #eThS>.M{background:#ededed}
.Media #eThS>.M>div{background:#eaeaea}

#eThS>.T div,#eThS>.M>div,#eThS>.E,#eTpaT{border-radius:0 0 12px 12px;box-shadow:0 8px 8px 4px #0001}

#eThS>.E,#eThS>.E>*{display:block;text-align:center}
#eThS>.E{position:absolute;width:396px;overflow:auto;z-index:2;right:0}
#eThS>.E>p{font-size:14px;margin:20px 0 0}
#eThS>.E>li{border:0;background:no-repeat calc(50% - 64px) 50%;background-size:16px}
#eThS>.E>li>a{position:relative;background:#efefef;width:332px;max-width:84vw;padding:16px;margin:6px 0;border-radius:4px}
#eThS>.E>li>a:after{content:'>';font:bold 16px/1.2 serif;position:absolute;right:18px;transform:scaleY(2)}
#eThS>.E>li.B>a:after,#eThS>.E>li.X>a:after{content:''}
#eThS>.E>li.B>a{font:14px/16px SB,Arial;padding:12px 24px;margin:16px 0;color:#fff;width:auto;border-radius:8px;background:#d90d25;box-shadow:0 4px 8px #9003;transition:box-shadow .3s}
#eThS>.E>li.B>a:hover{box-shadow:0 4px 8px #9005}
#eThS>.E>li.X>a{font:14px/16px SB,Arial;padding:12px 24px 12px 44px;margin:16px 0;background:#0000;color:#181818;border:1px solid #181818;width:auto;border-radius:8px;transition:box-shadow .3s}
#eThS>.E>li.X>a:hover{box-shadow:0 4px 8px #2226}
#eThS>.E>.CN{cursor:pointer;text-decoration:underline;font-size:12px;color:#e2001a;margin-top:12px;padding:4px 0}
#eThS>.E.C>.D,#eThS>.E.O>*{display:none}
#eThS>.E.C:not(.O)>.C,#eThS>.E.O>.N,#eThS>.E.O>.CN{display:block}
#eThS>.E.O>.CN{font-size:0;margin:8px 0}
#eThS>.E.O>.CN:after{content:'Retour';font-size:12px}
#eThS>.E>.N{background:#fcfcfc;margin:0 -12px -12px;border:0 solid #ccc;border-width:1px 0 0}
#eThS>.E>.N>div{display:block}

#eThE:checked~.E{transform:scaleY(1)}
#eThE:checked~.M .hX,#eTpa:checked~.M .hX{transform:scaleY(1);right:0;z-index:3;position:absolute}
/*#eThE:checked~.E{right:0;z-index:2}*/
#eThE:checked~label{display:block;cursor:default;position:fixed;z-index:-1;top:0;left:0;width:100vw;height:100vh;background:#0009;content:''}
/*#eThE:checked~.M .hX,#eTpa:checked~.M .hX{right:16px;z-index:3;position:absolute}*/
#eTpa:checked~#eTpaT{display:block;position:absolute;z-index:1;background:#eee;font:14px/1.2 SB,Arial;overflow:auto}

#eThS>.M .hE b{position:absolute;text-align:center;width:100%;padding:0;top:12px;left:0;color:#e2001a;font-size:12px}
#eThS>.M li>* i{position:absolute;text-align:center;padding:1px 5px;border-radius:8px;top:0;left:50%;margin-left:5px;background:#e2001a;color:#fff;font-size:12px}
#eThS>.M .NEW{padding:0 40px 0 0}
#eThS>.M .NEW:after{content:'New';position:absolute;top:4px;right:16px;font-size:10px;padding:2px 4px;color:#fff;background:#181818;border-radius:4px}


@media (min-width:768px){
body:before{height:112px}
#eThS a:hover,#eThS label:hover{text-shadow:0 0 1px}
#eThS .A>p:after{content:'';display:block;margin-top:4px;height:3px;background:#d90d25}
#eThS>.M>li>.A{padding-bottom:0}
#eThS li.ho:hover>a:before{position:absolute;content:'';height:28px;width:calc(100% + 120px);left:-60px;top:24px;z-index:1}
#eThS>.T div,#eThS>.M>div,#eThS>.E{background:#fff linear-gradient(#3331,#fff) no-repeat;background-size:100% 8px}
#eThS>.T div,#eThS>.M>div,#eThS>.E,#eThS .hX{transform:scaleY(0);transform-origin:top;transition:transform .1s .3s}
#eThS>.T div,#eThS>.M>div{visibility:hidden;position:absolute;z-index:3;top:72px;left:32px;max-width:calc(100% - 64px);padding:24px 8px 24px 48px}
#eThS #eThP,#eThS>.E,#eThS .hX{transition:transform .2s}
#eThS li.ho:hover{z-index:3}
#eThS li.ho:hover+div,#eThS>.T div:hover,#eThS>.M>div:hover,#eThP:checked+li+div{visibility:visible;transform:scaleY(1)}
#eThS ul.MM2>li{width:49%}
#eThS ul.MM3>li{width:33%}
#eThS ul.MM4>li{width:24%}
#eThS .hE{margin:0 -12px 0 -8px}
#eThS .PRO,#eThS .hd{display:none}
#eThS>.M>li.hf{border-color:transparent}
#eThS>.M .hX{background-size:24px;display:block;top:72px}
#eThS>.E,#eThS>.T div,#eThS>.M>div{max-height:calc(100vh - 112px);overflow-y:auto}
#eThS>.T .A{padding-bottom:0}
#eThS>.T .A>p:after{margin-top:2px}
/*#eThS>.E,#eThS .hX{right:-133vw;transition:right .4s}*/
#eTpaT{top:112px;right:12px;min-width:300px;min-height:50px;max-height:calc(100vh - 112px)}
#eTpaT>b{padding:9px 20px}

}
@media (min-width:1344px){
#eThS>ul:not(.E){padding-left:calc(50% - 640px)}
#eThE:checked~.E,#eThS>ul>span,#eThS>.N>div,#eTpaT{right:calc(50% - 640px)}
#eThS>.M>div{left:calc(50% - 640px)}

#eThS .hX{margin-right:32px}
}
@media (min-width:768px) and (max-width:959.9px){
#eThS>.T li>*{letter-spacing:calc(.5vw - 4.8px)}
#eThS>.M>span>li>*:not([for=eThX]){padding:36px calc(3vw - 17px) 0}
#eThS>.M>li>a{font-size:15px;padding:7px calc(3vw - 18px);letter-spacing:calc(.3vw - 3px)}
#eThS>.M>a{margin-right:calc(3vw - 18px)}

}
@media (max-width:767.9px){
body.hS,#eThS>.M{overflow:hidden}
body:before{height:64px}
#eThB:checked~.M{overflow:auto;min-height:100vh}
#eThS .hB,#eThX:not(:checked)~.M .hX{display:inline-block}
#eThPr:checked~.M .PAR,#eThPr:checked~.M .PAR+div+label,
#eThPa:checked~.M .PRO,#eThPa:checked~.M .PRO+div+label,
#eThB:checked~.M .hB,#eThS>.T div,#eThS>.T>span,#eThS>.M>div,#eThS #eThP,#eThS>.M>li{display:none}
#eThB:checked~ul [for^=eThM]{display:block;height:44px;margin-top:-44px;z-index:1;position:relative}
#eThS>.M>div{position:absolute;display:block;top:163px;left:0;z-index:9;background:#fff;width:100%;padding:0;transform:scaleX(0);transform-origin:right;height:calc(100vh - 163px);overflow:auto;transition:transform .4s}
#eThS>.M>div+label{opacity:0}
#eThS>.M>div+label:after{content:"Retour";display:block;font-size:16px;padding:12px 0 0 calc(5% + 28px)}
#eThS>.M>div>a{font:14px/1.2 SB,Arial;padding:16px;border-bottom:8px solid #eee;width:100%}
#eThB:checked~.M [id^=eThM]:checked+li+div{transform:none}
#eThB:checked~.M [id^=eThM]:checked+li+div+label{position:absolute;z-index:8;top:164px;left:0;width:100%;opacity:1;background:#f2f2f2 url(//static.s-sfr.fr/media/hs-back.svg) 5% 8px no-repeat}
#eThS>ul{padding:12px 16px}
#eThS>ul>a{height:40px;width:40px}
#eThS>ul [class^=MM]>li{padding:16px;display:block}
#eThS>.M div>a,#eThS [class^=MM]>li{border:0 solid #f2f2f2;border-width:0 0 8px}
#eThS>.M ul+ul{text-align:center;padding:6px 0 120px}
#eThS>.M ul+ul>li{margin:6px}
#eThS>.M>span{top:8px;right:4px}
#eThS>.M>span>li{font-size:10px}
#eThS>.M>span>li>*{padding:36px 0 0;min-width:48px}
#eThS>.T,#eThS>.T>*{top:0;position:absolute;background:#f2f2f2;padding:0}
#eThB:checked~.T>li{top:123px;left:16px;z-index:7;width:calc(50% - 16px);font-size:12px;border:0;border-radius:4px;padding:0;background:#fff;color:#222}
#eThB:checked~.T>label{top:123px;left:5%;z-index:8;width:45%;height:30px;background:transparent}
#eThPa:checked~.T>.hPa,#eThPr:checked~.T>.hPr{background:#222;color:#fff}
#eThB:checked~.T>li>a{text-align:center;padding:8px;width:100%}
#eThS>ul.T .hPr,#eThS>ul.T [for=eThPr]{left:50%}
#eThB:checked~.T>form{top:64px;left:0;z-index:6;width:100%;max-width:none;padding:16px 16px 64px;text-align:center}
#eThB:checked~.T>span{display:block;top:469px;right:0;z-index:9;width:100%;padding:0 0 8px;text-align:center;background:#fff}
#eThS>.T>span>li{padding:0 2% 0 1%;background-position-x:6px}
#eThS>.T>span>li>*{padding:5px 0 5px 28px}
#eThB:checked~.M{padding-bottom:38px;box-shadow:0 9px 9px #0001}
#eThB:checked~.M>a{margin-bottom:115px}
#eThB:checked~.M>li{display:block;border:0 solid #eee;border-width:1px 0 0;margin:0;padding:0}
#eThS>.M>li>a{display:block;padding:12px 28px 12px 12px}
#eThS>.M>li.ho>a:after{content:'>';font:bold 16px/1.2 none;position:absolute;right:8px;transform:scaleY(2)}
#eThS>.M>div li li>a{padding:7px 12px;width:100%}
#eThS>.T div li{width:72px}
#eThS>.T>span>div+li{border:0}
#eThS #eThP+li{display:block;background:#f2f2f2 no-repeat 40px 24px;background-size:24px;padding:16px;margin:0 0 12px}
#eThS #eThP+li>label{width:100%;padding:12px 0 12px 60px;border:1px solid #d7d7d7;border-radius:8px;transition:padding-bottom .3s}
#eThS #eThP+li>label:after{content:'>';font:bold 12px/1.2 none;position:absolute;right:40px;transform:rotate(90deg) scaleY(2);transition:transform .3s}
#eThS #eThP:checked+li>label:after{transform:rotate(-90deg) scaleY(2)}
#eThB:checked~.T #eThP:checked+li>label{padding-bottom:88px}
#eThB:checked~.T #eThP:checked+li+div{display:inline-block;position:absolute;z-index:1;left:50%;transform:translateX(-50%);top:56px;padding:0;box-shadow:none;width:300px;text-align:center}
#eThS>.E{display:none;position:absolute;width:100%;height:calc(100vh - 64px);overflow:auto;background:#f2f2f2;border-radius:0;padding-bottom:40px}
#eThS>.E>li>a{background:#fff}
#eThE:checked~.E{display:block}
#eThE:checked~.M .hX{top:0;right:52px}
#eThE:checked~.M .hE{background-size:0}
#eThS>.E>li>a:after{right:18px}
#eThS>#eTpaT{top:64px;height:calc(100vh - 64px);padding-bottom:60px;width:100%;max-width:none;border-radius:0}
#eTpa:checked~.M .hX{top:0;right:158px;position:absolute}
#eTpa:checked~.M .P{background-size:0}
#eThS>.E>.N{margin:0 auto;border-width:1px 1px 0}

}


@font-face{font-family:'SFR-Regular';src:url("//static.s-sfr.fr/assets/fonts/Poppins-Regular.woff2")}
@font-face{font-family:'SFR-Light';src:url("//static.s-sfr.fr/assets/fonts/Poppins-Light.woff2")format("woff2")}
@font-face{font-family:'SFR-Bold';src:url("//static.s-sfr.fr/assets/fonts/Poppins-Bold.woff2")format("woff2")}
@font-face{font-family:'SFR-Black';src:url("//static.s-sfr.fr/assets/fonts/Poppins-Black.woff2")format("woff2")}
a,article,audio,b,body,del,details,div,em,fieldset,figcaption,figure,footer,form,header,html,i,iframe,img,input,label,legend,li,menu,nav,ol,p,pre,section,small,span,strong,sub,sup,table,tbody,td,tfoot,th,thead,time,tr,ul,video{margin:0;padding:0;border:0;outline:0;font-size:100%;background:transparent;box-sizing:border-box;font-style:normal}
button {border: none;margin: 0;text-decoration: none;-webkit-appearance: none;-moz-appearance: none}
h1{display:block;font:normal 40px/60px SFR-Black;margin:0}
h2{display:block;font:normal 32px/48px SFR-Bold;margin:0}
h3{display:block;font:normal 24px/36px SFR-Bold;margin:0}
body{font-family:SFR-Regular, Arial;color:var(--clr-black);}
:root{
	--clr-sfr:#c00404;
	--clr-sfr2:#D90D25;
	--clr-black:#181818;
	--clr-bg:#F2F2F2;
	--clr-disable:#d2d2d2;
	--clr-grey:#8A8A8A;
	--clr-green:#02C39A;
	--clr-yellow:#ffcd00;
	--clr-error:#E2001A;
}

a[class^="btn"],input[class^="btn"]{display:block;position:relative;font-family:SFR-Bold;font-size:14px;line-height:16px;padding:12px 24px;text-align:center;width:100%;border-radius:8px;cursor:pointer;overflow:hidden;text-decoration:none;transition: box-shadow .2s cubic-bezier(.4,0,.2,1);user-select:none;-webkit-user-select:none}
a[class^="btn"]:hover,input[class^="btn"]:hover{box-shadow:0 4px 12px rgba(24,24,24,0.32)}
.btn{color:#fff;background:var(--clr-sfr2);box-shadow:0 4px 8px rgba(150,0,0,0.16)}
a.btn:hover,input.btn:hover{box-shadow:0 4px 8px rgba(150,0,0,0.32)}
a.btn2:hover,input.btn2:hover{box-shadow:0 4px 12px rgb(24 24 24 / 32%)}
.btn2{color:#fff;background:var(--clr-black);box-shadow:0 0 12px rgba(24,24,24,0.16)}
.btn3{color:var(--clr-black);background:#fff;box-shadow:0 0 12px rgba(24,24,24,0.16)}
.btn4{color:var(--clr-black);border:solid 1px var(--clr-black);box-shadow:0 0 12px rgba(24,24,24,0.16)}
.btn5{color:#fff;background:var(--clr-black);border:solid 1px #fff;box-shadow:0 0 12px rgba(24,24,24,0.16)}
.btn:active{box-shadow:inset 0 4px 8px rgba(0, 0, 0, 0.2)}
.btn2:active{background:#444;box-shadow:0px 4px 12px rgba(0, 0, 0, 0.16), inset 0px 4px 8px rgba(0, 0, 0, 0.32)}
.btn3:active{box-shadow:0 4px 8px rgba(0, 0, 0, 0.04), inset 0 2px 2px rgba(1, 1, 1, 0.1)}
.btn4:active{box-shadow:0 0 12px rgba(24,24,24,0.16)}
.btn5:active{box-shadow:0 0 16px rgba(255, 255, 255, 0.24)}
.btn:disabled,.btn2:disabled,.btn3:disabled{color:var(--clr-grey);background-color:var(--clr-disable);box-shadow:0 0 16px rgba(255,255,255,0.24);pointer-events: none;}
.btn4:disabled,.btn5:disabled{color:var(--clr-grey);border-color:var(--clr-grey)}
.btn[disabled],.btn2[disabled],.btn3[disabled]{color:var(--clr-grey);background-color:var(--clr-disable);box-shadow:0 0 16px rgba(255,255,255,0.24);pointer-events: none;}
.btn4[disabled],.btn5[disabled]{color:var(--clr-grey);border-color:var(--clr-grey)}
a[class^="btn"].loader,input[class^="btn"].loader{background:var(--clr-disable);box-shadow:unset;border:var(--clr-disable);cursor:default}
a[class^="btn"].loader:before,input[class^="btn"].loader:before{content:'';position:absolute;width:100%;height:100%;background:var(--clr-disable);left:0;top:0}
.loader:after{content:"";position:absolute;top:0;bottom:0;left:0;right:0;margin:auto;height:16px;width:16px;color:var(--clr-sfr2);display:inline-block;border:2px solid;border-radius:50%;border-top-color:transparent;animation:rotate 1s linear infinite}

a[class^="link"]{position:relative;font:normal 14px/18px SFR-Bold;padding:0 13px 0 0;cursor:pointer}
a[class^="link"]:after{content:'';position:absolute;width:8px;height:8px;right:1px;top:0;bottom:0;margin:auto;border-radius:2px;border:2px solid;border-left:0;border-bottom:0;transform:rotate(45deg);transition:all .2s cubic-bezier(.4,0,.2,1)}
a[class^="link"]:hover:after{right:-3px}
@keyframes rotate{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}

.link{color:var(--clr-sfr2)}
.link2{color:var(--clr-black)}
.link3{color:#fff}
.link.u{font-family:SFR-Bold;color:var(--clr-black);text-decoration:underline;padding:0}
.link.u:after{content:none}

.price {position:relative;display:grid;grid-template-areas:"b a" "b c";}
.price .L {font:normal 32px/30px SFR-Bold;grid-area: b;margin:0;}
.price .R{ text-align: left;font:normal 12px/12px SFR-Bold;}
.price .o {font-size: 12px;font-family: 'SFR-Regular';vertical-align: middle;display: inline-block;text-decoration: line-through;}
@media(max-width:1100px){
    h1{font-size:32px;line-height:48px}
    h2{font-size:24px;line-height:36px}
    h3{font-size:16px;line-height:24px}
	a[class^="btn"],input[class^="btn"]{font-size:12px}	
	a[class^="link"]{font-size:12px;line-height:16px}
	a[class^="link"]:after{top:unset;bottom: 2px;}
} 
main { display: flex; flex-direction: column; background: #f2f2f2; }
#Acc5 { order:1; }
h1 { order: 2; font-family: 'SFR-Bold'; font-size: 32px; line-height: 36px; margin: 40px auto 24px; max-width: 1280px; width: calc(100% - 64px); text-align: center;}
#Pilier { order:3; }
#Choose { order: 4; }
#Best { order:5; }
#Rea { order:6; }
#News { order:7; }
#eTav { order:8; }
#Seo { order:9; }
#Mentions { order:10; }
#Pilier { padding: 0; display: none; }
#TT { display: none; }
#eTsNL { order:9; }

#Acc5 { width: 100%; height: 460px; position: relative; overflow: hidden; }
#Acc5 .heroes { position: relative; height: 100%; }
#Acc5 .hero { position: relative; height: 100%; display:block; background-repeat: no-repeat; animation: fadein 1s ease-out; }
#Acc5 .hero:before { content: ''; height: 296px; position: absolute; bottom: 0; left: 0; right: 0; width: 100%; background: rgba(226, 0, 0, 0.8); background-image: linear-gradient(360deg, var(--clr-sfr) 70%, rgba(97, 91, 91, 0) 95%); box-shadow: 0px 0 30px 40px rgb(0 0 0 / 30%); }
#Acc5 .hero>.illu { object-fit: cover; display: flex; width: 100%; height: 100%; z-index: -1;}
#Acc5 .hero>.c { position: absolute; left: 40px; right: 40px; bottom: 0; margin: auto; max-width: 1280px; height: 296px; display: flex; justify-content: space-between; }
#Acc5 .hero>.c>div { display: inline-block; vertical-align: top; }
#Acc5 .hero>.c>.L { width: 290px; margin: -26px 40px 0 0; }
#Acc5 .hero>.c>.L strong { display: block; font-family: 'SFR-Bold'; font-size: 32px; line-height: 48px; color: #fff; margin: 0 0 16px 0; font-weight:100;}
#Acc5 .hero>.c>.L p { display: block; font-family: 'SFR-Regular'; font-size: 16px; line-height: 24px; color: #fff; }
#Acc5 .hero>.c>.M { width: 620px; }
#Acc5 .hero>.c>.R { width: 290px; margin: 0 0 118px 0; align-self: flex-end; }
#Acc5 .hero>.c>.R .sticker { background: var(--clr-yellow); font-family: 'SFR-Bold'; color: var(--clr-black); margin: -20px 0 0 0; font-size: 12px; padding: 0 8px; border-radius: 4px; display: table;}
#Acc5 .hero>.c>.R .sticker + .price { margin-top: 22px;  }
#Acc5 .hero>.c>.R .apd { font-size: 14px; line-height: 22px; font-family: 'SFR-Bold'; display: block; color: #fff;  }
#Acc5 .hero>.c>.R .apd + .price { margin: 0; }
#Acc5 .hero>.c>.R .apd + .info { margin: 0 0 8px 0; }
#Acc5 .hero>.c>.R:has(.sticker + .price) .sticker { margin: 4px 0 -15px 0; }
#Acc5 .hero>.c>.R .price { margin: 20px 0 0 0; justify-content: left; }
#Acc5 .hero>.c>.R .price .L { font-size: 60px; line-height: 48px; color: #fff; }
#Acc5 .hero>.c>.R .price .R { font-size: 16px; line-height: 24px; color: #fff;}
#Acc5 .hero>.c>.R .price + a { margin: 16px 0 0 0; }
#Acc5 .hero>.c>.R>.info { font-family: 'SFR-Bold'; color: #fff; font-size: 12px; line-height: 18px; margin: 8px 0;}
#Acc5 .hero>.c>.R>a { display: table; width: auto; position: static; }
#Acc5 .hero>.c>.R>a:after { content: ''; position: absolute; left: -640px; right: -640px; top: -164px; width: auto; height: 460px; }
#Acc5 .hero>.c>.B { display: block; position: absolute; width: 100%; bottom: 80px; height: 18px; }
#Acc5 .hero>.c>.B>span{ position: absolute; top: 0; right: 0; color: #fff; font-size: 12px; line-height: 18px; display: table;}
#Acc5 .hero>.c>.B>input { display: none; }
#Acc5 .hero>.c>.B>input + label .bubble{ display: none; }
#Acc5 .hero>.c>.B>input:checked + label .bubble { display: block; }
#Acc5 .hero>.c>.B label { position: relative; }
#Acc5 .hero>.c>.B label>span.das{ left: 0; cursor: pointer; color: #fff; font-size: 12px; line-height: 18px; display: table; position: relative; }
#Acc5 .hero>.c>.B label>span.das:after { content: ''; background-image: url(https://static.s-sfr.fr/assets/pictos/aide_plein_40_blanc.svg); width: 14px; height: 14px; display: block; background-size:contain; background-repeat:no-repeat; position: absolute; top: 1px; left: 28px; }
#Acc5 .hero>.c>.B label>span.das + .bubble {  cursor: auto; width: 150px; box-shadow: 0 2px 4px 0 rgb(0 0 0 / 10%); border-radius: 4px; color: #fff; font-family: 'SFR-Regular'; background-color: var(--clr-black); font-size: 10px; padding: 3px; position: absolute; z-index: 9; transition: opacity 0.3s; bottom: 25px; }
#Acc5 .hero>.c>.B label>span.das + .bubble:after {content: ""; position: absolute; bottom: -14px; left: 8px; margin-top: -5px; border-width: 7px; border-style: solid; border-color: var(--clr-black) transparent transparent transparent;}
#Acc5 .capsules { max-width: 1280px; width: calc(100% - 80px); margin: -70px auto 0 auto; position: relative; display: flex; justify-content: space-around; gap: 0 40px; }
#Acc5 .cap { display: inline-block; vertical-align: middle; width: 288px; padding: 0 8px 0 0; background: rgba(255, 255, 255, 0.2);max-width: calc(100% / 4 - 15px); width: 288px; font-family: 'SFR-Regular'; color: #fff; border-radius: 8px; font-size: 14px; line-height: 18px; cursor: pointer;  transition: background .3s ease-out; }
#Acc5 .cap>div { width: 52px; height: 52px; display: inline-block; vertical-align: middle; margin: 0 14px 0 0; }
#Acc5 .cap>div>.vign { height: 100%; }
#Acc5 .cap>span { display:inline-block; vertical-align: middle; width: calc(100% - 70px); }
#Acc5 .cap:hover { background: rgba(24, 24, 24, 0.2);}
#Acc5 .cap.s { background: rgba(24, 24, 24, 0.2); }
#Acc5 .cap:last-child { margin: 0; }
#Acc5 .hero[hidden] { background:none; background-image:none; display:none; }

.arrow {padding-right:12px;} 
.arrow:after {content: ''; position: absolute;width: 7px;height: 7px;background-color: transparent;border: 2px solid;right: 0;transform: rotate(45deg);top: 0;bottom: 0;margin: auto;border-left: 0;border-bottom: 0;transition: all .2s cubic-bezier(.4,0,.2,1);} 
.arrow:hover:after {right: -5px;}
a .arrow {position: relative; display: inline-block; vertical-align: middle; height: 8px; width: 8px; right: -8px;}
a .arrow:after {content: ''; position: absolute;width: 8px;height: 8px;background-color: transparent;border: 2px solid;right: 0;transform: rotate(45deg);top: 0;bottom: 0;margin: auto;border-left: 0;border-bottom: 0;} 
a:hover .arrow {right: -12px; transition: all .2s cubic-bezier(.4,0,.2,1);}

#Choose { background: #fff; box-shadow: 0px 8px 16px rgba(24, 24, 24, 0.02); border-radius: 12px; max-width: 1280px; margin: 0 auto; width: calc(100% - 64px); padding: 24px 24px 90px 24px; display: flex; gap: 22px; flex-wrap: wrap; position: relative; justify-content: space-evenly;  }
#Choose .c { text-align: center; width: 225px; }
#Choose .c>img{ height: 64px; margin: 0 0 16px 0; }
#Choose .c p{ font-family: 'SFR-Bold'; font-size: 14px; margin: 0 0 16px 0; }
#Choose .c a.link{ text-decoration: none; }
#Choose .btn4 { width: fit-content; margin: 0 auto; position: absolute; bottom: 24px; left: 0; right: 0; }

#Pilier {text-align: center; padding-bottom: 18px;}
#Pilier h1 {font-family: 'SFR-Bold'; font-size: 32px; line-height: 36px;margin: 32px auto 40px;}
#Pilier .z {display: inline-block; vertical-align: middle; width: 720px; text-align: left; margin-bottom: 25px;}
#Pilier .p {position: relative; display: inline-block; text-align: left; vertical-align: top; margin: 0 1% 0 0;}
#Pilier .p:last-child {border:none;}
#Pilier .p .si {display: inline-block; vertical-align: middle; margin: 0px 8px 0 0; }
#Pilier .p .si + div {display: inline-block; vertical-align: middle;}
#Pilier .p a {position: relative; display: inline-block; vertical-align: middle; font-family: 'SFR-Bold'; font-size: 14px; text-decoration: none; color: var(--clr-sfr2); line-height: 16px; margin-right: 15px;}
#Pilier .p a:before {content: ''; position: absolute; width: calc(100% + 92px); height: 70px; top: -50px; left: -63px;}
#Pilier .p a.m {display: none;}
#Pilier .p p {margin: 0 0 10px 0; line-height: 18px; width: 190px; font-family: 'SFR-Regular'; font-size: 14px; color: var(--clr-black);}
#Pilier .m {display: none;}
@keyframes ltr2 {0% {right:-12px;} 50% {right: -20px;} 95% {right: -9px;} 100% {right: -12px;}}
#Best {position: sticky; /* not my best idea */ padding: 40px 0 8px 0; text-align: center; background-color: var(--clr-bg);}
#Best h2 {font-family: 'SFR-Bold';color: var(--clr-black);font-size: 32px;line-height: 36px;text-transform: none;margin-top: 0;margin-bottom: 44px;}
#Best a {text-decoration: none; color: var(--clr-black);}
#Best .wrap {width: calc(100% - 64px);max-width: 1280px;margin: 40px auto 0 auto;display: grid;grid-template-columns: 1fr 1fr; gap: 40px}
#Best .card {position: relative;text-align: left; box-sizing: border-box; padding: 24px 24px 0 24px; height: 278px; background-color: #fff; border-radius: 12px; }
#Best .card .sticker {position: absolute; background-color: var(--clr-yellow); padding: 3px 8px 14px 8px; z-index: -1; top: -16px; left: 0; border-radius: 4px 4px 0 0; color: var(--clr-black); line-height: 10px; font-size: 12px; font-family: 'SFR-Bold'; }
#Best .card a:not(.ub) {display: block; font-family: 'SFR-Bold'; color: var(--clr-black); font-size: 16px; margin: 0 0 8px 0; position: relative; z-index: 2;}
#Best .card a:not(.ub):before {content: ""; bottom: 0; left: -32px; position: absolute; width: calc(100% + 32px * 2); height: 233px; top: -32px;}
#Best .card > p {font-family: 'SFR-Regular'; font-size: 14px;line-height:22px; margin: 0; margin-bottom: 10px; color: var(--clr-black); position: relative; z-index: 2;max-width:211px;}
#Best .card > p + .price {margin-top: 24px; justify-content: left;}
#Best .card .tadp {font-family: 'SFR-Bold';color: var(--clr-black);font-size: 10px;line-height: 14px;}
#Best .card .price {justify-content: left;}
#Best .card .price>.entier {display: inline-block; vertical-align: middle; font-size: 40px;line-height: 40px; font-family: 'SFR-Bold'; color: var(--clr-black);}
#Best .card .price>div {display: inline-block; vertical-align: middle;}
#Best .card .price>div>.cents{display: inline-block; vertical-align: middle; font-size: 16px; font-family: 'SFR-Bold';  color: var(--clr-black);}
#Best .card .price>div>.granu{display: inline-block; vertical-align: middle; font-size: 16px; font-family: 'SFR-Bold'; text-transform: lowercase; color: var(--clr-black);}
#Best .card .price + p {font-size: 12px; line-height: 18px; font-family: 'SFR-Regular'; font-weight:normal;margin: 0; color: var(--clr-black); z-index: 2; position: relative;}
#Best .card .illu {height: 200px; width: 300px; max-width: 300px; position: absolute; right: 50px; top: 35px; transition: 0.5s ease-out transform;}
#Best .card:hover .illu {transform: scale(1.1);}
.tooltip {cursor: pointer; position: absolute; bottom: 45px; right: 20px;z-index:2;}
#Best .card .tooltip .das {position: relative;font-family: 'SFR-Regular';font-size: 12px;line-height:12px; padding: 0 17px 0 0;}
#Best .card .tooltip .das:after {content: "";position: absolute; bottom: 1px; right: 0; width: 15px; height: 15px; background: url(//static.s-sfr.fr/assets/pictos/aide_plein_40_noir.svg); background-repeat: no-repeat; background-size: cover; }
#Best .card .tooltip .tooltiptext {cursor: auto; width: 130px; box-shadow: 0 2px 4px 0 rgb(0 0 0 / 10%); border-radius: 4px; color: #fff; font-family: 'SFR-Regular'; background-color: var(--clr-black); font-size: 10px; padding: 3px; position: absolute; z-index: 9; right: -20px; top: auto; bottom: 23px;  transition: opacity 0.3s;}
#Best .card .tooltip .tooltiptext::after {content: ""; position: absolute; bottom: -12px; left: 73%; margin-top: -5px; border-width: 7px; border-style: solid; border-color: var(--clr-black) transparent transparent transparent;}
@media(hover: none) {.tooltip .tooltiptext.hov {display:none;}}
@media(hover: hover) {.tooltip .tooltiptext.hov {display:none;} .tooltip:hover .tooltiptext.hov {display:block;}}
#Best .card .ub {position: absolute;display: table;bottom: 22px;left: 50%;transform: translateX(-50%);font-family: 'SFR-Bold';color: var(--clr-sfr2);z-index:3;font-size: 14px;line-height: 18px;text-align: center;width: max-content;width: -moz-max-content;}
#Best .card .ub:before {content: "";position: absolute;width: 510px;height: 32px;top: -10px;left: 50%;transform: translateX(-50%);}
.tooltip.das.s > div.tooltiptext {visibility: hidden;}
.tooltip.das.s > div.tooltiptext.hide {visibility: hidden;}
.tooltip.das.s > div.tooltiptext.show {visibility: visible; opacity: 1;}

#Rea {position: relative; background-color: var(--clr-bg); text-align: center; padding: 1px 0 0 0;}
#Rea .band {position:relative;width: 1280px;height:92px;max-width: calc(100% - 64px);background: #fff;border-radius: 8px;overflow:hidden;margin: 0 auto;z-index: 1;}
#Rea .band div {display:inline-block;float:left;}
#Rea .band .L {flex:0 0 200px;}
#Rea .band .R {display: flex; flex-direction: column; align-items: flex-start; justify-content: center; text-align: left; padding: 0 24px; }
#Rea .band p{font-size: 14px;line-height: 22px;}
#Rea .band p:first-child{font-size:16px;margin-bottom:8px;}
#Rea .band strong{font-family:'SFR-Bold';font-weight:100;}
#Rea .band img{display:inline-block;object-fit: contain;}
#Rea h2 {position:relative;display: block;text-align: center;text-transform: none;font-family: 'SFR-Bold';font-size: 32px;line-height: 36px;color: var(--clr-black);margin-top: 40px;margin-bottom: 44px;z-index:1;}
#Rea:before {position: absolute;width: 100%;max-width: 1530px;height: 100%;content: '';left: 0;right: 0;margin: auto;top: 0;z-index: 0;}
#Rea ul {display: grid;grid-template-columns: 1fr 1fr 1fr;gap: 0 16px;margin: 0 auto;padding: 24px 0 40px;max-width:1280px;width: calc(100% - 64px);}
#Rea li {background: linear-gradient(180deg, #FFFFFF 0%, #E4E4E4 100%);position:relative;height:400px;box-shadow: 0px 0px 24px 4px rgba(0, 0, 0, 0.04);border-radius: 12px;cursor:pointer;overflow:hidden}
#Rea .t .illu>img {object-fit: contain;}
#Rea .t {display:list-item;height:400px}
#Rea .b{content: "";position: absolute;width: 100%;height:100%;left: 0;top:calc(100% - 120px);transition:top 0.6s;background: #fff;font-family:'SFR-Bold';font-size: 28px;line-height: 32px;padding:32px 24px;z-index:1;}
#Rea .title{font-family:'SFR-Bold';font-size: 16px;line-height: 24px;margin:0 auto;max-width:280px;min-height:48px;padding:8px;}
#Rea .desc{font-family:'SFR-Regular';font-size: 14px;line-height: 18px;margin:32px 0 16px;text-align:left;}
#Rea a{position: relative;display:table;vertical-align: middle;font-family: 'SFR-Bold';font-size: 14px;line-height: 22px;text-decoration: none;text-align:left;color: var(--clr-sfr2);margin-top:10px;}
#Rea a+a{margin-top:0px;}
#Rea li:hover .b {top:0;height:100%;}
/*to clean*/
#Rea .c { display: flex; max-width: 1280px; margin: 0 auto; width: calc(100% - 64px); }
#Rea .c .band { display: inline-block; display: flex; vertical-align: top; width: calc(50% - 11px); min-height: 172px;  }
#Rea .band div { float:none; vertical-align: middle; }
#Rea .band:first-of-type { margin: 0 16px 0 0; }
#Rea .band.sc .L { flex: 0 0 200px; display: flex; justify-content: center; align-items: center; }
#Rea .band.sc b {font-size: 16px;line-height: 24px; font-family: 'SFR-Bold'; display: block; margin: 0 0 8px 0; }
#Rea .band.sc p>a { font-family: 'SFR-Bold'; text-decoration:underline; display:inline; color: var(--clr-black); font-size: 12px;}

@keyframes fadein {from {opacity: 0.5;} to {opacity: 1;}}

#News {position: relative; background-color: var(--clr-bg); text-align: center; padding: 1px 0 20px;}
#News h2 {font-family: 'SFR-Bold'; font-size: 32px; line-height: 36px; color: var(--clr-black); text-align: center; text-transform: unset; display: block; margin: 40px auto 44px;}
#News .card {display: inline-block; vertical-align: top; height: 320px; width: 30%; max-width: 408px; box-shadow: 0 0 24px 4px rgba(0, 0, 0, 0.06); border-radius: 8px; margin: 0 14px 25px 14px; box-sizing: border-box;}
#News .card a {text-decoration: none;}
#News .card .T {position: relative; height: 192px; width: 100%; background-size: cover; background-position: center center; border-radius: 8px 8px 0 0;} 
#News .card .T span {position: absolute; color: #fff; font-family: 'SFR-Bold'; background-color: var(--clr-black); font-size: 10px; border-radius: 4px; padding: 5px 8px; top: 12px; left: 12px;}
#News .card .T .illu {border-radius: 8px 8px 0 0;}
#News .card .T .illu>img {object-fit: cover;}
#News .card .B {height: calc(320px - 192px); width: 100%; padding: 16px 24px; text-align: left; box-sizing: border-box; white-space: normal; background-color:#fff; border-radius: 0 0 8px 8px;}
#News .card .B .date {font-family: 'SFR-Regular';font-size: 12px;line-height: 16px;color: #a0a0a0;display: block;margin-bottom: 8px;} 
#News .card .B .titre {font-family: 'SFR-Bold';font-size: 16px;line-height: 20px;color: var(--clr-black);margin-bottom: 8px;} 
#News .card .B p {font-family: 'SFR-Regular';font-size: 12px;line-height: 14px;color: var(--clr-black);margin: 8px 0 0;} 
/*#News>a {position:relative;display: table;margin: 12px auto 30px auto;text-decoration: none;color: var(--clr-black);font-family: 'SFR-Bold';font-size: 16px;line-height: 16px;}*/
#News>a {position:relative;display: table;margin: 12px auto 30px auto;text-decoration: none;color: var(--clr-black);font-family: 'SFR-Bold';font-size: 14px;padding: 9px 24px;border:1px solid var(--clr-black);border-radius:8px;transition: .3s all ease-out;}
#News>a:hover { box-shadow: 0 4px 12px rgb(24 24 24 / 32%);}
#News>a>.arrow { display:none; }
#News .carousel-preview {display: none;}
#News .amp-carousel-button {display: none}
#News #carousel-actu > div > div {scroll-snap-type: x mandatory;}
#News #actu-dots {display: none;}

#Seo {font-family:'SFR-Regular'; color: #222; font-size: 12px; line-height: 1.3; position: relative; max-width: 1280px; margin: 0 auto 30px auto;padding: 0 20px;}
#Seo h2 {font-family:'SFR-Bold'; color: #222; font-size: 16px; margin-top: 15px; display: block;}
#Seo a {text-decoration: none; color: #222;}
#Seo strong  {font-family:'SFR-Bold'; color: #222; font-size: 16px; margin-top: 15px; margin-bottom: 15px; display: block; font-weight:100;}
#Seo b {font-weight: bold;}
#Seo input[type="checkbox"] {display: none;}
#Seo input[type="checkbox"] + label {display:block; position:relative;}
#Seo input[type="checkbox"] + label .curt {width: 100%; height: 86px; position: absolute; bottom: 30px; background: linear-gradient(#ffffff2b, #fff); background: #fff; display:none;}
#Seo input[type="checkbox"]:checked + label .curt {width: 90%; background-color: transparent; height: 0; position: absolute; top: 0;}
#Seo input[type="checkbox"] + label p {height: 80px; overflow: hidden; color: var(--clr-grey);}
#Seo input[type="checkbox"]:checked + label p {height: auto; overflow: auto;}
#Seo .vm {display: table; margin: 20px auto 0 auto; cursor: pointer; position: relative; font-family: 'SFR-Bold';}
#Seo .vm:after {content: '';width: 8px;height: 8px;border: 2px solid;transform: rotate(45deg);right: -17px;top: 0;position: absolute;border-top: 0;border-left: 0;}
#Seo .vp {display: none; margin: 20px auto 0 auto; cursor: pointer; position: relative; font-family: 'SFR-Bold';}
#Seo .vp:after {content: '';width: 8px;height: 8px;border: 2px solid; transform: rotate(-135deg);right: -17px;top: 5px;position: absolute;border-top: 0;border-left: 0;}
#Seo input[type="checkbox"]:checked + label .vp {display: table;}
#Seo input[type="checkbox"]:checked + label .vm {display: none;}

#Mentions {margin-bottom: 25px; border-top: 1px solid #ebebeb; padding-top: 25px;} 
#Mentions .t {font-family: 'SFR-Bold'; font-size: 12px; margin: 0 auto; display: table; position: relative; cursor: pointer;}
#Mentions .t:after {position: absolute;border-top: 0;border-left: 0;content: '';width: 8px;height: 8px;border: 2px solid;transform: rotate(45deg);right: -17px;top: 0;border-top: 0;border-left: 0;}
#Mentions .t.s:after {transform: rotate(-135deg);top: 5px;}
#Mentions .cont {max-width: 1280px; margin: 25px auto; display: block; font-family: 'SFR-Regular'; font-size: 12px; color: #222; line-height: 1.3; padding: 0 20px;}
#Mentions .show {display: block;}
#Mentions .hide {display: none;}
#Mentions strong  {font-family:'SFR-Bold'; color: #222; font-size: 16px; margin-top: 15px; margin-bottom: 15px; display: block; font-weight:100;} 
#Mentions b { font-family: 'SFR-Bold';}
#Mentions a {text-decoration:none; color: var(--clr-grey);}

body #eTav>ul>li {color: #595959;}

@media all and (max-width: 1100px) {
    h1 { background: #fff; padding: 24px 16px; margin: 0; width: auto; font-size: 24px; }
    #Pilier { display: block; background: #fff; }
    #TT { display: flex; order: 7; margin: 18px auto 24px auto; }
    #Choose { flex-direction: column; order: 7; gap: 40px; width: calc(100% - 100px); }
    #Choose .c { max-width: none; width: auto; }
    #Choose .c>img { height: 60px; margin: 0 0 8px 0; }
    #Choose .c p { margin: 0 0 8px 0; }
    
    #Acc5 { height: 560px; }
    #Acc5 .hero:before { height: 448px; }
    #Acc5 .hero>.c { display: block; height: 448px; left: 16px; right: 16px; display: flex; justify-content: space-around; gap: unset; }
    #Acc5 .hero>.c>.L { width: 100%; display: block; text-align: center; margin: -26px 0 0 0; position: absolute; }
    #Acc5 .hero>.c>.L strong { margin: 0 0 0 0; }
    #Acc5 .hero>.c>.M { max-width: none; width: auto; text-align: right; text-align: center;  }
    #Acc5 .hero>.c>.R { max-width: none; width: auto; margin: 0 0 178px 0; }
    #Acc5 .hero>.c>.R>a:after { height: 612px; }
    #Acc5 .hero>.c>.B { bottom: 146px; }
    #Acc5 .capsules { width: 100%; max-width: 1100px; margin: -136px auto 0 auto; flex-wrap: wrap; flex-direction: row; gap: 16px; justify-content: space-evenly; padding: 0 16px 16px 16px;}
    #Acc5 .cap { max-width: none; width: calc(50% - 8px); height: 52px; font-size: 12px; line-height: 18px; padding: 0; }
    #Acc5 .cap>div { margin: 0 8px 0 0; }
    #Acc5 .cap>span { width: calc(100% - 70px); }
    
    #Pilier h1 {font-size: 24px;}
    #Pilier .p {text-align: center; display: block; border-bottom: 1px solid #d8d8d8; padding: 16px 0; border-right: none; margin: 0 32px;}
    #Pilier .p svg.si {display: none;}
    #Pilier .p div>p {display: none;}
    #Pilier .p .si + div {margin-left: 32px;}
    #Pilier .p .m {position: relative;display: block;text-align: left; margin-right: 2px}
    #Pilier .p .m svg {display:inline-block;vertical-align: middle;}
    #Pilier .p .m a{margin-right:0;width: calc(100% - 40px);color: var(--clr-black);}
    #Pilier .p:last-child { color: var(--clr-sfr2); }
    #Pilier .p:last-child .m svg{ filter: invert(13%) sepia(79%) saturate(6072%) hue-rotate(348deg) brightness(86%) contrast(98%); }
    #Pilier .p:last-child .m a{ color: var(--clr-sfr2);}
    #Pilier .p>div:not(.m) {display: none;}
    #Pilier .p a:before {content: '';position: absolute;width: calc(100% + 24px);height: calc(100% + 32px);top: -16px;left: -30px;}
    
    #Best {padding-left: 18px; padding-right: 18px;}
    #Best h2 {font-size: 24px; line-height: 24px; padding: 0 20px;}
    #Best .card {height: 262px; padding: 12px;box-sizing: border-box;}
    #Best .card .ub:before {width: 327px;}
    #Best .card a:not(.ub) {font-size: 16px; margin-bottom: 0; position: relative; z-index: 2;}
    #Best .card a:not(.ub):before {content: ""; bottom: 0; left: -12px;max-width: calc(100% + 12px * 2);height: 185px; top: -12px;}
    #Best .card >p {font-size: 14px;line-height: 22px;margin-bottom: 5px; z-index: 2; position: relative;}
    #Best .card .tadp {font-size: 9px; line-height: 14px; margin-bottom: -2px; display: table;}
    #Best .card .price>.entier {font-size: 30px;}
    #Best .card .price>div {height: 35px;} 
    #Best .card .price>div>.cents {font-size: 16px;}
    #Best .card .price>div>.granu {font-size: 10px;}
    #Best .card .price p {font-size: 10px;line-height: 14px;margin-top: -3px;}
    #Best .card .illu-r {position: absolute;}
    #Best .card .tooltip {bottom: 38px; right: 10px;}
    #Best .card .tooltip .hov.tooltiptext {display:none;}
    #Best .card .tooltip .tooltiptext {right: -10px;}
    #Best .card .tooltip .tooltiptext:after {left: 83%;}
    #Best .carou {position: absolute; bottom: 35px; right: 6px; z-index: 5;}
    #Best .carou .amp-carousel-button {display: none;}
    #Best .carou-but{position: absolute; right: 55px; bottom: 28px;}
    #Best .carou-but>button {background-color: var(--clr-disable); border: 0; width: 4px; padding: 3px; height: 4px; border-radius: 20px; margin:0 4px;}
    #Best .carou-but>button[option][selected] {background-color: #222; border:0; outline:0;}
    
    #Rea .band {height:114px}
    #Rea .band .L {width: auto; position: relative; }
    #Rea .band .R{max-width:calc(100% - 178px);}
    #Rea h2 {font-size: 24px; line-height: 24px; margin-bottom: 55px; padding: 0 20px;}
    #Rea ul {grid-template-columns:1fr;gap:16px 0}
    #Rea:before {background-position: left top, calc(100% + 72px) bottom;}
    #Rea .carousel-preview {top: 90px; box-sizing: border-box; width: 320px; min-width: 370px; left:0; right: 0; margin: auto; padding: 8px 16px;}
    #Rea .carousel-preview button {box-sizing: border-box; width: 108px; font-size: 10px; line-height: 12px; padding: 7px; margin: 0; box-shadow: 0 0 4px rgba(0, 0, 0, 0.06);}
    #Rea .r {height: 328px;}
    #Rea .r .tongue {padding: 16px 16px 16px 30px; bottom: 15px;}
    #Rea .r .tongue strong {font-size: 14px; line-height: 14px;}
    #Rea .r .tongue p {font-size: 12px; line-height: 14px;}
    #Rea .r .tongue a {font-size: 12px; line-height: 14px; margin: 0 auto 5px auto;}
    #Rea .r .oj1 {top: 0; width: 291px; height: 457px; background-position: unset; background-size: contain; position: absolute; background-repeat: no-repeat;}
    #Rea .r .oj2 {top: 0; left: 0; background-size: contain; background-repeat: no-repeat; background-position: unset;}
    #Rea .r .tongue .illu {display: block; margin: 5px auto 0 auto;}
    #Rea .r .tongue .illu + p {display: block; text-align: center; margin-top:-8px;}
    #Rea .carousel-preview button>h3 {font-size: 10px;}
    #Rea .r.s1 .B {margin: 5px 0;}
    #Rea .r.s1 .illu {display: inline-block; vertical-align: middle;}
    #Rea .r.s1 .illu + div{display: inline-block; vertical-align: middle; margin-top: 8px; padding-left: 8px;}
    #Rea .r.s1 .illu + div a{margin: 8px 0 0 0; text-align: left;}
    /*to clean*/
    #Rea .c { display: block; } 
    #Rea .c .band { display: flex; max-width: 100%; width: 100%; min-height: 90px; height: 114px; margin: 0 0 16px; } 
    #Rea .c .band .L { flex: 0 0 130px; } 
    #Rea .c .band .R { padding: 0 24px; }
    #Rea .band.sc .L { padding: 0; }
    #Rea .band .R { max-width: none; width: auto; margin: 0 0 0 0; padding: 12px 0; }
    #Rea a{margin-top:0;}
    #Rea .band p{margin-bottom:5px;}
    
    #News {position: relative;}
    #News h2 {font-size: 24px; line-height: 28px; color: var(--clr-black); margin: 24px auto;}
    #News .card {width: 285px; height: 292px;}
    #News .card:nth-child(1) {margin-left: 250px;}
    #News .card .T {height: 162px;}
    #News .card .T span {}
    #News .card .B {height: calc(292px - 162px); box-sizing: border-box;}
    #News .card .B .titre {font-size: 14px;line-height: 18px;}
    #News a {margin: 0 auto 25px auto;}
    #News #carousel-actu {padding-left: 20px; margin-bottom: 0;}
    #News .carousel-preview {display: block; margin: -50px auto 20px auto; position: absolute; left:0; right:0;}
    #News .carousel-preview>button {background-color: var(--clr-disable); border: 0; width: 4px; padding: 3px; height: 4px; border-radius: 20px; margin:0 4px;}
    #News .carousel-preview>button.setBlack {background-color: #222;}
    #News #actu-dots {display: block; margin-bottom: 20px;}
    #News #actu-dots>button {background-color: var(--clr-disable); border: 0; width: 4px; padding: 3px; height: 4px; border-radius: 20px; margin:0 4px;}
    #News #actu-dots>button[option][selected] {background-color: #222; border:0; outline:0;}
    #Seo {padding: 0 18px;}
}
@media all and (max-width: 768px) {
    .arrow:after {width:6px;height:6px;}
    #Acc5 .hero>.c{ gap: 16px; }
    #Acc5 .hero>.c>.L { margin: -18px 0 0 0; }
    #Acc5 .hero>.c>.L strong { font-size: 24px; line-height: 36px;  margin: 0;}
    #Acc5 .hero>.c>.L p { font-size: 14px; line-height: 22px; }
    
    #Pilier {padding-bottom: 8px;}
    #Pilier .p {margin:0 16px;}
    #Pilier h1 {font-size: 20px;margin:24px auto 8px;}
    
    #Choose { width:calc(100% - 40px); }
    
    #Rea:before {background-position: left 128px, right bottom;}
    #Rea .band {max-width: calc(100% - 32px);height:auto}
    #Rea .band .L {width: 100%; }
    #Rea .band .R{display:block;text-align:center;padding:0 0 16px;max-width:100%;}
    #Rea .band p {text-align:left;}
    #Rea .band div{width:100%;}
    #Rea .band img{object-fit: cover;}
    #Rea h2 {font-size: 20px; max-width: 280px; margin: 24px auto;}
    #Rea ul {width:calc(100% - 32px);padding:16px 0 22px;}
    #Rea li {height:304px;}
    #Rea .t {height: calc(100% - 104px);}
    #Rea .b {top: calc(100% - 104px);}
    #Rea .title {font-size: 16px;line-height: 20px;max-width: 195px;min-height:40px;padding: 0;}
    /*to clean*/
    #Rea .c { width: calc(100% - 34px); }
    #Rea .c .band { flex-direction: column; height: auto; }
    #Rea .c .band .L { flex: 0 0 154px; }
    #Rea .c .band .R { padding: 16px; }
    #Rea .c .band.sc .p { padding: 0; }
    #Rea .band.sc .L{ flex: 0 0 100px; }

    #Best .card .ub, #Rea a, #Rea .desc {font-size: 12px;line-height: 16px;}
    #Best .wrap {grid-template-columns: 1fr;margin-bottom:24px; width:100%;}
    #Best .card .tooltip {right: 16px;}
    #Best .card .tooltip .das {font-size: 10px;line-height: 10px;}
    #Best .card .price, #Best .card >p {max-width: 172px;}
    #Best .card {padding: 16px 16px 8px;}
    #Best {padding-top: 20px;}
    #Best h2 {font-size: 20px; line-height: 20px;}
    
    #News h2 {font-size: 20px;}
}
