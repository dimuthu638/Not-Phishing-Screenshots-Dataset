#eTfS,#eTfS *{color:inherit;margin:0;padding:0;box-sizing:border-box;line-height:1.2}
#eTfS{background:#222;position:relative;z-index:60000;width:100%;text-align:center}
#eTfS:before{clear:both;content:" ";display:block}
#eTfS>div{color:#fff;margin:0 auto;padding:16px 32px;text-align:justify;line-height:0;position:relative;max-width:1344px}
#eTfS>div>*{display:inline-block;vertical-align:top;padding:0}
#eTfS>div>p{width:99%;font-size:0}
#eTfS>div>div>p{font:13px/1.2 SR,Arial;padding:6px 0}
#eTfS>div>div>p>a{padding:6px 0}
#eTfS>div>div>p>b{width:2px;background:#777;display:inline-block;height:13px;margin:-2px 6px}

#eTfS .SOC,#eTfS .BAS{width:100%;text-align:center;padding:16px 0 0}
#eTfS .SOC>a{display:inline-block;height:44px;width:44px;background-size:contain}
#eTfS .SOC>a+a{margin-left:9%}
#eTfS .BAS{text-align:justify}
#eTfS .BAS a{font:12px/1.2 SR,Arial;display:inline-block;vertical-align:top}
#eTfS .BAS a+a{padding:6px}
#eTfS .BAS a:first-child{height:24px;width:24px;background-size:contain}
#eTfS .BAS>b{display:inline-block;width:99%}
#eTfS h3{position:relative;font:16px/1.2 SB,Arial;padding:15px 0 9px}
#eTfS a{text-decoration:none;cursor:pointer}
#eTfS input,#eTfS label{display:none}

@media (min-width:1280px){
#eTfS .SOC{position:absolute;width:28%;right:5.8%;bottom:30px;text-align:right}
#eTfS .BAS{width:70%;max-width:992px}}

@media (min-width:768px) and (max-width:991.99px){
#eTfS .SOC,#eTfS .BAS{padding:12px 0 0}
#eTfS>div>div>p{font-size:11px;letter-spacing:calc(.4vw - 4px)}}

@media (min-width:1px) and (max-width:767.99px){
#eTfS>div{padding:0 16px 9px}
#eTfS>div>div{width:100%;padding:0 0 9px;border-bottom:1px solid #444;max-height:48px;overflow:hidden;transition:max-height .3s}
#eTfS h3>label{position:absolute;top:0;display:block;cursor:pointer;width:100%;height:100%}
#eTfS h3 i{width:15px;height:15px;border:0 solid #e13;border-width:0 3px 3px 0;position:absolute;top:12px;right:3px;transform:rotate(45deg);transition:transform .3s}
#eTfS input:checked+div h3>[for=T0]{z-index:1}
#eTfS input:checked+div{max-height:300px}
#eTfS input:checked+div i{transform:rotate(225deg);top:20px}
#eTfS .SOC,#eTfS .BAS{border:none;max-height:none;text-align:center}
#eTfS .BAS a:first-child{display:none}}

#IFS{height:2px;width:2px;position:fixed;top:99vh;left:0;z-index:99999}

</style>

