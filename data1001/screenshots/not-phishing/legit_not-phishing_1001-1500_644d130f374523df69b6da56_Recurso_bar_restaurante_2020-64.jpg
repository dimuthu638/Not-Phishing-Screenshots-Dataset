5"><h2 class="titulo-creadores mx-auto align-self-center"> Internacional</h2></div> </a></div></div></div></li><li class="nav-item dropdown px-xl-3 px-lg-1 mx-0"> <a href="/sobre-sgae/" class="py-0 menu-sobre-sgae nav-link dropdown-toggle " role="button" aria-haspopup="true" aria-expanded="false"> Sobre SGAE </a><div class="dropdown-menu py-5" aria-labelledby="navbarDropdown"><div class="container mx-auto"><div class="col"><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5;"><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/quienes-somos/"> Quiénes somos </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/normativa-y-estatutos/"> Normativa y Estatutos </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/organizacion/"> Organización y gobierno </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/consejos-territoriales/"> Consejos Territoriales </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/somos-transparentes/"> Somos transparentes </a></li></ul></div><div class="col mb-auto mt-4 pt-2"><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5;"><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/fundacion-sgae/"> Fundación SGAE </a></li></ul><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5;"><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/instituto-autor/"> Instituto Autor </a></li></ul><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5;"><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/centro-documentacion-archivo/"> Archivo (CEDOA) </a></li></ul></div><div class="col pt-4"> <a href="/sobre-sgae/"><div class="col-12 text-white menu-imagen-sobre d-flex p-5"><h2 class="titulo-creadores mx-auto align-self-center"> Sobre SGAE</h2></div> </a></div></div></div></li><li class="nav-item dropdown px-xl-3 px-lg-1 mx-0"> <a href="/actualidad/" class="py-0 menu-actualidad nav-link dropdown-toggle " role="button" aria-haspopup="true" aria-expanded="false"> Actualidad </a><div class="dropdown-menu py-5" aria-labelledby="navbarDropdown"><div class="container mx-auto"><div class="col"><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5"><li class="nav-item"> <a class="nav-link" href="/actualidad/noticias/"> Noticias </a></li><li class="nav-item"> <a class="nav-link" href="/actualidad/agenda-cultural/"> Agenda cultural </a></li><li class="nav-item"> <a class="nav-link" href="/actualidad/revista-sgae/"> Revista SGAE </a></li></ul></div><div class="col"><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5"></ul></div><div class="col pt-4"> <a href="/actualidad/"><div class="col-12 text-white menu-imagen-actualidad d-flex p-5"><h2 class="titulo-creadores mx-auto align-self-center"> Actualidad</h2></div> </a></div></div></div></li><li class="nav-item px-xl-3 px-lg-1 mx-0 text-center"> <a href="/sedes-y-contacto/" class="py-0 menu-sedes-contacto nav-link fw-normal "> Sedes y contacto </a></li><li class="nav-item ps-xl-4 ps-lg-1 mx-0 text-center"> <a href="/ayuda/" class="py-0 menu-ayuda nav-link fw-normal "> Ayuda </a></li></ul></div><div class="mx-auto menu-segunda-linea-mobile"><ul class="navbar-nav text-left justify-content-end"><li class="nav-item pt-4 pb-2 display-inline"> <a class="pr-4" href="/autores-editores/"> Autores y Editores</a> <a class="mas-desplegable nav-link dropdown-toggle mx-auto d-block" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="icono-menu bi bi-arrow-right-square"></i> </a><div class="dropdown-menu" aria-labelledby="navbarDropdown"><ul class="nav flex-column text-left"><li class="nav-item"> <a class="nav-link" href="/autores-editores/alta-online/"> Alta online </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/notifica-tus-conciertos/"> Notifica tus conciertos </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/cuando-percibes-tus-derechos/"> Cuándo percibes tus derechos </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/servicios-socios/"> Servicios a Socios </a></li><li class="nav-item"> <a class="nav-link" href="Área Social y Asistencial"> Área Social y Asistencial </a></li></ul></div></li><li class="nav-item py-2 display-inline"> <a class="pr-4" href="/clientes-usuarios/">Clientes y Usuarios</a> <a class="mas-desplegable nav-link dropdown-toggle mx-auto d-block" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="icono-menu bi bi-arrow-right-square"></i> </a><div class="dropdown-menu" aria-labelledby="navbarDropdown"><ul class="nav flex-column text-left"><li class="nav-item"> <a class="nav-link" href="/clientes-usuarios/#licencias"> ¿Qué licencia necesitas? </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/centro-documentacion-archivo//#alquiler"> Alquiler de materiales de orquesta </a></li><li class="nav-item"> <a class="nav-link" href="/clientes-usuarios/ventajas/"> Ventajas para tu negocio </a></li></ul></div></li><li class="nav-item py-2 display-inline"> <a class="pr-4" href="/internacional/">Internacional</a> <a class="mas-desplegable nav-link dropdown-toggle mx-auto d-block" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="icono-menu bi bi-arrow-right-square"></i> </a><div class="dropdown-menu" aria-labelledby="navbarDropdown"><ul class="nav flex-column text-left"><li class="nav-item"> <a class="nav-link" href="/internacional/gestion-internacional/"> Nuestra gestión </a></li><li class="nav-item"> <a class="nav-link" href="/internacional/estructura-internacional-sgae/"> Nuestra estructura internacional </a></li><li class="nav-item"> <a class="nav-link" href="/internacional/convenios-internacionales/"> Convenios internacionales </a></li><li class="nav-item"> <a class="nav-link" href="/internacional/organismos-y-foros-internacionales/"> Organismos y foros internacionales </a></li></ul></div></li><li class="nav-item py-2 display-inline"> <a class="pr-4" href="/sobre-sgae/">Sobre SGAE</a> <a class="mas-desplegable nav-link dropdown-toggle mx-auto d-block" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="icono-menu bi bi-arrow-right-square"></i> </a><div class="dropdown-menu" aria-labelledby="navbarDropdown"><ul class="nav flex-column text-left"><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/quienes-somos/"> Quiénes somos </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/normativa-y-estatutos/"> Normativa y Estatutos </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/organizacion/"> Organización y gobierno </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/consejos-territoriales/"> Consejos Territoriales </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/somos-transparentes/"> Somos transparentes </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/fundacion-sgae/"> Fundación SGAE </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/instituto-autor/"> Instituto Autor </a></li><li class="nav-item"> <a class="nav-link" href="/sobre-sgae/centro-documentacion-archivo/"> Archivo (CEDOA) </a></li></ul></div></li><li class="nav-item py-2 display-inline"> <a class="pr-4" href="/actualidad/">Actualidad</a> <a class="mas-desplegable nav-link dropdown-toggle mx-auto d-block" role="button" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false"> <i class="icono-menu bi bi-arrow-right-square"></i> </a><div class="dropdown-menu" aria-labelledby="navbarDropdown"><ul class="nav flex-column text-left"><li class="nav-item"> <a class="nav-link" href="/actualidad/noticias/"> Noticias </a></li><li class="nav-item"> <a class="nav-link" href="/actualidad/agenda-cultural/"> Agenda cultural </a></li><li class="nav-item"> <a class="nav-link" href="/actualidad/revista-sgae/"> Revista SGAE </a></li></ul></div></li><li class="nav-item py-2"> <a class="nav-link fw-normal py-0" href="/sedes-y-contacto/"> Sedes y contacto </a></li><li class="nav-item py-2"> <a class="nav-link fw-normal py-0" href="/ayuda/"> Ayuda </a></li></ul></div></div></div></nav></div><ul class="slideshow" style="list-style: none;"><li> <span class="img-bg-slide">Image 01</span></li><li> <span class="img-bg-slide">Image 02</span></li><li> <span class="img-bg-slide">Image 03</span></li><li> <span class="img-bg-slide">Image 04</span></li></ul><div class="container"><div class="p-xl-5 p-lg-0 amamos"><div class=""><h1 class="mb-md-5 mb-2"> <img class="" src="https://www.sgae.es/wp-content/themes/sgae/images/redesing-sgae/amamos-la-cultura-logo.svg"></h1></div></div><div class="row justify-content-center botones-header-home-sgae"><div class="col-md col-sm-9 p-xl-4 p-3"><div class="row necesitas"><div class="col-6"><p class="mb-0"> ¿Necesitas registrar una obra de tu autoría?</p></div><div class="col-3"><div class="boton-header"> <a href="/autores-editores/" class=""> Autores y Editores </a></div></div></div></div><div class="col-md col-sm-9 p-xl-4 p-3"><div class="row quieres"><div class="col-6"><p class="mb-0"> ¿Quieres hacer uso del<br>repertorio de SGAE?</p></div><div class="col-3"><div class="boton-header"> <a href="/clientes-usuarios/" class=""> Clientes </a></div></div></div></div></div></div></header><section id="por-que" class="pb-5 pt-md-0 pt-5"><div class="container py-lg-5"><div class="row pb-lg-5"><div class="col-12 text-center justify-content-center mb-0 mb-sm-5"><p class="mb-3" style="color: var(--main-color);"></p><h2 class="mb-3"> ¿Por qué SGAE?</h2><p class="col-sm-10 col-md-10 col-lg-7 mx-auto mb-5"> Porque queremos que vivas de tu obra creativa. Te apoyamos en el desarrollo de tu trayectoria autoral con formación y promoción de tus obras, tenemos acuerdos con las entidades de gestión de derechos de autor más relevantes del mundo y recibirás un trato próximo y personalizado. Además, ofrecemos asistencia jurídica gratuita y ayudas sociales a nuestras socias y socios, y mucho más.</p></div></div><div class="row text-center px-xl-4 px-0 mb-5 justify-content-center"><div class="col-md-4 col-sm-10 col-12 my-md-0 my-4"><div class="porque-column py-xl-3 py-sm-3 py-5 px-md-0 px-3"> <img class="mb-4" src="https://www.sgae.es/wp-content/uploads/2023/01/icono-quienes-somos@2x-1.png"><h3 class="mb-4"> ¿Quiénes somos?</h3><p class="mx-xl-4 mx-0 mb-xl-5 mb-4"> Como entidad sin ánimo de lucro, en SGAE nos dedicamos a la defensa y gestión colectiva de los derechos de propiedad intelectual en artes escénicas, audiovisuales y música. Contamos con más de 120.000 socias y socios (autores, editores musicales y herederos). Representamos a más de 4 millones de derechohabientes, con un repertorio superior a 80 millones de obras en 180 países.</p> <a href="/sobre-sgae/quienes-somos/"> Saber más </a></div></div><div class="col-md-4 col-sm-10 col-12 my-md-0 my-4"><div class="porque-column py-xl-3 py-sm-3 py-5 px-md-0 px-3"> <img class="mb-4" src="https://www.sgae.es/wp-content/uploads/2023/01/icono-percib-tus-derechos@2x-1.png"><h3 class="mb-4"> Percibe tus derechos</h3><p class="mx-xl-4 mx-0 mb-xl-5 mb-4"> Registra tus obras y te abonaremos los pagos de tus derechos de autor. Recibirás información detallada y te ingresaremos puntualmente los beneficios que genere tu trabajo. Nuestra misión principal es que vivas de tu obra creativa y percibas lo que te corresponde por el uso que se hace de ella. Puedes consultar el calendario de reparto de derechos de autor en un solo click.</p> <a href="/autores-editores/cuando-percibes-tus-derechos/"> Saber más </a></div></div><div class="col-md-4 col-sm-10 col-12 my-md-0 my-4"><div class="porque-column py-xl-3 py-sm-3 py-5 px-md-0 px-3"> <img class="mb-4" src="https://www.sgae.es/wp-content/uploads/2023/01/icono-asociate-home@2x-1.png"><h3 class="mb-4"> Por qué asociarte</h3><p class="mx-xl-4 mx-0 mb-xl-5 mb-4"> Tenemos experiencia en la gestión colectiva de los derechos de autor, lo hacemos desde la cercanía y la proximidad a través de nuestras sedes en España, Argentina, Cuba y Brasil. Impulsamos un programa de servicios y ventajas para nuestros miembros promoviendo su desarrollo profesional y favoreciendo su bienestar a través de las líneas de ayudas sociales.</p> <a href="/autores-editores/area-social-asistencial/"> Saber más </a></div></div><div class="col-11 my-5"><h2 class="mb-3 mt-5"> C&oacute;mo hacerte socio/a (alta online)</h2><p class="col-sm-10 col-md-10 col-lg-7 mx-auto mb-5"> Te explicamos los pasos para darte de alta en la entidad</p><div class="embed-responsive embed-responsive-16by9"> <iframe class="embed-responsive-item" src="https://www.youtube.com/embed/Std8nhwlYOQ" allowfullscreen></iframe></div></div></div></div></section><section id="news" class="bg-white py-5"><div class="container py-lg-5"><div class="row"><div class="col-12 text-center justify-content-center mb-0 mb-sm-5"><h2 class="mb-3">Noticias</h2></div></div><div class="row px-xl-4 px-0 mb-5"><div class="col-lg-3 col-md-6 my-3"><div class="noticia"><p style="color: var(--main-color);" class="categoria-noticia">Música</P> <a href="https://www.sgae.es/noticia/sgae-reivindica-con-una-exposicion-el-rock-espanol-de-los-ultimos-50-anos/"><div class="contenedor-imagen-noticias"> <img class="w-100" src="https://www.sgae.es/wp-content/uploads/2023/04/IMAGEN-WEB-1349-x-679-px-1024x515.jpg" alt="SGAE organiza una muestra sobre rock"></div> </a><p class="mt-4" style="color: var(--main-color);"> 24 de abril de 2023<span> | </span></p><h3> <a href="https://www.sgae.es/noticia/sgae-reivindica-con-una-exposicion-el-rock-espanol-de-los-ultimos-50-anos/" style="color: #000;"> SGAE organiza una muestra sobre rock </a></h3><p class="noticia-text"> Con 100 objetos de Barón Rojo, Héroes del Silencio y Leño, entre otros grupos</p></div></div><div class="col-lg-3 col-md-6 my-3"><div class="noticia"><p style="color: var(--main-color);" class="categoria-noticia">Actualidad</P> <a href="https://www.sgae.es/noticia/nuevo-numero-de-cultura-revista-sgae/"><div class="contenedor-imagen-noticias"> <img class="w-100" src="https://www.sgae.es/wp-content/uploads/2023/04/revista_def-1024x515.jpg" alt="Nuevo número de Cultura Revista SGAE"></div> </a><p class="mt-4" style="color: var(--main-color);"> 28 de abril de 2023<span> | </span></p><h3> <a href="https://www.sgae.es/noticia/nuevo-numero-de-cultura-revista-sgae/" style="color: #000;"> Nuevo número de Cultura Revista SGAE </a></h3><p class="noticia-text"> Reportaje central dedicado a la música urbana canaria</p></div></div><div class="col-lg-3 col-md-6 my-3"><div class="noticia"><p style="color: var(--main-color);" class="categoria-noticia">Actualidad, Danza</P> <a href="https://www.sgae.es/noticia/29-de-abril-dia-mundial-de-la-danza/"><div class="contenedor-imagen-noticias"> <img class="w-100" src="https://www.sgae.es/wp-content/uploads/2023/04/web-danza-1024x515.jpg" alt="29 de abril: Día Mundial de la Danza"></div> </a><p class="mt-4" style="color: var(--main-color);"> 28 de abril de 2023<span> | </span></p><h3> <a href="https://www.sgae.es/noticia/29-de-abril-dia-mundial-de-la-danza/" style="color: #000;"> 29 de abril: Día Mundial de la Danza </a></h3><p class="noticia-text"> SGAE reivindica una mayor internacionalización de la disciplina</p></div></div><div class="col-lg-3 col-md-6 my-3"><div class="noticia"><p style="color: var(--main-color);" class="categoria-noticia">Actualidad</P> <a href="https://www.sgae.es/noticia/fallo-de-la-x-edicion-del-premio-antonio-delgado/"><div class="contenedor-imagen-noticias"> <img class="w-100" src="https://www.sgae.es/wp-content/uploads/2023/04/Prueba_1-1024x515.jpg" alt="Fallo del X Premio Antonio Delgado"></div> </a><p class="mt-4" style="color: var(--main-color);"> 26 de abril de 2023<span> | </span></p><h3> <a href="https://www.sgae.es/noticia/fallo-de-la-x-edicion-del-premio-antonio-delgado/" style="color: #000;"> Fallo del X Premio Antonio Delgado </a></h3><p class="noticia-text"> El Instituto Autor reconoce a Adriana Moscoso y a Mercedes Morán</p></div></div><div class="col-12 text-center mt-4"> <a href="/noticias" class="btn-news btn-t-rojo mt-2"> Más noticias SGAE </a></div></div></div></section><section id="agenda" class="py-5"><div class="container py-lg-5 text-center"><div class="row"><div class="col-12 text-center justify-content-center mb-0 mb-sm-5"><h2 class="mb-3">Agenda cultural SGAE</h2></div><div class="col-md col-12 px-3 my-3 mx-auto"><div class="bg-white p-sm-5 p-3 h-100"><p class="text-right"> <span class="agenda-day d-block">4</span> <span class="agenda-mes pr-1">MAY</span></p><div class="text-left"><p class="agenda-tipo text-start" style="color: var(--main-color);">Música</p><h3 class=" pe-4 text-start"> <a href="https://www.sgae.es/agenda-cultural/visita-nuestra-exposicion-tiempos-de-rock/" style="color: #000;"> Exposición ‘¡Tiempos de rock!’, muestra con entrada libre </a></h3><h4 class=" pe-4 text-start">Madrid</h4><p class=" pe-4 mt-4 text-start"> Del 4 de mayo al 4 de junio (de L a D, de 16 a 21 h.- c/ Pelayo,  61- Madrid).</p></div></div></div><div class="col-md col-12 px-3 my-3 mx-auto"><div class="bg-white p-sm-5 p-3 h-100"><p class="text-right"> <span class="agenda-day d-block">27</span> <span class="agenda-mes pr-1">ABR</span></p><div class="text-left"><p class="agenda-tipo text-start" style="color: var(--main-color);">Artes escénicas, Presentación</p><h3 class=" pe-4 text-start"> <a href="https://www.sgae.es/agenda-cultural/els-joglars-presentan-que-salga-aristofanes/" style="color: #000;"> Els Joglars presenta '¡Que salga Aristófanes!' en Barcelona </a></h3><h4 class=" pe-4 text-start">Cataluña</h4><p class=" pe-4 mt-4 text-start"> La compañía celebra su 60 aniversario con un nuevo espectáculo</p></div></div></div><div class="col-md col-12 px-3 my-3 mx-auto"><div class="bg-white p-sm-5 p-3 h-100"><p class="text-right"> <span class="agenda-day d-block">21</span> <span class="agenda-mes pr-1">ABR</span></p><div class="text-left"><p class="agenda-tipo text-start" style="color: var(--main-color);">Derechos de autor</p><h3 class=" pe-4 text-start"> <a href="https://www.sgae.es/agenda-cultural/jornada-informativa-sobre-el-estatuto-del-artista/" style="color: #000;"> Jornada informativa sobre el Estatuto del Artista </a></h3><h4 class=" pe-4 text-start">Madrid</h4><p class=" pe-4 mt-4 text-start"> Presencial o streaming - Con expertos en la reforma legislativa</p></div></div></div><div class="col-12 mt-5 text-center"> <a href="/actualidad/agenda-cultural/" class="btn-agenda btn-t-rojo mt-2"> Ir a la agenda cultural </a></div></div></div></section><section id="revista" class="py-5"><div class="container py-lg-5"><div class="row text-center"><div class="col-12"><p class="mb-3" style="color: var(--main-color);"></p><h2 class="mb-3"> Cultura Revista SGAE</h2><p class="col-md-5 col-12 mx-auto"> Publicación digital de tendencias musicales, audiovisuales y escénicas</p><div class="col-12 bg-white mt-5 p-sm-5 p-4 text-left"> <a href="https://revistacultura.sgae.es/cultura_revista_sgae_07/inicio" target="_blank"> <img src="https://www.sgae.es/wp-content/uploads/2023/04/revista_def.jpg" alt="Número 08" /> </a></div></div><div class="col-12 mt-5 text-center"> <a href="/actualidad/revista-sgae/" class="btn-revista btn-t-rojo mt-2"> Más revistas SGAE </a></div></div></div></section><section id="porque-sgae" class="py-5"><div class="container py-xl-5"><div class="row justify-content-center"><div class="col-lg-6 col-md-5"> <img src="https://www.sgae.es/wp-content/uploads/2023/02/porque-cast@2x.png" alt="¿Por qué SGAE?"></div><div class="col-lg-6 col-md-7 pl-xl-5 pt-xl-4 pt-lg-0 pt-md-0 pt-4"><h2 class="mb-4"> La industria audiovisual bebe de  los laboratorios de la Fundación SGAE</h2><p class="text-white porque-sgae-texto"> Las obras que surgen de ellos son una de las principales referencias para los foros. <br><br> Más de una docena de guiones ya se han estrenado, con gran acogida de público y crítica. <br><br> En una década se han organizado 23 laboratorios:  nueve para cine, ocho para series de televisión y dos para telefilme. <br><br> 136 guionistas, con un 42% de mujeres, han desarrollado sus proyectos. <br><br> Hasta la fecha, la entidad ha invertido 1,4 millones de euros en la financiación de esta iniciativa. <br><br> <a class="text-white" href="/por-que-sgae"> Ir a Por qué SGAE </a></p></div></div></div></section><section id="sabias-que" class="py-md-5 py-5"><div class="container"><div class="row"><div class="col-md col-12 px-0 align-self-center order-md-first order-last"><div class="p-xl-4 p-3 col-10"><h2> Resumen del informe de gestión 2021</h2><p> Hemos aumentado nuestros ingresos sociales y hemos distribuido una mayor remuneración por derechos. Además, hemos apostado aún más fuerte por la igualdad, la inclusión y la diversidad.</p> <a style="color: var(--main-color);" href="https://informe-gestion2021.sgae.es/" target="_blank"> Ir al informe → </a></div></div><div class="col-md col-12 px-0 order-md-last order-first py-md-0 py-5"> <a href="https://informe-gestion2021.sgae.es/" target="_blank"> <img src="https://www.sgae.es/wp-content/uploads/2022/06/portada-resumen.jpeg" alt="Resumen del informe de gestión 2021"> </a></div></div><div class="row"><div class="col-md col-12 px-0 py-md-0 py-5"> <img src="https://www.sgae.es/wp-content/uploads/2022/06/sabias-que-img-def.jpg" alt="¿Sabías que...?"></div><div class="col-md col-12 px-0 align-self-center"><div class="p-xl-5 p-3 col-10"><h2>¿Sabías que...?</h2><p>Los socios y las socias de SGAE pueden hacer uso de los espacios e instalaciones en las sedes de SGAE</p> <a style="color: var(--main-color);" href="/autores-editores/espacios-y-prestaciones-para-los-socios/"> Infórmate → </a></div></div></div><div class="row"><div class="col-md col-12 px-0 align-self-center order-md-first order-last"><div class="p-xl-4 p-3 col-10"><h2>Gestionamos tus derechos en plataformas digitales</h2><p>Trabajamos con BackOffice Music Services para maximizar el flujo de derechos de autor procedentes de las plataformas musicales en el mercado digital paneuropeo</p> <a style="color: var(--main-color);" href="https://www.sgae.es/noticia/la-sgae-tendra-un-mayor-control-del-mercado-digital-paneuropeo-gracias-a-la-plataforma-tecnologica-backoffice/"> Saber más → </a></div></div><div class="col-md col-12 px-0 order-md-last order-first py-md-0 py-5"> <img src="https://www.sgae.es/wp-content/uploads/2022/06/armonia-img-def.jpg" alt="Gestionamos tus derechos en plataformas digitales"></div></div></div></section><section id="pregunta" class="py-5" style="background: rgb(255,81,47);background: linear-gradient(75deg, rgba(161,22,51,1) 0%, rgba(255,81,47,1) 100%);"><div class="container py-lg-5"><div class="row text-center"><div class="col-12" style="color:#FFF;"><p> TENEMOS CASI TODAS LAS RESPUESTAS</p><h2> Pregunta sin miedo</h2></div><div class="col-12 text-center mt-4"> <a href="https://www.sgae.es/cqs/" class="btn btn-rojo-deg  mt-2"> Ayuda </a></div></div></div></section><footer class="pt-4 pb-lg-5 pb-3"><div class="container-fluid"><div class="row"><div class="col-md-2 col-sm-3 col-4 pl-xl-5 pl-3 pt-2 logo-footer"> <img src="/wp-content/uploads/2022/06/logo-footer-def-2.png"></div><div class="col-md-10 col-sm-9 text-right pr-xl-5 pr-sm-3  pt-4 rrss"> <a class="px-sm-2 px-1" href="https://www.facebook.com/SGAEActualidad" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/facebook.png"></a> <a class="px-sm-2 px-1" href="https://twitter.com/sgaeactualidad" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/tweeter-rojo.png"></a> <a class="px-sm-2 px-1" href="https://www.youtube.com/user/CreadoresTV" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/youtube.png"></a> <a class="px-sm-2 px-1" href="https://www.instagram.com/sgae.es/" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/instagram-rojo.png"></a> <a class="px-sm-2 px-1" href="https://www.flickr.com/photos/sgae" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/flickr.png"></a> <a class="px-sm-2 px-1" href="https://t.me/SGAEActualidad" target="_blank"><img src="https://www.sgae.es/wp-content/themes/sgae/images/telegram.png"></a></div></div><div class="row py-4"><div class="offset-xl-1 col-xl-2 offset-lg-0 col-lg-3 col-md-3 col-sm-6 pl-xl-5 pl-3 pt-4 pb-xl-5 pb-md-3"><p class="text-white" style="border-bottom: 1px solid #fff9;">SGAE online</p> <a href="https://sede.sgae.es/auth/login" class="btn boton-menu-footer text-white my-2" target="_blank" >Portal socios</a> <a href="https://clientesenlinea.sgae.es/Clientes/" class="btn boton-menu-footer text-white my-3" target="_blank" >Portal clientes</a></div><div class="col-xl-2 col-lg-3 col-md-3 col-sm-6 pl-lg-5 pl-3 pt-4 pb-xl-5 pb-md-3"><p class="text-white" style="border-bottom: 1px solid #fff9;">Acceso directo</p> <a href="/sedes-y-contacto/" class="text-white my-lg-2 my-1 d-block" >Sedes y contacto</a> <a href="/sedes-y-contacto/" class="text-white my-lg-3 my-2 d-block" >Trabaja con nosotros</a> <a href="https://enlinea.sgae.es/RepertorioOnline/" class="text-white my-lg-3 my-2 d-block" target="_blank" >Repertorio online</a> <a href="/ayuda/" class="text-white my-lg-3 my-2 d-block" >Ayuda</a></div></div></div><div class="buttom-footer"><div class="container-fluid text-white mt-4"><div class="float-left buttom-footer-text pl-xl-5 pl-3">© Sociedad General de Autores y Editores - Todos los derechos reservados. Desarrollado por <a style="color:#fff;" href="http://www.theoms.es/" target="_blank"><b>The OMS</b></a></div><div class="float-right buttom-footer-text pr-xl-5 pr-3"> <a class="px-2 text-white" href="https://www.sgae.es/politica-de-cookies/"> Política de cookies </a> <a class="px-2 text-white" href="https://www.sgae.es/politica-de-privacida