 position: relative;"><nav class="navbar navbar-light navbar-expand-lg mr-0 m-xl-auto bg-white" style="font-weight:700;"><div class="container-fluid p-0" style="position: relative"> <a class="navbar-brand pl-4 pt-4" href="/"><img src="https://www.sgae.es/wp-content/themes/sgae/images/logo-rojo-sgae.png" /></a> <a href="#" class="button-nav--toggle mr-4" data-toggle="collapse" data-target="#navbarNavAltMarkup" aria-controls="navbarNavAltMarkup" aria-expanded="false" aria-label="Toggle navigation"> <span></span> <span></span> <span></span> </a><div class="ml-auto collapse navbar-collapse" id="navbarNavAltMarkup"><div class="p-lg-0 p-0 me-5 menu-top"><ul class="navbar-nav justify-content-end mb-2 mb-lg-0 menu-botones mr-xl-5 mr-0"> <a class="navbar-brand d-lg-none mx-auto" href="#"> <img src="https://www.sgae.es/wp-content/themes/sgae/images/logo-negro-sgae.png" /> </a><li class="nav-item px-0 mx-auto mx-lg-0 px-lg-2 py-2 py-lg-0"> <img class="icono-menu-sup" src="https://www.sgae.es/wp-content/themes/sgae/images/redesing-sgae/icono-repertorio-online.svg"> <a href="https://enlinea.sgae.es/RepertorioOnline/" class="menu-sup-enlace" target="_blank"> Repertorio online </a></li><li class="nav-item px-0 mx-auto mx-lg-0 px-lg-2 py-2 py-lg-0"> <img class="icono-menu-sup" src="https://www.sgae.es/wp-content/themes/sgae/images/redesing-sgae/icono-portal-socios.svg"> <a href="https://sede.sgae.es/auth/login" class="menu-sup-enlace" target="_blank"> Portal socios </a></li><li class="nav-item px-0 mx-auto mx-lg-0 px-lg-2 py-2 py-lg-0"> <img class="icono-menu-sup" src="https://www.sgae.es/wp-content/themes/sgae/images/redesing-sgae/icono-portal-clientes.svg"> <a href="https://clientesenlinea.sgae.es/Clientes/" class="menu-sup-enlace" target="_blank"> Portal clientes </a></li> <!--<li class="nav-item dropdown lang px-lg-4 px-0 py-lg-0 py-3 mx-sm-auto mx-auto"></li>--><li><div class="box"><div class="container-2"> <span class="icon"><i class="fa fa-search"></i></span><form id="searchform" role="search" class="top-search-form searchform" action="/" method="get"> <input type="search" name="s" id="search" placeholder="Escribe y pulsa 'Enter'..." autocomplete="off"></form></div></div></li></ul></div><div class="p-lg-0 p-0 menu-segunda-linea"><ul class="navbar-nav mb-2 mb-lg-0 mt-4 mr-xl-5 mr-0 justify-content-end"><li class="nav-item dropdown px-xl-3 px-lg-1 mx-0"> <a href="/autores-editores/" class="py-0 menu-autores-editores nav-link dropdown-toggle " role="button" aria-haspopup="true" aria-expanded="false"> Autores y Editores </a><div class="dropdown-menu py-5" aria-labelledby="navbarDropdown"><div class="container mx-auto"><div class="col"><ul class="nav flex-column" style="border-right: 1px solid #e5e5e5"><li class="nav-item"> <a class="nav-link" href="/autores-editores/alta-online/"> Alta online </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/notifica-tus-conciertos/"> Notifica tus conciertos </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/cuando-percibes-tus-derechos/"> Cuándo percibes tus derechos </a></li><li class="nav-item"> <a class="nav-link" href="/autores-editores/servicios-socios/"> Servicios a Socios </a></li></ul></div><div class="col mb-auto mt-4 pt-2"><ul class="nav flex-column align-items-stretch" style="border-right: 1px solid #e5e5e5"><li class="nav-item"> <a class="nav-link" href="/autores-editores/area-social-asistencial/"> Área Social y Asistencial </a></li></ul></div><div class="col pt-4"> <a href="/autores-editores/"><div class="col-12 text-white menu-imagen d-flex p-5"><h2 class="titulo-creadores mx-auto align-self-center"> Autores y Editores</h2></div> </a></div></div></div></li><li class="nav-item dropdown px-xl-3 px-lg-1 mx-0"> <a href="/clientes-usuarios/" class="py-0 menu-clientes-usuarios nav-link dropdown-toggle " role="button" aria-haspopup="true" aria-expanded="false"> Clientes y Usuarios </a><div class="dropdown-menu py-5" aria-labelledby="navbarDropdown"><