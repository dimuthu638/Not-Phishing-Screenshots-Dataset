sion":"2021-09-24"},"net":153.38,"gross":182.52,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"Nach Geldeingang 1-3 Tage","deliveryTime":{"type":"day-range","data":[1,3],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":10,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"PCS4528122","ean":"4007754239119","isbn":null,"manufacturer":"MONACOR","mpn":"TXS-900HSE","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":null,"tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fc1\u002Fa0\u002F687fcbd8ae753e491382cdf57facd93cee9ff56e94d5087f7ee36d8d8383a0c1-medium","height":900,"width":1200,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fc1\u002Fa0\u002F687fcbd8ae753e491382cdf57facd93cee9ff56e94d5087f7ee36d8d8383a0c1-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fc1\u002Fa0\u002F687fcbd8ae753e491382cdf57facd93cee9ff56e94d5087f7ee36d8d8383a0c1-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["MONACOR"]},"suggestions":["MONACOR","Funk-Sender","Stage","Line","TXS-900HSE"]},"meta":{"yategoLegacy":{"productId":"644c8ef5bf96d","shopId":"643e61e316e396.4","stockId":"644c8ef628ef1","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":842,"deleted":false,"deleteDate":null,"createDate":"2023-04-29T12:16:10+02:00","lastModified":null},{"id":"929987","score":17.796581,"title":"Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar","textContent":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E Diese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E Dank des Zylinder Designs aus schwarz mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E Die Deckenleuchte ist jedoch nicht nur optisch attraktiv, sondern überzeugt auch durch ihre vielfältigen Einsatzmöglichkeiten.\u003Cbr\u003E\u003Cbr\u003E Die moderne, aufbauende Bauweise der 2 flammigen Leuchte eignet sich besonders, wenn man eine optische Abhebung im Raum wünscht. Durch die schwenkbaren Fassungen in der Leuchte, kann man die Lichtkegel optimal einstellen. Somit setzt diese Spotleuchte Kunststücke, Bildwerke oder antike und wertvolle Vasen gekonnt in Szene. Darüber hinaus können mehrere dieser Deckenlampe für Vitrinen-, Flur-, Galerie- oder Kochinselbeleuchtung im Einsatz gebracht werden.\u003Cbr\u003E\u003Cbr\u003E Ob als stylishe Deckenlampe in großzügigen Fluren und Dielen, als zeitgemäßer Strahler über Ihrem Esstisch in Küche oder Esszimmer, als Eyecatcher in Ihrem Wohnzimmer oder auch als Highlights in öffentlichen Bereichen, wie z.B. Büro, Geschäften oder Praxen. Auch als coole Deckenlampe für das Jugendzimmer ist diese COOKIE Leuchte die richtige Wahl.\u003Cbr\u003E\u003Cbr\u003E Ganz gleich, welche Art von Lichtspots Sie für Ihre Zwecke benötigen, ob Sie auf der Suche nach Wohnzimmerlampen, Flurleuchten, Küchendeckenlampen, Schlafzimmerlampen, Büroleuchten oder sonstigen Wohnraumleuchten sind, dieser universell einsetzbarer Deckenstrahler wird all Ihren Ansprüchen gewiss gerecht!\u003Cbr\u003E\u003Cbr\u003E * Geeignet für 2 x GU10 Leuchtmittel bis max. 35 Watt (nicht enthalten)\u003C\u002Fp\u003E Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar Schwenkbare Spotleuchte COOKIE mit zwei schwenkbaren GU10 Spots, schwarz mattModernes Design aus schwarz mattem MetallLichtspots ... zeitgemaesse ueberzeugt vielfaeltigen Einsatzmoeglichkeiten.\u003Cbr\u003E\u003Cbr\u003E aufbaünde wuenscht. Kunststuecke, Darueber koennen fuer grosszuegigen zeitgemaesser ueber Kueche oeffentlichen Buero, Geschaeften fuer fuer benoetigen, Kuechendeckenlampen, Bueroleuchten Anspruechen fuer fuer ueber 5e15214744761 612900232","description":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E\nDiese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E\nDank des Zylinder Designs aus schwarz mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E\nDie Deckenleuchte ist jedoch nicht nur optisch attraktiv, sondern überzeugt auch durch ihre vielfältigen Einsatzmöglichkeiten.\u003Cbr\u003E\u003Cbr\u003E\nDie moderne, aufbauende Bauweise der 2 flammigen Leuchte eignet sich besonders, wenn man eine optische Abhebung im Raum wünscht. Durch die schwenkbaren Fassungen in der Leuchte, kann man die Lichtkegel optimal einstellen. Somit setzt diese Spotleuchte Kunststücke, Bildwerke oder antike und wertvolle Vasen gekonnt in Szene. Darüber hinaus können mehrere dieser Deckenlampe für Vitrinen-, Flur-, Galerie- oder Kochinselbeleuchtung im Einsatz gebracht werden.\u003Cbr\u003E\u003Cbr\u003E\nOb als stylishe Deckenlampe in großzügigen Fluren und Dielen, als zeitgemäßer Strahler über Ihrem Esstisch in Küche oder Esszimmer, als Eyecatcher in Ihrem Wohnzimmer oder auch als Highlights in öffentlichen Bereichen, wie z.B. Büro, Geschäften oder Praxen. Auch als coole Deckenlampe für das Jugendzimmer ist diese COOKIE Leuchte die richtige Wahl.\u003Cbr\u003E\u003Cbr\u003E\nGanz gleich, welche Art von Lichtspots Sie für Ihre Zwecke benötigen, ob Sie auf der Suche nach Wohnzimmerlampen, Flurleuchten, Küchendeckenlampen, Schlafzimmerlampen, Büroleuchten oder sonstigen Wohnraumleuchten sind, dieser universell einsetzbarer Deckenstrahler wird all Ihren Ansprüchen gewiss gerecht!\u003Cbr\u003E\u003Cbr\u003E\n* Geeignet für 2 x GU10 Leuchtmittel bis max. 35 Watt (nicht enthalten)\u003C\u002Fp\u003E","shortDescription":"Schwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten Diese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas! Dank...","legalAdvice":null,"price":{"rrp":{"savingGross":22.85,"savingPercent":35,"net":53.77,"gross":63.99,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":34.57,"gross":41.14,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":0,"deliveryString":"Lieferzeit 1 - 3 Werktage","deliveryTime":{"type":"work-day-range","data":[1,3],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":48,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"612900232","ean":"4017807426533","isbn":null,"manufacturer":"Trio Leuchten","mpn":"612900232","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"220000\u002F221701\u002F221709","tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F16\u002Fcd\u002F48f306ffe09aa3ac9d55dc84436033ecceb67a2a3d2f48db83bdff71044dcd16-medium","height":1044,"width":1392,"ratio":1.