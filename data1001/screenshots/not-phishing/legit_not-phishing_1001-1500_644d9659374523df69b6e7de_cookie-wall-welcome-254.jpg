all":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0a\u002F45\u002Fba49241f4b0e0e6b79f880565c5975b9e52874e3009328220347be7e3de1450a-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0a\u002F45\u002Fba49241f4b0e0e6b79f880565c5975b9e52874e3009328220347be7e3de1450a-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Nyx Professional Make Up"]},"suggestions":["BUTTER","GLOSS","#fortune","cookie"]},"meta":{"yategoLegacy":{"productId":"6408aaa61d80f","shopId":"62fb42006ca6d0.1","stockId":"6408aaa6ac5e7","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":655,"deleted":false,"deleteDate":null,"createDate":"2023-03-08T17:23:41+01:00","lastModified":null},{"id":"318825","score":19.731726,"title":"Monin Cookie Choco Sirup 0.7 L","textContent":"\u003Cp\u003EMonin Cookie Choco Sirup\u003Cbr\u003E\u003Cbr\u003E Cookie Chocos ist ein feines Gebäck welches ursprünglich aus den USA kommt. Es handelt sich dabei um einen Keks mit Schokoladenstückchen der auf mittlerweile auf der ganzen Welt beliebt ist. Monin Cookie Choco Sirup verbindet diesen köstlichen, nach frisch gebackenem, duftenden Gebäck und Schokolade.\u003Cbr\u003E\u003Cbr\u003E Farbe: Braun mit karamellfarbenen Reflexen. Im Aroma und Geschmack nach dunklem Schokoladenkeks mit Butter.\u003Cbr\u003E\u003Cbr\u003E Geeignet für: Verfeinert Kaffee, für die Küche, für Desserts, Kuchen und vieles mehr. Chocolate chip cookies sind eine ur-amerikansiche Schöpfung. Mrs. Ruth Wakefield aus dem Toll House Inn in Whitman, Massachusetts soll sie 1933 erfunden haben. 1997 wurde der Chocolate chip cookie der \"official cookie of the State of Massachusetts\". Heute findet man ihn in der ganzen Welt.\u003Cbr\u003E\u003Cbr\u003E Empfehlung: Cookie Alexander: 1cl Dark Chocolate Sauce, 1cl Monin Chocolate Chip Cookie Sirup, 3cl Brandy, 6-8cl Vanilleeis, 4cl Milch. Zur Garnierung dunkle Schokoladensauce, Muskat. Alle abgemessenen Zutaten in einen shaker geben und sehr kräftig und lange genug schütteln. In ein gekühltes, mit etwas dunkler Schokoladensauce ausgeschwenktes Glas abseihen und mit Schokosauce und geriebenem Muskat garnieren.\u003Cbr\u003E\u003Cbr\u003E Zutaten: Zucker, Wasser, Aroma, Farbstoff: Zuckerkulör.\u003Cbr\u003E\u003Cbr\u003E Nährwertangaben (Per 100ml):\u003Cbr\u003E Kcal 334\u003Cbr\u003E Kj 1397\u003Cbr\u003E Eiweiß in g 0\u003Cbr\u003E Kohlenhydrate in g 83,5\u003Cbr\u003E Davon Zucker in g 80,9\u003Cbr\u003E Fett in g 0\u003Cbr\u003E Salz in g 0,02\u003Cbr\u003E\u003Cbr\u003E\u003Cstrong\u003EProduktart:\u003C\u002Fstrong\u003E Saft \u002F Sirup\u003Cbr\u003E\u003Cbr\u003E\u003Cstrong\u003EHinweis:\u003C\u002Fstrong\u003E enthält Farbstoffe\u003C\u002Fp\u003E Monin Cookie Choco Sirup 0.7 L Verfeinert Kaffee, für die Küche, für Desserts, Kuchen und vieles mehr. Gebaeck urspruenglich Schokoladenstueckchen koestlichen, Gebaeck fuer: fuer Kueche, fuer Schoepfung. kraeftig schuetteln. gekuehltes, Zuckerkuloer.\u003Cbr\u003E\u003Cbr\u003E Naehrwertangaben Eiweiss enthaelt fuer Kueche, fuer 5b2375583827f 4019472","description":"\u003Cp\u003EMonin Cookie Choco Sirup\u003Cbr\u003E\u003Cbr\u003E\nCookie Chocos ist ein feines Gebäck welches ursprünglich aus den USA kommt. Es handelt sich dabei um einen Keks mit Schokoladenstückchen der auf mittlerweile auf der ganzen Welt beliebt ist. Monin Cookie Choco Sirup verbindet diesen köstlichen, nach frisch gebackenem, duftenden Gebäck und Schokolade.\u003Cbr\u003E\u003Cbr\u003E\nFarbe: Braun mit karamellfarbenen Reflexen. Im Aroma und Geschmack nach dunklem Schokoladenkeks mit Butter.\u003Cbr\u003E\u003Cbr\u003E\nGeeignet für: Verfeinert Kaffee, für die Küche, für Desserts, Kuchen und vieles mehr. Chocolate chip cookies sind eine ur-amerikansiche Schöpfung. Mrs. Ruth Wakefield aus dem Toll House Inn in Whitman, Massachusetts soll sie 1933 erfunden haben. 1997 wurde der Chocolate chip cookie der \"official cookie of the State of Massachusetts\". Heute findet man ihn in der ganzen Welt.\u003Cbr\u003E\u003Cbr\u003E\nEmpfehlung: Cookie Alexander: 1cl Dark Chocolate Sauce, 1cl Monin Chocolate Chip Cookie Sirup, 3cl Brandy, 6-8cl Vanilleeis, 4cl Milch. Zur Garnierung dunkle Schokoladensauce, Muskat. Alle abgemessenen Zutaten in einen shaker geben und sehr kräftig und lange genug schütteln. In ein gekühltes, mit etwas dunkler Schokoladensauce ausgeschwenktes Glas abseihen und mit Schokosauce und geriebenem Muskat garnieren.\u003Cbr\u003E\u003Cbr\u003E\nZutaten: Zucker, Wasser, Aroma, Farbstoff: Zuckerkulör.\u003Cbr\u003E\u003Cbr\u003E\nNährwertangaben (Per 100ml):\u003Cbr\u003E\nKcal 334\u003Cbr\u003E\nKj 1397\u003Cbr\u003E\nEiweiß in g 0\u003Cbr\u003E\nKohlenhydrate in g 83,5\u003Cbr\u003E\nDavon Zucker in g 80,9\u003Cbr\u003E\nFett in g 0\u003Cbr\u003E\nSalz in g 0,02\u003Cbr\u003E\u003Cbr\u003E\u003Cstrong\u003EProduktart:\u003C\u002Fstrong\u003E Saft \u002F Sirup\u003Cbr\u003E\u003Cbr\u003E\u003Cstrong\u003EHinweis:\u003C\u002Fstrong\u003E enthält Farbstoffe\u003C\u002Fp\u003E","shortDescription":"Monin Cookie Choco Sirup Cookie Chocos ist ein feines Gebäck welches ursprünglich aus den USA kommt. Es handelt sich dabei um einen Keks mit Schokoladenstückchen...","legalAdvice":"- Produktart: Saft \u002F Sirup \u003Cbr\u002F\u003E\n- Hinweis: enthält Farbstoffe","price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":"l","net":12.8,"gross":13.7,"taxFactor":1.07,"objectVersion":"2021-09-24"},"net":8.96,"gross":9.59,"taxFactor":1.07,"objectVersion":"2021-09-24"},"delivery":{"units":1.3,"surcharge":0,"c