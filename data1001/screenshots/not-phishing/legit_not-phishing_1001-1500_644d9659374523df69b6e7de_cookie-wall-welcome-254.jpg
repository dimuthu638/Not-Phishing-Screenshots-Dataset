objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["LILY LOLO"]},"suggestions":["LILY","LOLO","SPF15","BASE","COMPACTA","COOKIE","10ML"]},"meta":{"yategoLegacy":{"productId":"6408a1b1b7839","shopId":"62fb42006ca6d0.1","stockId":"6408a1b266db1","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":655,"deleted":false,"deleteDate":null,"createDate":"2023-03-08T17:23:32+01:00","lastModified":null},{"id":"929984","score":17.525623,"title":"Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar","textContent":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E Diese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E Dank des Zylinder Designs aus weiß mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E Die Deckenleuchte ist jedoch nicht nur optisch attraktiv, sondern überzeugt auch durch ihre vielfältigen Einsatzmöglichkeiten.\u003Cbr\u003E\u003Cbr\u003E Die moderne, aufbauende Bauweise der 2 flammigen Leuchte eignet sich besonders, wenn man eine optische Abhebung im Raum wünscht. Durch die schwenkbaren Fassungen in der Leuchte, kann man die Lichtkegel optimal einstellen. Somit setzt diese Spotleuchte Kunststücke, Bildwerke oder antike und wertvolle Vasen gekonnt in Szene. Darüber hinaus können mehrere dieser Deckenlampe für Vitrinen-, Flur-, Galerie- oder Kochinselbeleuchtung im Einsatz gebracht werden.\u003Cbr\u003E\u003Cbr\u003E Ob als stylishe Deckenlampe in großzügigen Fluren und Dielen, als zeitgemäßer Strahler über Ihrem Esstisch in Küche oder Esszimmer, als Eyecatcher in Ihrem Wohnzimmer oder auch als Highlights in öffentlichen Bereichen, wie z.B. Büro, Geschäften oder Praxen. Auch als coole Deckenlampe für das Jugendzimmer ist diese COOKIE Leuchte die richtige Wahl.\u003Cbr\u003E\u003Cbr\u003E Ganz gleich, welche Art von Lichtspots Sie für Ihre Zwecke benötigen, ob Sie auf der Suche nach Wohnzimmerlampen, Flurleuchten, Küchendeckenlampen, Schlafzimmerlampen, Büroleuchten oder sonstigen Wohnraumleuchten sind, dieser universell einsetzbarer Deckenstrahler wird all Ihren Ansprüchen gewiss gerecht!\u003Cbr\u003E\u003Cbr\u003E * Geeignet für 2 x GU10 Leuchtmittel bis max. 35 Watt (nicht enthalten)\u003C\u002Fp\u003E Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar Schwenkbare Spotleuchte COOKIE mit zwei schwenkbaren GU10 Spots, weiß mattModernes Design aus weiß mattem MetallLichtspots in ... zeitgemaesse weiss ueberzeugt vielfaeltigen Einsatzmoeglichkeiten.\u003Cbr\u003E\u003Cbr\u003E aufbaünde wuenscht. Kunststuecke, Darueber koennen fuer grosszuegigen zeitgemaesser ueber Kueche oeffentlichen Buero, Geschaeften fuer fuer benoetigen, Kuechendeckenlampen, Bueroleuchten Anspruechen fuer fuer ueber weiss weiss 5e15214346fed 612900231","description":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E\nDiese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E\nDank des Zylinder Designs aus weiß mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E\nDie Deckenleuchte ist jedoch nicht nur optisch attraktiv, sondern überzeugt auch durch ihre vielfältigen Einsatzmöglichkeiten.\u003Cbr\u003E\u003Cbr\u003E\nDie moderne, aufbauende Bauweise der 2 flammigen Leuchte eignet sich besonders, wenn man eine optische Abhebung im Raum wünscht. Durch die schwenkbaren Fassungen in der Leuchte, kann man die Lichtkegel optimal einstellen. Somit setzt diese Spotleuchte Kunststücke, Bildwerke oder antike und wertvolle Vasen gekonnt in Szene. Darüber hinaus können mehrere dieser Deckenlampe für Vitrinen-, Flur-, Galerie- oder Kochinselbeleuchtung im Einsatz gebracht werden.\u003Cbr\u003E\u003Cbr\u003E\nOb als stylishe Deckenlampe in großzügigen Fluren und Dielen, als zeitgemäßer Strahler über Ihrem Esstisch in Küche oder Esszimmer, als Eyecatcher in Ihrem Wohnzimmer oder auch als Highlights in öffentlichen Bereichen, wie z.B. Büro, Geschäften oder Praxen. Auch als coole Deckenlampe für das Jugendzimmer ist diese COOKIE Leuchte die richtige Wahl.\u003Cbr\u003E\u003Cbr\u003E\nGanz gleich, welche Art von Lichtspots Sie für Ihre Zwecke benötigen, ob Sie auf der Suche nach Wohnzimmerlampen, Flurleuchten, Küchendeckenlampen, Schlafzimmerlampen, Büroleuchten oder sonstigen Wohnraumleuchten sind, dieser universell einsetzbarer Deckenstrahler wird all Ihren Ansprüchen gewiss gerecht!\u003Cbr\u003E\u003Cbr\u003E\n* Geeignet für 2 x GU10 Leuchtmittel bis max. 35 Watt (nicht enthalten)\u003C\u002Fp\u003E","shortDescription":"Schwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten Diese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas! Dank...","legalAdvice":null,"price":{"rrp":{"savingGross":22.450000000000003,"savingPercent":35,"net":53.77,"gross":63.99,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":34.91,"gross":41.54,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":0,"deliveryString":"Lieferzeit 1 - 3 Werktage","deliveryTime":{"type":"work-day-range","data":[1,3],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":49,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"612900231","ean":"4017807426526","isbn":null,"manufacturer":"Trio Leuchten","mpn":"612900231","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"m