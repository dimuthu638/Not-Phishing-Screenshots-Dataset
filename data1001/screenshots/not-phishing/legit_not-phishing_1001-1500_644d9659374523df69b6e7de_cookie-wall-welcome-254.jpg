ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F9e\u002Fbc\u002F8ae9d12402569110e998ed4a1e87e8bb9ae888f22e51052145e51d5fdf4cbc9e-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F9e\u002Fbc\u002F8ae9d12402569110e998ed4a1e87e8bb9ae888f22e51052145e51d5fdf4cbc9e-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["COLLISTAR"]},"suggestions":["Collistar","Even","Finish","Foundation","Plus","Primer","Perfect","Skin","Spf15","Cookie","35ml"]},"meta":{"yategoLegacy":{"productId":"642240eb8fb46","shopId":"626804c0adada9.0","stockId":"644b2869c5bd4","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":502,"deleted":false,"deleteDate":null,"createDate":"2023-03-28T09:55:40+02:00","lastModified":"2023-04-29T09:19:41+02:00"},{"id":"262249","score":17.673487,"title":"Bacanha Sirop Brut Cookie 400 ml - Cookie \u002F Keks Sirup aus Frankreich","textContent":"\u003Cp\u003EDer Cookie Sirup von Bacanha ist ein Gourmet- und Duftelixier. Sein Geruch ist von einer subtilen Süße, sein ausgeprägter Geschmack von Haselnusskeksen ist einfach und natürlich.\u003C\u002Fp\u003E \u003Cp\u003EDer Kekssirup passt perfekt zu Ihren Latte-, Cappuccino- oder Pralinenzubereitungen.\u003C\u002Fp\u003E \u003Cp\u003EBacanhas Mission: Emotionen durch Geschmack wecken!\u003C\u002Fp\u003E \u003Cp\u003EDie Marke Bacanha wurde 2013 gegründet und hat sich der Entwicklung und Herstellung qualitativ hochwertiger Bio Sirups verschrieben.\u003C\u002Fp\u003E \u003Cp\u003EDa Qualität bei Bacanha GROß geschrieben wird, kommen hier ausschließlich ausgewählte Zutaten wie nachhaltig angebauter Bio Rohrzuckeraus Brasilien, Fruchtkonzentrat und natürliche Aromen zum Einsatz. Jede Kreation trägt die einzigartige Handschrift des passionierten und kreativen Teams und wird in und um Paris entwickelt und produziert.\u003C\u002Fp\u003E \u003Cp\u003EDie Bacanha Sirups schmecken ganz einfach in Wasser verdünnt, in diversen Cocktail-Kreationen mit und ohne Alkohol, in selbstgemachtem Eistee, in Smoothies, im Kaffee oder Tee und sind sogar beim Kochen und Backen eine leckere Ergänzung.\u003C\u002Fp\u003E \u003Cp\u003EAus Liebe zur Umwelt setzt Bacanha mit den markanten und recycelbaren 400 ml Glasflaschen, deren Inhalt für ca. 20 Getränke reicht, ein Zeichen gegen die schädlichen Einflüsse von Einwegflaschen.\u003C\u002Fp\u003E \u003Cp\u003E Durchschnittliche Nährwertangaben pro 100g\u002F100ml:\u003C\u002Fp\u003E Energie \u003Ctable\u003E \u003Ctr\u003E\u003Ctd\u003E 1298 kJ \u002F 304 kcal\u003C\u002Ftd\u003E\u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E Fett\u003C\u002Ftd\u003E \u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E davon gesättigte Fettsäuren\u003C\u002Ftd\u003E \u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E Kohlenhydrate\u003C\u002Ftd\u003E \u003Ctd\u003E 76,5 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E davon Zucker\u003C\u002Ftd\u003E \u003Ctd\u003E 76,5 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E Eiweiß\u003C\u002Ftd\u003E \u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E Salz\u003C\u002Ftd\u003E \u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003C\u002Ftable\u003E \u003Cul\u003E \u003Cli\u003EInhalt: 0,4 Liter Cookie-Sirup\u003C\u002Fli\u003E \u003Cli\u003EIn der recycelbaren Glasflasche mit Holzstopfen\u003C\u002Fli\u003E \u003Cli\u003EZutaten: Zucker, Wasser, Aroma, Zitronensäure.\u003C\u002Fli\u003E \u003Cli\u003ELagerung an einem sauberen, trockenen und kühlen Ort. Nach dem Öffnen innerhalb von 2 Monaten aufbrauchen.\u003C\u002Fli\u003E \u003Cli\u003EHersteller: BACANHA - 19, rue de l'Inte - 77165 Saint-Soupplets - France\u003C\u002Fli\u003E \u003C\u002Ful\u003E Bacanha Sirop Brut Cookie 400 ml - Cookie \u002F Keks Sirup aus Frankreich Der Cookie Sirup von Bacanha ist ein Gourmet- und Duftelixier. Sein Geruch ist von einer subtilen Süße, sein ausgeprägter ... Suesse, ausgepraegter natuerlich.\u003C\u002Fp\u003E gegruendet \u003Cp\u003EDa Qualitaet GROss ausschliesslich ausgewaehlte natuerliche traegt verduennt, Ergaenzung.\u003C\u002Fp\u003E fuer Getraenke schaedlichen Einfluesse Naehrwertangaben gesaettigte Fettsaeuren\u003C\u002Ftd\u003E Eiweiss\u003C\u002Ftd\u003E Zitronensaeure.\u003C\u002Fli\u003E kuehlen Oeffnen rü Suesse, ausgepraegter 63002ab0df00a 7005549","description":"\u003Cp\u003EDer Cookie Sirup von Bacanha ist ein Gourmet- und Duftelixier. Sein Geruch ist von einer subtilen Süße, sein ausgeprägter Geschmack von Haselnusskeksen ist einfach und natürlich.\u003C\u002Fp\u003E\n\u003Cp\u003EDer Kekssirup passt perfekt zu Ihren Latte-, Cappuccino- oder Pralinenzubereitungen.\u003C\u002Fp\u003E\n\u003Cp\u003EBacanhas Mission: Emotionen durch Geschmack wecken!\u003C\u002Fp\u003E\n\u003Cp\u003EDie Marke Bacanha wurde 2013 gegründet und hat sich der Entwicklung und Herstellung qualitativ hochwertiger Bio Sirups verschrieben.\u003C\u002Fp\u003E\n\u003Cp\u003EDa Qualität bei Bacanha GROß geschrieben wird, kommen hier ausschließlich ausgewählte Zutaten wie nachhaltig angebauter Bio Rohrzuckeraus Brasilien, Fruchtkonzentrat und natürliche Aromen zum Einsatz. Jede Kreation trägt die einzigartige Handschrift des passionierten und kreativen Teams und wird in und um Paris entwickelt und produziert.\u003C\u002Fp\u003E\n\u003Cp\u003EDie Bacanha Sirups schmecken ganz einfach in Wasser verdünnt, in diversen Cocktail-Kreationen mit und ohne Alkohol, in selbstgemachtem Eistee, in Smoothies, im Kaffee oder Tee und sind sogar beim Kochen und Backen eine leckere Ergänzung.\u003C\u002Fp\u003E\n\u003Cp\u003EAus Liebe zur Umwelt setzt Bacanha mit den markanten und recycelbaren 400 ml Glasflaschen, deren Inhalt für ca. 20 Getränke reicht, ein Zeichen gegen die schädlichen Einflüsse von Einwegflaschen.\u003C\u002Fp\u003E\n\u003Cp\u003E Durchschnittliche Nährwertangaben pro 100g\u002F100ml:\u003C\u002Fp\u003E\nEnergie\n\u003Ctable\u003E\n\u003Ctr\u003E\u003Ctd\u003E 1298 kJ \u002F 304 kcal\u003C\u002Ftd\u003E\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E Fett\u003C\u002Ftd\u003E\n\u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E davon gesättigte Fettsäuren\u003C\u002Ftd\u003E\n\u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E Kohlenhydrate\u003C\u002Ftd\u003E\n\u003Ctd\u003E 76,5 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E davon Zucker\u003C\u002Ftd\u003E\n\u003Ctd\u003E 76,5 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E Eiweiß\u003C\u002Ftd\u003E\n\u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E Salz\u003C\u002Ftd\u003E\n\u003Ctd\u003E 0,0 g\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003C\u002Ftable\u003E\n\u003Cul\u003E\n\u003Cli\u003EInhalt: 0,4 Liter Cookie-Sirup\u003C\u002Fli\u003E\n\u003Cli\u003EIn der recycelbaren Glasflasche mit Holzstopfen\u003C\u002Fli\u003E\n\u003Cli\u003EZutaten: Zucker, Wasser, Aroma, Zitronensäure.\u003C\u002Fli\u003E\n\u003Cli\u003ELagerung an einem sauberen, trockenen und kühlen Ort. Nach dem Öffnen innerhalb von 2 Monaten aufbrauchen.\u003C\u002Fli\u003E\n\u003Cli\u003EHersteller: BACANHA - 19, rue de l'Inte - 77165 Saint-Soupplets - France\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Der Cookie Sirup von Bacanha ist ein Gourmet- und Duftelixier. Sein Geruch ist von einer subtilen Süße, sein ausgeprägter Geschmack von Haselnusskeksen...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":"l","net":28.02,"gross":29.98,"taxFactor":1.07,"objectVersion":"2021-09-24"},"net":11.21,"gross":11.99,"taxFactor":1.07,"objectVersion":"2021-09-24"},"delivery":{"units":1200,"surcharge":0,"calculateOnce":1,"deliveryString":"Lieferzeit 1-3 Tage","deliveryTime":{"type":"day-range","data":[1,3],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":true,"objectVersion":"2021-09-24"},"stock":{"available":4,"quantityUnit":"Liter","packageSize":0.4,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"7005549","ean":"3760310820091","isbn":null,"manufacturer":"Bacanha","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"240000\u002F241901\u002F241907","tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0d\u002Fda\u002F75ea76e93926df31c38d81541b609d7ff88d054b43b06ec01c48e687fab3da0d-medium","height":1200,"width":1200,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0d\u002Fda\u002F75ea76e93926df31c38d81541b609d7ff88d054b43b06ec01c48e687fab3da0d-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0d\u002Fda\u002F75ea76e93926df31c38d81541b609d7ff88d054b43b06ec01c48e687fab3da0d-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersio