":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["GEFU"]},"suggestions":["Gebäckpresse","&quot","Cookie&quot"]},"meta":{"yategoLegacy":{"productId":"641916c87e64a","shopId":"435cb1c56b0686.0","stockId":"6449d49111b64","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":169,"deleted":false,"deleteDate":null,"createDate":"2023-03-21T07:55:03+01:00","lastModified":"2023-04-29T04:59:44+02:00"},{"id":"161878","score":18.419802,"title":"Hands off my Chocolate Chip Cookie Dough Tafel Milchschokolade 100g","textContent":"\u003Ch4\u003E\u003Cstrong\u003EHands off my Chocolate Chip Cookie Dough Tafel Milchschokolade 100g\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003E \u003Cp\u003EFür die Chocoholics, die es anders mögen. Hands Off My Chocolate Chocolate Chip Cookie Dough ist ein süßer Hingucker, der auch durch seinen einzigartigen Geschmack besticht. Die originell geformte Tafel setzt sich aus einer hellen und einer dunkleren Schicht feinster Milchschokolade zusammen. Die obere Schicht trägt den Geschmack von köstlichem Cookie-Dough, während die untere mit knusprigen Schoko-Crispies verfeinert wurde. Ein echter Genuss für jeden Schoko-Liebhaber. \u003C\u002Fp\u003E \u003Cstrong\u003EHands Off B.V. 's\u003C\u002Fstrong\u003E \u003Cstrong\u003EGravelandseweg 46 D 1211\u003C\u002Fstrong\u003E \u003Cstrong\u003EBT HILVERSUM Niederlande\u003C\u002Fstrong\u003E \u003Cp\u003EZutaten: Zucker, Kakaobutter, VOLLMILCHPULVER, Kakaomasse, WEIZENMEHL, MOLKENPULVER, MAGERMILCHPULVER, karamellisierter Zucker, Emulgator: SOJALECITHINE, Salz, Kokosöl, BUTTERREINFETT, natürliche Aromen. Kann NÜSSE enthalten. Keine künstlichen Farbstoffe und Aromen.\u003C\u002Fp\u003E \u003Cp\u003EDurchschnittliche Nährwerte je 100 g (unzubereitet)    Menge\u003Cbr\u003E Brennwert in kJ    2263,000\u003Cbr\u003E Brennwert in kcal    545,000\u003Cbr\u003E Fett in g    33,000\u003Cbr\u003E Fett, davon gesättigte Fettsäuren in g    20,000\u003Cbr\u003E Kohlenhydrate in g    54,000\u003Cbr\u003E Kohlenhydrate, davon Zucker in g    49,000\u003Cbr\u003E Eiweiß in g    7,300\u003Cbr\u003E Salz in g    0,330\u003C\u002Fp\u003E \u003Cdiv\u003E\u003Cstrong\u003EAllergene: GLUTENHALTIGE GETREIDE sowie daraus hergestellte Erzeugnisse; SOJA und daraus hergestellte Erzeugnisse; MILCH und daraus hergestellte Erzeugnisse, WEIZEN sowie daraus hergestellte Erzeugnisse\u003C\u002Fstrong\u003E\u003C\u002Fdiv\u003E \u003Cdiv\u003EKühl und trocken lagern\u003C\u002Fdiv\u003E Hands off my Chocolate Chip Cookie Dough Tafel Milchschokolade 100g  \u003Cp\u003EFuer moegen. Hands suesser traegt koestlichem waehrend fuer Kokosoel, natuerliche NUeSSE kuenstlichen Naehrwerte gesaettigte Fettsaeuren Eiweiss \u003Cdiv\u003EKuehl 5de729d139355 869120","description":"\u003Ch4\u003E\u003Cstrong\u003EHands off my Chocolate Chip Cookie Dough Tafel Milchschokolade 100g\u003C\u002Fstrong\u003E\u003C\u002Fh4\u003E\n\u003Cp\u003EFür die Chocoholics, die es anders mögen. Hands Off My Chocolate Chocolate Chip Cookie Dough ist ein süßer Hingucker, der auch durch seinen einzigartigen Geschmack besticht. Die originell geformte Tafel setzt sich aus einer hellen und einer dunkleren Schicht feinster Milchschokolade zusammen. Die obere Schicht trägt den Geschmack von köstlichem Cookie-Dough, während die untere mit knusprigen Schoko-Crispies verfeinert wurde. Ein echter Genuss für jeden Schoko-Liebhaber. \u003C\u002Fp\u003E\n\u003Cstrong\u003EHands Off B.V. 's\u003C\u002Fstrong\u003E\n\u003Cstrong\u003EGravelandseweg 46 D 1211\u003C\u002Fstrong\u003E\n\u003Cstrong\u003EBT HILVERSUM Niederlande\u003C\u002Fstrong\u003E\n\u003Cp\u003EZutaten: Zucker, Kakaobutter, VOLLMILCHPULVER, Kakaomasse, WEIZENMEHL, MOLKENPULVER, MAGERMILCHPULVER, karamellisierter Zucker, Emulgator: SOJALECITHINE, Salz, Kokosöl, BUTTERREINFETT, natürliche Aromen. Kann NÜSSE enthalten. Keine künstlichen Farbstoffe und Aromen.\u003C\u002Fp\u003E\n\u003Cp\u003EDurchschnittliche Nährwerte je 100 g (unzubereitet)    Menge\u003Cbr\u003E\nBrennwert in kJ    2263,000\u003Cbr\u003E\nBrennwert in kcal    545,000\u003Cbr\u003E\nFett in g    33,000\u003Cbr\u003E\nFett, davon gesättigte Fettsäuren in g    20,000\u003Cbr\u003E\nKohlenhydrate in g    54,000\u003Cbr\u003E\nKohlenhydrate, davon Zucker in g    49,000\u003Cbr\u003E\nEiweiß in g    7,300\u003Cbr\u003E\nSalz in g    0,330\u003C\u002Fp\u003E\n\u003Cdiv\u003E\u003Cstrong\u003EAllergene: GLUTENHALTIGE GETREIDE sowie daraus hergestellte Erzeugnisse; SOJA und daraus hergestellte Erzeugnisse; MILCH und daraus hergestellte Erzeugnisse, WEIZEN sowie daraus hergestellte Erzeugnisse\u003C\u002Fstrong\u003E\u003C\u002Fdiv\u003E\n\u003Cdiv\u003EKühl und trocken lagern\u003C\u002Fdiv\u003E","shortDescription":"Hands off my Chocolate Chip Cookie Dough Tafel Milchschokolade 100g Für die Chocoholics, die es anders mögen. Hands Off My Chocolate Chocolate...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":"kg","net":32.8,"gross":35.1,"taxFactor":1.07,"objectVersion":"2021-09-24"},"net":3.28,"gross":3.51,"taxFactor":1.07,"objectVersion":"2021-09-24"},"delivery":{"units":202,"surcharge":0,"calculateOnce":1,"deliveryString":"Lieferzeit 1-2 Tage","deliveryTime":{"type":"day-range","data":[1,2],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":true,"objectVersion":"2021-09-24"},"stock":{"available":23,"quantityUnit":"Kilogramm","packageSize":0.1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"869120","ean":"8718754740289","isbn":null,"manufacturer":"Hands Off BV","mpn":"869120","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath"