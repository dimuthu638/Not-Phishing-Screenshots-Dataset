o.com\u002F_media\u002Fc1\u002Fa0\u002F687fcbd8ae753e491382cdf57facd93cee9ff56e94d5087f7ee36d8d8383a0c1-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fc1\u002Fa0\u002F687fcbd8ae753e491382cdf57facd93cee9ff56e94d5087f7ee36d8d8383a0c1-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["MONACOR"]},"suggestions":["MONACOR","Funk-Sender","Stage","Line","TXS-900HSE"]},"meta":{"yategoLegacy":{"productId":"644c8ef5bf96d","shopId":"643e61e316e396.4","stockId":"644c8ef628ef1","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":842,"deleted":false,"deleteDate":null,"createDate":"2023-04-29T12:16:10+02:00","lastModified":null},{"id":"929987","score":17.796581,"title":"Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar","textContent":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E Diese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E Dank des Zylinder Designs aus schwarz mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E Die Deckenleuchte ist jedoch nicht nur optisch attraktiv, sondern überzeugt auch durch ihre vielfältigen Einsatzmöglichkeiten.\u003Cbr\u003E\u003Cbr\u003E Die moderne, aufbauende Bauweise der 2 flammigen Leuchte eignet sich besonders, wenn man eine optische Abhebung im Raum wünscht. Durch die schwenkbaren Fassungen in der Leuchte, kann man die Lichtkegel optimal einstellen. Somit setzt diese Spotleuchte Kunststücke, Bildwerke oder antike und wertvolle Vasen gekonnt in Szene. Darüber hinaus können mehrere dieser Deckenlampe für Vitrinen-, Flur-, Galerie- oder Kochinselbeleuchtung im Einsatz gebracht werden.\u003Cbr\u003E\u003Cbr\u003E Ob als stylishe Deckenlampe in großzügigen Fluren und Dielen, als zeitgemäßer Strahler über Ihrem Esstisch in Küche oder Esszimmer, als Eyecatcher in Ihrem Wohnzimmer oder auch als Highlights in öffentlichen Bereichen, wie z.B. Büro, Geschäften oder Praxen. Auch als coole Deckenlampe für das Jugendzimmer ist diese COOKIE Leuchte die richtige Wahl.\u003Cbr\u003E\u003Cbr\u003E Ganz gleich, welche Art von Lichtspots Sie für Ihre Zwecke benötigen, ob Sie auf der Suche nach Wohnzimmerlampen, Flurleuchten, Küchendeckenlampen, Schlafzimmerlampen, Büroleuchten oder sonstigen Wohnraumleuchten sind, dieser universell einsetzbarer Deckenstrahler wird all Ihren Ansprüchen gewiss gerecht!\u003Cbr\u003E\u003Cbr\u003E * Geeignet für 2 x GU10 Leuchtmittel bis max. 35 Watt (nicht enthalten)\u003C\u002Fp\u003E Deckenlampen, Lichtspots, Aufbaustrahler für über Kochinsel Galerie schwenkbar Schwenkbare Spotleuchte COOKIE mit zwei schwenkbaren GU10 Spots, schwarz mattModernes Design aus schwarz mattem MetallLichtspots ... zeitgemaesse ueberzeugt vielfaeltigen Einsatzmoeglichkeiten.\u003Cbr\u003E\u003Cbr\u003E aufbaünde wuenscht. Kunststuecke, Darueber koennen fuer grosszuegigen zeitgemaesser ueber Kueche oeffentlichen Buero, Geschaeften fuer fuer benoetigen, Kuechendeckenlampen, Bueroleuchten Anspruechen fuer fuer ueber 5e15214744761 612900232","description":"\u003Cp\u003ESchwenkbarer Aufbaustrahler COOKIE aus dem Hause TRIO Leuchten\u003Cbr\u003E\u003Cbr\u003E\nDiese zeitgemäße Innenleuchte verleiht jedem Wohnbereich das Gewisse etwas!\u003Cbr\u003E\u003Cbr\u003E\nDank des Zylinder Designs aus schwarz mattem Metall ist die schwenkbare COOKIE Spotlampe schon im Hellen ein wahrer Hingucker.\u003Cbr\u003E\u003Cbr\u003E\nDie Deckenleuchte ist jedoch nicht nur optisch at