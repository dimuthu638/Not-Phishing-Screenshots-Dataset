il":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fbc\u002F74\u002Ff2c5f1ddbb270aee35f7572e302b0fe13550201a0a796565b3e3f0deebed74bc-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":["holz"],"manufacturer":["vidaXL"]},"suggestions":["vidaXL","Gartenzaun-Element","Imprägniertes","Kiefernholz","180x180"]},"meta":{"yategoLegacy":{"productId":"63ec4d51cd495","shopId":"59d78a6377c6a3.9","stockId":"644c8adb4aa77","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":72,"deleted":false,"deleteDate":null,"createDate":"2023-02-16T11:24:34+01:00","lastModified":"2023-04-29T10:59:54+02:00"},{"id":"7332609","score":14.988321,"title":"vidaXL Lagerzelt Grau 180x180 cm Verzinkter Stahl","textContent":"\u003Cp\u003EDieses klassische Mehrzweckzelt schützt Ihre Outdoor-Ausrüstung und alle anderen Sachen, die Sie verstauen möchten. Diese Zeltgarage ist daher sowohl eine praktische als auch eine dekorative Ergänzung zu Ihrem Außenbereich. Dieses Lagerzelt besteht aus PE und ist somit wasserabweisend und UV-beständig. Es schützt vor Regen und Sonnenhitze. Die verzinkte Stahlrahmenkonstruktion trägt zu seiner Robustheit und Stabilität bei. Das offene Türdesign sorgt für frische Luft. Das Zelt kann auch eine gute Wahl für Outdoor-Events sein. Darüber hinaus kann es bei Nichtgebrauch ordentlich verpackt und einfach verstaut werden.\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EFarbe: Grau\u003C\u002Fli\u003E \u003Cli\u003EMaterial: PE (Polyethylen), verzinkter Stahl\u003C\u002Fli\u003E \u003Cli\u003EAbmessungen: 180 x 180 x 180 cm (L x B x H)\u003C\u002Fli\u003E \u003Cli\u003ETür-Größe: 130 x 150 cm (H x B)\u003C\u002Fli\u003E \u003Cli\u003EDichte der Plane: 210 g\u002Fm²\u003C\u002Fli\u003E \u003Cli\u003EStangen-Durchmesser: 3,4 cm\u003C\u002Fli\u003E \u003Cli\u003EInklusive 8 Zurrgurte und 4 Sturmanker\u003C\u002Fli\u003E \u003Cli\u003EUV-beständig\u003C\u002Fli\u003E \u003Cli\u003EZusammenbau erforderlich: Ja\u003C\u002Fli\u003E \u003C\u002Ful\u003E vidaXL Lagerzelt Grau 180x180 cm Verzinkter Stahl Dieses klassische Lagerzelt stellt eine perfekte Kombination aus Stil und Funktionalität dar. Hier lassen sich Ihre ... schuetzt Outdoor-Ausruestung verstaün moechten. Ergaenzung Aussenbereich. UV-bestaendig. schuetzt traegt Stabilitaet Tuerdesign fuer fuer Darueber \u003Cli\u003ETuer-Groesse: \u003Cli\u003EUV-bestaendig\u003C\u002Fli\u003E Funktionalitaet 642cc323ccda6 148633","description":"\u003Cp\u003EDieses klassische Mehrzweckzelt schützt Ihre Outdoor-Ausrüstung und alle anderen Sachen, die Sie verstauen möchten. Diese Zeltgarage ist daher sowohl eine praktische als auch eine dekorative Ergänzung zu Ihrem Außenbereich. Dieses Lagerzelt besteht aus PE und ist somit wasserabweisend und UV-beständig. Es schützt vor Regen und Sonnenhitze. Die verzinkte Stahlrahmenkonstruktion trägt zu seiner Robustheit und Stabilität bei. Das offene Türdesign sorgt für frische Luft. Das Zelt kann auch eine gute Wahl für Outdoor-Events sein. Darüber hinaus kann es bei Nichtgebrauch ordentlich verpackt und einfach verstaut werden.\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EFarbe: Grau\u003C\u002Fli\u003E\n\u003Cli\u003EMaterial: PE (Polyethylen), verzinkter Stahl\u003C\u002Fli\u003E\n\u003Cli\u003EAbmessungen: 180 x 180 x 180 cm (L x B x H)\u003C\u002Fli\u003E\n\u003Cli\u003ETür-Größe: 130 x 150 cm (H x B)\u003C\u002Fli\u003E\n\u003Cli\u003EDichte der Plane: 210 g\u002Fm²\u003C\u002Fli\u003E\n\u003Cli\u003EStangen-Durchmesser: 3,4 cm\u003C\u002Fli\u003E\n\u003Cli\u003EInklusive 8 Zurrgurte und 4 Sturmanker\u003C\u002Fli\u003E\n\u003Cli\u003EUV-beständig\u003C\u002Fli\u003E\n\u003Cli\u003EZusammenbau erforderlich: Ja\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Dies