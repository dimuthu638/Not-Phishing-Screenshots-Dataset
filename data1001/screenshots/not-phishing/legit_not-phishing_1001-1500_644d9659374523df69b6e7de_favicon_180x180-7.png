0,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Ff4\u002F73\u002F2b33e4c99306d0d1e2d1f5538361db022232b21babfeeecd3f29c61b09f073f4-medium","height":1100,"width":422,"ratio":0.38,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Ff4\u002F73\u002F2b33e4c99306d0d1e2d1f5538361db022232b21babfeeecd3f29c61b09f073f4-small","height":480,"width":184,"ratio":0.38,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Ff4\u002F73\u002F2b33e4c99306d0d1e2d1f5538361db022232b21babfeeecd3f29c61b09f073f4-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":["braun"],"category":[],"material":[],"manufacturer":["Dekoleidenschaft"]},"suggestions":["Paravent","&quot","Bambus&quot","180x180","braun","Raum","Teiler","Sicht","Schutz","Trenn","Falt","Wand"]},"meta":{"yategoLegacy":{"productId":"61fe8b30755a4","shopId":"4dee34abd454b7.9","stockId":"63cc14067fb42","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":403,"deleted":false,"deleteDate":null,"createDate":"2022-11-24T06:10:08+01:00","lastModified":"2023-04-29T18:43:38+02:00"},{"id":"3376015","score":18.158148,"title":"Spaarset Adapter Afriso PNG-01+ Gefäßfüller Fauch 400ml (6639#","textContent":"\u003Cp\u003ESpaarset \u003Cbr\u003E\u003Cb\u003EGefäßfüller Fauch\u003Cbr\u003E\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cbr\u003E \u003Ca href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Fauch_Gefaessfueller.pdf\"\u003E HIER FÜR SICHERHEITSDATENBLATT KLICKEN\u003C\u002Fa\u003E \u003Cbr\u003E \u003Cp\u003Efür Ausdehnungsgefäße MAG 400ml Spezial - Adapter für Gefäßfüller AFRISO PNG\"&gt; für Ausdehnungsgefäße MAG \u003Cbr\u003E\u003Cstrong\u003EDer Gefäßfüller ist unentbehrlich wenn Sie Ihr Ausdehnungsgefäß z.B. Heizung \u002F Solar \u002F Trinkwasser überprüfen bzw. mit Spezial Gefäßfüller auffüllen möchten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EDieser Adapter besteht aus einem Schlauchanschluß , Manometer 0-4bar , einen Spezialanschlußstück für Gefäßfüllflaschen \u003Cbr\u003E\u003Cstrong\u003EDieser Adapter ist nur in Verbindung mit einer Gefäßfüllflasche zur Überprüfung geeignet.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDer Gefässfüller pflegt und dichtet die Gummimembran im MAG und ermöglicht eine einfache und schnelle Druckergänzung!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EIdeal zum Auffüllen Vordruck Heizungsausdehnungsgefäße , Solarausdehnungsgefäße , Brauchwasserausdehnungsgefäße oder Trinkwasserausdehnungsgefäße \u003Cbr\u003E\u003Cstrong\u003EWichtig jedes Ausdehnungsgefäß sollte jährlich mindestens 1x überprüft werden ( Vordruck! ) dazu muß das Ausdehnungsgefäß drucklos sein ( Anlagendruck ) entweder durch absperren Kappenventil + entleeren oder durch trennen von Ihrer bestehenden Anlage!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EBei Trinkwasseraudehnungsgefäße 1.Sicherheitsgruppe Kaltwasser Absperrhahn schliesen \u003Cbr\u003E\u003Cstrong\u003E2. Druck über Warmwasserhahn evtl. Mischbatterie Waschtisch ( öffnen )entweichen lassen !\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E3. Mischbatterie wieder schliesen \u003Cbr\u003E\u003Cstrong\u003E4. Vordruck mit Adapter+Füllflasche überprüfen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003Ewenn fertig mit der Überprüfung = Sicherheitsgruppe Absteller wieder öffnen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDiese Spezialfüllflasche ist nur mit dem Spezialadapter ( in unseren Angeboten ) zu verwenden!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Spaarset Adapter Afriso PNG-01+ Gefäßfüller Fauch 400ml (6639# Adapter für Gefäßfüller für Ausdehnungsgefäße , MAG , Gefäßfüller , Ausdehnungsgefäße, Nicht zutreffend \u003Cbr\u003E\u003Cb\u003EGefaessfueller href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Fauch_Gefäßfüller.pdf\"\u003E FUeR \u003Cp\u003Efuer Ausdehnungsgefaesse fuer Gefaessfueller fuer Ausdehnungsgefaesse Gefaessfueller Ausdehnungsgefaess ueberpruefen Gefaessfueller auffuellen moechten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Schlauchanschluss Spezialanschlussstueck fuer Gefaessfuellflaschen Gefaessfuellflasche Ueberpruefung Gefaessfueller ermoeglicht Druckergaenzung!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Auffuellen Heizungsausdehnungsgefaesse Solarausdehnungsgefaesse Brauchwasserausdehnungsgefaesse Trinkwasserausdehnungsgefaesse Ausdehnungsgefaess jaehrlich ueberprueft muss Ausdehnungsgefaess Trinkwasseraudehnungsgefaesse ueber oeffnen Adapter+Fuellflasche ueberpruefen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Ueberpruefung oeffnen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Spezialfuellflasche Gefaessfueller fuer Gefaessfueller fuer Ausdehnungsgefaesse Gefaessfueller Ausdehnungsgefaesse, 63acd69f759ad 6639","description":"\u003Cp\u003ESpaarset \u003Cbr\u003E\u003Cb\u003EGefäßfüller Fauch\u003Cbr\u003E\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cbr\u003E\n\u003Ca href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Fauch_Gefaessfueller.pdf\"\u003E HIER FÜR SICHERHEITSDATENBLATT KLICKEN\u003C\u002Fa\u003E\n\u003Cbr\u003E\n\u003Cp\u003Efür Ausdehnungsgefäße MAG 400ml Spezial - Adapter für Gefäßfüller AFRISO PNG\"&gt; für Ausdehnungsgefäße MAG \u003Cbr\u003E\u003Cstrong\u003EDer Gefäßfüller ist unentbehrlich wenn Sie Ihr Ausdehn