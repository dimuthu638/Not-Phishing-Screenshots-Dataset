b193162eb59f-medium","height":600,"width":800,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F9f\u002Fb5\u002F31b88052b02f8fcb2bf8d5229b57157f59bc8bcedf8709c56245b193162eb59f-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F9f\u002Fb5\u002F31b88052b02f8fcb2bf8d5229b57157f59bc8bcedf8709c56245b193162eb59f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Amazon"]},"suggestions":["Amazon","Paperwhite","Generation","E-Book-Reader","B08N3TCP2F"]},"meta":{"yategoLegacy":{"productId":"62be9f4cbe749","shopId":"60912d237095f3.4","stockId":"64409a9234b30","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":280,"deleted":false,"deleteDate":null,"createDate":"2023-04-20T07:44:35+02:00","lastModified":"2023-04-29T02:50:25+02:00"},{"id":"2020832","score":17.544134,"title":"Messing PE - Winkel 32x32 mm (5829#","textContent":"\u003Cp\u003EMessing - Winkel für PE - Kunststoffrohre Winkel 32x32 mm \u003Cbr\u003EDiese Winkel können guten Gewissens als Universal - Verbindungen mit vielen positiven Merkmalen bezeichnet werden. Messing versprötet nicht, ist unempfindlich gegen Hitze und Kälte, setzt rauher mechanischer Beanspruchung, wie sie auf Baustellen vor kommt, größten Widerstand entgegen. Auch bei Erdverschiebungen und hoher Gewichtsbelastung durch Straßenverkehr ist ein Ausreißen oder Brechen der Verbindung bei erdverlegten Leitungen so gut wie ausgeschlossen.\u003C\u002Fp\u003E \u003Cp\u003EVORTEIL \u003Cbr\u003E\u003Cb\u003EMessing PE Winkel eignen sich besonders gut für Aufputz Installation, da sie geringere Außenmaße haben als PE Winkel aus Plaste.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003ETechnische Eigenschaften:\u003C\u002Fp\u003E \u003Cp\u003EGehäuse: Messing, Dichtung: NBR, Max. Betriebstemperatur: 40 °C, Sicherungsring: Plast, Max. Betriebsdruck: 10 bar, Medium: Wasser \u003Cbr\u003E\u003Cb\u003EInnenteile\u003C\u002Fb\u003E\u003C\u002Fp\u003E Messing PE - Winkel 32x32 mm (5829# Pe Kupplung , Plastrohrkupplung,PE , PE Übergang , Messing PE Kupplung, 8010660098042 fuer koennen versproetet Kaelte, groessten Strassenverkehr Ausreissen fuer Aussenmasse \u003Cp\u003EGehaeuse: Uebergang 63a45b632e2c5 5829","description":"\u003Cp\u003EMessing - Winkel für PE - Kunststoffrohre Winkel 32x32 mm \u003Cbr\u003EDiese Winkel können guten Gewissens als Universal - Verbindungen mit vielen positiven Merkmalen bezeichnet werden. Messing versprötet nicht, ist unempfindlich gegen Hitze und Kälte, setzt rauher mechanischer Beanspruchung, wie sie auf Baustellen vor kommt, größten Widerstand entgegen. Auch bei Erdverschiebungen und hoher Gewichtsbelastung durch Straßenverkehr ist ein Ausreißen oder Brechen der Verbindung bei erdverlegten Leitungen so gut wie ausgeschlossen.\u003C\u002Fp\u003E\n\u003Cp\u003EVORTEIL \u003Cbr\u003E\u003Cb\u003EMessing PE Winkel eignen sich besonders gut für Aufputz Installation, da sie geringere Außenmaße haben als PE Winkel aus Plaste.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003ETechnische Eigenschaften:\u003C\u002Fp\u003E\n\u003Cp\u003EGehäuse: Messing, Dichtung: NBR, Max. Betriebstemperatur: 40 °C, Sicherungsring: Plast, Max. Betriebsdruck: 10 bar, Medium: Wasser \u003Cbr\u003E\u003Cb\u003EInnenteile\u003C\u002Fb\u003E\u003C\u002Fp\u003E","shortDescription":"Messing - Winkel für PE - Kunststoffrohre Winkel 32x32 mm Diese Winkel können guten Gewissens als Universal - Verbindungen mit vielen positiven...","legalAdvice":null,"price":{"rrp":{"savi