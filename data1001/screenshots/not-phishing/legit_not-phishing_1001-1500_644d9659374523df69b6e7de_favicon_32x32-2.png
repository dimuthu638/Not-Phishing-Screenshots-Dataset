7d37882402.5\u002Foffer\u002F_raw\u002F86b5688a93e914fc745557e367a5db1c","height":800,"width":1500,"ratio":1.88,"avif":false,"png":false,"jpeg":true,"webp":false,"objectVersion":"2021-09-24"},"small":null,"thumbnail":null,"objectVersion":"2021-09-24"},{"large":{"uri":"https:\u002F\u002Fpicture.yatego.com\u002Fimages\u002F503f7d37882402.5\u002Foffer\u002F_raw\u002F29aec7f9fd42b270154b74755cd05765","height":1500,"width":1500,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":false,"objectVersion":"2021-09-24"},"medium":null,"small":null,"thumbnail":null,"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["LEGO®"]},"suggestions":["LEGO","Weiße","Bauplatte","Classic","Kreativ","Spielen","Kinder","Bauen","Platte","25x25cm"]},"meta":{"yategoLegacy":{"productId":"63f21103cfb43","shopId":"503f7d37882402.5","stockId":"64071440a4a0d","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":240,"deleted":false,"deleteDate":null,"createDate":"2023-02-19T17:26:10+01:00","lastModified":"2023-04-29T00:34:57+02:00"},{"id":"906308","score":16.750443,"title":"Tierbett Polyester dunkelgrau ø 60 cm KULU","textContent":"\u003Cp\u003ERundes Hundebett aus Kunstfell. Mit diesem besonders flauschigen Haustierbett fühlt sich Ihr pelziger Freund wie zu Hause und genießt einen hohen Schlafkomfort. Seine plüschige Textur in Kombination mit einer dicken Füllung macht das Kissen zu einem echten Ort der Entspannung, an dem sich Ihre Katze oder Ihr Hund gemütlich einkuscheln kann. Seine universelle, charmante Farbe passt zu vielen Einrichtungsstilen, so dass Sie sich keine Sorgen machen müssen, dass es nicht in Ihr Schlafzimmer oder Wohnzimmer passt. Außerdem ist es nicht zu groß, so dass Sie es problemlos neben einem Sofa oder Ihrem Bett platzieren können, um Ihren Liebling immer in der Nähe zu haben.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Tierbett\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Klassisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Dunkelgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Webpelz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rund\u003Cbr\u003E\u003Cb\u003ERutschfeste Unterseite:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EHandgefertigt:\u003C\u002Fb\u003E Nein\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EInnere Abmessungen:\u003C\u002Fb\u003E 32x32\u003Cbr\u003E\u003Cb\u003EHöhe:\u003C\u002Fb\u003E 15 cm\u003Cbr\u003E\u003Cb\u003EGewicht:\u003C\u002Fb\u003E 2 kg\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003ESie kaufen:\u003C\u002Fb\u003E 1 x Tierbett\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EProduktvorteile:\u003C\u002Fb\u003E\u003Cbr\u003E Besonders sicher dank rutschfester Unterseite, Herrlich weich, Lange Lebensdauer, Hohe Qualität, In der Waschmaschine als Ganzes waschbar\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EMontage:\u003C\u002Fb\u003E\u003Cbr\u003E Benötigt keine Montage\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPflegeanleitung:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EWebpelz:\u003C\u002Fb\u003E\u003Cbr\u003E 1.Wenn auf dem Etikett nicht anders angegeben, bitte nicht im Trockner trocknen und auch nicht bügeln\u003Cbr\u003E 2.Von Hand oder mit einem Feinwäsche-Programm bei max. 30°C waschen, wenn auf dem Etikett keine weiteren Hinweise des Herstellers gegeben sind.\u003C\u002Fp\u003E Tierbett Polyester dunkelgrau ø 60 cm KULU  fuehlt geniesst plueschige Fuellung gemuetlich muessen, Ausserdem gross, koennen, Naehe Webpelz\u003Cbr\u003E\u003Cb\u003EFuellmaterial:\u003C\u002Fb\u003E 32x32\u003Cbr\u003E\u003Cb\u003EHoehe:\u003C\u002Fb\u003E Lebensdaür, Qualitaet, Benoetigt buegeln\u003Cbr\u003E Feinwaesche-Programm ø 62f58e7533f9f ","description":"\u003Cp\u003ERundes Hundebett aus Kunstfell. Mit diesem besonders flauschigen Haustierbett fühlt sich Ihr pelziger Freund wie zu Hause und genießt einen hohen Schlafkomfort. Seine plüschige Textur in Kombination mit einer dicken Füllung macht das Kissen zu einem echten Ort der Entspannung, an dem sich Ihre Katze oder Ihr Hund gemütlich einkuscheln kann. Seine universelle, charmante Farbe passt zu vielen Einrichtungsstilen, so dass Sie sich keine Sorgen machen müssen, dass es nicht in Ihr Schlafzimmer oder Wohnzimmer passt. Außerdem ist es nicht zu groß, so dass Sie es problemlos neben einem Sofa oder Ihrem Bett platzieren können, um Ihren Liebling immer in der Nähe zu haben.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Tierbett\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Klassisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Dunkelgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Webpelz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rund\u003Cbr\u003E\u003Cb\u003ERutschfeste Unterseite:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EHandgefertigt:\u003C\u002Fb\u003E Nein\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u0