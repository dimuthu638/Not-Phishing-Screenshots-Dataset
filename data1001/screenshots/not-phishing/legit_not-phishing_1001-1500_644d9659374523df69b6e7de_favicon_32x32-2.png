2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["LEGO®"]},"suggestions":["LEGO","32x32","Noppen","Grundplatten","Hellgrau","Stueck","Light","bluish","grey","plate"]},"meta":{"yategoLegacy":{"productId":"62ba18eeeb95e","shopId":"62b960ae1959e8.1","stockId":null,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":631,"deleted":false,"deleteDate":null,"createDate":"2023-01-13T06:12:37+01:00","lastModified":"2023-04-29T04:33:43+02:00"},{"id":"906473","score":16.173717,"title":"Tierbett Polyester hellgrau ø 60 cm KULU","textContent":"\u003Cp\u003ERundes Hundebett aus Kunstfell. Mit diesem besonders flauschigen Haustierbett fühlt sich Ihr pelziger Freund wie zu Hause und genießt einen hohen Schlafkomfort. Seine plüschige Textur in Kombination mit einer dicken Füllung macht das Kissen zu einem echten Ort der Entspannung, an dem sich Ihre Katze oder Ihr Hund gemütlich einkuscheln kann. Seine universelle, charmante Farbe passt zu vielen Einrichtungsstilen, so dass Sie sich keine Sorgen machen müssen, dass es nicht in Ihr Schlafzimmer oder Wohnzimmer passt. Außerdem ist es nicht zu groß, so dass Sie es problemlos neben einem Sofa oder Ihrem Bett platzieren können, um Ihren Liebling immer in der Nähe zu haben.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Tierbett\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Klassisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Hellgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Webpelz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rund\u003Cbr\u003E\u003Cb\u003ERutschfeste Unterseite:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EHandgefertigt:\u003C\u002Fb\u003E Nein\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EInnere Abmessungen:\u003C\u002Fb\u003E 32x32\u003Cbr\u003E\u003Cb\u003EHöhe:\u003C\u002Fb\u003E 15 cm\u003Cbr\u003E\u003Cb\u003EGewicht:\u003C\u002Fb\u003E 2 kg\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003ESie kaufen:\u003C\u002Fb\u003E 1 x Tierbett\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EProduktvorteile:\u003C\u002Fb\u003E\u003Cbr\u003E Besonders sicher dank rutschfester Unterseite, Herrlich weich, Lange Lebensdauer, Hohe Qualität, In der Waschmaschine als Ganzes waschbar\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EMontage:\u003C\u002Fb\u003E\u003Cbr\u003E Benötigt keine Montage\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPflegeanleitung:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EWebpelz:\u003C\u002Fb\u003E\u003Cbr\u003E 1.Von Hand oder mit einem Feinwäsche-Programm bei max. 30°C waschen, wenn auf dem Etikett keine weiteren Hinweise des Herstellers gegeben sind\u003Cbr\u003E 2.Wenn auf dem Etikett nicht anders angegeben, bitte nicht im Trockner trocknen und auch nicht bügeln.\u003C\u002Fp\u003E Tierbett Polyester hellgrau ø 60 cm KULU  fuehlt geniesst plueschige Fuellung gemuetlich muessen, Ausserdem gross, koennen, Naehe Webpelz\u003Cbr\u003E\u003Cb\u003EFuellmaterial:\u003C\u002Fb\u003E 32x32\u003Cbr\u003E\u003Cb\u003EHoehe:\u003C\u002Fb\u003E Lebensdaür, Qualitaet, Benoetigt Feinwaesche-Programm buegeln.\u003C\u002Fp\u003E ø 62f58e9009f89 ","description":"\u003Cp\u003ERundes Hundebett aus Kunstfell. Mit diesem besonders flauschigen Haustierbett fühlt sich Ihr pelziger Freund wie zu Hause und genießt einen hohen Schlafkomfort. Seine plüschige Textur in Kombination mit einer dicken Füllung macht das Kissen zu einem echten Ort der Entspannung, an dem sich Ihre Katze oder Ihr Hund gemütlich einkuscheln kann. Seine universelle, charmante Farbe passt zu vielen Einrichtungsstilen, so dass Sie sich keine Sorgen machen müssen, dass es nicht in Ihr Schlafzimmer oder Wohnzimmer passt. Außerdem ist es nicht zu groß, so dass Sie es problemlos neben einem Sofa oder Ihrem Bett platzieren können, um Ihren Liebling immer in der Nähe zu haben.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Tierbett\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Klassisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Hellgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Webpelz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rund\u003Cbr\u003E\u003Cb\u003ERutschfeste Unterseite:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EHandgefertigt:\u003C\u002Fb\u003E Nein\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 60 cm\u003Cbr\u003E\u003Cb\u003EInnere Abmessungen:\u003C\u002Fb\u003E 32x32\u003Cbr\u003E\u003Cb\u003EHöhe:\u003C\u002Fb\u003E 15 cm\u003Cbr\u003E\u003Cb\u003EGewicht:\u003C\u002Fb\u003E 2 kg\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003ESie kaufen:\u003C\u002Fb\u003E 1 x Tierbett\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EProduktvorteile:\u003C\u002Fb\u003E\u003Cbr\u003E\nBesonders sicher dank rutschfester Unterseite, Herrlich weich, Lange Lebensdauer, Hohe Qualität, In der Waschmaschine als Ganzes waschbar\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EMontage:\u003C\u002Fb\u003E\u003Cbr\u003E\nBenötigt keine Montage\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPflegeanleitung:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EWebpelz:\u003C\u002Fb\u003E\u003Cbr\u003E\n1.Von Hand oder mit einem Feinwäsche-Programm bei max. 30°C waschen, wenn auf dem Etikett keine weiteren Hinweise des Herstellers gegeben sind\u003Cbr\u003E\n2.Wenn auf dem Etikett nicht anders angegeben, bitte nicht im Trockner trocknen und auch nicht bügeln.\u003C\u002Fp\u003E","shortDescription":"Rundes Hundebett aus Kunstfell. Mit diesem besonders flauschigen Haustierbett fühlt sich Ihr pelziger Freund wie zu Hause und genießt einen hohen...","legalAdvice":null,"price":{"rrp":{"savingGross":10.009999999999998,"savingPercent":22,"net":37.82,"gross":45,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":29.4,"gross":34.99,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"2 Tage","deliveryTime":{"type":"exact-day","data":[2],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":1,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"","ean":"4251682282826","isbn":null,"manufacturer":"Beliani","mpn":"322993","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"310000\u002F311301\u002F311312","tags":[],"mainImage":{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0c\u002F4a\u002F21633f300bd35495877ebafe173690b6d85f43357b63e595b1ffb6a55b034a0c-large","height":2560,"width":2560,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0c\u0