jectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fa1\u002F4d\u002F248a283594159fb2ce0ab8994717733b4e302d4d31967a41bd5e86d107244da1-small","height":465,"width":640,"ratio":1.38,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fa1\u002F4d\u002F248a283594159fb2ce0ab8994717733b4e302d4d31967a41bd5e86d107244da1-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":"https:\u002F\u002Fbalustrade24.de\u002Fsockelplatte-quadratische-betonplatte-fuer-pfeiler-abdeckplatte-und-gartenfigur-pflanzgefaess-grundplatte.html?combi_id=16066","_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":[]},"suggestions":["Sockelplatte","quadratische","Betonplatte","Pfeiler","Abdeckplatte","Gartenfigur","Pflanzgef","Grundplatte","BAD-32x32cm"]},"meta":{"yategoLegacy":{"productId":"64028eac77d83","shopId":"56cecdc0649707.3","stockId":null,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":44,"deleted":false,"deleteDate":null,"createDate":"2023-04-29T03:05:00+02:00","lastModified":null},{"id":"3376003","score":16.988277,"title":"Spaarset Adapter Afriso PNG-01 + Gefäßfüller Ulith 400ml (6641#","textContent":"\u003Cp\u003ESpaarset \u003Cbr\u003E\u003Cb\u003EGefäßfüller Ulith\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Ca href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Ulith_Gefaessfueller.pdf\"\u003EHIER FÜR SICHERHEITSDATENBLATT KLICKEN\u003C\u002Fa\u003E \u003Cbr\u003E \u003Cp\u003Efür Ausdehnungsgefäße MAG 400ml Spezial - Adapter für Gefäßfüller AFRISO PNG\"&gt; für Ausdehnungsgefäße MAG \u003Cbr\u003E\u003Cstrong\u003EDer Gefäßfüller ist unentbehrlich wenn Sie Ihr Ausdehnungsgefäß z.B. Heizung \u002F Solar \u002F Trinkwasser überprüfen bzw. mit Spezial Gefäßfüller auffüllen möchten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EDieser Adapter besteht aus einem Schlauchanschluß , Manometer 0-4bar , einen Spezialanschlußstück für Gefäßfüllflaschen \u003Cbr\u003E\u003Cstrong\u003EDieser Adapter ist nur in Verbindung mit einer Gefäßfüllflasche zur Überprüfung geeignet.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDer Gefässfüller pflegt und dichtet die Gummimembran im MAG und ermöglicht eine einfache und schnelle Druckergänzung!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EIdeal zum Auffüllen Vordruck Heizungsausdehnungsgefäße , Solarausdehnungsgefäße , Brauchwasserausdehnungsgefäße oder Trinkwasserausdehnungsgefäße \u003Cbr\u003E\u003Cstrong\u003EWichtig jedes Ausdehnungsgefäß sollte jährlich mindestens 1x überprüft werden ( Vordruck! ) dazu muß das Ausdehnungsgefäß drucklos sein ( Anlagendruck ) entweder durch absperren Kappenventil + entleeren oder durch trennen von Ihrer bestehenden Anlage!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EBei Trinkwasseraudehnungsgefäße 1.Sicherheitsgruppe Kaltwasser Absperrhahn schliesen \u003Cbr\u003E\u003Cstrong\u003E2. Druck über Warmwasserhahn evtl. Mischbatterie Waschtisch ( öffnen )entweichen lassen !\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E3. Mischbatterie wieder schliesen \u003Cbr\u003E\u003Cstrong\u003E4. Vordruck mit Adapter+Füllflasche überprüfen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003Ewenn fertig mit der Überprüfung = Sicherheitsgruppe Absteller wieder öffnen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDiese Spezialfüllflasche ist nur mit dem Spezialadapter ( in unseren Angeboten ) zu verwenden!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Spaarset Adapter Afriso PNG-01 + Gefäßfüller Ulith 400ml (6641# Adapter für Gefäßfüller für Ausdehnungsgefäße , MAG , Gefäßfüller , Ausdehnungsgefäße, Nicht zutreffend \u003Cbr\u003E\u003Cb\u003EGefaessfueller href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Ulith_Gefäßfüller.pdf\"\u003EHIER FUeR \u003Cp\u003Efuer Ausdehnungsgefaesse fuer Gefaessfueller fuer Ausdehnungsgefaesse Gefaessfueller Ausdehnungsgefaess ueberpruefen Gefaessfueller auffuellen moechten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Schlauchanschluss Spezialanschlussstueck fuer Gefaessfuellflaschen Gefaessfuellflasche Ueberpruefung Gefaessfueller ermoeglicht Druckergaenzung!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Auffuellen Heizungsausdehnungsgefaesse Solarausdehnungsgefaesse Brauchwasserausdehnungsgefaesse Trinkwasserausdehnungsgefaesse Ausdehnungsgefaess jaehrlich ueberprueft muss Ausdehnungsgefaess Trinkwasseraudehnungsgefaesse ueber oeffnen Adapter+Fuellflasche ueberpruefen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Ueberpruefung oeffnen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Spezialfuellflasche Gefaessfueller fuer Gefaessfueller fuer Ausdehnungsgefaesse Gefaessfueller Ausdehnungsgefaesse, 63a45a66e28f9 6641","description":"\u003Cp\u003ESpaarset \u003Cbr\u003E\u003Cb\u003EGefäßfüller Ulith\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cbr\u003E\n\u003Cbr\u003E\n\u003Ca href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Ulith_Gefaessfueller.pdf\"\u003EHIER FÜR SICHERHEITSDATENBLATT KLICKEN\u003C\u002Fa\u003E\n\u003Cbr\u003E\n\u003Cp\u003Efür Ausdehnungsgefäße MAG 400ml Spezial - Adapter für Gefäßfüller AFRISO PNG\"&gt; für Ausdehnungsgefäße MAG \u003Cbr\u003E\u003Cstrong\u003EDer Gefäßfüller ist unentbehrlich wenn Sie Ihr Ausdehnungsgefäß z.B. Heizung \u002F Solar \u002F Trinkwasser überprüfen bzw. mit Spezial Gefäßfüller auffüllen möchten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003EDieser Adapter besteht aus einem Schlauchanschluß , Manometer 0-4bar , einen Spezialanschlußstück fü