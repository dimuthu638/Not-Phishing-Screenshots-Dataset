:"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F15\u002F56\u002F11ef90efe8f00e88225bf4c2d243dd5e48f887986485d52f968d9867391d5615-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Lindner"]},"suggestions":["LINDNER","2051-802005","MÜNZHÜLLEN","GLASKLARE","FOLIE","BESCHRIFTUNGSKÄRTCHEN"]},"meta":{"yategoLegacy":{"productId":"6208eadb72787","shopId":"4d4bd629d54f94.8","stockId":"6208eadbc4a6a","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":101,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T13:19:43+01:00","lastModified":"2023-03-06T22:08:38+01:00"},{"id":"519926","score":16.583895,"title":"Sigel GL403 Glas Magnetboard LED Beleuchtung 48x48 Sichtbeton Magnettafel Board","textContent":"\u003Cp\u003EGlas-Magnetboard Artverum LED light, Design Sichtbeton, 48 x 48 cm - GL403 \u003Cbr\u003EGraues, hochglänzendes Glas-Magnetboard Artverum LED light im Design \"Sichtbeton\". Das rückseitig rundum beleuchtete Board in der Lichtfarbe Warmweiß mit moderner Betonstruktur ist magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Die Stromversorgung läuft über ein 2 Meter langes weißes Kabel inkl. Kabelschalter mit Eurostecker inkl. Transformator. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1) und rückseitig aufgebrachtem Aluminiumprofil mit Diffusor und integriertem LED-Band. Das Leuchtmittel ist fest installiert und kann nicht ausgetauscht werden, die durchschnittliche Leuchtdauer beträgt 25.000 h. Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Aufhängung sorgt für einen sicheren Halt. Die Größe des Boards beträgt 48x48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete, Befestigungsmaterial und Leuchtmittel enthalten.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EDesign: Design Sichtbeton\u003C\u002Fli\u003E \u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E \u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Cp\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EGlas-Magnetboard Artverum LED light - einzigartiges Raum-Objekt im Design Sichtbeton mit attraktivem LED-Stimmungslicht\u003C\u002Fli\u003E \u003Cli\u003Einklusive Leuchtmittel: LED-Band im Aluminiumprofil auf der Rückseite des Glas-Magnetboards fest installiert, weißes Kabel (2 m) inkl. Kabelschalter und Eurostecker\u003C\u002Fli\u003E \u003Cli\u003EAus Sicherheitsglas: hochwertiges Tempered Glas (ESG, EN 12150-1), magnethaftend und beschreibbar\u003C\u002Fli\u003E \u003Cli\u003EWarmweißes Licht durch LED-Band, Leuchtdauer: ca. 25.000 h, Lichtstrom: 540 lm; Lichtleistung 8,6 W\u003C\u002Fli\u003E \u003Cli\u003Einkl. drei starker SuperDym-Magnete, Befestigungsmaterial und Bohrschablone\u003C\u002Fli\u003E \u003C\u002Ful\u003E Sigel GL403 Glas Magnetboard LED Beleuchtung 48x48 Sichtbeton Magnettafel Board * Design: Design Sichtbeton * Maße Produkt: 48 x 48 x 1,5 cm * Material: Tempered Glas \u002F Sicherheitsglas (ESG) \u003Cbr\u003EGraüs, hochglaenzendes rueckseitig Warmweiss laeuft ueber weisses rueckseitig Leuchtdaür betraegt Aufhaengung laesst Aufhaengung fuer Groesse betraegt \u003Cli\u003EMasse Rueckseite weisses \u003Cli\u003EWarmweisses Leuchtdaür: Masse 5ff3d45af0a5e ","description":"\u003Cp\u003EGlas-Magnetboard Artverum LED light, Design Sichtbeton, 48 x 48 cm - GL403 \u003Cbr\u003EGraues, hochglänzendes Glas-Magnetboard Artverum LED light im Design \"Sichtbeton\". Das rückseitig rundum beleuchtete Board in der Lichtfarbe Warmweiß mit moderner Betonstruktur ist magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Die Stromversorgung läuft über ein 2 Meter langes weißes Kabel inkl. Kabelschalter mit Eurostecker inkl. Transformator. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1) und rückseitig aufgebrachtem Aluminiumprofil mit Diffusor und integriertem LED-Band. Das Leuchtmittel ist fest installiert und kann nicht ausgetauscht werden, die durchschnittliche Leuchtdauer beträgt 25.000 h. Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Aufhängung sorgt für einen sicheren Halt. Die Größe des Boards beträgt 48x48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete, Befestigungsmaterial und Leuchtmittel enthalten.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EDesign: Design Sichtbeton\u003C\u002Fli\u003E\n\u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E\n\u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EGlas-Magnetboard Artverum LED light - einzigartiges Raum-Objekt im Design Sichtbeton mit attraktivem LED-Stimmungslicht\u003C\u002Fli\u003E\n\u003Cli\u003Einklusive Leuchtmittel: LED-Band im Aluminiumprofil auf der Rückseite des Glas-Magnetboards fest installiert, weißes Kabel (2 m) inkl. Kabelschalter und Eurostecker\u003C\u002Fli\u003E\n\u003Cli\u003EAus Sicherheitsglas: hochwertiges Tempered Glas (ESG, EN 12150-1), magnethaftend und beschreibbar\u003C\u002Fli\u003E\n\u003Cli\u003EWarmweißes Licht durch LED-Band, Leuchtdauer: ca. 25.000 h, Lichtstrom: 540 lm; Lichtleistung 8,6 W\u003C\u002Fli\u003E\n\u003Cli\u003Einkl. drei starker SuperDym-Magnete, Befestigungsmaterial und Bohrschablone\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Glas-Magnetboard Artverum LED light, Design Sichtbeton, 48 x 48 