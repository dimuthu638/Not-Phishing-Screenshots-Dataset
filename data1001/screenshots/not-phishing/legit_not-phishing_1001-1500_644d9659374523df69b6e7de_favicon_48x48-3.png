ecb991691ff94dd5a165c2ea5bc9b5e005cbc28e2b21dc18a6ba61a4b6bc2f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":["schwarz"],"category":[],"material":[],"manufacturer":["Sigel"]},"suggestions":["Sigel","GL400","Glas","Magnetboard","Beleuchtung","48x48","Magnettafel","Board","schwarz"]},"meta":{"yategoLegacy":{"productId":"5ff3d45e32d42","shopId":"49ad6885e41569.9","stockId":"644c8350c8016","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":102,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T12:18:25+01:00","lastModified":"2023-04-29T06:44:16+02:00"},{"id":"519977","score":14.703874,"title":"Sigel Glas Magnetboard Artverum GL272 Pinnwand 48x48 Glasboard Magnet Tafel","textContent":"\u003Cp\u003ESigel Glas Magnetboard Artverum GL272, beerenrot \u003Cbr\u003EBringen Sie Farbe in Ihre Räume -  aber nicht einfach irgendwie! Ein Glas-Magnetboard Artverum ist die etwas andere Wandgestaltung. Das satte Beerenrot ist ein Eyecatcher in Küche, Eingangsbereich oder Homeoffice. Mit Kreidemarkern oder Glasboard-Markern können Sie sich Notizen darauf machen oder kleine Nachrichten hinterlassen. Die Metallplatte hinter dem Glas macht die Oberfläche magnethaftend. Achtung: Nur extra-starke Neodym-Magnete halten hier Kühlschrankmagnete oder ähnliche sind zu schwach. In der Größe 48 x 48 cm eignet sich das Board perfekt für kleinere Wandflächen, z. B. im Flur oder als Arbeitshilfe über dem Schreibtisch. Wichtige Reminder bringt Artverum designstark ins Gedächtnis. Besonders dekorativ wirken die Glastafeln, wenn zwei nebeneinander gehängt werden. Die Montage geht dank der Bohrschablone besonders einfach.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E* Designprämierte Glas-Magnettafel für Wohnzimmer, Homeoffice oder Büro: magnethaftend, beschreibbar, trocken abwischbar und dekorativ * Farbe: beerenrot * Maße Produkt: 48 x 48 x 1,5 cm * Material: Tempered Glas \u002F Sicherheitsglas (ESG) * Schwebender 3D-Look durch rahmenlose Aufhängung schaffen ein Statement an der Wand * Einfache Montage dank Bohrschablone * Aufhängung im Hoch- und Querformat möglich \u003Cbr\u003E* Inkl. 2x Neodym Magnet im Cube Disgn, silber (normale Magnete halten nicht)\u003C\u002Fp\u003E Sigel Glas Magnetboard Artverum GL272 Pinnwand 48x48 Glasboard Magnet Tafel * Designprämierte Glas-Magnettafel für Wohnzimmer, Homeoffice oder Büro: magnethaftend, beschreibbar, trocken abwischbar und ... Raeume Kueche, koennen Oberflaeche Kuehlschrankmagnete aehnliche Groesse fuer Wandflaechen, ueber Gedaechtnis. gehaengt Designpraemierte fuer Buero: Masse Aufhaengung Aufhaengung Qürformat moeglich Designpraemierte fuer Buero: 5ff3d46419221 ","description":"\u003Cp\u003ESigel Glas Magnetboard Artverum GL272, beerenrot \u003Cbr\u003EBringen Sie Farbe in Ihre Räume -  aber nicht einfach irgendwie! Ein Glas-Magnetboard Artverum ist die etwas andere Wandgestaltung. Das satte Beerenrot ist ein Eyecatcher in Küche, Eingangsbereich oder Homeoffice. Mit Kreidemarkern oder Glasboard-Markern können Sie sich Notizen darauf machen oder kleine Nachrichten hinterlassen. Die Metallplatte hinter dem Glas macht die Oberfläche magnethaftend. Achtung: Nur extra-starke Neodym-Magnete halten hier Kühlschrankmagnete oder ähnliche sind zu schwach. In der Größe 48 x 48 cm eignet sich das Board perfekt für kleinere Wandflächen, z. B. im Flur oder als Arbeitshilfe über dem Schreibtisch. Wichtige Reminder bringt Artverum designstark ins Gedächtnis. Besonders dekorativ wirken die Glastafeln, wenn zwei nebeneinander gehängt werden. Die Montage geht dank der Bohrschablone besonders einfach.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E* Designprämierte Glas-Magnettafel für Wohnzimmer, Homeoffice oder Büro: magnethaftend, beschreibbar, trocken abwischbar und dekorativ * Farbe: beerenrot * Maße Produkt: 48 x 48 x 1,5 cm * Material: Tempered Glas \u002F Sicherheitsglas (ESG) * Schwebender 3D-Look durch rahmenlose Aufhängung schaffen ein Statement an der Wand * Einfache Montage dank Bohrschablone * Aufhängung im Hoch- und Querformat möglich \u003Cbr\u003E* Inkl. 2x Neodym Magnet im Cube Disgn, silber (normale Magnete halten nicht)\u003C\u002Fp\u003E","shortDescription":"Sigel Glas Magnetboard Artverum GL272, beerenrot Bringen Sie Farbe in Ihre Räume -  aber nicht einfach irgendwie! Ein Glas-Magnetboard Artverum...","legalAdvice":null,"price":{"rrp":{"savingGross":8.419999999999987,"savingPercent":10,"net":64.46,"gross":76.71,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":57.39,"gross":68.29,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":1,"surcharge":0,"calculateOnce":0,"deliveryString":"Kurzfristig verfügbar, Lieferzei","deliveryTime":{"type":"unknown","data":[],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":109,"quantityUnit":"Stueck","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"","ean":"4004360836220","isbn":null,"manufacturer":"Sigel","mpn":"Außenlager Sigel","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":null,"tags":[],"mainImage":{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F6e\u002F5f\u002Ff41ac93927a0fed0c28ae99e629dbcf1d4340ab3efc380c7ac8c82740eab5f6e-large","height":1600,"width":1600,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion