1a680920f-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0f\u002F92\u002Fc9135fb036a2982c537213640ac8b0e193b78d127511c5069ad21131a680920f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["HIP"]},"suggestions":["Zierkissen","Valdez","48x48"]},"meta":{"yategoLegacy":{"productId":"64265818d6952","shopId":"59d78a6377c6a3.9","stockId":"64408d7a7db77","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":72,"deleted":false,"deleteDate":null,"createDate":"2023-04-01T11:30:54+02:00","lastModified":"2023-04-29T11:03:30+02:00"},{"id":"378212","score":16.461008,"title":"Pad Kissen CHAMPAGNE Fellkissen BLAU Kissenhülle 48x48 cm Fell Kissenbezug","textContent":"\u003Ch4\u003EFellkissen Bezug Champagne in Blau von Pad Concept\u003C\u002Fh4\u003E \u003Cul\u003E \u003Cli\u003EPad Kissenhülle CHAMPAGNE in Fell Optik\u003C\u002Fli\u003E \u003Cli\u003EKunstfell aus Polyester in Blau\u003C\u002Fli\u003E \u003Cli\u003EHergestellt in Europa\u003C\u002Fli\u003E \u003Cli\u003EGröße ca. 48 x 48 cm\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E \u003Cp\u003EIn einem wunderschönen, satten Blau setzt die große, quadratische Pad Kissenhülle in jeder Einrichtung einen geschmackvollen Akzent.\u003C\u002Fp\u003E \u003Cp\u003ESie fügt sich optimal in einen klassischen Einrichtungsstil, ergänzt aber ebenso perfekt das gemütliche, moderne Wohnen.\u003C\u002Fp\u003E \u003Cp\u003EDas attraktive Pad Kissen in Fell-Imitat lässt sich mit weiteren Kissen der Serie Champagne zu einer geschmackvollen Kuschellandschaft auf dem Sofa ergänzen. Selbst eine passende Felldecke führen wir im Onlineshop.\u003C\u002Fp\u003E \u003Cp\u003EAls Einzelstück wird die flauschige Pad Kissenhülle zum einzigartigen Eyecatcher in Deiner Wohnlandschaft. Selbstverständlich ist das dekorative Pad Kissen in Fell-Imitat nicht nur zum Ansehen gedacht.\u003C\u002Fp\u003E \u003Cp\u003EDie große Pad Kissenhülle sorgt auf der heimischen Couch für einen behaglichen Fernsehabend und bietet im Bett als zweites Kopfkissen eine kuschelige und warme Kopfstütze.\u003C\u002Fp\u003E \u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E \u003Ctable\u003E \u003Ctr\u003E \u003Ctd\u003EArtikelnummer:\u003C\u002Ftd\u003E \u003Ctd\u003E26.885-12898\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003EMaterial:\u003C\u002Ftd\u003E \u003Ctd\u003EPolyester\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cp\u003EAbmessungen:\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003ECa. 48 x 48 cm\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003EGewicht:\u003C\u002Ftd\u003E \u003Ctd\u003ECa. 310 Gramm \u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003ELieferumfang:\u003C\u002Ftd\u003E \u003Ctd\u003E1 Pad Kissenbezug Champagne Blau 48x48 in Felloptik ohne Inlett\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003C\u002Ftable\u003E \u003Cbr\u003E Blau \u003Cbr\u003E Polyester \u003Cbr\u003E Pad Concept \u003Cbr\u003E 48 x 48 cm \u003Cbr\u003E Kissenhülle \u003Cbr\u003E 48 cm \u003Cbr\u003E 48 cm \u003Cbr\u003E 12898 \u003Cbr\u003E 48 cm \u003Cbr\u003E Champagne \u003Cbr\u003E 310 g Pad Kissen CHAMPAGNE Fellkissen BLAU Kissenhülle 48x48 cm Fell Kissenbezug Mit dem Kuschelkissen von Pad Concept Harmonie und Wärme schenken. Das herrlich blaue Pad Kissen in Fell-Nachahmung sorgt für ... Kissenhuelle \u003Cli\u003EGroesse wunderschoenen, grosse, Kissenhuelle fuegt ergaenzt gemuetliche, laesst ergaenzen. fuehren Einzelstueck Kissenhuelle Selbstverstaendlich grosse Kissenhuelle fuer Kopfstuetze.\u003C\u002Fp\u003E Kissenhuelle Kissenhuelle Waerme blaü fuer 5fcae8aa9a499 26.885-12898","description":"\u003Ch4\u003EFellkissen Bezug Champagne in Blau von Pad Concept\u003C\u002Fh4\u003E\n\u003Cul\u003E\n\u003Cli\u003EPad Kissenhülle CHAMPAGNE in Fell Optik\u003C\u002Fli\u003E\n\u003Cli\u003EKunstfell aus Polyester in Blau\u003C\u002Fli\u003E\n\u003Cli\u003EHergestellt in Europa\u003C\u002Fli\u003E\n\u003Cli\u003EGröße ca. 48 x 48 cm\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E\n\u003Cp\u003EIn einem wunderschönen, satten Blau setzt die große, quadratische Pad Kissenhülle in jeder Einrichtung einen geschmackvollen Akzent.\u003C\u002Fp\u003E\n\u003Cp\u003ESie fügt sich optimal in einen klassischen Einrichtungsstil, ergänzt aber ebenso perfekt das gemütliche, moderne Wohnen.\u003C\u002Fp\u003E\n\u003Cp\u003EDas attraktive Pad Kissen in Fell-Imitat lässt sich mit weiteren Kissen der Serie Champagne zu einer geschmackvollen Kuschellandschaft auf dem Sofa ergänzen. Selbst eine passende Felldecke führen wir im Onlineshop.\u003C\u002Fp\u003E\n\u003Cp\u003EAls Einzelstück wird die flauschige Pad Kissenhülle zum einzigartigen Eyecatcher in Deiner Wohnlandschaft. Selbstverständlich ist das dekorative Pad Kissen in Fell-Imitat nicht nur zum Ansehen gedacht.\u003C\u002Fp\u003E\n\u003Cp\u003EDie große Pad Kissenhülle sorgt auf der heimischen Couch für einen behaglichen Fernsehabend und bietet im Bett als zweites Kopfkissen eine kuschelige und warme Kopfstütze.\u003C\u002Fp\u003E\n\u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E\n\u003Ctable\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EArtikelnummer:\u003C\u002Ftd\u003E\n\u003Ctd\u003E26.885-12898\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EMaterial:\u003C\u002Ftd\u003E\n\u003Ctd\u003EPolyester\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\u003Cp\u003EAbmessungen:\u003C\u002Fp\u003E\u003C\u002Ftd\u003E\n\u003Ctd\u003E\u003Cp\u003ECa. 48 x 48 cm\u003C\u002Fp\u003E\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EGewicht:\u003C\u002Ftd\u003E\n\u003Ctd\u003ECa. 310 Gramm \u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003ELieferumfang:\u003C\u002Ftd\u003E\n\u003Ctd\u003E1 Pad Kissenbezug Champagne Blau 48x48 in Felloptik ohne Inlett\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003C\u002Ftable\u003E\n\u003Cbr\u003E\nBlau\n\u003Cbr\u003E\nPolyester\n\u003Cbr\u003E\nPad Concept\n\u003Cbr\u003E\n48 x 48 cm\n\u003Cbr\u003E\nKissenhülle\n\u003Cbr\u003E\n48 cm\n\u003Cbr\u003E\n48 cm\n\u003Cbr\u003E\n12898\n\u003Cbr\u003E\n48 cm\n\u003Cbr\u003E\nChampagne\n\u003Cbr\u003E\n310 g","shortDescription":"Fellkissen Bezug Champagne in Blau von Pad Concept   Pad Kissenhülle CHAMPAGNE in Fell Optik Kunstfell aus Polyester in Blau Hergestellt in Europa...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":45.34,"gross":53.95,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":5,"calculateOnce":0,"deliveryString":"Lieferzeit 48h","deliveryTime":{"type":"unknown","data":[],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":3,"quantityUnit":"Stueck","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"26.885-12898","ean":"4260669241282","isbn":null,"manufacturer":"Pad Concept","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"220000\u002F222301\u002F222316","tags":[],"mainImage":{"large":null,"medium":null,"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F7d\u002F44\u002F81b1ddc80b04d7383341dd550a9c402f6fc34f67131f4a031a8dd7723583447d-small","height":470,"width":540,"ratio":1.15,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F7d\u002F44\u002F81b1ddc80b04d7383341dd550a9c402f6fc34f67131f4a031a8dd7723583447d-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":["blau"],"category":[],"material":["polyester"],"manufacturer":["Pad Concept"]},"suggestions":["Kissen","CHAMPAGNE","Fellkissen","BLAU","Kissenhülle","48x48","Fell","Kissenbezug"]},"meta":{"yategoLegacy":{"productId":"5fcae8aa9a499","shopId":"5bd0624cd16991.3","stockId":"644c5f931a390","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":94,"deleted":false,"deleteDate":null,"createDate":"2022-11-09T21:40:16+01:00","lastModified":"2023-04-29T04:35:10+02:00"},{"id":"5959368","score":16.410498,"title":"LEGO® Graue Bauplatte 11024 Classic Kreativ Spielen Kinder Bauen Platte 38x38cm","textContent":"\u003Cp\u003EDiese graue Bauplatte mit 48x48 Noppen ermöglicht viele fantasievolle Bauprojekte. Auf diesem festen grauen Fundament können Kinder zum Beispiel Straßen, Burgen und Gebirge darstellen oder alles aufbauen, was ihnen sonst noch in den Sinn kommt. Auf der griffigen Noppenfläche lassen sich die fertigen Modelle dann auch sicher transportieren und ausstellen. Kreative Spielwiese: Diese 48x48 Bauplatte dient als Fundament und offene Landschaft für die unterschiedlichsten LEGO® Modelle Robust und strapazierfähig: 2.304 Noppen in einem perfekten quadratischen Raster geben den LEGO® Bausteinen festen Halt Unzählige kreative Möglichkeiten: Dein Kind kann alles bauen, was ihm in den Sinn kommt, zum Beispiel Straßenkulissen, Burgen oder Gebirge Geschenk für jeden Anlass: Das LEGO® Classic Spielzeug Graue Bauplatte (11024) eignet sich als Geburtstags-, Weihnachts- oder Überraschungsgeschenk für Kinder ab 4 Jahren Für kreative Spielabenteuer: Die quadratische Bauplatte (38 cm x 38 cm) bietet reichlich Platz für die Bauprojekte und Modelle deines Kindes Batterieloses Produkt: Die Fantasie kreativer Kinder reicht völlig Eine Bauanleitung wird nicht benötigt: Nimm die Bauplatte einfach aus der Box, um viele Stunden fantasievoll zu spielen Kinder lernen beim Spielen: LEGO® Classic Sets fördern die physische Entwicklung und das kreative Denkvermögen Die Qualität hat Vorrang: LEGO® Sets erfüllen strenge Branchenstandards, damit sie einheitlich und kompatibel sind und riesigen Bauspaß bieten Sicherheit steht an erster Stelle: LEGO® Classic Spielsets werden gründlich getestet, damit jedes Spielzeug die strengen globalen Sicherheits- und Qualitätsstandards erfüllt Achtung. Nicht geeignet für Kinder unter 36 Monate. Enthält verschluckbare Kleinteile. Erstickungsgefahr.\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Cul\u003E \u003Cli\u003ESofort lieferbar\u003C\u002Fli\u003E \u003Cli\u003EBeste Ware\u003C\u002Fli\u003E \u003Cli\u003EBeste Preise\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Ch5\u003EGraue Bauplatte\u003C\u002Fh5\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Cp\u003EDiese graue Bauplatte mit 48x48 Noppen ermöglicht viele fantasievolle Bauprojekte. Auf diesem festen grauen Fundament können Kinder zum Beispiel Straßen, Burgen und Gebirge darstellen oder alles aufbauen, was ihnen sonst noch in den Sinn kommt. Auf der griffigen Noppenfläche lassen sich die fertigen Modelle dann auch sicher transportieren und ausstellen.\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cp\u003EKreative Spielwiese: Diese 48x48 Bauplatte dient als Fundament und offene Landschaft für die unterschiedlichsten LEGO® Modelle\u003Cbr\u003E Robust und strapazierfähig: 2.304 Noppen in einem perfekten quadratischen Raster geben den LEGO® Bausteinen festen Halt\u003Cbr\u003E Unzählige kreative Möglichkeiten: Dein Kind kann alles bauen, was ihm in den Sinn kommt, zum Beispiel Straßenkulissen, Burgen oder Gebirge\u003Cbr\u003E Geschenk für jeden Anlass: Das LEGO® Classic Spielzeug Graue Bauplatte (11024) eignet sich als Geburtstags-, Weihnachts- oder Überraschungsgeschenk für Kinder ab 4 Jahren\u003Cbr\u003E Für kreative Spielabenteuer: Die quadratische Bauplatte (38 cm x 38 cm) bietet reichlich Platz für die Bauprojekte und Modelle deines Kindes\u003Cbr\u003E Batterieloses Produkt: Die Fantasie kreativer Kinder reicht völlig\u003Cbr\u003E Eine Bauanleitung wird nicht benötigt: Nimm die Bauplatte einfach aus der Box, um viele Stunden fantasievoll zu spielen\u003Cbr\u003E Kinder lernen beim Spielen: LEGO® Classic Sets fördern die physische Entwicklung und das kreative Denkvermögen\u003Cbr\u003E Die Qualität hat Vorrang: LEGO® Sets erfüllen strenge Branchenstandards, damit sie einheitlich und kompatibel sind und riesigen Bauspaß bieten\u003Cbr\u003E Sicherheit steht an erster Stelle: LEGO® Classic Spielsets werden gründlich getestet, damit jedes Spielzeug die strengen globalen Sicherheits- und Qualitätsstandards erfüllt\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cp\u003EAchtung. Nicht geeignet für Kinder unter 36 Monate. Enthält verschluckbare Kleinteile. Erstickungsgefahr.\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Cp\u003E\u003Cstrong\u003EArt-Nr. KOKA:\u003C\u002Fstrong\u003E K25695 \u003Cstrong\u003E\u003Cbr\u003E\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cp\u003E\u003Cstrong\u003EEAN:\u003C\u002Fstrong\u003E 5702017185279\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cp\u003E\u003Cstrong\u003EHersteller:\u003C\u002Fstrong\u003E LEGO®\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Cp\u003E\u003Cbr\u003E IHRE VORTEILE:\u003Cbr\u003E\u003Cbr\u003E • Sicher einkaufe