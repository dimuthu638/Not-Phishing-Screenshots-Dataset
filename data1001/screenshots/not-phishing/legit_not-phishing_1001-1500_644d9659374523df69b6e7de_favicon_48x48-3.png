":1.5,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F6f\u002F07\u002F085066daa468bd25bdc2cd584d97396340b88bef5a6a94f7d238f50a218e076f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Flashforge"]},"suggestions":["Flashforge","Guider","Printer","FF-3DP-1NG2S-01"]},"meta":{"yategoLegacy":{"productId":"62bea55425cd2","shopId":"60912d237095f3.4","stockId":"62c588adbcf6c","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":280,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T16:36:57+01:00","lastModified":"2023-04-29T02:51:21+02:00"},{"id":"8035507","score":14.96597,"title":"Sigel Glas Magnettafel GL110 48x48 Board Magnetwand Pinnwand Memoboard schwarz","textContent":"\u003Cp\u003ESigel Glas Magnettafel Artverum 48x48cm  \u003Cbr\u003EHochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei extra-starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E \u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E \u003Cli\u003EAnheften von Notizen etc. mit SuperDym- \u002F Neodym-Magneten\u003C\u002Fli\u003E \u003Cli\u003Ebeschreibbar mit Glasboard- und Kreidemarkern\u003C\u002Fli\u003E \u003Cli\u003EMontage im Hoch- oder Querformat möglich\u003C\u002Fli\u003E \u003Cli\u003Erahmenlose Sicherheits-Aufhängung für einen frei schwebenden 3D-Look\u003C\u002Fli\u003E \u003Cli\u003ELieferung inklusive 3 extra-starker SuperDym-Magnete, Bohrschablone und Befestigungsmaterial\u003C\u002Fli\u003E \u003C\u002Ful\u003E Sigel Glas Magnettafel GL110 48x48 Board Magnetwand Pinnwand Memoboard schwarz  \u003Cbr\u003EHochglaenzendes, designpraemiertes Aufhaengung laesst Groesse betraegt \u003Cli\u003EMasse Qürformat moeglich\u003C\u002Fli\u003E Sicherheits-Aufhaengung fuer 6125b7b501d35 ","description":"\u003Cp\u003ESigel Glas Magnettafel Artverum 48x48cm  \u003Cbr\u003EHochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei extra-starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E\n\u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E\n\u003Cli\u003EAnheften von Notizen etc. mit SuperDym- \u002F Neodym-Magneten\u003C\u002Fli\u003E\n\u003Cli\u003Ebeschreibbar mit Glasboard- und Kreidemarkern\u003C\u002Fli\u003E\n\u003Cli\u003EMontage im Hoch- oder Querformat möglich\u003C\u002Fli\u003E\n\u003Cli\u003Erahmenlose Sicherheits-Aufhängung für einen frei schwebenden 3D-Look\u003C\u002Fli\u003E\n\u003Cli\u003ELieferung inklusive 3 extra-starker SuperDym-Magnete, Bohrschablone und Befestigungsmaterial\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Sigel Glas Magnettafel Artverum 48x48cm  Hochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten...","legalAdvice":null,"price":{"rrp":{"savingGross":76.71,"savingPercent":100,"net":64.46,"gross":76.71,"t