on":"2021-09-24"},{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F31\u002F0a\u002Fc262cff1d11bd775bd68b92f5eb206b6724a883d3fa02c9cd75681bf04d50a31-large","height":1500,"width":1500,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F31\u002F0a\u002Fc262cff1d11bd775bd68b92f5eb206b6724a883d3fa02c9cd75681bf04d50a31-medium","height":1440,"width":1440,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F31\u002F0a\u002Fc262cff1d11bd775bd68b92f5eb206b6724a883d3fa02c9cd75681bf04d50a31-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F31\u002F0a\u002Fc262cff1d11bd775bd68b92f5eb206b6724a883d3fa02c9cd75681bf04d50a31-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Sigel"]},"suggestions":["Sigel","48x48","Glas","Magnetboard","GL164","Pinnwand","Magnettafel","Magnetwand","Tafel"]},"meta":{"yategoLegacy":{"productId":"5ff3d44ed224d","shopId":"49ad6885e41569.9","stockId":"644c834c8f834","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":102,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T12:18:10+01:00","lastModified":"2023-04-29T06:44:16+02:00"},{"id":"520262","score":14.703874,"title":"Sigel Glas Magnetboard Artverum GL262 48x48 Glasboard Magnet Tafel bronze","textContent":"\u003Cp\u003EGlas-Magnetboard Artverum, Design Used-Bronze, 48 x 48 cm, 1 Stück - GL263 \u003Cbr\u003EModerner Metallic-Trend für Ihre Räume ein Glas-Magnetboard Artverum ist die etwas andere Wandgestaltung. Das kunstvolle Design Used-Bronze schmückt und verschönert Wohnzimmer, Wartezimmer oder Büro. Mit Kreidemarkern oder Glasboard-Markern können Sie sich Notizen darauf machen oder kleine Nachrichten hinterlassen. Die Metallplatte hinter dem Glas macht die Oberfläche magnethaftend. Achtung: Nur extra-starke Neodym-Magnete halten hier - Kühlschrankmagnete oder ähnliche sind zu schwach. In der Größe 48 x 48 cm eignet sich das Board perfekt für kleinere Wandflächen, z. B. im Eingangsbereich oder als Arbeitshilfe über dem Schreibtisch. Besonders dekorativ wirken die Glastafeln, wenn zwei nebeneinander gehängt werden. Die Montage geht dank der Bohrschablone besonders einfach.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003EDesign: Design Used-Bronze Maße Produkt: 48 x 48 x 1,5 cm Material: Tempered Glas \u002F Sicherheitsglas (ESG) \u003Cbr\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003EDesignprämierte Glas-Magnettafel für Wohnzimmer, Homeoffice oder Büro: magnethaftend, beschreibbar, trocken abwischbar und dekorativ. Nur mit extra-starken Neodym-Magneten magnethaftend.\u003C\u002Fp\u003E \u003Cp\u003EModernes Used-Bronze-Design und schwebender 3D-Look durch rahmenlose Aufhängung Aus Sicherheitsglas (ESG, EN 12150-1) \u003Cbr\u003EIm Lieferumfang enthalten: drei  besonders haftstarke Magnete (Neodym) im Cube-Design Silber. Achtung: Normale Magnete halten nicht!\u003C\u002Fp\u003E \u003Cp\u003EEinfache Montage dank Bohrschablone\u003C\u002Fp\u003E Sigel Glas Magnetboard Artverum GL262 48x48 Glasboard Magnet Tafel bronze  Stueck fuer Raeume schmueckt verschoenert Buero. koennen Oberflaeche Kuehlschrankmagnete aehnliche Groesse fuer Wandflaechen, ueber gehaengt Masse \u003Cp\u003EDesignpraemierte fuer Buero: Aufhaengung 607e2d0c99b89 ","description":"\u003Cp\u003EGlas-Magnetboard Artverum, Design Used-Bronze, 48 x 48 cm