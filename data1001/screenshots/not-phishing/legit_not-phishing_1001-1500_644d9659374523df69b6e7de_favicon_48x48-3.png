l,"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F86\u002F95\u002F8957afa1747f62c8b6540edeadda1f30047e8c02a0c35ac6fcd36e02d12b9586-small","height":258,"width":254,"ratio":0.98,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F86\u002F95\u002F8957afa1747f62c8b6540edeadda1f30047e8c02a0c35ac6fcd36e02d12b9586-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":null,"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fdf\u002Fa0\u002Fe96d74c217d10a358c65244bb2b211c00aae7a8e68cdba5e6df3855a3255a0df-small","height":328,"width":510,"ratio":1.55,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fdf\u002Fa0\u002Fe96d74c217d10a358c65244bb2b211c00aae7a8e68cdba5e6df3855a3255a0df-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F8f\u002Fa9\u002Fe0a3c13f7a8e16466ac134138ea1c8ad60e1a471a2aff448d2d6521d0d52a98f-medium","height":609,"width":641,"ratio":1.05,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F8f\u002Fa9\u002Fe0a3c13f7a8e16466ac134138ea1c8ad60e1a471a2aff448d2d6521d0d52a98f-small","height":608,"width":640,"ratio":1.05,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F8f\u002Fa9\u002Fe0a3c13f7a8e16466ac134138ea1c8ad60e1a471a2aff448d2d6521d0d52a98f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Rudi Schlattner GmbH"]},"suggestions":["KOBRA","FT2H","glasklare","Doppel-Münztaschen","Doppelmünzhüllen","Taschen","48x48","innen"]},"meta":{"yategoLegacy":{"productId":"57e5446bac655","shopId":"4d4bd629d54f94.8","stockId":"582c57bdca6a0","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":101,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T13:17:19+01:00","lastModified":"2022-12-15T16:20:29+01:00"},{"id":"519904","score":16.081755,"title":"Sigel GL404 Glas Magnetboard LED Beleuchtung 48x48 Schiefer Stone Magnet Tafel","textContent":"\u003Cp\u003EGlas-Magnetboard Artverum LED light, Design Schiefer-Stone, 48 x 48 cm - GL404 \u003Cbr\u003EAnthrazitfarbenes, hochglänzendes Glas-Magnetboard Artverum LED light im Design \"Schiefer-Stone\". Das rückseitig rundum beleuchtete Board in der Lichtfarbe Warmweiß mit edler Steinstruktur ist magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Die Stromversorgung läuft über ein 2 Meter langes weißes Kabel inkl. Kabelschalter mit Eurostecker inkl. Transformator. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1) und rückseitig aufgebrachtem Aluminiumprofil mit Diffusor und integriertem LED-Band. Das Leuchtmittel ist fest installiert und kann nicht ausgetauscht werden, die durchschnittliche Leuchtdauer beträgt 25.000 h. Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Aufhängung sorgt für einen sicheren Halt. Die Größe des Boards beträgt 48x48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete, Befestigungsmaterial und Leuchtmittel enthalten.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EDesign: Design Schiefer-Stone\u003C\u002Fli\u003E \u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E \u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Cp\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EGlas-Magnetboard Artverum LED light - einzigartiges Raum-Objekt im Design Schiefer-Stone mit attraktivem LED-Stimmungslicht\u003C\u002Fli\u003E \u003Cli\u003Einklusive Leuchtmittel: LED-Band im Aluminiumprofil auf der Rückseite des Glas-Magnetboards fest installiert, weißes Kabel (2 m) inkl. Kabelschalter und Eurostecker\u003C\u002Fli\u003E \u003Cli\u003EAus Sicherheitsglas: hochwertiges Tempered Glas (ESG, EN 12150-1), magnethaftend und beschreibbar\u003C\u002Fli\u003E \u003Cli\u003EWarmweißes Licht durch LED-Band, Leuchtdauer: ca. 25.000 h, Lichtstrom: 540 lm; Lichtleistung 8,6 W\u003C\u002Fli\u003E \u003Cli\u003Einkl. drei starker SuperDym-Magnete, Befestigungsmaterial und Bohrschablone\u003C\u002Fli\u003E \u003C\u002Ful\u003E Sigel GL404 Glas Magnetboard LED Beleuchtung 48x48 Schiefer Stone Magnet Tafel * Design: Design Schiefer-Stone * Maße Produkt: 48 x 48 x 1,5 cm * Material: Tempered Glas \u002F Sicherheitsglas (ESG) hochglaenzendes rueckseitig Warmweiss laeuft ueber weisses rueckseitig Leuchtdaür betraegt Aufhaengung laesst Aufhaengung fuer Groesse betraegt \u003Cli\u003EMasse Rueckseite weisses \u003Cli\u003EWarmweisses Leuchtdaür: Masse 5ff3d459e37d1 ","description":"\u003Cp\u003EGlas-Magnetboard Artverum LED light, Design Schiefer-Stone, 48 x 48 cm - GL404 \u003Cbr\u003EAnthrazitfarbenes, hochglänzendes Glas-Magnetboard Artverum LED light im Design \"Schiefer-Stone\". Das rückseitig rundum beleuchtete Board in der Lichtfarbe Warmweiß mit edler Steinstruktur ist magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Die Stromversorgung läuft über ein 2 Meter langes weißes Kabel inkl. Kabelschalter mit Eurostecker inkl. Transformator. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1) und rückseitig aufgebrachtem Aluminiumprofil mit Diffusor und integriertem LED-Band. Das Leuchtmittel ist fest installiert und kann nicht ausgetauscht werden, die durchschnittliche Leuchtdauer beträgt 25.000 h. Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die Aufhängung sorgt für einen sicheren Halt. Die Größe des Boards beträgt 48x48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete, Befestigungsmaterial und Leuchtmittel enthalten.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EDesign: Design Schiefer-Stone\u003C\u002Fli\u003E\n\u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E\n\u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cp\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EGlas-Magnetboard Artverum LED light - einzigartiges Raum-Objekt im Design Schiefer-Stone mit attraktivem LED-Stimmungslicht\u003C\u002Fli\u003E\n\u003Cli\u003Einklusive Leuchtmittel: LED-Band im Aluminiumprofil auf der Rückseite des Glas-Magnetboards fest installiert, weißes Kabel (2 m) inkl. Kabelschalter und Eurostecker\u003C\u002Fli\u003E\n\u003Cli\u003EAus Sicherheitsglas: hochwertiges Tempered Glas (ESG, EN 12150-1), magnethaftend und beschreibbar\u003C\u002Fli\u003E\n\u003Cli\u003EWarmweißes Licht durch LED-Band, Leuchtdauer: ca. 25.000 h, Lichtstrom: 540 lm; Lichtleistung 8,6 W\u003C\u002Fli\u003E\n\u003Cli\u003Einkl. drei starker SuperDym-Magnete, Befestigungsmaterial und Bohrschablone\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Glas-Magnetboard Artverum LED light, Design Schiefer-Stone, 48 x 48 cm - GL404 Anthrazitfarbenes, hochglänzendes Glas-Magnetboard Artverum LED light...","legalAdvice":null,"price":{"rrp":{"savingGross":7.780000000000001,"savingPercent":6,"net":