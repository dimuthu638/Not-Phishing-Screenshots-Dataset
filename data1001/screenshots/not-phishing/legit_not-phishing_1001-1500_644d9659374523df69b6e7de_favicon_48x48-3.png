-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F0f\u002F92\u002Fc9135fb036a2982c537213640ac8b0e193b78d127511c5069ad21131a680920f-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["HIP"]},"suggestions":["Zierkissen","Valdez","48x48"]},"meta":{"yategoLegacy":{"productId":"64265818d6952","shopId":"59d78a6377c6a3.9","stockId":"64408d7a7db77","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":72,"deleted":false,"deleteDate":null,"createDate":"2023-04-01T11:30:54+02:00","lastModified":"2023-04-29T11:03:30+02:00"},{"id":"378212","score":16.461008,"title":"Pad Kissen CHAMPAGNE Fellkissen BLAU Kissenhülle 48x48 cm Fell Kissenbezug","textContent":"\u003Ch4\u003EFellkissen Bezug Champagne in Blau von Pad Concept\u003C\u002Fh4\u003E \u003Cul\u003E \u003Cli\u003EPad Kissenhülle CHAMPAGNE in Fell Optik\u003C\u002Fli\u003E \u003Cli\u003EKunstfell aus Polyester in Blau\u003C\u002Fli\u003E \u003Cli\u003EHergestellt in Europa\u003C\u002Fli\u003E \u003Cli\u003EGröße ca. 48 x 48 cm\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E \u003Cp\u003EIn einem wunderschönen, satten Blau setzt die große, quadratische Pad Kissenhülle in jeder Einrichtung einen geschmackvollen Akzent.\u003C\u002Fp\u003E \u003Cp\u003ESie fügt sich optimal in einen klassischen Einrichtungsstil, ergänzt aber ebenso perfekt das gemütliche, moderne Wohnen.\u003C\u002Fp\u003E \u003Cp\u003EDas attraktive Pad Kissen in Fell-Imitat lässt sich mit weiteren Kissen der Serie Champagne zu einer geschmackvollen Kuschellandschaft auf dem Sofa ergänzen. Selbst eine passende Felldecke führen wir im Onlineshop.\u003C\u002Fp\u003E \u003Cp\u003EAls Einzelstück wird die flauschige Pad Kissenhülle zum einzigartigen Eyecatcher in Deiner Wohnlandschaft. Selbstverständlich ist das dekorative Pad Kissen in Fell-Imitat nicht nur zum Ansehen gedacht.\u003C\u002Fp\u003E \u003Cp\u003EDie große Pad Kissenhülle sorgt auf der heimischen Couch für einen behaglichen Fernsehabend und bietet im Bett als zweites Kopfkissen eine kuschelige und warme Kopfstütze.\u003C\u002Fp\u003E \u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E \u003Ctable\u003E \u003Ctr\u003E \u003Ctd\u003EArtikelnummer:\u003C\u002Ftd\u003E \u003Ctd\u003E26.885-12898\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003EMaterial:\u003C\u002Ftd\u003E \u003Ctd\u003EPolyester\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cp\u003EAbmessungen:\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003ECa. 48 x 48 cm\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003EGewicht:\u003C\u002Ftd\u003E \u003Ctd\u003ECa. 310 Gramm \u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003ELieferumfang:\u003C\u002Ftd\u003E \u003Ctd\u003E1 Pad Kissenbezug Champagne Blau 48x48 in Felloptik ohne Inlett\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003C\u002Ftable\u003E \u003Cbr\u003E Blau \u003Cbr\u003E Polyester \u003Cbr\u003E Pad Concept \u003Cbr\u003E 48 x 48 cm \u003Cbr\u003E Kissenhülle \u003Cbr\u003E 48 cm \u003Cbr\u003E 48 cm \u003Cbr\u003E 12898 \u003Cbr\u003E 48 cm \u003Cbr\u003E Champagne \u003Cbr\u003E 310 g Pad Kissen CHAMPAGNE Fellkissen BLAU Kissenhülle 48x48 cm Fell Kissenbezug Mit dem Kuschelkissen von Pad Concept Harmonie und Wärme schenken. Das herrlich blaue Pad Kissen in Fell-Nachahmung sorgt für ... Kissenhuelle \u003Cli\u003EGroesse wunderschoenen, grosse, Kissenhuelle fuegt ergaenzt gemuetliche, laesst ergaenzen. fuehren Einzelstueck Kissenhuelle Selbstverstaendlich grosse Kissenhuelle fuer Kopfstuetze.\u003C\u002Fp\u003E Kissenhuelle Kissenhuelle Waerme blaü fuer 5fcae8aa9a499 26.885-12898","description":"\u003Ch4\u003EFellkissen Bezug Champagne in Blau von Pad Concept\u003C\u002Fh4\u003E\n\u003Cul\u003E\n\u003Cli\u003EPad Kissenhülle CHAMPAGNE in Fell Optik\u003C\u002Fli\u003E\n\u003Cli\u003EKunstfell aus Polyester in Blau\u003C\u002Fli\u003E\n\u003Cli\u003EHergestellt in Europa\u003C\u002Fli\u003E\n\u003Cli\u003EGröße ca. 48 x 48 cm\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E\n\u003Cp\u003EIn einem wunderschönen, satten Blau setzt die große, quadratische Pad Kissenhülle in jeder Einrichtung einen geschmackvollen Akzent.\u003C\u002Fp\u003E\n\u003Cp\u003ESie fügt sich optimal in einen klassischen Einrichtungsstil, ergänzt aber ebenso perfekt das gemütliche, moderne Wohnen.\u003C\u002Fp\u003E\n\u003Cp\u003EDas attraktive Pad Kissen in Fell-Imitat lässt sich mit weiteren Kissen der Serie Champagne zu einer geschmackvollen Kuschellandschaft auf dem Sofa ergänzen. Selbst eine passende Felldecke führen wir im Onlineshop.\u003C\u002Fp\u003E\n\u003Cp\u003EAls Einzelstück wird die flauschige Pad Kissenhülle zum einzigartigen Eyecatcher in Deiner Wohnlandschaft. Selbstverständlich ist das dekorative Pad Kissen in Fell-Imitat nicht nur zum Ansehen gedacht.\u003C\u002Fp\u003E\n\u003Cp\u003EDie große Pad Kissenhülle sorgt auf der heimischen Couch für einen behaglichen Fernsehabend und bietet im Bett als zweites Kopfkissen eine kuschelige und warme Kopfstütze.\u003C\u002Fp\u003E\n\u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E\n\u003Ctable\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EArtikelnummer:\u003C\u002Ftd\u003E\n\u003Ctd\u003E26.885-12898\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003EMaterial:\u003C\u002Ftd\u003E\n\u003Ctd\u003EPolyester\u003C\u002Ftd\u003E\n\u003C\u002Ftr\u003E\n\u003Ctr\u003E\n\u003Ctd\u003E\u003Cp\u003EAbmessungen:\u003C\u002Fp\u003E\u003C\u002Ftd\u003E\n\u003Ctd\u003E\u003Cp\u003ECa. 48 x 48 cm\u003C\u002Fp\u003E\u003C\u002Ftd\u003E\n\u003C\u00