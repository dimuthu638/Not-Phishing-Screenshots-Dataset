F\u002Fwww.yatego.com\u002F_media\u002Fe5\u002F31\u002F362d5328c3ac359917f1d131f1a1a147fd1ef562b0511e44fdf6dc1f020331e5-medium","height":1000,"width":1000,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fe5\u002F31\u002F362d5328c3ac359917f1d131f1a1a147fd1ef562b0511e44fdf6dc1f020331e5-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fe5\u002F31\u002F362d5328c3ac359917f1d131f1a1a147fd1ef562b0511e44fdf6dc1f020331e5-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Pad Concept"]},"suggestions":["Kissen","CHAMPAGNE","Fellkissen","Natur","Kissenhülle","48x48","Fell","Kissenbezug"]},"meta":{"yategoLegacy":{"productId":"61774d033877a","shopId":"5bd0624cd16991.3","stockId":"644c5e4e569d2","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":94,"deleted":false,"deleteDate":null,"createDate":"2023-03-11T05:22:54+01:00","lastModified":"2023-04-29T04:34:58+02:00"},{"id":"3376003","score":16.988277,"title":"Spaarset Adapter Afriso PNG-01 + Gefäßfüller Ulith 400ml (6641#","textContent":"\u003Cp\u003ESpaarset \u003Cbr\u003E\u003Cb\u003EGefäßfüller Ulith\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Ca href=\"https:\u002F\u002Fbilder.afterbuy.de\u002Fimages\u002F52220\u002FSicherheitsdatenblatt_Ulith_Gefaessfueller.pdf\"\u003EHIER FÜR SICHERHEITSDATENBLATT KLICKEN\u003C\u002Fa\u003E \u003Cbr\u003E \u003Cp\u003Efür Ausdehnungsgefäße MAG 400ml Spezial - Adapter für Gefäßfüller AFRISO PNG\"&gt; für Ausdehnungsgefäße MAG \u003Cbr\u003E\u003Cstrong\u003EDer Gefäßfüller ist unentbehrlich wenn Sie Ihr Ausdehnungsgefäß z.B. Heizung \u002F Solar \u002F Trinkwasser überprüfen bzw. mit Spezial Gefäßfüller auffüllen möchten!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EDieser Adapter besteht aus einem Schlauchanschluß , Manometer 0-4bar , einen Spezialanschlußstück für Gefäßfüllflaschen \u003Cbr\u003E\u003Cstrong\u003EDieser Adapter ist nur in Verbindung mit einer Gefäßfüllflasche zur Überprüfung geeignet.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDer Gefässfüller pflegt und dichtet die Gummimembran im MAG und ermöglicht eine einfache und schnelle Druckergänzung!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EIdeal zum Auffüllen Vordruck Heizungsausdehnungsgefäße , Solarausdehnungsgefäße , Brauchwasserausdehnungsgefäße oder Trinkwasserausdehnungsgefäße \u003Cbr\u003E\u003Cstrong\u003EWichtig jedes Ausdehnungsgefäß sollte jährlich mindestens 1x überprüft werden ( Vordruck! ) dazu muß das Ausdehnungsgefäß drucklos sein ( Anlagendruck ) entweder durch absperren Kappenventil + entleeren oder durch trennen von Ihrer bestehenden Anlage!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EBei Trinkwasseraudehnungsgefäße 1.Sicherheitsgruppe Kaltwasser Absperrhahn schliesen \u003Cbr\u003E\u003Cstrong\u003E2. Druck über Warmwasserhahn evtl. Mischbatterie Waschtisch ( öffnen )entweichen lassen !\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E3. Mischbatterie wieder schliesen \u003Cbr\u003E\u003Cstrong\u003E4. Vordruck mit Adapter+Füllflasche überprüfen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003Ewenn fertig mit der Überprüfung = Sicherheitsgruppe Absteller wieder öffnen!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EDiese Spezialfüllflasche ist nur mit dem Spezialadapter ( in unseren Angeboten ) zu verwenden!\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E Spaarset Adapte