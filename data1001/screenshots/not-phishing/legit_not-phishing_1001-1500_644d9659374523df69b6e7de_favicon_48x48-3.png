02Fwww.yatego.com\u002F_media\u002F40\u002Fe5\u002Fe21457bc17001ffa532b52559fca3d2fbe05d9a5016377f312dd81d968aee540-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":"www.froschkoenig24.de\u002Fa-67073\u002F","_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":["aluminium"],"manufacturer":["Best Freizeitmöbel"]},"suggestions":["Alu-Gartenstuhl","klappbar","Romantica","Natur"]},"meta":{"yategoLegacy":{"productId":"6211bde10643e","shopId":"593fedfd37a189.2","stockId":"64489f4e0b0ab","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":67,"deleted":false,"deleteDate":null,"createDate":"2022-11-09T19:48:02+01:00","lastModified":"2023-04-29T09:33:05+02:00"},{"id":"519897","score":14.703874,"title":"Sigel 48x48 Glas Magnetboard GL164 Pinnwand Magnettafel Magnetwand Tafel weiß","textContent":"\u003Cp\u003EGlas-Magnetboard Artverum, Design White-Klinker, 48 x 48 cm \u003Cbr\u003EWeiße, hochglänzende Glas-Magnettafel Artverum im Design \"White-Klinker\". Das Board mit den weißen Ziegelsteinen im modernen Loft-Look ist designprämiert. Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit SIGEL Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt die Glas-Magnettafel frei vor der Wand schweben. Die TÜV- und GS-geprüfte Produktsicherheit und die TÜV-geprüfte Aufhängung sorgen für einen sicheren Halt. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EDesign: Design White-Klinker\u003C\u002Fli\u003E \u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E \u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Cp\u003E\u003Cb\u003EFeatures:\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003Emagnetisch und beschriftbar\u003C\u002Fli\u003E \u003Cli\u003Eanbringbar im Hoch- oder Querformat\u003C\u002Fli\u003E \u003Cli\u003Erahmenlose Aufhängung für einen frei schwebenden 3D-Look\u003C\u002Fli\u003E \u003Cli\u003Einklusive extra starker SuperDym-Magnete\u003C\u002Fli\u003E \u003Cli\u003EAchtung: Normale Magnete halten nicht!\u003C\u002Fli\u003E \u003Cli\u003ESicherheitsglas\u003C\u002Fli\u003E \u003C\u002Ful\u003E Sigel 48x48 Glas Magnetboard GL164 Pinnwand Magnettafel Magnetwand Tafel weiß * Design: Design White-Klinker * Maße Produkt: 48,3 x 48,3 x 2,5 cm * Material: Tempered Glas \u002F Sicherheitsglas (ESG) \u003Cbr\u003EWeisse, hochglaenzende weissen designpraemiert. Aufhaengung laesst TUeV- GS-gepruefte TUeV-gepruefte Aufhaengung fuer Groesse betraegt \u003Cli\u003EMasse Qürformat\u003C\u002Fli\u003E Aufhaengung fuer weiss Masse 5ff3d44ed224d ","description":"\u003Cp\u003EGlas-Magnetboard Artverum, Design White-Klinker, 48 x 48 cm \u003Cbr\u003EWeiße, hochglänzende Glas-Magnettafel Artverum im Design \"White-Klinker\". Das Board mit den weißen Ziegelsteinen im modernen Loft-Look ist designprämiert. Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit SIGEL Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt die Glas-Magnettafel frei vor der Wand schweben. Die TÜV- und GS-geprüfte Produktsicherheit und die TÜV-geprüfte Aufhängung sorgen für einen sicheren Halt. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EArtikelmerkmale:\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EDesign: Design White-Klinker\u003C\u002Fli\u003E\n\u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u