b517e16120fa0a980b03bce0925072ff6c882-small","height":327,"width":640,"ratio":1.96,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F82\u002Fc8\u002F9bdbcd1194736871082de6733d1b517e16120fa0a980b03bce0925072ff6c882-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Rudi Schlattner GmbH"]},"suggestions":["KOBRA","FT2Z","Münzkärtchen","Beschriftungskarten","Doppel","Münztaschen"]},"meta":{"yategoLegacy":{"productId":"57e532ccf3839","shopId":"4d4bd629d54f94.8","stockId":"582c57bc7138e","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":101,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T13:17:16+01:00","lastModified":"2022-12-15T16:20:28+01:00"},{"id":"520297","score":17.702826,"title":"SIGEL GL169 Glas Magnetboard 48x48 cm Schiefer Stone Magnettafel Artverum Tafel","textContent":"\u003Cp\u003ESigel Glas Magnettafel Artverum 48x48cm  \u003Cbr\u003EHochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die TÜV- und GS-geprüfte Produktsicherheit und die TÜV-geprüfte Aufhängung sorgen für einen sicheren Halt. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei extra-starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E \u003Cul\u003E \u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E \u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E \u003Cli\u003EAnheften von Notizen etc. mit SuperDym- \u002F Neodym-Magneten\u003C\u002Fli\u003E \u003Cli\u003Ebeschreibbar mit Glasboard- und Kreidemarkern\u003C\u002Fli\u003E \u003Cli\u003EMontage im Hoch- oder Querformat möglich\u003C\u002Fli\u003E \u003Cli\u003Erahmenlose Sicherheits-Aufhängung für einen frei schwebenden 3D-Look\u003C\u002Fli\u003E \u003Cli\u003ELieferung inklusive 3 extra-starker SuperDym-Magnete, Bohrschablone und Befestigungsmaterial\u003C\u002Fli\u003E \u003Cli\u003EAchtung: Normale Magnete halten nicht!\u003C\u002Fli\u003E \u003C\u002Ful\u003E SIGEL GL169 Glas Magnetboard 48x48 cm Schiefer Stone Magnettafel Artverum Tafel * Maße ca.: 48x48 cm * Design, das für sich spricht, zusätzlich magnethaftend und beschreibbar * rahmenlose Aufhängung * Lieferung ... \u003Cbr\u003EHochglaenzendes, designpraemiertes Aufhaengung laesst TUeV- GS-gepruefte TUeV-gepruefte Aufhaengung fuer Groesse betraegt \u003Cli\u003EMasse Qürformat moeglich\u003C\u002Fli\u003E Sicherheits-Aufhaengung fuer Masse fuer zusaetzlich Aufhaengung 6074e801913ab ","description":"\u003Cp\u003ESigel Glas Magnettafel Artverum 48x48cm  \u003Cbr\u003EHochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten und mit Sigel Markern optimal beschreibbar. Gefertigt aus Sicherheitsglas (ESG, EN 12150-1). Die rahmenlose Aufhängung lässt das Glas-Magnetboard frei vor der Wand schweben. Die TÜV- und GS-geprüfte Produktsicherheit und die TÜV-geprüfte Aufhängung sorgen für einen sicheren Halt. Die Größe des Boards beträgt 48 x 48 cm. Im Lieferumfang sind drei extra-starke SuperDym-Magnete und Befestigungsmaterial enthalten.\u003C\u002Fp\u003E\n\u003Cul\u003E\n\u003Cli\u003EMaße Produkt: 48 x 48 x 1,5 cm\u003C\u002Fli\u003E\n\u003Cli\u003EMaterial: Tempered Glas \u002F Sicherheitsglas (ESG)\u003C\u002Fli\u003E\n\u003Cli\u003EAnheften von Notizen etc. mit SuperDym- \u002F Neodym-Magneten\u003C\u002Fli\u003E\n\u003Cli\u003Ebeschreibbar mit Glasboard- und Kreidemarkern\u003C\u002Fli\u003E\n\u003Cli\u003EMontage im Hoch- oder Querformat möglich\u003C\u002Fli\u003E\n\u003Cli\u003Erahmenlose Sicherheits-Aufhängung für einen frei schwebenden 3D-Look\u003C\u002Fli\u003E\n\u003Cli\u003ELieferung inklusive 3 extra-starker SuperDym-Magnete, Bohrschablone und Befestigungsmaterial\u003C\u002Fli\u003E\n\u003Cli\u003EAchtung: Normale Magnete halten nicht!\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Sigel Glas Magnettafel Artverum 48x48cm  Hochglänzendes, designprämiertes Glas-Magnetboard Artverum.  Magnethaftend mit SuperDym-\u002FNeodym-Magneten...","legalAdvice":null,"price":{"rrp":{"savingGross":8.850000000000009,"savingPercent":9,"net":74.66,"gross":88.84,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":67.22,"gross":79.99,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":1,"surcharge":0,"calculateOnce":0,"deliveryString":"Kurzfristig verfügbar, Lieferzei","deliveryTime":{"type":"unknown","data":[],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":321,"quantityUnit":"Stueck","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"","ean":"4055325835734","isbn":null,"manufacturer":"Sigel","mpn":"Außenlager Sigel","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"220000\u002F221101\u002F221127","tags":[],"mainImage":{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F4d\u002F32\u002F213c3da163f5706648748ddc2bf73419fa339425e5b1eeeaec1bdd0e74a6324d-large","height":2560,"width":2560,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_medi