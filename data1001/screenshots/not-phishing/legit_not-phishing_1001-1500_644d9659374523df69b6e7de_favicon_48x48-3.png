67","isbn":null,"manufacturer":"Afriso","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":null,"tags":[],"mainImage":{"large":null,"medium":null,"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Faf\u002F76\u002Fe5b817022f018517a7b23db1cb01a3ac1275988c03de699c075e040ecc5c76af-small","height":440,"width":500,"ratio":1.14,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Faf\u002F76\u002Fe5b817022f018517a7b23db1cb01a3ac1275988c03de699c075e040ecc5c76af-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Afriso"]},"suggestions":["Gefäßfülladapter","Afriso","0-4bar","PNG-01","Absperrung","schw.Schlauch","(5130"]},"meta":{"yategoLegacy":{"productId":"63a45c0c43099","shopId":"427f6f1b49dd82.6","stockId":"63d0c5344abe2","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":523,"deleted":false,"deleteDate":null,"createDate":"2022-12-22T18:56:22+01:00","lastModified":"2023-04-29T03:55:57+02:00"},{"id":"5962429","score":17.008606,"title":"Pad Kissen CHAMPAGNE Fellkissen Natur Kissenhülle 48x48 Fell Kissenbezug Pad Con","textContent":"\u003Ch4\u003EFellkissen Champagne naturfarbig 48x48 cm\u003C\u002Fh4\u003E \u003Cul\u003E \u003Cli\u003E Kissenbezug aus Kunstfell\u003C\u002Fli\u003E \u003Cli\u003E Farbe: Natur\u003C\u002Fli\u003E \u003Cli\u003E Hergestellt in Europa\u003C\u002Fli\u003E \u003Cli\u003E Größe ca. 48 x 48 cm\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E \u003Cp\u003E Das engagierte, deutsche Label Pad Concept hat es sich zur Aufgabe gemacht, positive Energie in die Wohnungen zu zaubern. Dazu baut es in seinen herrlich frischen und niemals langweiligen Kollektionen auf opulente Farben, moderne Designs und herrliche Stoffe.\u003C\u002Fp\u003E \u003Cp\u003E Doch nicht nur der dekorative Aspekt ist dem Brand aus dem bayrischen Mertingen wichtig. Qualität und Sozialverträglichkeit stehen ebenfalls an erster Stelle. So werden viele seiner Produkte in kleinen, wohl ausgesuchten Handwerksbetrieben hergestellt.\u003C\u002Fp\u003E \u003Cp\u003E Auch das beige Pad Fellkissen ist mit viel Liebe und Leidenschaft entstanden. In seinem neutralen Farbton integriert es sich perfekt, sowohl in eine klassische Wohnungseinrichtung, wie auch in jeden modernen Einrichtungsstil.\u003C\u002Fp\u003E \u003Cp\u003E Die Pad Kissenhülle mit ihrem Fell in Creme verströmt Gemütlichkeit und Wärme. Möchtest Du Deinem Besuch eine Freude bereiten, legst Du das Knuddelkissen aufs Gästebett. Aber natürlich willst Du auch selbst den Kuscheleffekt genießen.\u003C\u002Fp\u003E \u003Cp\u003E Wenn Du nach der Arbeit gemütlich auf dem Sofa liegst und ein Nickerchen machst, kannst Du Deinen Kopf genüsslich ins Flauschefell schmiegen. Oder Du nutzt das Kuschelkissen abends im Bett als zusätzliches Kopfkissen. Unter den Kopf geschoben verbessert es die Sicht auf den Fernseher.\u003C\u002Fp\u003E \u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E \u003Ctable\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Artikelnummer:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cb\u003E26.885-A05\u003C\u002Fb\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Material:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003E80% Polyacryl, 20% Polyester\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003E Abmessungen:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003ECa. 48 x 48 cm\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Gewicht:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003E Ca. 310 Gramm\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Lieferumfang:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cb\u003E1 Kissenhülle Champagne naturfarbig 48x48 cm von pad concept\u003C\u002Fb\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003C\u002Ftable\u003E \u003Cbr\u003E Natur \u003Cbr\u003E Polyacryl, Polyester \u003Cbr\u003E Pad Concept \u003Cbr\u003E 48 x 48 cm \u003Cbr\u003E Kissenhülle \u003Cbr\u003E 48 cm \u003Cbr\u003E 48 cm \u003Cbr\u003E 455455-A05 \u003Cbr\u003E Champagne \u003Cbr\u003E 310 g Pad Kissen CHAMPAGNE Fellkissen Natur Kissenhülle 48x48 Fell Kissenbezug Pad Con Für den kuscheligen Abend auf dem Sofa! In  dieses Kissen in Felloptik kannst Du Dich so richtig schön vergraben. Der helle ... Groesse Qualitaet Sozialvertraeglichkeit Kissenhuelle verstroemt Gemuetlichkeit Waerme. Moechtest Gaestebett. natuerlich geniessen.\u003C\u002Fp\u003E gemuetlich genuesslich zusaetzliches Kissenhuelle Kissenhuelle Kissenhuelle Fuer schoen 61774d033877a 26.885-A05","description":"\u003Ch4\u003EFellkissen Champagne naturfarbig 48x48 cm\u003C\u002Fh4\u003E\n\u003Cul\u003E\n\u003Cli\u003E Kissenbezug aus Kunstfell\u003C\u002Fli\u003E\n\u003Cli\u003E Farbe: Natur\u003C\u002Fli\u003E\n\u003Cli\u003E Hergestellt in Europa\u003C\u002Fli\u003E\n\u003Cli\u003E Größe ca. 48 x 48 cm\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E\n\u003Cp\u003E Das engagierte, deutsche Label Pad Concept hat es sich zur Aufgabe gemacht, positive Energie in die Wohnungen zu zaubern. Dazu baut es in seine