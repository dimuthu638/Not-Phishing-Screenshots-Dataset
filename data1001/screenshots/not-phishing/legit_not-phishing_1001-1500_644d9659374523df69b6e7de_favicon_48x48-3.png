n":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd8\u002Fd4\u002F6aa07c9e07e2f70032f1c2ccf42bc5055371fc9b5bfe8275b3a09ce44d18d4d8-large","height":1772,"width":1772,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd8\u002Fd4\u002F6aa07c9e07e2f70032f1c2ccf42bc5055371fc9b5bfe8275b3a09ce44d18d4d8-medium","height":1440,"width":1440,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd8\u002Fd4\u002F6aa07c9e07e2f70032f1c2ccf42bc5055371fc9b5bfe8275b3a09ce44d18d4d8-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd8\u002Fd4\u002F6aa07c9e07e2f70032f1c2ccf42bc5055371fc9b5bfe8275b3a09ce44d18d4d8-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Sigel"]},"suggestions":["SIGEL","GL169","Glas","Magnetboard","48x48","Schiefer","Stone","Magnettafel","Artverum","Tafel"]},"meta":{"yategoLegacy":{"productId":"6074e801913ab","shopId":"49ad6885e41569.9","stockId":"644c83680c07a","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":102,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T12:19:51+01:00","lastModified":"2023-04-29T06:44:38+02:00"},{"id":"375233","score":17.541573,"title":"Pad Kissen CHAMPAGNE Fellkissen Olive Kissenhülle 48x48 Fell Kissenbezug Pad Con","textContent":"\u003Ch4\u003EFellkissen Champagne im dunklen Oliven Grün 48x48 cm\u003C\u002Fh4\u003E \u003Cul\u003E \u003Cli\u003E Kissenbezug aus Kunstfell\u003C\u002Fli\u003E \u003Cli\u003E Farbe: Olive\u003C\u002Fli\u003E \u003Cli\u003E Hergestellt in Europa\u003C\u002Fli\u003E \u003Cli\u003E Größe ca. 48 x 48 cm\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Ch5\u003EProduktbeschreibung\u003C\u002Fh5\u003E \u003Cp\u003E Im bayerischen Mertingen hat sich vor über zehn Jahren Pad Concept niedergelassen, ein Brand für attraktive Wohnaccessoires. Das junge, deutsche Label, das höchste Ansprüche an Qualität und Sozialverträglichkeit bei der Herstellung seiner Produkte stellt, ist mittlerweile weltbekannt.\u003C\u002Fp\u003E \u003Cp\u003E Es liefert in mehr als 30 Länder Europas, nach Australien und in die USA. Seine große Popularität verdankt Pad Concept aber nicht nur der Qualität seiner Artikel, sondern natürlich im Besonderen seinen liebevoll designeten Wohnaccessoires. Immer anders und herrlich frisch gestalten die Designer jährlich zwei große Kollektionen und eine ganz besondere Weihnachts Edition.\u003C\u002Fp\u003E \u003Cp\u003E Das große Pad Fellkissen in einem dunklen Olivton integriert sich optimal in eine Wohnungseinrichtung der 70er Jahre. Auch im zeitgemäßen, skandinavischen Design fühlt sich die grüne Pad Kissenhülle wohl. Und selbst im klassisch eingerichteten Wohnzimmer findet das Pad Kissen aus der Kollektion Champagne seinen Platz.\u003C\u002Fp\u003E \u003Cp\u003E Da das anpassungsfähige Polster eigentlich in jedem Einrichtungsstil zu Hause ist, eignet es sich perfekt als Geschenk. Wenn Du für einen lieben Freund ein Mitbringsel suchst, liegst Du mit dem Flauschekissen genau richtig.\u003C\u002Fp\u003E \u003Cp\u003E Aber selbstverständlich kannst Du Dich auch selbst im eigenen Wohnzimmer ans behagliche Kuschelkissen schmiegen.\u003C\u002Fp\u003E \u003Ch5\u003EProduktinformation\u003C\u002Fh5\u003E \u003Ctable\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Artikelnummer:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cb\u003E26.885-D40\u003C\u002Fb\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Material:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003E80% Polyacryl, 20% Polyester\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cstrong\u003E Abmessungen:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003ECa. 48 x 48 cm\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Gewicht:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cp\u003E\u003Cb\u003E Ca. 310 Gramm\u003C\u002Fb\u003E\u003C\u002Fp\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003Ctr\u003E \u003Ctd\u003E\u003Cstrong\u003E Lieferumfang:\u003C\u002Fstrong\u003E\u003C\u002Ftd\u003E \u003Ctd\u003E\u003Cb\u003E1 Kissenhülle Champagne olive 48x48 cm von pad concept\u003C\u002Fb\u003E\u003C\u002Ftd\u003E \u003C\u002Ftr\u003E \u003C\u002Ftable\u003E \u003Cbr\u003E Olive \u003Cbr\u003E Polyacryl, Polyester \u003Cbr\u003E Pad Concept \u003Cbr\u003E 48 x 48 cm \u003Cbr\u003E Kissenhülle \u003Cbr\u003E 48 cm \u003Cbr\u003E 48 cm \u003Cbr\u003E 455455-D40 \u003Cbr\u003E Champagne \u003Cbr\u003E 310 g Pad Kissen CHAMPAGNE Fellkissen Olive Kissenhülle 48x48 Fell Kissenbezug Pad Con Tolles weiches Kissen für eine Extra-Kuschelzeit! Das weiche Kissen Champagne von PAD lädt mit seinem Fellcharakter zum Träumen ... Gruen Groesse ueber fuer hoechste Ansprueche Qualitaet Sozialvertraeglichkeit Laender grosse Popularitaet Qualitaet natuerlich jaehrlich grosse grosse zeitgemaessen, fuehlt gruene Kissenhuelle anpassungsfaehige fuer selbstverstaendlich Kissenhuelle Kissenhuelle Kissenhuelle fuer laedt Traeumen 5ea76bac50d6b 26.885-D40","description":"\u003Ch4\u003EFellkissen Champagne im dunklen Oliven Grün 48x48 cm\u003C\u002Fh4\u003E\n\u003Cul\u003E\n\u003Cli\u003E 