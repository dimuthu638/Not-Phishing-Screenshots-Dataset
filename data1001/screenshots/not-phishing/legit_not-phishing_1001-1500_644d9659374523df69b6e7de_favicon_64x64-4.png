2Fbc11cbcd41b84ca9d62648202815df5cfad1bdfaad6ed151bfa63e47fc9b532b-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fed\u002Fe8\u002F51effab5c970fa8caea422c39bb6b8384bc62d4e93b080625381019b385ce8ed-large","height":1999,"width":2000,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fed\u002Fe8\u002F51effab5c970fa8caea422c39bb6b8384bc62d4e93b080625381019b385ce8ed-medium","height":1439,"width":1440,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fed\u002Fe8\u002F51effab5c970fa8caea422c39bb6b8384bc62d4e93b080625381019b385ce8ed-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fed\u002Fe8\u002F51effab5c970fa8caea422c39bb6b8384bc62d4e93b080625381019b385ce8ed-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":["dunkelgrau"],"category":[],"material":["holz"],"manufacturer":["Beliani"]},"suggestions":["Ecksessel","Polsterbezug","dunkelgrau","FEVIK"]},"meta":{"yategoLegacy":{"productId":"6415036509cba","shopId":"4dbeb317820050.8","stockId":"644c565217d84","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":308,"deleted":false,"deleteDate":null,"createDate":"2023-03-19T08:18:16+01:00","lastModified":"2023-04-29T06:10:19+02:00"},{"id":"444532","score":11.714923,"title":"Arobas Guitar Pro 8 Notations-Software","textContent":"\u003Ch5\u003ENotations-Software Guitar Pro 8\u003C\u002Fh5\u003E \u003Cul\u003E \u003Cli\u003EUmfangreiche Tabulator-Software\u003C\u002Fli\u003E \u003Cli\u003EGro?e Sound Datenbank an virtuellen Instrumenten\u003C\u002Fli\u003E \u003Cli\u003EF?r Anf?nger und Profis geeignet\u003C\u002Fli\u003E \u003Cli\u003EDeutsche Sprache verf?gbar\u003C\u002Fli\u003E \u003Cli\u003EAudio-File zur Partitur zuweisbar\u003C\u002Fli\u003E \u003Cli\u003EErstellen Sie Ihre eigenen Partituren\u003C\u002Fli\u003E \u003Cli\u003ELernunterst?tzende Inhalte wie Akkord-Diagramme und Skalen\u003C\u002Fli\u003E \u003Cli\u003EVerbinden Sie Ihre Gitarre ?ber eine externe Soundkarte mit der Software\u003C\u002Fli\u003E \u003Cli\u003EExportieren Sie Ihre Partitur als Dokument, Bild oder Audio-Datei\u003C\u002Fli\u003E \u003C\u002Ful\u003E \u003Cbr\u003E Die Notationssoftware \u003Cstrong\u003EGuitar Pro 8\u003C\u002Fstrong\u003E von Arobas ist eine umfangreiche \u003Cstrong\u003ETabulatur-Editor-Software\u003C\u002Fstrong\u003E f?r Gitarre und weitere Saiteninstrumente, die sich f?r \u003Cstrong\u003EAnf?nger sowie f?r Profis\u003C\u002Fstrong\u003E eignet. Angefangen bei der Erstellung von Partituren bietet Guitar Pro viele Funktionen, mit denen sowohl Anf?nger wie auch erfahrene Musiker ihre instrumentalen F?higkeiten verbessern, eigene Songs komponieren oder auf mehreren Spuren eine \u003Cstrong\u003EBand zur Begleitung\u003C\u002Fstrong\u003E zusammenstellen k?nnen, die das ?ben unterst?tzt. \u003Cbr\u003E \u003Cbr\u003E In der \u003Cstrong\u003EVersion 8\u003C\u002Fstrong\u003E k?nnen Sie zur Partitur ein \u003Cstrong\u003EAudio-File\u003C\u002Fstrong\u003E wie beispielsweise ein Song oder Backingtrack abspielen. Partitur und Audio-File k?nnen dann \u003Cstrong\u003Esynchronisiert\u003C\u002Fstrong\u003E werden - dies ist nicht nur beim ?ben hilfreich sondern auch f?r Unterrichtszwecke um Iiformationen ?ber ein Audiofile mitzugeben. Dazu gibt es ein \u003Cstrong\u003Evisuelles Metronom\u003C\u002Fstrong\u003E als Tempohilfe - das Tempo des Songs kann zu ?bungszwecken schnell und einfach verlangtsamt werden. ?ber das \u003Cstrong\u003Evirtuelle Pedalboard\u003C\u002Fstrong\u003E k?nnen Sie nun Ihre Effektkette ?bersichtlich managen. \u003Cbr\u003E \u003Cbr\u003E W?hlbar sind ?ber 1000 Preset Sounds die im Detail weiter ver?ndert werden k?nnen und eine gro?e Vielfalt an Kl?ngen bietet. \u003Cbr\u003E \u003Cbr\u003E Das virtuelle \u003Cstrong\u003EGriffbrett\u003C\u002Fstrong\u003E (Gitarre, Bass, Banjo und Piano) erleichtert das Lernen von neuen Riffs ma?geblich und veranschaulicht das Spiel ?bersichtlich und leicht verst?ndlich. Im Internet finden sich unz?hlige Tabulatoren zu Songs aus allen Musikrichtungen. Guitar Pro 8 kann zahlreiche Formate wie z.B. gpx, midi, musicxml, ASCII und ptb importieren und exportieren. F?r den Export stehen des weiteren die Formate PDF, PNG, sowie die Audio Formate MP3, WAV, FLAC und Ogg zur Verf?gung \u003Cbr\u003E \u003Cbr\u003E Es k?nnen nun auch alle einzelnen Tracks gleichzeitig - aber separat - in einem einzigen Vorgang exportiert werden. Das polyphone Stimmger?t erm?glicht das Pr?fen der Stimmung mit nur einem Anschlag aller Saiten. \u003Ch5\u003ELieferumfang:\u003C\u002Fh5\u003E \u003Cul\u003E\u003Cli\u003EGuitar Pro 8 DVD-Rom\u003C\u002Fli\u003E\u003C\u002Ful\u003E \u003Cbr\u003E \u003Cbr\u003E Arobas Guitar Pro 8 Notations-Software  virtüllen \u003Cstrong\u003Evisülles \u003Cstrong\u003Evirtülle virtülle neün 6295494d964e3 gitpro8","description":"\u003Ch5\u003ENotations-Software Guitar Pro 8\u003C\u002Fh5\u003E\n\u003Cul\u003E\n\u003Cli\u003EUmfangreiche Tabulator-Software\u003C\u002Fli\u003E\n\u003Cli\u003EGro?e Sound Datenbank an virtuellen Instrumenten\u003C\u002Fli\u003E\n\u003Cli\u003EF?r Anf?nger und Profis geeignet\u003C\u002Fli\u003E\n\u003Cli\u003EDeutsche Sprache verf?gbar\u003C\u002Fli\u003E\n\u003Cli\u003EAudio-File zur Partitur zuweisbar\u003C\u002Fli\u003E\n\u003Cli\u003EErstellen Sie Ihre eigenen Partituren\u003C\u002Fli\u003E\n\u003Cli\u003ELernunterst?tzende Inhalte wie Akkord-Diagramme und Skalen\u003C\u002Fli\u003E\n\u003Cli\u003EVerbinden Sie Ihre Gitarre ?ber eine externe Soundkarte mit der Software\u003C\u002Fli\u003E\n\u003Cli\u003EExportieren Sie Ihre Partitur als Dokument, Bild oder Audio-Datei\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\n\u003Cbr\u003E\nDie Notationssoftware\n\u003Cstrong\u003EGuitar Pro 8\u003C\u002Fstrong\u003E\nvon Arobas ist eine umfangreiche\n\u003Cstrong\u003ETabulatur-Editor-Software\u003C\u002Fstrong\u003E\nf?r Gitarre und weitere Saiteninstrumente, die sich f?r\n\u003Cstrong\u003EAnf?nger sowie f?r Profis\u003C\u002Fstrong\u003E\neignet. Angefangen bei der Erstellung von Partituren bietet Guitar Pro viele Funktionen, mit denen sowohl Anf?nger wie auch erfahrene Musiker ihre instrumentalen F?higkeiten verbessern, eigene Songs komponieren oder auf mehreren Spuren eine\n\u003Cstrong\u003EBand zur Begleitung\u003C\u002Fstrong\u003E\nzusammenstellen k?nnen, die das ?ben unterst?tzt.\n\u003Cbr\u003E\n\u003Cbr\u003E\nIn der\n\u003Cstrong\u003EVersion 8\u003C\u002Fstrong\u003E\nk?nnen Sie zur Partitur ein\n\u003Cstrong\u003EAudio-File\u003C\u002Fstrong\u003E\nwie beispielsweise ein Song oder Backingtrack abspielen. Partitur und Audio-File k?nnen dann\n\u003Cstrong\u003Esynchronisiert\u003C\u002Fstrong\u003E\nwerden - dies ist nicht nur beim ?ben hilfreich sondern auch f?r Unterrichtszwecke um Iiformationen ?ber ein Audiofile mitzugeben. Dazu gibt es ein\n\u003Cstrong\u003Evisuelles Metronom\u003C\u002Fstrong\u003E\nals Tempohilfe - das Tempo des Songs kann zu ?bungszwecken schnell und einfach verlangtsamt werden. ?ber das\n\u003Cstrong\u003Evirtuelle Pedalboard\u003C\u002Fstrong\u003E\nk?nnen Sie nun Ihre Effektkette ?bersichtlich managen.\n\u003Cbr\u003E\n\u003Cbr\u003E\nW?hlbar sind ?ber 1000 Preset Sounds die im Detail weiter ver?ndert werden k?nnen und eine gro?e Vielfalt an Kl?ngen bietet.\n\u003Cbr\u003E\n\u003Cbr\u003E\nDas virtuelle\n\u003Cstrong\u003EGriffbrett\u003C\u002Fstrong\u003E\n(Gitarre, Bass, Banjo und Piano) erleichtert das Lernen von neuen Riffs ma?geblich und veranschaulicht das Spiel ?bersichtlich und leicht verst?ndlich. Im Internet finden sich unz?hlige Tabulatoren zu Songs aus allen Musikrichtungen. Guitar Pro 8 kann zahlreiche Formate wie z.B. gpx, midi, musicxml, ASCII und ptb importieren und exportieren. F?r den Export stehen des weiteren die Formate PDF, PNG, sowie die Audio Formate MP3, WAV, FLAC und Ogg zur Verf?gung\n\u003Cbr\u003E\n\u003Cbr\u003E\nEs k?nnen nun auch alle einzelnen Tracks gleichzeitig - aber separat - in einem einzigen Vorgang exportiert werden. Das polyphone Stimmger?t erm?glicht das Pr?fen der Stimmung mit nur einem Anschlag aller Saiten.\n\u003Ch5\u003ELieferumfang:\u003C\u002Fh5\u003E\n\u003Cul\u003E\u003Cli\u003EGuitar Pro 8 DVD-Rom\u003C\u002Fli\u003E\u003C\u002Ful\u003E\n\u003Cbr\u003E\n\u003Cbr\u003E","shortDescription":"Notations-Software Guitar Pro 8 Umfangreiche Tabulator-Software Gro?e Sound Datenbank an virtuellen Instrumenten F?r Anf?nger und Profis geeignet...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":66.39,"gross":79,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"2-3","deliveryTime":{"type":"unknown","data":[],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":50000,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"gitpro8","ean":"3760104280025","isbn":null,"manufacturer":"Arobas Music","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"150000\u002F153101\u002F153111","tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F67\u002F76\u002F178d6f197b7b31e7717f7fd0f9445be006a6b5ce4c423f787915119bcc707667-medium","height":600,"width":600,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F67\u002F76\u002F178d6f197b7b31e7717f7fd0f9445be006a6b5ce4c423f787915119bcc707667-small","height":600,"width":600,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F67\u002F76\u002F178d6f197b7b31e7717f7fd0f9445be006a6b5ce4c423f787915119bcc707667-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd9\u002Faf\u002F90640037098b75da6440ab7753c29e4468c2f745901dac2eba373fc46542afd9-medium","height":591,"width":600,"ratio":1.02,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd9\u002Faf\u002F90640037098b75da6440ab7753c29e4468c2f745901dac2eba373fc46542afd9-small","height":591,"width":600,"ratio":1.02,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fd9\u002Faf\u002F90640037098b75da6440ab7753c29e4468c2f745901dac2eba373fc46542afd9-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F3a\u002F7a\u002Fcfe501250ea93c20994cf6613b5b4c9b96fda83249f759f8d8da480adac47a3a-medium","height":591,"width":600,"ratio":1.02,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F3a\u002F7a\u002Fcfe501250ea93c20994cf6613b5b4c9b96fda83249f759f8d8da480adac47a3a-small","height":591,"width":600,"ratio":1.02,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F3a\u002F7a\u002Fcfe501250ea93c20994cf6613b5b4c9b96fda83249f759f8d8da480adac47a3a-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Arobas Music"]},"suggestions":["Arobas","Guitar","Notations-Software"]},"meta":{"yategoLegacy":{"productId":"6295494d964e3","shopId":"4b8fe2d9d5e5b2.9","stockId":"63e6e8d656bf1","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":154,"deleted":false,"deleteDate":null,"createDate":"2022-11-22T08:24:34+01:00","lastModified":"2023-04-29T01:43:44+02:00"},{"id":"8378018","score":11.656685,"title":"Ecksessel Polsterbezug hellgrau FEVIK","textContent":"\u003Cp\u003EModernes Eckmodul mit hellgrauem Polsterbezug. Dieses multifunktionale Eckmodul kann sich als eigenständiges Möbelstück in jedem Wohnbereich bewähren. Zudem kann man die Sitzplätze mittels verdeckter Steckverbinder einfach und komfortabel miteinander verbinden, um einen 2-Sitzer oder ein Ecksofa zu erschaffen. In Kombination mit den anderen Modulen dieser Serie können Sie ein langes Sofa oder eine U-förmige Wohnlandschaft kreieren. Die weiche Polsterung auf den Sitz- und Rückenkissen sorgt für ein herrliches Sitzgefühl, so dass Sie jede freie Minute mit Vergnügen auf dem Sessel verbringen werden.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Sofaelement\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Skandinavisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Hellgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusätzliches Material:\u003C\u002Fb\u003E Eichenholz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Schaumstoff\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rechteckig\u003Cbr\u003E\u003Cb\u003EArmlehnen:\u003C\u002Fb\u003E Gerade\u003Cbr\u003E\u003Cb\u003ERückseite mit Polsterbezug:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003ESchutzkappen \u002F Filzgleiter:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EMuster:\u003C\u002Fb\u003E Kein Muster\u003Cbr\u003E\u003Cb\u003ESitzkonstruktion:\u003C\u002Fb\u003E Wellenfederung\u003Cbr\u003E\u003Cb\u003ESchaumstoffdichte:\u003C\u002Fb\u003E 45 kg\u002Fm3\u003Cbr\u003E\u003Cb\u003EAnzahl Sitzplätze:\u003C\u002Fb\u003E 1 Person\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003EHöhe Armlehnen:\u003C\u002Fb\u003E 72 cm\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 76 cm\u003Cbr\u003E\u003Cb\u003EDicke der Polsterauflagen:\u003C\u002Fb\u003E 10 cm\u003Cbr\u003E\u003Cb\u003ESitzhöhe:\u003C\u002Fb\u003E 39 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 76 cm\u003Cbr\u003E\u003Cb\u003EHöhe:\u003C\u002Fb\u003E 80 cm\u003Cbr\u003E\u003Cb\u003ESitzfläche:\u003C\u002Fb\u003E 64x64 cm\u003Cbr\u003E\u003Cb\u003EGewicht:\u003C\u002Fb\u003E 22 kg\u003Cbr\u003E\u003Cb\u003EMax. Belastung p.P:\u003C\u002Fb\u003E 150 kg\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003ESie kaufen:\u003C\u002Fb\u003E 1 x Eckmodul\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EProduktvorteile:\u003C\u002Fb\u003E\u003Cbr\u003E Kann mit anderen Modulen aus der Serie kombiniert werden, Passt ausgezeichnet zu vielen Einrichtungsstilen, Rundumbezug und daher frei im Raum stellbar, Rückenkissen mit abnehmbaren Bezügen, Rutschfester Stand\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EMontage:\u003C\u002Fb\u003E\u003Cbr\u003E Teilweise montiert. 5 - 15 Min.\u003Cbr\u003E\u003Cb\u003EZusatzinformationen:\u003C\u002Fb\u003E Um sicherzustellen, dass die Konstruktion stabil und die Nutzungssicherheit gewährleistet ist, sollte man 2 Wochen nach dem Zusammenbau überprüfen, ob die Ware auch korrekt montiert wurde. Außerdem ist alle 3 Monate zu prüfen, ob die Schrauben richtig festgezogen sind.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPflegeanleitung:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPolyester:\u003C\u002Fb\u003E\u003Cbr\u003E 1.Oberflächen nur mit geeignetem Aufsatz vorsichtig absaugen\u003Cbr\u003E 2.Flecken können mit einem Polsterreiniger, einem angefeuchteten Schwamm oder milden Reinigungsmitteln entfernt werden.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EEichenholz:\u003C\u002Fb\u003E\u003Cbr\u003E 1.Geöltes Holz sollte nach einiger Zeit nachgeölt werden, damit es lange in einem guten Zustand erhalten bleibt\u003Cbr\u003E 2.Feuchte Stellen sofort mit einem weichen Tuch trocken reiben und Dauernässe bei der Reinigung vermeiden\u003Cbr\u003E 3.Bitte ausschließlich milde Reinigungsmittel und weiche Tüchern verwenden. Dabei immer in Richtung der Maserung abwischen.\u003C\u002Fp\u003E Ecksessel Polsterbezug hellgrau FEVIK  hellgraüm eigenstaendiges Moebelstueck bewaehren. Sitzplaetze koennen U-foermige Rueckenkissen fuer Sitzgefuehl, Vergnuegen Sofälement\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusaetzliches Eichenholz\u003Cbr\u003E\u003Cb\u003EFuellmaterial:\u003C\u002Fb\u003E Gerade\u003Cbr\u003E\u003Cb\u003ERueckseite Sitzplaetze:\u003C\u002Fb\u003E Person\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003EHoehe cm\u003Cbr\u003E\u003Cb\u003ESitzhoehe:\u003C\u002Fb\u003E cm\u003Cbr\u003E\u003Cb\u003EHoehe:\u003C\u002Fb\u003E cm\u003Cbr\u003E\u003Cb\u003ESitzflaeche:\u003C\u002Fb\u003E Rueckenkissen Bezuegen, gewaehrleistet ueberpruefen, Ausserdem pruefen, 1.Oberflaechen koennen 1.Geoeltes nachgeoelt Dauernaesse Daürnäße ausschliesslich Tuechern 644b1156d7684 ","description":"\u003Cp\u003EModernes Eckmodul mit hellgrauem Polsterbezug. Dieses multifunktionale Eckmodul kann sich als eigenständiges Möbelstück in jedem Wohnbereich bewähren. Zudem kann man die Sitzplätze mittels verdeckter Steckverbinder einfach und komfortabel miteinander verbinden, um einen 2-Sitzer oder ein Ecksofa zu erschaffen. In Kombination mit den anderen Modulen dieser Serie können Sie ein langes Sofa oder eine U-förmige Wohnlandschaft kreieren. Die weiche Polsterung auf den Sitz- und Rückenkissen sorgt für ein herrliches Sitzgefühl, so dass Sie jede freie Minute mit Vergnügen auf dem Sessel verbringen werden.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDetails:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003ETyp\u003C\u002Fb\u003E Sofaelement\u003Cbr\u003E\u003Cb\u003EStil:\u003C\u002Fb\u003E Skandinavisch\u003Cbr\u003E\u003Cb\u003EFarbe:\u003C\u002Fb\u003E Grau\u003Cbr\u003E\u003Cb\u003EFarbton:\u003C\u002Fb\u003E Hellgrau\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Stoff\u003Cbr\u003E\u003Cb\u003EMaterial:\u003C\u002Fb\u003E Polyester\u003Cbr\u003E\u003Cb\u003EZusätzliches Material:\u003C\u002Fb\u003E Eichenholz\u003Cbr\u003E\u003Cb\u003EFüllmaterial:\u003C\u002Fb\u003E Schaumstoff\u003Cbr\u003E\u003Cb\u003EZusammenstellung:\u003C\u002Fb\u003E 100% Polyester\u003Cbr\u003E\u003Cb\u003EForm:\u003C\u002Fb\u003E Rechteckig\u003Cbr\u003E\u003Cb\u003EArmlehnen:\u003C\u002Fb\u003E Gerade\u003Cbr\u003E\u003Cb\u003ERückseite mit Polsterbezug:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003ESchutzkappen \u002F Filzgleiter:\u003C\u002Fb\u003E Ja\u003Cbr\u003E\u003Cb\u003EMuster:\u003C\u002Fb\u003E Kein Muster\u003Cbr\u003E\u003Cb\u003ESitzkonstruktion:\u003C\u002Fb\u003E Wellenfederung\u003Cbr\u003E\u003Cb\u003ESchaumstoffdichte:\u003C\u002Fb\u003E 45 kg\u002Fm3\u003Cbr\u003E\u003Cb\u003EAnzahl Sitzplätze:\u003C\u002Fb\u003E 1 Person\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EDimensions:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cb\u003EHöhe Armlehnen:\u003C\u002Fb\u003E 72 cm\u003Cbr\u003E\u003Cb\u003ETiefe:\u003C\u002Fb\u003E 76 cm\u003Cbr\u003E\u003Cb\u003EDicke der Polsterauflagen:\u003C\u002Fb\u003E 10 cm\u003Cbr\u003E\u003Cb\u003ESitzhöhe:\u003C\u002Fb\u003E 39 cm\u003Cbr\u003E\u003Cb\u003EBreite:\u003C\u002Fb\u003E 76 cm\u003Cbr\u003E\u003Cb\u003EHöhe:\u003C\u002Fb\u003E 80 cm\u003Cbr\u003E\u003Cb\u003ESitzfläche:\u003C\u002Fb\u003E 64x64 cm\u003Cbr\u003E\u003Cb\u003EGewicht:\u003C\u002Fb\u003E 22 kg\u003Cbr\u003E\u003Cb\u003EMax. Belastung p.P:\u003C\u002Fb\u003E 150 kg\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003ESie kaufen:\u003C\u002Fb\u003E 1 x Eckmodul\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EProduktvorteile:\u003C\u002Fb\u003E\u003Cbr\u003E\nKann mit anderen Modulen aus der Serie kombiniert werden, Passt ausgezeichnet zu vielen Einrichtungsstilen, Rundumbezug und daher frei im Raum stellbar, Rückenkissen mit abnehmbaren Bezügen, Rutschfester Stand\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EMontage:\u003C\u002Fb\u003E\u003Cbr\u003E\nTeilweise montiert. 5 - 15 Min.\u003Cbr\u003E\u003Cb\u003EZusatzinformationen:\u003C\u002Fb\u003E Um sicherzustellen, dass die Konstruktion stabil und die Nutzungssicherheit gewährleistet ist, sollte man 2 Wochen nach dem Zusammenbau überprüfen, ob die Ware auch korrekt montiert wurde. Außerdem ist alle 3 Monate zu prüfen, ob die Schrauben richtig festgezogen sind.\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPflegeanleitung:\u003C\u002Fb\u003E\u003Cbr\u003E\u003Cbr\u003E\u003Cb\u003EPolyester:\u003C\u002Fb\u003E\u003Cbr\u003E\n1.Oberflächen nur mit geeignetem