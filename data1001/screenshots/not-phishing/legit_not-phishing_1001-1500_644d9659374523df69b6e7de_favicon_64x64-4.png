yatego.com\u002F_media\u002F25\u002Fda\u002Fb687b8a85456af9b2cc90ba377236669004361548e1f2eee7b911f5e1769da25-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F25\u002Fda\u002Fb687b8a85456af9b2cc90ba377236669004361548e1f2eee7b911f5e1769da25-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F1c\u002F9e\u002F70a1d59584a019488b553cb04ad427d9bc9cfa3a695758a18ead2ada92769e1c-medium","height":768,"width":768,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F1c\u002F9e\u002F70a1d59584a019488b553cb04ad427d9bc9cfa3a695758a18ead2ada92769e1c-small","height":640,"width":640,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F1c\u002F9e\u002F70a1d59584a019488b553cb04ad427d9bc9cfa3a695758a18ead2ada92769e1c-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":"www.froschkoenig24.de\u002Fa-68950\u002F","_computed":{"attributes":{"tag":[],"size":[],"color":["schwarz"],"category":[],"material":[],"manufacturer":["Siena Garden"]},"suggestions":["Como","Tisch","eckig","64x64","Schwarz","matt","Mosaikoptik"]},"meta":{"yategoLegacy":{"productId":"6247da47db97a","shopId":"593fedfd37a189.2","stockId":"643f62a60de50","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":67,"deleted":false,"deleteDate":null,"createDate":"2022-11-09T19:48:23+01:00","lastModified":"2023-04-29T09:33:38+02:00"},{"id":"99433","score":18.374178,"title":"Gießform aus Kunststoff für Verblendsteinform 64x64 Riemchen Wandverkleidung für Betonplatten RO-1306","textContent":"\u003Cp\u003EForm für Riemchen RO-1306\u003Cbr\u003E 1 Platte 64x64 cm für rustikale Wanddekorationen im Innen- und Außenbereich individuelle Gestaltungsmöglichkeiten einer Wandverkleidung\u003C\u002Fp\u003E \u003Cbr\u003E \u003Cbr\u003E \u003Ch4\u003EForm für Verblendsteine als Betonplatten zur Wandverkleidung\u003C\u002Fh4\u003E \u003Ch5\u003EBeton Gießform aus Kunststoff\u003C\u002Fh5\u003E RO-1306 \u003Cul\u003E \u003Cli\u003ESie suchen nach einer schnellen und besonderen, aber auch preiswerten Art einer Gestaltungsmöglichkeit für Ihren Innen und Außenbereich. Dann haben wir hier die Lösung!  Eine Gießform für die Herstellung von Verblendsteinen zur Dekoration und zur abwechslungsreichen Gestaltung an Fassaden und Haussockel\u003C\u002Fli\u003E \u003Cli\u003EVerkleidung für Zaunsockel und rustikale Mauern\u003C\u002Fli\u003E \u003Cli\u003ESchalungsform für Steinplatten einer dekorativen, rustikalen Wandverkleidung\u003C\u002Fli\u003E \u003Cli\u003Efür rustikale Wanddekorationen im Innenbereich\u003C\u002Fli\u003E \u003Cli\u003Eindividuelle Gestaltungsmöglichkeiten in der Verlegung der Steinplatten möglich, sowie auch eine individuelle Farbgestaltung mit einem Farbanstrich möglich   \u003C\u002Fli\u003E \u003C\u002Ful\u003E Mit dieser Form stellen Sie selbst Ihre Verblendsteine in Beton für den Außenbereich oder aus Gips für den Innenbereich her! Für den Außenbereich verwendet wegen der benötigten Frostsicherheit der Verblender, handelsüblichen Zement- oder Betonmörtel in grauer Farbe oder eine Mischung aus Weißzement und feinen Sand. Für die farbige Gestaltung werden der Betonmischung Farbpigmente zugesetzt, um einen Natursteincharakter zu erzielen. Oder man verwendet für eine nachträgliche, farbige Patinierung der Verblendsteine eine Wasserlasur mit Bindemitteln (z.B. Tiefgrund) und trägt diese mit Pinsel und Schwamm in einer Wischtechnik auf. So können Sie selbst die Farbe, Intensität und Gestaltung Ihrer Verblendsteine dekorativ gestalten. Auch ein überstreichen mit Fassadenfarbe ist möglich.    \u003Cbr\u003E Wir führen ein umfangreiches Sortiment an verschiedenen Formen für Verblendsteine und Riemchen! \u003Cbr\u003E   Formenplatte ist als ganze Platte im Maß von 64x64cm, dann auch als fertige Betonplatte an der Wand verlegbar! Sie müssen nicht erst aufwendig alle Riemchen einzeln an der Wand verlegen! Das bedeutet eine enorme Zeitersparnis beim verlegen, da sie nicht aufwendig alle einzelnen Fugen zwischen den einzelnen Riemchensteinen extra verfugen müssen!  \u003Cbr\u003E Wir führen ein umfangreiches Sortiment an verschiedenen Formen für Verblendsteine und Riemchen!  \u003Cbr\u003E Maße des fertigen Verblendsteines: \u003Cul\u003E \u003Cli\u003EBreite x Länge:  64x64 cm\u003C\u002Fli\u003E \u003Cli\u003EHöhe: ca. 2,5 cm\u003C\u002Fli\u003E \u003C\u002Ful\u003E INFO-CD-ROM \u003Cul\u003E \u003Cli\u003EDetaillierte Arbeitsanleitungen mit Bildern zum arbeiten mit Balustradenformen!\u003C\u002Fli\u003E \u003Cli\u003EHinweise zur Betonherstellung, Vergussmörtel, Betonzusätze\u003C\u002Fli\u003E \u003Cli\u003EVerwendung von Trennmitteln, Schalöl\u003C\u002Fli\u003E \u003Cli\u003ELieferübersicht mit Fotos von allen lieferbaren Formen!   \u003C\u002Fli\u003E \u003Cli\u003EWichtige Hinweise zum Aufbau eines kompletten Balustradengeländers!\u003C\u002Fli\u003E \u003Cli\u003EVerwendung von Betoneisen, Dornen, Kleber \u003C\u002Fli\u003E \u003Cli\u003EVorschläge mit Bildern und Materialhinweise zur farblichen Gestaltung eines Balustradengeländers\u003C\u002Fli\u003E \u003Cli\u003EWeiterhin auch auf CD ein Katalog zu lieferbaren Gartenfiguren, Putten, Gartenbrunnen, japanischen Steinlaternen, Säulen, Pfeiler und vieles mehr.\u003C\u002Fli\u003E \u003C\u002Ful\u003E Gießform aus Kunststoff für Verblendsteinform 64x64 Riemchen Wandverkleidung für Betonplatten RO-1306 verblener, riemchen, Steine, Platten, Plattenform, Wanddekoration, Balustraden \u003E Beton Gießformen \u003E Verblender Wandverkleidung ... fuer fuer Aussenbereich individülle Gestaltungsmoeglichkeiten fuer Giessform Gestaltungsmoeglichkeit fuer Aussenbereich. Loesung!  Giessform fuer fuer Maürn\u003C\u002Fli\u003E fuer \u003Cli\u003Efuer \u003Cli\u003Eindividülle Gestaltungsmoeglichkeiten moeglich, individülle moeglich  fuer Aussenbereich fuer Fuer Aussenbereich benoetigten handelsueblichen Betonmoertel graür Weisszement Fuer fuer nachtraegliche, traegt koennen Intensitaet ueberstreichen moeglich.  fuehren fuer Mass muessen muessen!  fuehren fuer Masse Laenge:  \u003Cli\u003EHoehe: Vergussmoertel, Betonzusaetze\u003C\u002Fli\u003E Schaloel\u003C\u002Fli\u003E \u003Cli\u003ELieferuebersicht Balustradengelaenders!\u003C\u002Fli\u003E \u003Cli\u003EVorschlaege Balustradengelaenders\u003C\u002Fli\u003E Saeulen, Giessform fuer fuer Giessformen 5efbbcca52e75 259 RO-1306","description":"\u003Cp\u003EForm für Riemchen RO-1306\u003Cbr\u003E\n1 Platte 64x64 cm für rustikale Wanddekorationen im Innen- und Außenbereich individuelle Gestaltungsmöglichkeiten einer Wandverkleidung\u003C\u002Fp\u003E\n\u003Cbr\u003E\n\u003Cbr\u003E\n\u003Ch4\u003EForm für Verblendsteine als Betonplatten zur Wandverkleidung\u003C\u002Fh4\u003E\n\u003Ch5\u003EBeton Gießform aus Kunststoff\u003C\u002Fh5\u003E\nRO-1306\n\u003Cul\u003E\n\u003Cli\u003ESie suchen nach einer schnellen und besonderen, aber auch preiswerten Art einer Gestaltungsmöglichkeit für Ihren Innen und Außenbereich. Dann haben wir hier die Lösung!  Eine Gießform für die Herstellung von Verblendsteinen zur Dekoration und zur abwechslungsreichen Gestaltung an Fassaden und Haussockel\u003C\u002Fli\u003E\n\u003Cli\u003EVerkleidung für Zaunsockel und rustikale Mauern\u003C\u002Fli\u003E\n\u003Cli\u003ESchalungsform für Steinplatten einer dekorativen, rustikalen Wandverkleidung\u003C\u002Fli\u003E\n\u003Cli\u003Efür rustikale Wanddekorationen im Innenbereich\u003C\u002Fli\u003E\n\u003Cli\u003Eindividuelle Gestaltungsmöglichkeiten in der Verlegung der Steinplatten möglich, sowie auch eine individuelle Farbgestaltung mit einem Farbanstrich möglich   \u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\nMit dieser Form stellen Sie selbst Ihre Verblendsteine in Beton für den Außenbereich oder aus Gips für den Innenbereich her! Für den Außenbereich verwendet wegen der benötigten Frostsicherheit der Verblender, handelsüblichen Zement- oder Betonmörtel in grauer Farbe oder eine Mischung aus Weißzement und feinen Sand. Für die farbige Gestaltung werden der Betonmischung Farbpigmente zugesetzt, um einen Natursteincharakter zu erzielen. Oder man verwendet für eine nachträgliche, farbige Patinierung der Verblendsteine eine Wasserlasur mit Bindemitteln (z.B. Tiefgrund) und trägt diese mit Pinsel und Schwamm in einer Wischtechnik auf. So können Sie selbst die Farbe, Intensität und Gestaltung Ihrer Verblendsteine dekorativ gestalten. Auch ein überstreichen mit Fassadenfarbe ist möglich.   \n\u003Cbr\u003E\nWir führen ein umfangreiches Sortiment an verschiedenen Formen für Verblendsteine und Riemchen!\n\u003Cbr\u003E\n  Formenplatte ist als ganze Platte im Maß von 64x64cm, dann auch als fertige Betonplatte an der Wand verlegbar! Sie müssen nicht erst aufwendig alle Riemchen einzeln an der Wand verlegen! Das bedeutet eine enorme Zeitersparnis beim verlegen, da sie nicht aufwendig alle einzelnen Fugen zwischen den einzelnen Riemchensteinen extra verfugen müssen! \n\u003Cbr\u003E\nWir führen ein umfangreiches Sortiment an verschiedenen Formen für Verblendsteine und Riemchen! \n\u003Cbr\u003E\nMaße des fertigen Verblendsteines:\n\u003Cul\u003E\n\u003Cli\u003EBreite x Länge:  64x64 cm\u003C\u002Fli\u003E\n\u003Cli\u003EHöhe: ca. 2,5 cm\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E\nINFO-CD-ROM\n\u003Cul\u003E\n\u003Cli\u003EDetaillierte Arbeitsanleitungen mit Bildern zum arbeiten mit Balustradenformen!\u003C\u002Fli\u003E\n\u003Cli\u003EHinweise zur Betonherstellung, Vergussmörtel, Betonzusätze\u003C\u002Fli\u003E\n\u003Cli\u003EVerwendung von Trennmitteln, Schalöl\u003C\u002Fli\u003E\n\u003Cli\u003ELieferübersicht mit Fotos von allen lieferbaren Formen!   \u003C\u002Fli\u003E\n\u003Cli\u003EWichtige Hinweise zum Aufbau eines kompletten Balustradengeländers!\u003C\u002Fli\u003E\n\u003Cli\u003EVerwendung von Betoneisen, Dornen, Kleber \u003C\u002Fli\u003E\n\u003Cli\u003EVorschläge mit Bildern und Materialhinweise zur farblichen Gestaltung eines Balustradengeländers\u003C\u002Fli\u003E\n\u003Cli\u003EWeiterhin auch auf CD ein Katalog zu lieferbaren Gartenfiguren, Putten, Gartenbrunnen, japanischen Steinlaternen, Säulen, Pfeiler und vieles mehr.\u003C\u002Fli\u003E\n\u003C\u002Ful\u003E","shortDescription":"Form für Riemchen RO-1306 1 Platte 64x64 cm für rustikale Wanddekorationen im Innen- und Außenbereich individuelle Gestaltungsmöglichkeiten einer...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":40.25,"gross":47.9,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":5.1,"surcharge":0,"calculateOnce":1,"deliveryString":"8 Tage","deliveryTime":{"type":"exact-day","data":[8],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":6,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"259 RO-1306","ean":"4251519814053","isbn":null,"manufacturer":null,"mpn":"RO-1306","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":null,"tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u