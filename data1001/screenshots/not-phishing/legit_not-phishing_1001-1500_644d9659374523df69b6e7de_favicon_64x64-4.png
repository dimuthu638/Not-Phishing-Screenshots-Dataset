sion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"4-5 Werktage","deliveryTime":{"type":"work-day-range","data":[4,5],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":-1,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"33583","ean":"4549292133622","isbn":null,"manufacturer":"Canon","mpn":"3513C004AA","objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":null,"tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F48\u002Fbb\u002Fcad3b0049bd2faf6940872e3977804cbae8ce983d0a2526b761d2fd41583bb48-medium","height":600,"width":800,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F48\u002Fbb\u002Fcad3b0049bd2faf6940872e3977804cbae8ce983d0a2526b761d2fd41583bb48-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F48\u002Fbb\u002Fcad3b0049bd2faf6940872e3977804cbae8ce983d0a2526b761d2fd41583bb48-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F59\u002Fa7\u002Fcd38c32783cfaff66cc02749ce9145238320533ad1663201a764e9545423a759-medium","height":600,"width":800,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F59\u002Fa7\u002Fcd38c32783cfaff66cc02749ce9145238320533ad1663201a764e9545423a759-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F59\u002Fa7\u002Fcd38c32783cfaff66cc02749ce9145238320533ad1663201a764e9545423a759-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F64\u002F6c\u002F32dfbcef64b56adc8b02d024add238ac4b405ab50b4dcb133e11ae1b12eb6c64-medium","height":600,"width":800,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F64\u002F6c\u002F32dfbcef64b56adc8b02d024add238ac4b405ab50b4dcb133e11ae1b12eb6c64-small","height":480,"width":640,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002F64\u002F6c\u002F32dfbcef64b56adc8b02d024add238ac4b405ab50b4dcb133e11ae1b12eb6c64-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"}],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Canon"]},"suggestions":["Canon","i-SENSYS","MF542x","Multifunktionsdrucker","Laser","3513C004AA"]},"meta":{"yategoLegacy":{"productId":"62beab24890b0","shopId":"60912d237095f3.4","stockId":"644710bcd37ce","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":280,"deleted":false,"deleteDate":null,"createDate":"2023-04-07T02:00:33+02:00","lastModified":"2023-04-29T02:52:30+02:00"},{"id":"1021917","score":5.8942127,"title":"Microsoft Office 2019 Home and Student- 1PC - 32&64 Bit - Vollversion - Email Express Versand -","textContent":"\u003Ch5\u003E Microsoft Office 2019 Home and Student -Vollversion - 1PC - 32&amp;64 Bit für Windows 10\u003C\u002Fh5\u003E \u003Cp\u003E\u003Cb\u003ESie erwerben hier das \"neue\" Office 2019 Home and Student für 1 PC ( Windows 10 ) und zur online Aktivierung, die Online Aktivierung und generelle Aktivierung wird garantiert !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EEs ist kein Microsoft Konto erforderlich und der Zugang zur dazugehörenden Software wird durch von uns zugesendete Download Links gewährleistet und zur Verfügung gestellt.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E!!!!! Wenn Sie die Software werktags zwischen 9-16 Uhr unserer Bürozeit erwerben wird Ihnen die Email binnen der nächsten 30 Minuten - 1 Stunde an die von Ihnen hier hinterlegte Email Adresse zugestellt. Für alle Bestellungen nach 16 Uhr gilt das Sie die Email bis 9 Uhr des folgenden Tages in Ihrem Email Postfach vorfinden !!!!\u003C\u002Fp\u003E \u003Cp\u003EAuch am Wochenende sind wir für Sie da und versenden Ihre Käufe so schnell es irgend geht meist binnen 6-12 Stunden oder eher....!!!!\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003E100 % originale und legale Microsoft Software vom Experten, sicher und kompetent einkaufen !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Ch4\u003E Beschreibung\u003C\u002Fh4\u003E \u003Cdiv\u003E \u003Cdiv\u003E\u003Ch4\u003EProduktinformationen \"Microsoft Office 2019 Home and Student\"\u003C\u002Fh4\u003E\u003C\u002Fdiv\u003E \u003Cdiv\u003E \u003Cp\u003EZu Hause und als Student arbeiten - mit Office 2019 Home and Student Ideal geeignet für Privatanwender: Office 2019 Home and Student \u003Cbr\u003EDie wertvollsten Bestandteile für alle, die von zu Hause aus arbeiten: All das verbindet Office 2019 in der Home and Student-Edition. Es handelt sich um eine Programm für genau ein Gerät, welches die Programme Word, Excel und PowerPoint beinhaltet. OneNote steht über den Windows Store in Windows 10 zum Download bereit. Daten speichern Anwender entweder offline direkt auf dem Computer oder auch online in der Cloud durch die Verwendung von OneDrive oder ähnlichen Anbietern. \"Zu Hause oder in der Schule mehr erledigen\": Das ist das Motto von Microsoft, das mit dieser Edition von Office 2019 auch eingehalten werden kann.\u003C\u002Fp\u003E \u003Cp\u003EProfessionell aussehende Dokumente lassen sich in Word 2019 nun effektiver gestalten: Bearbeitung und Überprüfung des Inhalts des Ausdrucks am Drucker geschehen in einem Arbeitsgang. Zusätzlich ist die aus dem Vorgänger bekannte Suchfunktion inbegriffen, sodass Anfänger schnell Zugriff auf alle wichtigen Funktionen in Word 2019 erhalten. Komplett neu enthalten in der Version in Office 2019 Home and Student ist außerdem die Integration von SVG-Grafiken, die sich einfacher skalieren und verschieben lassen als etwa JPG- oder PNG-Grafiken. Alle, die mit einem Stift auf einem Touchscreen schreiben, freuen sich außerdem über eine verbesserte Schrifterkennung. Das ist vor allem beim Festhalten von Notizen hilfreich.\u003C\u002Fp\u003E \u003Cp\u003EFür Präsentationen wie geschaffen ist hingegen PowerPoint 2019: Das bekannte Werkzeug erlaubt die Gestaltung von Folien und kompletten Präsentationen auf einem professionellen Niveau. Ideen und Informationen lassen sich dadurch optisch und auch akustisch ansprechender darstellen. Neu in PowerPoint in Office 2019 ist die Verwendung von Aufnahmen in Ultra-HD-Auflösung, sodass 4K-Videos jetzt flüssig in die Folien integriert werden können. Eine verbesserte Unterstützung für Zoomen und Skalierung bestehender Fotos oder anderer Grafiken machen außerdem den Kauf von zusätzlichen Programmen für die Bildbearbeitung überflüssig. Von einfachen Folien bis zu mehreren Seiten langen Folien ist PowerPoint 2019 das geeignete Tool.\u003C\u002Fp\u003E \u003Cp\u003EMit Excel 2019 steht Käufern dieses Programms hingegen die bekannte Applikation für die Verwaltung von Tabellen bereit. Daten jeglicher Art lassen sich einfach und intuitiv eintragen und optisch aufbereiten. Tastenkombinationen erlauben den schnellen Zugriff auf die wichtigsten Funktionen für Nutzer, die täglich mit Excel arbeiten. Verbessert in der neuen Version sind unter anderem die mathematischen Funktionen, die jetzt in größerer Anzahl im Paket enthalten sind. Außerdem stellt die Applikation neue Methoden zur Verfügung, um Daten optisch ansprechend darzustellen und somit ein Werkzeug für die Visualisierung bereitzustellen. Dadurch sparen alle Nutzer Zeit und freuen sich dennoch über den bekannten Arbeitsfluss mit Excel.\u003C\u002Fp\u003E \u003Cp\u003EOneNote ist in Office 2019 Home and Student kein fester Bestandteil des Pakets mehr. Stattdessen können sich Interessenten das Programm im Windows Store herunterladen. Weiterhin hat Microsoft die Kompatibilität mit allen älteren Versionen von Windows entfernt. Auf dem Gerät muss zwingend Windows 10 installiert sein, um die Vorteile von Office 2019 und allen enthaltenen Anwendungen zu nutzen. Es handelt sich hierbei um ein dauerhaft nutzbares Programmpaket, welches für mindestens fünf Jahre von Microsoft mit Updates versorgt wird. Anders als bei Office 365 fallen keinerlei Abo-Gebühren an. Die Sicherung von Daten in OneDrive erzeugt eventuell Kosten.\u003C\u002Fp\u003E \u003Cdiv\u003E \u003Cp\u003EBetriebssystem:Windows 10Arbeitsspeicher:mindestens 2 GB RAMFestplatte:mindestens 3 GB verfügbarer SpeicherplatzBildschirm:mindestens 1.024 * 768 Pixel AuflösungGrafikkarte: DirectX 10-Unterstützung benötigt für GPU-beschleunigtes InterfaceBrowser:aktuelle Versionen von Internet Explorer, Chrome, Firefox, Microsoft Edge oder Safari.NET-Version:mindestens .NET-Version 3.5 \u003Cbr\u003E\u003Cb\u003EDas Computerprogramm wird online aktiviert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EEs handelt sich um ein\u003C\u002Fstrong\u003E\u003Cstrong\u003E100 % Original Microsoft Produkt.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003ESie erhalten nach dem Kauf :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EDen Downloadlink zur Vollversion des Computerprogramms \u003Cbr\u003E\u003Cb\u003Eincl. dem Produktschlüssel zur Aktivierung per Email an Ihre hier bei Yatego hinterlegte Email Adresse.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003ERechnung mit ausgewiesener MwSt auf Ihren Namen.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cdiv\u003E \u003Cp\u003E\u003Cstrong\u003E* ZUR BEACHTUNG:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cdiv\u003E\u003Cdiv\u003E\u003Cdiv\u003E \u003Cp\u003E Die Nutzung des Programmes auf einem anderen z.B. neu erworbenen Rechner der gegen den alten Rechner auf dem dem das Computerprogramm ursprünglich installiert war ausgetauscht wurde oder aber auch nach Wechsel des Betriebssystems ist laut Microsoft nicht möglich!\u003C\u002Fp\u003E \u003Cp\u003EDie Nutzungsdauer ist hierbei unbegrenzt, solange das Produkt auf dem gleichen Gerät genutzt wird. Sollte der Rechner neu formatiert werden, neu aufgesetzt werden oder es werden eventuelle Änderungen an der Hardware vorgenommen, so besteht keine Gewährleistung mehr, dass es auch weiterhin auf dem PC funktioniert.\u003C\u002Fp\u003E \u003Cdiv\u003E\u003Cdiv\u003E \u003Ch5\u003EEin Softwarehersteller kann sich dem Weiterverkauf seiner gebrauchten Lizenzen, die die Nutzung seiner aus dem Internet heruntergeladenen Programme ermöglichen, nicht widersetzen.\u003C\u002Fh5\u003E \u003Cp\u003EAus der Pressemitteilung Nr. 94\u002F12 zum Urteil in der Rechtssache C-128\u002F11 des Gerichtshof der Europäischen Union (EuGH):\u003C\u002Fp\u003E \u003Cblockquote\u003EDer Handel mit gebrauchter Computersoftware wurde vom obersten rechtssprechenden Organ der EU, dem Europäischen Gerichtshof (EuGH), als rechtsmäßig erklärt. Somit herrscht nun endgültige Klarheit über den Gebrauchthandel mit Software, unbedeutend ob es sich um online übertragene oder auf physischen Datenträgern ausgelieferte Software handelt.\u003C\u002Fblockquote\u003E \u003Cp\u003EAm 17.07.2013 wurde diese Grundsatzentscheidung des EuGH durch den BGH vollumfänglich bestätigt.\u003Cbr\u003E Das Aufsplitten von Volumenlizenzen unterliegt ebenfalls den Beschlüssen des EuGH.\u003C\u002Fp\u003E \u003Cp\u003EDass der Erschöpfungsgrundsatz bei jedem erstmaligen Verkauf einer Software gilt, wurde durch die 13 Richter der obersten Kammer bestätigt. Darüber hinaus wurde verfügt, dass Zweiterwerber von online übertragenen Lizenzen die Software direkt beim Hersteller erneut herunterladen dürfen \u003Cbr\u003EAußerdem erstreckt sich die Erschöpfung des Verbreitungsrechts auf die Programmkopie in der \"vom Urheberrechtsinhaber verbesserten und aktualisierten Fassung\", so der EuGH. Damit wurde nicht nur der Schlussantrag des EuGH-Generalanwalts vom 24. April 2012 vollständig bestätigt, sondern sogar noch erweitert.\u003C\u002Fp\u003E \u003Cp\u003EDieses Urteil des EuGH folgte auf eine Anfrage des BGH, da die Softwarehersteller die gesetzlich nicht eindeutigen Regelungen ausgenutzt haben, um den Handel einzuschränken und die Kunden einzuschüchtern - ungeachtet des Grundsatzes, der den Weiterverkauf von bereits einmal verwendeter Software schon vorher für legal deklarierte.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003E§§§ Gesetzliches &amp; Rechtliches §§§\u003C\u002Fstrong\u003E\u003Cstrong\u003E zur Information :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EWir verkaufen hier einen rechtmäßig erworbenen Artikel\u003Cbr\u003E und haben sämtliche Kopien des Artikels von all unseren Geräten, Datenträgern und sonstigen Speicherorten einschließlich Cloud-Diensten entfernt oder unbrauchbar gemacht, so wie es die höchstrichterliche Rechtsprechung erfordert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Ch5\u003E\u003Cb\u003EDesweiteren sind die Voraussetzungen des Art. 5 Abs. 1 der Richtlinie 2009\u002F24\u002FEG zum Erwerb einer \"erschöpften Programmkopie\" erfüllt, mit dem Erwerb des jeweiligen Produktes erlangen Sie die Möglichkeit zur sachgemäßen Nutzung des Computerprogramms.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E \u003Cp\u003EDer Umfang der erworbenen Nutzungsrechte richtet sich nach den jeweils geltenden Lizenzbedingungen des Rechteinhabers, soweit sie nicht gesetzlichen Bestimmungen widersprechen. Zu den Lizenzbedingungen gehören insbesondere die End User License Agreements (EULA), die bei Installation der Software abgerufen werden, sowie die Product Use Rights (PUR), die auf der Rechteinhaber-Homepage bereitgestellt werden.\u003C\u002Fp\u003E \u003Ch5\u003E\u003Cb\u003EWir machen ausdrücklich darauf aufmerksam, das sich erst mit dem Download ( der Installation der Software auf Ihrem Rechner ) und der sich daraus gebildeten Akzeptanz der jeweiligen gültigen Nutzungsbedingungen des Herstellers ( Microsoft ) eine Lizenz für das jeweilige Computerprogramm bildet, welche das Nutzungsrecht zwischen Ihnen und dem jeweiligen Hersteller ( hier Microsoft ) regelt.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E \u003Cp\u003EDarüber hinaus ist es Ihnen untersagt, den Key auf mehreren Geräten zu aktivieren, siehe ebenso Microsoft Nutzungsbedingungen ( microsoft ). Siehe auch Microsoft Datenschutzerklärung (microsoft ).\u003C\u002Fp\u003E \u003Cp\u003EDie jeweils aktuell gültigen Lizenzbedingungen für Ihr Produkt entnehmen Sie bitte den Hinweisen auf der Microsoft Website unter microsoft.com \u003Cbr\u003E\u003Cb\u003E!!!!!!!ACHTUNG!!!!!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cdiv\u003E Rechtliche Informationen Microsoft Trademarks. Alle Markenrechte für rechtsgeschütze Namen liegen bei dem jeweiligen Rechteinhaber, hier bei Microsoft Corporation. Alle graphischen Elemente, Logos, Icons etc. dienen nur zur Beschreibung des Angebots und der verständlichen Darstellung. Alle innerhalb des Internetangebotes genannten und ggf. durch Dritte geschützten Marken- und Warenzeichen unterliegen uneingeschränkt den Bestimmungen des jeweils gültigen Kennzeichenrechts und den Besitzrechten der jeweiligen eingetragenen Eigentümer. Weitere Informationen zur ordnungsgemäßen Verwendung von Microsoft Trademarks sind direkt bei Microsoft Corporation zu finden.\u003Cbr\u003E \u003C\u002Fdiv\u003E \u003Cp\u003E Das Urheberrecht der verwendeten Darstellungen, Artikelbeschreibungen und sämtlichem Textinhalt liegt insoweit nicht anders gekennzeichnet bei uns, eine Verwendung in jeglicher Form bedarf der ausdrücklichen Genehmigung unsererseits.\u003C\u002Fp\u003E \u003Cdiv\u003EDesweiteren sind wir zertifiziertes Mitglied im Verband des Deutschen Händlerschutzes.\u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E Microsoft Office 2019 Home and Student- 1PC - 32&64 Bit - Vollversion - Email Express Versand - Microsoft Office 2019 Home and Student -Vollversion - 1PC - 32&64 Bit für Windows 10Sie erwerben hier das ... fuer \"neü\" fuer dazugehoerenden gewaehrleistet Verfuegung Buerozeit naechsten Fuer fuer Kaeufe fuer fuer fuer Geraet, ueber aehnlichen Ueberpruefung Zusaetzlich Vorgaenger Anfaenger ausserdem freün ausserdem ueber \u003Cp\u003EFuer Praesentationen Praesentationen Ultra-HD-Aufloesung, fluessig koennen. Unterstuetzung fuer ausserdem zusaetzlichen fuer ueberfluessig. Kaeufern fuer fuer taeglich neün groesserer Ausserdem neü Verfuegung, fuer freün ueber koennen Kompatibilitaet aelteren Geraet daürhaft fuer fuenf Abo-Gebuehren eventüll verfuegbarer AufloesungGrafikkarte: 10-Unterstuetzung benoetigt fuer InterfaceBrowser:aktülle Produktschluessel urspruenglich moeglich!\u003C\u002Fp\u003E Nutzungsdaür Geraet eventülle Aenderungen Gewaehrleistung ermoeglichen, Europaeischen Europaeischen rechtsmaessig erklaert. endgueltige ueber uebertragene Datentraegern vollumfaenglich bestaetigt.\u003Cbr\u003E Beschluessen Erschoepfungsgrundsatz bestaetigt. Darueber verfuegt, uebertragenen duerfen \u003Cbr\u003EAusserdem Erschoepfung vollstaendig bestaetigt, einzuschraenken einzuschuechtern fuer rechtmaessig saemtliche Geraeten, Datentraegern einschliesslich hoechstrichterliche \"erschoepften erfuellt, Moeglichkeit sachgemaessen gehoeren ausdruecklich gueltigen fuer \u003Cp\u003EDarueber Geraeten Datenschutzerklaerung aktüll gueltigen fuer fuer rechtsgeschuetze verstaendlichen geschuetzten uneingeschraenkt gueltigen Eigentuemer. ordnungsgemaessen saemtlichem ausdruecklichen Haendlerschutzes.\u003C\u002Fdiv\u003E fuer 5f8043d308f9e 073","description":"\u003Ch5\u003E Microsoft Office 2019 Home and Student -Vollversion - 1PC - 32&amp;64 Bit für Windows 10\u003C\u002Fh5\u003E\n\u003Cp\u003E\u003Cb\u003ESie erwerben hier das \"neue\" Office 2019 Home and Student für 1 PC ( Windows 10 ) und zur online Aktivierung, die Online Aktivierung und generelle Aktivierung wird garantiert !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EEs ist kein Microsoft Konto erforderlich und der Zugang zur dazugehörenden Software wird durch von uns zugesendete Download Links gewährleistet und zur Verfügung gestellt.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E!!!!! Wenn Sie die Software werktags zwischen 9-16 Uhr unserer Bürozeit erwerben wird Ihnen die Email binnen der nächsten 30 Minuten - 1 Stunde an die von Ihnen hier hinterlegte Email Adresse zugestellt. Für alle Bestellungen nach 16 Uhr gilt das Sie die Email bis 9 Uhr des folgenden Tages in Ihrem Email Postfach vorfinden !!!!\u003C\u002Fp\u003E\n\u003Cp\u003EAuch am Wochenende sind wir für Sie da und versenden Ihre Käufe so schnell es irgend geht meist binnen 6-12 Stunden oder eher....!!!!\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003E100 % originale und legale Microsoft Software vom Experten, sicher und kompetent einkaufen !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Ch4\u003E Beschreibung\u003C\u002Fh4\u003E\n\u003Cdiv\u003E\n\u003Cdiv\u003E\u003Ch4\u003EProduktinformationen \"Microsoft Office 2019 Home and Student\"\u003C\u002Fh4\u003E\u003C\u002Fdiv\u003E\n\u003Cdiv\u003E\n\u003Cp\u003EZu Hause und als Student arbeiten - mit Office 2019 Home and Student Ideal geeignet für Privatanwender: Office 2019 Home and Student \u003Cbr\u003EDie wertvollsten Bestandteile für alle, die von zu Hause aus arbeiten: All das verbindet Office 2019 in der Home and Student-Edition. Es handelt sich um eine Programm für genau ein Gerät, welches die Programme Word, Excel und PowerPoint beinhaltet. OneNote steht über den Windows Store in Windows 10 zum Download bereit. Daten speichern Anwender entweder offline direkt auf dem Computer oder auch online in der Cloud durch die Verwendung von OneDrive oder ähnlichen Anbietern. \"Zu Hause oder in der Schule mehr erledigen\": Das ist das Motto von Microsoft, das mit dieser Edition von Office 2019 auch eingehalten werden kann.\u003C\u002Fp\u003E\n\u003Cp\u003EProfessionell aussehende Dokumente lassen sich in Word 2019 nun effektiver gestalten: Bearbeitung und Überprüfung des Inhalts des Ausdrucks am Drucker geschehen in einem Arbeitsgang. Zusätzlich ist die aus dem Vorgänger bekannte Suchfunktion inbegriffen, sodass Anfänger schnell Zugriff auf alle wichtigen Funktionen in Word 2019 erhalten. Komplett neu enthalten in der Version in Office 2019 Home and Student ist außerdem die Integration von SVG-Grafiken, die sich einfacher skalieren und verschieben lassen als etwa JPG- oder PNG-Grafiken. Alle, die mit einem Stift auf einem Touchscreen schreiben, freuen sich außerdem über eine verbesserte Schrifterkennung. Das ist vor allem beim Festhalten von Notizen hilfreich.\u003C\u002Fp\u003E\n\u003Cp\u003EFür Präsentationen wie geschaffen ist hingegen PowerPoint 2019: Das bekannte Werkzeug erlaubt die Gestaltung von Folien und kompletten Präsentationen auf einem professionellen Niveau. Ideen und Informationen lassen sich dadurch optisch und auch akustisch ansprechender darstellen. Neu in PowerPoint in Office 2019 ist die Verwendung von Aufnahmen in Ultra-HD-Auflösung, sodass 4K-Videos jetzt flüssig in die Folien integriert werden können. Eine verbesserte Unterstützung für Zoomen und Skalierung bestehender Fotos oder anderer Grafiken machen außerdem den Kauf von zusätzlichen Programmen für die Bildbearbeitung überflüssig. Von einfachen Folien bis zu mehreren Seiten langen Folien ist PowerPoint 2019 das geeignete Tool.\u003C\u002Fp\u003E\n\u003Cp\u003EMit Excel 2019 steht Käufern dieses Programms hingegen die bekannte Applikation für die Verwaltung von Tabellen bereit. Daten jeglicher Art lassen sich einfach und intuitiv eintragen und optisch aufbereiten. Tastenkombinationen erlauben den schnellen Zugriff auf die wichtigsten Funktionen für Nutzer, die täglich mit Excel arbeiten. Verbessert in der neuen Version sind unter anderem die mathematischen Funktionen, die jetzt in größerer Anzahl im Paket enthalten sind. Außerdem stellt die Applikation neue Methoden zur Verfügung, um Daten optisch ansprechend darzustellen und somit ein Werkzeug für die Visualisierung bereitzustellen. Dadurch sparen alle Nutzer Zeit und freuen sich dennoch über den bekannten Arbeitsfluss mit Excel.\u003C\u002Fp\u003E\n\u003Cp\u003EOneNote ist in Office 2019 Home and Student kein fester Bestandteil des Pakets mehr. Stattdessen können sich Interessenten das Programm im Windows Store herunterladen. Weiterhin hat Microsoft die Kompatibilität mit allen älteren Versionen von Windows entfernt. Auf dem Gerät muss zwingend Windows 10 installiert sein, um die Vorteile von Office 2019 und allen enthaltenen Anwendungen zu nutzen. Es handelt sich hierbei um ein dauerhaft nutzbares Programmpaket, welches für mindestens fünf Jahre von Microsoft mit Updates versorgt wird. Anders als bei Office 365 fallen keinerlei Abo-Gebühren an. Die Sicherung von Daten in OneDrive erzeugt eventuell Kosten.\u003C\u002Fp\u003E\n\u003Cdiv\u003E\n\u003Cp\u003EBetriebssystem:Windows 10Arbeitsspeicher:mindestens 2 GB RAMFestplatte:mindestens 3 GB verfügbarer SpeicherplatzBildschirm:mindestens 1.024 * 768 Pixel AuflösungGrafikkarte: DirectX 10-Unterstützung benötigt für GPU-beschleunigtes InterfaceBrowser:aktuelle Versionen von Internet Explorer, Chrome, Firefox, Microsoft Edge oder Safari.NET-Version:mindestens .NET-Version 3.5 \u003Cbr\u003E\u003Cb\u003EDas Computerprogramm wird online aktiviert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003EEs handelt sich um ein\u003C\u002Fstrong\u003E\u003Cstrong\u003E100 % Original Microsoft Produkt.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ESie erhalten nach dem Kauf :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003EDen Downloadlink zur Vollversion des Computerprogramms \u003Cbr\u003E\u003Cb\u003Eincl. dem Produktschlüssel zur Aktivierung per Email an Ihre hier bei Yatego hinterlegte Email Adresse.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003ERechnung mit ausgewiesener MwSt auf Ihren Namen.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cdiv\u003E\n\u003Cp\u003E\u003Cstrong\u003E* ZUR BEACHTUNG:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cdiv\u003E\u003Cdiv\u003E\u003Cdiv\u003E\n\u003Cp\u003E Die Nutzung des Programmes auf einem anderen z.B. neu erworbenen Rechner der gegen den alten Rechner auf dem dem das Computerprogramm ursprünglich installiert war ausgetauscht wurde oder aber auch nach Wechsel des Betriebssystems ist laut Microsoft nicht möglich!\u003C\u002Fp\u003E\n\u003Cp\u003EDie Nutzungsdauer ist hierbei unbegrenzt, solange das Produkt auf dem gleichen Gerät genutzt wird. Sollte der Rechner neu formatiert werden, neu aufgesetzt werden oder es werden eventuelle Änderungen an der Hardware vorgenommen, so besteht keine Gewährleistung mehr, dass es auch weiterhin auf dem PC funktioniert.\u003C\u002Fp\u003E\n\u003Cdiv\u003E\u003Cdiv\u003E\n\u003Ch5\u003EEin Softwarehersteller kann sich dem Weiterverkauf seiner gebrauchten Lizenzen, die die Nutzung seiner aus dem Internet heruntergeladenen Programme ermöglichen, nicht widersetzen.\u003C\u002Fh5\u003E\n\u003Cp\u003EAus der Pressemitteilung Nr. 94\u002F12 zum Urteil in der Rechtssache C-128\u002F11 des Gerichtshof der Europäischen Union (EuGH):\u003C\u002Fp\u003E\n\u003Cblockquote\u003EDer Handel mit gebrauchter Computersoftware wurde vom obersten rechtssprechenden Organ der EU, dem Europäischen Gerichtshof (EuGH), als rechtsmäßig erklärt. Somit herrscht nun endgültige Klarheit über den Gebrauchthandel mit Software, unbedeutend ob es sich um online übertragene oder auf physischen Datenträgern ausgelieferte Software handelt.\u003C\u002Fblockquote\u003E\n\u003Cp\u003EAm 17.07.2013 wurde diese Grundsatzentscheidung des EuGH durch den BGH vollumfänglich bestätigt.\u003Cbr\u003E\nDas Aufsplitten von Volumenlizenzen unterliegt ebenfalls den Beschlüssen des EuGH.\u003C\u002Fp\u003E\n\u003Cp\u003EDass der Erschöpfungsgrundsatz bei jedem erstmaligen Verkauf einer Software gilt, wurde durch die 13 Richter der obersten Kammer bestätigt. Darüber hinaus wurde verfügt, dass Zweiterwerber von online übertragenen Lizenzen die Software direkt beim Hersteller erneut herunterladen dürfen \u003Cbr\u003EAußerdem erstreckt sich die Erschöpfung des Verbreitungsrechts auf die Programmkopie in der \"vom Urheberrechtsinhaber verbesserten und aktualisierten Fassung\", so der EuGH. Damit wurde nicht nur der Schlussantrag des EuGH-Generalanwalts vom 24. April 2012 vollständig bestätigt, sondern sogar noch erweitert.\u003C\u002Fp\u003E\n\u003Cp\u003EDieses Urteil des EuGH folgte auf eine Anfrage des BGH, da die Softwarehersteller die gesetzlich nicht eindeutigen Regelungen ausgenutzt haben, um den Handel einzuschränken und die Kunden einzuschüchtern - ungeachtet des Grundsatzes, der den Weiterverkauf von bereits einmal verwendeter Software schon vorher für legal deklarierte.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E§§§ Gesetzliches &amp; Rechtliches §§§\u003C\u002Fstrong\u003E\u003Cstrong\u003E zur Information :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EWir verkaufen hier einen rechtmäßig erworbenen Artikel\u003Cbr\u003E\nund haben sämtliche Kopien des Artikels von all unseren Geräten, Datenträgern und sonstigen Speicherorten einschließlich Cloud-Diensten entfernt oder unbrauchbar gemacht, so wie es die höchstrichterliche Rechtsprechung erfordert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Ch5\u003E\u003Cb\u003EDesweiteren sind die Voraussetzungen des Art. 5 Abs. 1 der Richtlinie 2009\u002F24\u002FEG zum Erwerb einer \"erschöpften Programmkopie\" erfüllt, mit dem Erwerb des jeweiligen Produktes erlangen Sie die Möglichkeit zur sachgemäßen Nutzung des Computerprogramms.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E\n\u003Cp\u003EDer Umfang der erworbenen Nutzungsrechte richtet sich nach den jeweils geltenden Lizenzbedingungen des Rechteinhabers, soweit sie nicht gesetzlichen Bestimmungen widersprechen. Zu den Lizenzbedingungen gehören insbesondere die End User License Agreements (EULA), die bei Installation der Software abgerufen werden, sowie die Product Use Rights (PUR), die auf der Rechteinhaber-Homepage bereitgestellt werden.\u003C\u002Fp\u003E\n\u003Ch5\u003E\u003Cb\u003EWir machen ausdrücklich darauf aufmerksam, das sich erst mit dem Download ( der Installation der Software auf Ihrem Rechner ) und der sich daraus gebildeten Akzeptanz der jeweiligen gültigen Nutzungsbedingungen des Herstellers ( Microsoft ) eine Lizenz für das jeweilige Computerprogramm bildet, welche das Nutzungsrecht zwischen Ihnen und dem jeweiligen Hersteller ( hier Microsoft ) regelt.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E\n\u003Cp\u003EDarüber hinaus ist es Ihnen untersagt, den Key auf mehreren Geräten zu aktivieren, siehe ebenso Microsoft Nutzungsbedingungen ( microsoft ). Siehe auch Microsoft Datenschutzerklärung (microsoft ).\u003C\u002Fp\u003E\n\u003Cp\u003EDie jeweils aktuell gültigen Lizenzbedingungen für Ihr Produkt entnehmen Sie bitte den Hinweisen auf der Microsoft Website unter microsoft.com \u003Cbr\u003E\u003Cb\u003E!!!!!!!ACHTUNG!!!!!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cdiv\u003E Rechtliche Informationen Microsoft Trademarks. Alle Markenrechte für rechtsgeschütze Namen liegen bei dem jeweiligen Rechteinhaber, hier bei Microsoft Corporation. Alle graphischen Elemente, Logos, Icons etc. dienen nur zur Beschreibung des Angebots und der verständlichen Darstellung. Alle innerhalb des Internetangebotes genannten und ggf. durch Dritte geschützten Marken- und Warenzeichen unterliegen uneingeschränkt den Bestimmungen des jeweils gültigen Kennzeichenrechts und den Besitzrechten der jeweiligen eingetragenen Eigentümer. Weitere Informationen zur ordnungsgemäßen Verwendung von Microsoft Trademarks sind direkt bei Microsoft Corporation zu finden.\u003Cbr\u003E\n\u003C\u002Fdiv\u003E\n\u003Cp\u003E Das Urheberrecht der verwendeten Darstellungen, Artikelbeschreibungen und sämtlichem Textinhalt liegt insoweit nicht anders gekennzeichnet bei uns, eine Verwendung in jeglicher Form bedarf der ausdrücklichen Genehmigung unsererseits.\u003C\u002Fp\u003E\n\u003Cdiv\u003EDesweiteren sind wir zertifiziertes Mitglied im Verband des Deutschen Händlerschutzes.\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E","shortDescription":"Microsoft Office 2019 Home and Student -Vollversion - 1PC - 32&64 Bit für Windows 10 Sie erwerben hier das \"neue\" Office 2019 Home and Student für...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":13.4,"gross":15.95,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"1 Tag","deliveryTime":{"type":"exact-day","data":[1],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":true,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":939,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"073","ean":"0889842335514","isbn":null,"manufacturer":"Microsoft","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"150000\u002F155101\u002F155113","tags":[],"mainImage":{"large":null,"medium":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fe7\u002F08\u002F99d6a298f3e28ee845e35a0f1846d6b060d5c7d2fd1810e652bdeaf023ba08e7-medium","height":604,"width":613,"ratio":1.01,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fe7\u002F08\u002F99d6a298f3e28ee845e35a0f1846d6b060d5c7d2fd1810e652bdeaf023ba08e7-small","height":604,"width":613,"ratio":1.01,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fe7\u002F08\u002F99d6a298f3e28ee845e35a0f1846d6b060d5c7d2fd1810e652bdeaf023ba08e7-thumbnail","height":240,"width":320,"ratio":1.33,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"additionalImages":[],"externalUrl":null,"_computed":{"attributes":{"tag":[],"size":[],"color":[],"category":[],"material":[],"manufacturer":["Microsoft"]},"suggestions":["Microsoft","Office","Home","Student","32&64","Vollversion","Email","Express","Versand"]},"meta":{"yategoLegacy":{"productId":"5f8043d308f9e","shopId":"5f7adc977774a7.7","stockId":"5f884a1f311d8","objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24","type":"offer","merchantId":436,"deleted":false,"deleteDate":null,"createDate":"2022-11-25T00:38:50+01:00","lastModified":"2022-12-30T20:03:33+01:00"},{"id":"1022615","score":5.7879148,"title":"Microsoft Office 2019 Home and Student- 1PC - 32&64 Bit - Vollversion - Email Express Versand -","textContent":"\u003Ch5\u003E MS Microsoft Office 2019 Home and Student - Vollversion - 1PC Produkt Key 64\u002F32-Bit für Windows 10\u003C\u002Fh5\u003E \u003Cp\u003E\u003Cb\u003ESie erwerben hier das \"neue\" Office 2019 Home and Student für 1 PC ( Windows 10 ) und zur online Aktivierung, die Online Aktivierung und generelle Aktivierung wird garantiert !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EEmail Bindung mit dem Microsoft Konto möglich und Download der Software von offizieller Microsoft Seite.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E!!!!! Wenn Sie die Software werktags zwischen 9-16 Uhr unserer Bürozeit erwerben wird Ihnen die Email binnen der nächsten 30 Minuten - 1 Stunde an die von Ihnen hier hinterlegte Email Adresse zugestellt. Für alle Bestellungen nach 16 Uhr gilt das Sie die Email bis 9 Uhr des folgenden Tages in Ihrem Email Postfach vorfinden !!!!\u003C\u002Fp\u003E \u003Cp\u003EAuch am Wochenende sind wir für Sie da und versenden Ihre Käufe so schnell es irgend geht meist binnen 6-12 Stunden oder eher....!!!!\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003E100 % originale und legale Microsoft Software vom Experten, sicher und kompetent einkaufen !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Ch4\u003E Beschreibung\u003C\u002Fh4\u003E \u003Cdiv\u003E \u003Cdiv\u003E\u003Ch4\u003EProduktinformationen \"Microsoft Office 2019 Home and Student\"\u003C\u002Fh4\u003E\u003C\u002Fdiv\u003E \u003Cdiv\u003E \u003Cp\u003EZu Hause und als Student arbeiten - mit Office 2019 Home and Student Ideal geeignet für Privatanwender: Office 2019 Home and Student \u003Cbr\u003EDie wertvollsten Bestandteile für alle, die von zu Hause aus arbeiten: All das verbindet Office 2019 in der Home and Student-Edition. Es handelt sich um eine Programm für genau ein Gerät, welches die Programme Word, Excel und PowerPoint beinhaltet. OneNote steht über den Windows Store in Windows 10 zum Download bereit. Daten speichern Anwender entweder offline direkt auf dem Computer oder auch online in der Cloud durch die Verwendung von OneDrive oder ähnlichen Anbietern. \"Zu Hause oder in der Schule mehr erledigen\": Das ist das Motto von Microsoft, das mit dieser Edition von Office 2019 auch eingehalten werden kann.\u003C\u002Fp\u003E \u003Cp\u003EProfessionell aussehende Dokumente lassen sich in Word 2019 nun effektiver gestalten: Bearbeitung und Überprüfung des Inhalts des Ausdrucks am Drucker geschehen in einem Arbeitsgang. Zusätzlich ist die aus dem Vorgänger bekannte Suchfunktion inbegriffen, sodass Anfänger schnell Zugriff auf alle wichtigen Funktionen in Word 2019 erhalten. Komplett neu enthalten in der Version in Office 2019 Home and Student ist außerdem die Integration von SVG-Grafiken, die sich einfacher skalieren und verschieben lassen als etwa JPG- oder PNG-Grafiken. Alle, die mit einem Stift auf einem Touchscreen schreiben, freuen sich außerdem über eine verbesserte Schrifterkennung. Das ist vor allem beim Festhalten von Notizen hilfreich.\u003C\u002Fp\u003E \u003Cp\u003EFür Präsentationen wie geschaffen ist hingegen PowerPoint 2019: Das bekannte Werkzeug erlaubt die Gestaltung von Folien und kompletten Präsentationen auf einem professionellen Niveau. Ideen und Informationen lassen sich dadurch optisch und auch akustisch ansprechender darstellen. Neu in PowerPoint in Office 2019 ist die Verwendung von Aufnahmen in Ultra-HD-Auflösung, sodass 4K-Videos jetzt flüssig in die Folien integriert werden können. Eine verbesserte Unterstützung für Zoomen und Skalierung bestehender Fotos oder anderer Grafiken machen außerdem den Kauf von zusätzlichen Programmen für die Bildbearbeitung überflüssig. Von einfachen Folien bis zu mehreren Seiten langen Folien ist PowerPoint 2019 das geeignete Tool.\u003C\u002Fp\u003E \u003Cp\u003EMit Excel 2019 steht Käufern dieses Programms hingegen die bekannte Applikation für die Verwaltung von Tabellen bereit. Daten jeglicher Art lassen sich einfach und intuitiv eintragen und optisch aufbereiten. Tastenkombinationen erlauben den schnellen Zugriff auf die wichtigsten Funktionen für Nutzer, die täglich mit Excel arbeiten. Verbessert in der neuen Version sind unter anderem die mathematischen Funktionen, die jetzt in größerer Anzahl im Paket enthalten sind. Außerdem stellt die Applikation neue Methoden zur Verfügung, um Daten optisch ansprechend darzustellen und somit ein Werkzeug für die Visualisierung bereitzustellen. Dadurch sparen alle Nutzer Zeit und freuen sich dennoch über den bekannten Arbeitsfluss mit Excel.\u003C\u002Fp\u003E \u003Cp\u003EOneNote ist in Office 2019 Home and Student kein fester Bestandteil des Pakets mehr. Stattdessen können sich Interessenten das Programm im Windows Store herunterladen. Weiterhin hat Microsoft die Kompatibilität mit allen älteren Versionen von Windows entfernt. Auf dem Gerät muss zwingend Windows 10 installiert sein, um die Vorteile von Office 2019 und allen enthaltenen Anwendungen zu nutzen. Es handelt sich hierbei um ein dauerhaft nutzbares Programmpaket, welches für mindestens fünf Jahre von Microsoft mit Updates versorgt wird. Anders als bei Office 365 fallen keinerlei Abo-Gebühren an. Die Sicherung von Daten in OneDrive erzeugt eventuell Kosten.\u003C\u002Fp\u003E \u003Cdiv\u003E \u003Cp\u003EBetriebssystem:Windows 10Arbeitsspeicher:mindestens 2 GB RAMFestplatte:mindestens 3 GB verfügbarer SpeicherplatzBildschirm:mindestens 1.024 * 768 Pixel AuflösungGrafikkarte: DirectX 10-Unterstützung benötigt für GPU-beschleunigtes InterfaceBrowser:aktuelle Versionen von Internet Explorer, Chrome, Firefox, Microsoft Edge oder Safari.NET-Version:mindestens .NET-Version 3.5 \u003Cbr\u003E\u003Cb\u003EDas Computerprogramm wird online aktiviert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003EEs handelt sich um ein\u003C\u002Fstrong\u003E\u003Cstrong\u003E100 % Original Microsoft Produkt.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003ESie erhalten nach dem Kauf :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003EDownloadlink zur Vollversion des Computerprogramms incl. dem Produktschlüssel zur Aktivierung \u003Cbr\u003E\u003Cb\u003ERechnung mit ausgewiesener MwSt auf Ihren Namen.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E \u003Cp\u003E\u003Cstrong\u003E* ZUR BEACHTUNG:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cdiv\u003E\u003Cdiv\u003E\u003Cdiv\u003E \u003Cp\u003E Die Nutzung des Programmes auf einem anderen z.B. neu erworbenen Rechner der gegen den alten Rechner auf dem dem das Computerprogramm ursprünglich installiert war ausgetauscht wurde oder aber auch nach Wechsel des Betriebssystems ist laut Microsoft nicht möglich!\u003C\u002Fp\u003E \u003Cp\u003EDie Nutzungsdauer ist hierbei unbegrenzt, solange das Produkt auf dem gleichen Gerät genutzt wird. Sollte der Rechner neu formatiert werden, neu aufgesetzt werden oder es werden eventuelle Änderungen an der Hardware vorgenommen, so besteht keine Gewährleistung mehr, dass es auch weiterhin auf dem PC funktioniert.\u003C\u002Fp\u003E \u003Cdiv\u003E\u003Cdiv\u003E \u003Ch5\u003EEin Softwarehersteller kann sich dem Weiterverkauf seiner gebrauchten Lizenzen, die die Nutzung seiner aus dem Internet heruntergeladenen Programme ermöglichen, nicht widersetzen.\u003C\u002Fh5\u003E \u003Cp\u003EAus der Pressemitteilung Nr. 94\u002F12 zum Urteil in der Rechtssache C-128\u002F11 des Gerichtshof der Europäischen Union (EuGH):\u003C\u002Fp\u003E \u003Cblockquote\u003EDer Handel mit gebrauchter Computersoftware wurde vom obersten rechtssprechenden Organ der EU, dem Europäischen Gerichtshof (EuGH), als rechtsmäßig erklärt. Somit herrscht nun endgültige Klarheit über den Gebrauchthandel mit Software, unbedeutend ob es sich um online übertragene oder auf physischen Datenträgern ausgelieferte Software handelt.\u003C\u002Fblockquote\u003E \u003Cp\u003EAm 17.07.2013 wurde diese Grundsatzentscheidung des EuGH durch den BGH vollumfänglich bestätigt.\u003Cbr\u003E Das Aufsplitten von Volumenlizenzen unterliegt ebenfalls den Beschlüssen des EuGH.\u003C\u002Fp\u003E \u003Cp\u003EDass der Erschöpfungsgrundsatz bei jedem erstmaligen Verkauf einer Software gilt, wurde durch die 13 Richter der obersten Kammer bestätigt. Darüber hinaus wurde verfügt, dass Zweiterwerber von online übertragenen Lizenzen die Software direkt beim Hersteller erneut herunterladen dürfen \u003Cbr\u003EAußerdem erstreckt sich die Erschöpfung des Verbreitungsrechts auf die Programmkopie in der \"vom Urheberrechtsinhaber verbesserten und aktualisierten Fassung\", so der EuGH. Damit wurde nicht nur der Schlussantrag des EuGH-Generalanwalts vom 24. April 2012 vollständig bestätigt, sondern sogar noch erweitert.\u003C\u002Fp\u003E \u003Cp\u003EDieses Urteil des EuGH folgte auf eine Anfrage des BGH, da die Softwarehersteller die gesetzlich nicht eindeutigen Regelungen ausgenutzt haben, um den Handel einzuschränken und die Kunden einzuschüchtern - ungeachtet des Grundsatzes, der den Weiterverkauf von bereits einmal verwendeter Software schon vorher für legal deklarierte.\u003C\u002Fp\u003E \u003Cp\u003E\u003Cstrong\u003E§§§ Gesetzliches &amp; Rechtliches §§§\u003C\u002Fstrong\u003E\u003Cstrong\u003E zur Information :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EWir verkaufen hier einen rechtmäßig erworbenen Artikel\u003Cbr\u003E und haben sämtliche Kopien des Artikels von all unseren Geräten, Datenträgern und sonstigen Speicherorten einschließlich Cloud-Diensten entfernt oder unbrauchbar gemacht so wie es die höchstrichterliche Rechtsprechung erfordert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Ch5\u003E\u003Cb\u003EDesweiteren sind die Voraussetzungen des Art. 5 Abs. 1 der Richtlinie 2009\u002F24\u002FEG zum Erwerb einer \"erschöpften Programmkopie\" erfüllt, mit dem Erwerb des jeweiligen Produktes erlangen Sie die Möglichkeit zur sachgemäßen Nutzung des Computerprogramms.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E \u003Ch5\u003E\u003Cb\u003EWir machen ausdrücklich darauf aufmerksam, das sich erst mit dem Download ( der Installation der Software auf Ihrem Rechner ) und der sich daraus gebildeten Akzeptanz der jeweiligen gültigen Nutzungsbedingungen des Herstellers ( Microsoft ) eine Lizenz für das jeweilige Computerprogramm bildet, welche das Nutzungsrecht zwischen Ihnen und dem jeweiligen Hersteller regelt.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E \u003Cp\u003EDarüber hinaus ist es Ihnen untersagt, den Key auf mehreren Geräten zu aktivieren, siehe ebenso Microsoft Nutzungsbedingungen ( microsoft ). Siehe auch Microsoft Datenschutzerklärung (microsoft ).\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003EDie jeweils aktuell gültigen Lizenzbedingungen für Ihr Produkt entnehmen Sie bitte den Hinweisen auf der Microsoft Website unter microsoft.com .\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cp\u003E\u003Cb\u003E!!!!!!!ACHTUNG!!!!!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E \u003Cdiv\u003E Rechtliche Informationen Microsoft Trademarks. Alle Markenrechte für rechtsgeschütze Namen liegen bei dem jeweiligen Rechteinhaber, hier bei Microsoft Corporation. Alle graphischen Elemente, Logos, Icons etc. dienen nur zur Beschreibung des Angebots und der verständlichen Darstellung. Alle innerhalb des Internetangebotes genannten und ggf. durch Dritte geschützten Marken- und Warenzeichen unterliegen uneingeschränkt den Bestimmungen des jeweils gültigen Kennzeichenrechts und den Besitzrechten der jeweiligen eingetragenen Eigentümer. Weitere Informationen zur ordnungsgemäßen Verwendung von Microsoft Trademarks sind direkt bei Microsoft Corporation zu finden.\u003C\u002Fdiv\u003E \u003Cp\u003E Das Urheberrecht der verwendeten Darstellungen, Artikelbeschreibungen und sämtlichem Textinhalt liegt insoweit nicht anders gekennzeichnet bei uns, eine Verwendung in jeglicher Form bedarf der ausdrücklichen Genehmigung unsererseits.\u003C\u002Fp\u003E \u003Cdiv\u003EDesweiteren sind wir zertifiziertes Mitglied im Verband des Deutschen Händlerschutzes.\u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E \u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E Microsoft Office 2019 Home and Student- 1PC - 32&64 Bit - Vollversion - Email Express Versand - MS Microsoft Office 2019 Home and Student - Vollversion - 1PC Produkt Key 64\u002F32-Bit für Windows 10Sie erwerben hier das ... fuer \"neü\" fuer moeglich Buerozeit naechsten Fuer fuer Kaeufe fuer fuer fuer Geraet, ueber aehnlichen Ueberpruefung Zusaetzlich Vorgaenger Anfaenger ausserdem freün ausserdem ueber \u003Cp\u003EFuer Praesentationen Praesentationen Ultra-HD-Aufloesung, fluessig koennen. Unterstuetzung fuer ausserdem zusaetzlichen fuer ueberfluessig. Kaeufern fuer fuer taeglich neün groesserer Ausserdem neü Verfuegung, fuer freün ueber koennen Kompatibilitaet aelteren Geraet daürhaft fuer fuenf Abo-Gebuehren eventüll verfuegbarer AufloesungGrafikkarte: 10-Unterstuetzung benoetigt fuer InterfaceBrowser:aktülle Produktschluessel urspruenglich moeglich!\u003C\u002Fp\u003E Nutzungsdaür Geraet eventülle Aenderungen Gewaehrleistung ermoeglichen, Europaeischen Europaeischen rechtsmaessig erklaert. endgueltige ueber uebertragene Datentraegern vollumfaenglich bestaetigt.\u003Cbr\u003E Beschluessen Erschoepfungsgrundsatz bestaetigt. Darueber verfuegt, uebertragenen duerfen \u003Cbr\u003EAusserdem Erschoepfung vollstaendig bestaetigt, einzuschraenken einzuschuechtern fuer rechtmaessig saemtliche Geraeten, Datentraegern einschliesslich hoechstrichterliche \"erschoepften erfuellt, Moeglichkeit sachgemaessen ausdruecklich gueltigen fuer \u003Cp\u003EDarueber Geraeten Datenschutzerklaerung aktüll gueltigen fuer fuer rechtsgeschuetze verstaendlichen geschuetzten uneingeschraenkt gueltigen Eigentuemer. ordnungsgemaessen saemtlichem ausdruecklichen Haendlerschutzes.\u003C\u002Fdiv\u003E fuer 5f8043d47e618 055","description":"\u003Ch5\u003E MS Microsoft Office 2019 Home and Student - Vollversion - 1PC Produkt Key 64\u002F32-Bit für Windows 10\u003C\u002Fh5\u003E\n\u003Cp\u003E\u003Cb\u003ESie erwerben hier das \"neue\" Office 2019 Home and Student für 1 PC ( Windows 10 ) und zur online Aktivierung, die Online Aktivierung und generelle Aktivierung wird garantiert !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EEmail Bindung mit dem Microsoft Konto möglich und Download der Software von offizieller Microsoft Seite.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E!!!!! Wenn Sie die Software werktags zwischen 9-16 Uhr unserer Bürozeit erwerben wird Ihnen die Email binnen der nächsten 30 Minuten - 1 Stunde an die von Ihnen hier hinterlegte Email Adresse zugestellt. Für alle Bestellungen nach 16 Uhr gilt das Sie die Email bis 9 Uhr des folgenden Tages in Ihrem Email Postfach vorfinden !!!!\u003C\u002Fp\u003E\n\u003Cp\u003EAuch am Wochenende sind wir für Sie da und versenden Ihre Käufe so schnell es irgend geht meist binnen 6-12 Stunden oder eher....!!!!\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003E100 % originale und legale Microsoft Software vom Experten, sicher und kompetent einkaufen !!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Ch4\u003E Beschreibung\u003C\u002Fh4\u003E\n\u003Cdiv\u003E\n\u003Cdiv\u003E\u003Ch4\u003EProduktinformationen \"Microsoft Office 2019 Home and Student\"\u003C\u002Fh4\u003E\u003C\u002Fdiv\u003E\n\u003Cdiv\u003E\n\u003Cp\u003EZu Hause und als Student arbeiten - mit Office 2019 Home and Student Ideal geeignet für Privatanwender: Office 2019 Home and Student \u003Cbr\u003EDie wertvollsten Bestandteile für alle, die von zu Hause aus arbeiten: All das verbindet Office 2019 in der Home and Student-Edition. Es handelt sich um eine Programm für genau ein Gerät, welches die Programme Word, Excel und PowerPoint beinhaltet. OneNote steht über den Windows Store in Windows 10 zum Download bereit. Daten speichern Anwender entweder offline direkt auf dem Computer oder auch online in der Cloud durch die Verwendung von OneDrive oder ähnlichen Anbietern. \"Zu Hause oder in der Schule mehr erledigen\": Das ist das Motto von Microsoft, das mit dieser Edition von Office 2019 auch eingehalten werden kann.\u003C\u002Fp\u003E\n\u003Cp\u003EProfessionell aussehende Dokumente lassen sich in Word 2019 nun effektiver gestalten: Bearbeitung und Überprüfung des Inhalts des Ausdrucks am Drucker geschehen in einem Arbeitsgang. Zusätzlich ist die aus dem Vorgänger bekannte Suchfunktion inbegriffen, sodass Anfänger schnell Zugriff auf alle wichtigen Funktionen in Word 2019 erhalten. Komplett neu enthalten in der Version in Office 2019 Home and Student ist außerdem die Integration von SVG-Grafiken, die sich einfacher skalieren und verschieben lassen als etwa JPG- oder PNG-Grafiken. Alle, die mit einem Stift auf einem Touchscreen schreiben, freuen sich außerdem über eine verbesserte Schrifterkennung. Das ist vor allem beim Festhalten von Notizen hilfreich.\u003C\u002Fp\u003E\n\u003Cp\u003EFür Präsentationen wie geschaffen ist hingegen PowerPoint 2019: Das bekannte Werkzeug erlaubt die Gestaltung von Folien und kompletten Präsentationen auf einem professionellen Niveau. Ideen und Informationen lassen sich dadurch optisch und auch akustisch ansprechender darstellen. Neu in PowerPoint in Office 2019 ist die Verwendung von Aufnahmen in Ultra-HD-Auflösung, sodass 4K-Videos jetzt flüssig in die Folien integriert werden können. Eine verbesserte Unterstützung für Zoomen und Skalierung bestehender Fotos oder anderer Grafiken machen außerdem den Kauf von zusätzlichen Programmen für die Bildbearbeitung überflüssig. Von einfachen Folien bis zu mehreren Seiten langen Folien ist PowerPoint 2019 das geeignete Tool.\u003C\u002Fp\u003E\n\u003Cp\u003EMit Excel 2019 steht Käufern dieses Programms hingegen die bekannte Applikation für die Verwaltung von Tabellen bereit. Daten jeglicher Art lassen sich einfach und intuitiv eintragen und optisch aufbereiten. Tastenkombinationen erlauben den schnellen Zugriff auf die wichtigsten Funktionen für Nutzer, die täglich mit Excel arbeiten. Verbessert in der neuen Version sind unter anderem die mathematischen Funktionen, die jetzt in größerer Anzahl im Paket enthalten sind. Außerdem stellt die Applikation neue Methoden zur Verfügung, um Daten optisch ansprechend darzustellen und somit ein Werkzeug für die Visualisierung bereitzustellen. Dadurch sparen alle Nutzer Zeit und freuen sich dennoch über den bekannten Arbeitsfluss mit Excel.\u003C\u002Fp\u003E\n\u003Cp\u003EOneNote ist in Office 2019 Home and Student kein fester Bestandteil des Pakets mehr. Stattdessen können sich Interessenten das Programm im Windows Store herunterladen. Weiterhin hat Microsoft die Kompatibilität mit allen älteren Versionen von Windows entfernt. Auf dem Gerät muss zwingend Windows 10 installiert sein, um die Vorteile von Office 2019 und allen enthaltenen Anwendungen zu nutzen. Es handelt sich hierbei um ein dauerhaft nutzbares Programmpaket, welches für mindestens fünf Jahre von Microsoft mit Updates versorgt wird. Anders als bei Office 365 fallen keinerlei Abo-Gebühren an. Die Sicherung von Daten in OneDrive erzeugt eventuell Kosten.\u003C\u002Fp\u003E\n\u003Cdiv\u003E\n\u003Cp\u003EBetriebssystem:Windows 10Arbeitsspeicher:mindestens 2 GB RAMFestplatte:mindestens 3 GB verfügbarer SpeicherplatzBildschirm:mindestens 1.024 * 768 Pixel AuflösungGrafikkarte: DirectX 10-Unterstützung benötigt für GPU-beschleunigtes InterfaceBrowser:aktuelle Versionen von Internet Explorer, Chrome, Firefox, Microsoft Edge oder Safari.NET-Version:mindestens .NET-Version 3.5 \u003Cbr\u003E\u003Cb\u003EDas Computerprogramm wird online aktiviert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003EEs handelt sich um ein\u003C\u002Fstrong\u003E\u003Cstrong\u003E100 % Original Microsoft Produkt.\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003ESie erhalten nach dem Kauf :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003EDownloadlink zur Vollversion des Computerprogramms incl. dem Produktschlüssel zur Aktivierung \u003Cbr\u003E\u003Cb\u003ERechnung mit ausgewiesener MwSt auf Ihren Namen.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\n\u003Cp\u003E\u003Cstrong\u003E* ZUR BEACHTUNG:\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cdiv\u003E\u003Cdiv\u003E\u003Cdiv\u003E\n\u003Cp\u003E Die Nutzung des Programmes auf einem anderen z.B. neu erworbenen Rechner der gegen den alten Rechner auf dem dem das Computerprogramm ursprünglich installiert war ausgetauscht wurde oder aber auch nach Wechsel des Betriebssystems ist laut Microsoft nicht möglich!\u003C\u002Fp\u003E\n\u003Cp\u003EDie Nutzungsdauer ist hierbei unbegrenzt, solange das Produkt auf dem gleichen Gerät genutzt wird. Sollte der Rechner neu formatiert werden, neu aufgesetzt werden oder es werden eventuelle Änderungen an der Hardware vorgenommen, so besteht keine Gewährleistung mehr, dass es auch weiterhin auf dem PC funktioniert.\u003C\u002Fp\u003E\n\u003Cdiv\u003E\u003Cdiv\u003E\n\u003Ch5\u003EEin Softwarehersteller kann sich dem Weiterverkauf seiner gebrauchten Lizenzen, die die Nutzung seiner aus dem Internet heruntergeladenen Programme ermöglichen, nicht widersetzen.\u003C\u002Fh5\u003E\n\u003Cp\u003EAus der Pressemitteilung Nr. 94\u002F12 zum Urteil in der Rechtssache C-128\u002F11 des Gerichtshof der Europäischen Union (EuGH):\u003C\u002Fp\u003E\n\u003Cblockquote\u003EDer Handel mit gebrauchter Computersoftware wurde vom obersten rechtssprechenden Organ der EU, dem Europäischen Gerichtshof (EuGH), als rechtsmäßig erklärt. Somit herrscht nun endgültige Klarheit über den Gebrauchthandel mit Software, unbedeutend ob es sich um online übertragene oder auf physischen Datenträgern ausgelieferte Software handelt.\u003C\u002Fblockquote\u003E\n\u003Cp\u003EAm 17.07.2013 wurde diese Grundsatzentscheidung des EuGH durch den BGH vollumfänglich bestätigt.\u003Cbr\u003E\nDas Aufsplitten von Volumenlizenzen unterliegt ebenfalls den Beschlüssen des EuGH.\u003C\u002Fp\u003E\n\u003Cp\u003EDass der Erschöpfungsgrundsatz bei jedem erstmaligen Verkauf einer Software gilt, wurde durch die 13 Richter der obersten Kammer bestätigt. Darüber hinaus wurde verfügt, dass Zweiterwerber von online übertragenen Lizenzen die Software direkt beim Hersteller erneut herunterladen dürfen \u003Cbr\u003EAußerdem erstreckt sich die Erschöpfung des Verbreitungsrechts auf die Programmkopie in der \"vom Urheberrechtsinhaber verbesserten und aktualisierten Fassung\", so der EuGH. Damit wurde nicht nur der Schlussantrag des EuGH-Generalanwalts vom 24. April 2012 vollständig bestätigt, sondern sogar noch erweitert.\u003C\u002Fp\u003E\n\u003Cp\u003EDieses Urteil des EuGH folgte auf eine Anfrage des BGH, da die Softwarehersteller die gesetzlich nicht eindeutigen Regelungen ausgenutzt haben, um den Handel einzuschränken und die Kunden einzuschüchtern - ungeachtet des Grundsatzes, der den Weiterverkauf von bereits einmal verwendeter Software schon vorher für legal deklarierte.\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cstrong\u003E§§§ Gesetzliches &amp; Rechtliches §§§\u003C\u002Fstrong\u003E\u003Cstrong\u003E zur Information :\u003C\u002Fstrong\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EWir verkaufen hier einen rechtmäßig erworbenen Artikel\u003Cbr\u003E\nund haben sämtliche Kopien des Artikels von all unseren Geräten, Datenträgern und sonstigen Speicherorten einschließlich Cloud-Diensten entfernt oder unbrauchbar gemacht so wie es die höchstrichterliche Rechtsprechung erfordert.\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Ch5\u003E\u003Cb\u003EDesweiteren sind die Voraussetzungen des Art. 5 Abs. 1 der Richtlinie 2009\u002F24\u002FEG zum Erwerb einer \"erschöpften Programmkopie\" erfüllt, mit dem Erwerb des jeweiligen Produktes erlangen Sie die Möglichkeit zur sachgemäßen Nutzung des Computerprogramms.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E\n\u003Ch5\u003E\u003Cb\u003EWir machen ausdrücklich darauf aufmerksam, das sich erst mit dem Download ( der Installation der Software auf Ihrem Rechner ) und der sich daraus gebildeten Akzeptanz der jeweiligen gültigen Nutzungsbedingungen des Herstellers ( Microsoft ) eine Lizenz für das jeweilige Computerprogramm bildet, welche das Nutzungsrecht zwischen Ihnen und dem jeweiligen Hersteller regelt.\u003C\u002Fb\u003E\u003C\u002Fh5\u003E\n\u003Cp\u003EDarüber hinaus ist es Ihnen untersagt, den Key auf mehreren Geräten zu aktivieren, siehe ebenso Microsoft Nutzungsbedingungen ( microsoft ). Siehe auch Microsoft Datenschutzerklärung (microsoft ).\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003EDie jeweils aktuell gültigen Lizenzbedingungen für Ihr Produkt entnehmen Sie bitte den Hinweisen auf der Microsoft Website unter microsoft.com .\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cp\u003E\u003Cb\u003E!!!!!!!ACHTUNG!!!!!!\u003C\u002Fb\u003E\u003C\u002Fp\u003E\n\u003Cdiv\u003E Rechtliche Informationen Microsoft Trademarks. Alle Markenrechte für rechtsgeschütze Namen liegen bei dem jeweiligen Rechteinhaber, hier bei Microsoft Corporation. Alle graphischen Elemente, Logos, Icons etc. dienen nur zur Beschreibung des Angebots und der verständlichen Darstellung. Alle innerhalb des Internetangebotes genannten und ggf. durch Dritte geschützten Marken- und Warenzeichen unterliegen uneingeschränkt den Bestimmungen des jeweils gültigen Kennzeichenrechts und den Besitzrechten der jeweiligen eingetragenen Eigentümer. Weitere Informationen zur ordnungsgemäßen Verwendung von Microsoft Trademarks sind direkt bei Microsoft Corporation zu finden.\u003C\u002Fdiv\u003E\n\u003Cp\u003E Das Urheberrecht der verwendeten Darstellungen, Artikelbeschreibungen und sämtlichem Textinhalt liegt insoweit nicht anders gekennzeichnet bei uns, eine Verwendung in jeglicher Form bedarf der ausdrücklichen Genehmigung unsererseits.\u003C\u002Fp\u003E\n\u003Cdiv\u003EDesweiteren sind wir zertifiziertes Mitglied im Verband des Deutschen Händlerschutzes.\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\n\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E\u003C\u002Fdiv\u003E","shortDescription":"MS Microsoft Office 2019 Home and Student - Vollversion - 1PC Produkt Key 64\u002F32-Bit für Windows 10 Sie erwerben hier das \"neue\" Office 2019 Home...","legalAdvice":null,"price":{"rrp":{"savingGross":0,"savingPercent":0,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"basePrice":{"unit":null,"net":0,"gross":0,"taxFactor":1.19,"objectVersion":"2021-09-24"},"net":13.4,"gross":15.95,"taxFactor":1.19,"objectVersion":"2021-09-24"},"delivery":{"units":0,"surcharge":0,"calculateOnce":1,"deliveryString":"1 Tag","deliveryTime":{"type":"exact-day","data":[1],"objectVersion":"2021-09-24"},"objectVersion":"2021-09-24"},"flags":{"topOffer":false,"explicitContent":false,"hasVariations":false,"hasBasePrice":false,"objectVersion":"2021-09-24"},"stock":{"available":958,"quantityUnit":"","packageSize":1,"objectVersion":"2021-09-24"},"identifier":{"articleNumber":"055","ean":"0889842326659","isbn":null,"manufacturer":"Microsoft","mpn":null,"objectVersion":"2021-09-24"},"variations":{"count":0,"minimumPrice":0,"maximumPrice":0,"options":[],"choices":[],"objectVersion":"2021-09-24"},"categoryPath":"150000\u002F155101\u002F155113","tags":[],"mainImage":{"large":null,"medium":null,"small":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fbf\u002F26\u002F96f04c6fcdd3dc65b282c6d627d4f00e4ff931b2cc94ad78813e269ea17b26bf-small","height":225,"width":225,"ratio":1,"avif":false,"png":false,"jpeg":true,"webp":true,"objectVersion":"2021-09-24"},"thumbnail":{"uri":"https:\u002F\u002Fwww.yatego.com\u002F_media\u002Fbf\u002F26\u002F96f04c6fcdd3dc65b282c6d627d4f00e4ff931b2cc94ad78813e269ea17b26bf-thumbn