<body>
	<script>
    var isBodyLoaded;
    var isBackgroundPreloaded;
	document.body.className += " pearltrees-body  hide-rightcol  withRighColumnAds scrollers ";

	function onBackgroundPreloaded() {
		isBackgroundPreloaded = true;
		displayBackgroundIfNeeded();
	}
	
	function displayBackgroundIfNeeded() {
		if (isBodyLoaded && isBackgroundPreloaded) {
			var bg = document.getElementById('background1');
			var veil = document.getElementById('first-bg-veil');
			
			if (typeof bg.style['display'] !== "undefined") {
				bg.style.display = '';	
			}
			
			bg.style.filter = 'brightness(112%) blur(30px)';
			veil.style.backgroundColor = 'rgba(255, 255, 255, 0.7)';
			
			var hs = document.getElementById('horizontal-scroller');
			hs.removeChild(document.getElementById("backgroundPreloader"));
		}
	}
</script>
<div id="loader-container"></div>
<div id="horizontal-scroller">
<img id="backgroundPreloader" src="http://cdn2.pearltrees.com/v2/asset/background/default_background-lightest.jpg?v=2019-16-09" onload="onBackgroundPreloaded()" alt="background preloader" style="opacity: 0.01">
<div id="full-container" class="isWaitingPearlsLoaded  withRighColumnAds withWidget with-size-constraint">
	<div id="right-column-region" class="">
         <div id="right-column-background"> 
            <div id="right-column-container"></div>
	  	 </div>
	  	 <svg id="right-column-border-left" class="right-column-border"></svg>                 
         <svg id="right-column-border-right" class="right-column-border"></svg>
    </div>
    <div id="main-container">
		<div id="background-container">
			<div id="background1" class="fadeCss" style="background-image: url(http://cdn2.pearltrees.com/v2/asset/background/default_background-lightest.jpg?v=2019-16-09); display: none;">
				
				<div id="first-bg-veil" class="background-veil"></div>
			</div>
			<div id="background2" class="fadeCss fadeOut" style="display: none;">
				<div class="background-veil"></div>
			</div>
			
			</div>
		
		<script>
		</script>
		<div id="content-container" >
			<div class="content-scrollable-region">
		    	<div id="content-container-region"></div>
		    </div>
		</div>

        <div id="sidebar" class="ui sidebar"></div>
        	
		<!--
		<div id="mask-container">
			<div id="mask-top"></div>
			<div id="mask-bottom"></div>
		</div>
		-->
		<div class="nav-bar">

<div id="no-log-logo" class="button left sprite-navbar-logo_no_log"></div>
        <div id="navbar-right-container">
                <div id="rightcol-button" class="button right sprite-navbar-rightcol"></div>
        			<div id="search-widget" class="right sprite-navbar-search_feed">
        		      <label for="search-feed" style="display: none"> label </label>
        		      <input type="text" name="query" id="search-feed" class="btn-group" data-i18n="[placeholder]search_bar.mode_pearltrees">
        		      <div id="search-menu-container">
                            <button type="button" class="search-btn sprite-navbar-search_button_anonymous"> 
                            <span style="display:none">Pearltrees</span>
                            </button>
                        </div>
        		    </div>
    		</div>
    		</div><div id="bottom-bar"></div>
		<div id="under-main" class='atBottom '>
            <div id="related-container"></div>
            <div id="cookie-info-container" class=''></div>
            </div>
        
    <div id="reader-and-background">
			<div class="background-cloak"></div>
			<div id="reader-container"></div>
		</div>
        
        <div id="modal"></div>
		
		<div id="central-window"></div>
		
	</div>
    <script>
		document.body.className += " anonymous";
		</script>
		<iframe name="myPostMessage" src="https://www.pearltrees.com/s/signup/secureStorage" style="display:none;"></iframe>
		</div>
</div>
<div class="scroll-catcher "></div>
<script>
    function testAdblock() {
    if(typeof document.body == 'undefined') {
            return;
        }
        var testad_id = "sponsorText";
        var testad = document.createElement("DIV");
        testad.id = testad_id;
        testad.style.position = "absolute";
        testad.style.left = "-999px";
        testad.appendChild(document.createTextNode("&nbsp;"));
        document.body.appendChild(testad);
        setTimeout(
            function () {
                var fullContainer = document.getElementById("full-container");
                if (testad) {
                    var blocked = (testad.clientHeight == 0);
                    if(typeof PearltreesEnvParams !== 'undefined') {
                    PearltreesEnvParams.hasAdBlock = blocked ? 1 : 0;
                    }
                    if (false && blocked) {
                        var rightCol = document.getElementById("right-column-region");
                        if (rightCol) {
                            rightCol.className = rightCol.className + " soonwithpromo";
                        }
                    }
                    document.body.removeChild(testad);
                }
            }, 300
        );
    }
    testAdblock();
</script><script>
    isBodyLoaded = true;
    displayBackgroundIfNeeded();
</script>
