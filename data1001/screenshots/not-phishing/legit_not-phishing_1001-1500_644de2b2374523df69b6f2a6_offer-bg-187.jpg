<script>
function txtSpeak()
{

function voiceStartCallback() {
    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Stop');
}
 
function voiceEndCallback() {
    $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Listen');
}
 
var parameters = {
rate: 1.1,
    onstart: voiceStartCallback,
    onend: voiceEndCallback
}


if(responsiveVoice.isPlaying()) {
  responsiveVoice.cancel();
  $('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Listen');
}
else
{
responsiveVoice.setDefaultVoice("US English Male");
$('.btnListen').html('<strong class="fa fa-volume-up" ></strong>Stop');
var txtforspeech=$(".main-detail").text().replace(/\s+/g, " ");
responsiveVoice.speak(txtforspeech,'US English Male',parameters);
}

}

</script>



        
        
