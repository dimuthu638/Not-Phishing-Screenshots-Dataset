            <h1>Florida Botanical Gardens</h1>

                                                                <address vocab="http://schema.org/" typeof="PostalAddress">
                    <span class="d-none" property="name">Florida Botanical Gardens</span>
                    <span property="streetAddress">12520 Ulmerton Road</span><br>
                    <span property="addressLocality">Largo</span>,
                    <span property="addressRegion">Florida</span>
                    <span property="postalCode">33774</span>
                    <span class="d-none" property="addressCountry">United States</span><br>
                    <a href="https://maps.google.com/?q=12520+Ulmerton+Road+Largo%2C+FL+33774">Google Map</a>
                </address>
                                        <figure id="pinellas-featured-image" class="figure img-fluid w-100"><img width="825" height="464"   alt="red white and pink roses at Florida Botanical Gardens" decoding="async" loading="lazy" data-src="https://pinellas.gov/wp-content/uploads/2021/12/Florida_Botanical_Gardens2-825x464.jpg" class="w-100 wp-post-image lazyload" src="data:image/gif;base64,R0lGODlhAQABAAAAACH5BAEKAAEALAAAAAABAAEAAAICTAEAOw==" /><noscript><img width="825" height="464" src="https://pinellas.gov/wp-content/uploads/2021/12/Florida_Botanical_Gardens2-825x464.jpg" class="w-100 wp-post-image" alt="red white and pink roses at Florida Botanical Gardens" decoding="async" loading="lazy" /></noscript><figcaption class="figure-caption"></figcaption></figure>                                                    <div class="mt-5">
                
<style type="text/css">
	#callout-block_107f6249688b148b6b9de75a239343d2 {
		/* Add styles that use ACF values here */
	}
	.block-callout {
		max-width: 540px;
	}
