      if (!isCSSLoaded) {
        const head = document.getElementsByTagName('head')[0];
        const cssLink = document.createElement('link');

        cssLink.rel = 'stylesheet';
        cssLink.href = '/bancopan-institucional/conteudo/templates/modal/telemarketing-ativo/main.css';
        cssLink.setAttribute('data-js', 'modal-telemarketing-ativo-css');

        head.appendChild(cssLink);
      }
      if (!isJSLoaded) {
        const body = document.getElementsByTagName('body');
        const jsElement = document.createElement('script');

        jsElement.type = 'application/javascript';
        jsElement.src = '/bancopan-institucional/conteudo/templates/modal/telemarketing-ativo/app.js?v=2';
        jsElement.setAttribute('data-js', 'modal-telemarketing-ativo-js');

        document.body.appendChild(jsElement);
      }
    })()
    </script>
