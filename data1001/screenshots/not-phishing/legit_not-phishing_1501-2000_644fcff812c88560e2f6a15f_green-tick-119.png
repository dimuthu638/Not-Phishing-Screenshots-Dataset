<script src="/docs/default-source/assets/js/uicommon/jquery-ui.js" defer=""></script>
<script defer="" type="text/javascript" src="/docs/default-source/productionassets/jscripts/common/core.js?ver=11102022"></script>
<!-- <script type="text/javascript" src="/docs/default-source/assets/js/morerecentblogs.js?ver=1709022"> </script> -->
<script>
    $(document).ready(function () {
        $("#HAP-close").on("click", function () {
            $("#HAP-popup").removeClass("active");
        });
        allInCallAgentAvailable();
        intervalAgentCheckCall();
    });
    function allInCallAgentAvailable() {
        var c = getCookie("is_vcognomeet_agent_availabe");
        if (c != "true") {
            $("#connectNow").hide();
            $("#exploreBtn").show();
        } else {
            $("#connectNow").show();
            $("#exploreBtn").hide();
        }
    }
    function intervalAgentCheckCall() {
        window.setInterval(function () {
            allInCallAgentAvailable();
        }, 8000);
    }
    function getCookie(name) {
        var value = `; ${document.cookie}`;
        var parts = value.split(`; ${name}=`);
        if (parts.length === 2) return parts.pop().split(";").shift();
    }
    function happopupActive() {
        $("#HAP-popup").addClass("active");
    }
</script>

