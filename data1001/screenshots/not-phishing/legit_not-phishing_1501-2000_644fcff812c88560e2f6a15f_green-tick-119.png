    margin: 0 auto;
}

.iltc-wrapper {
    padding: 10px 0;
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    z-index: 99999;
    background: #ffffff;
    display: none;
}

.closebtn-wrapper {
    position: absolute;
    right: 5px;
    top: 2px;
}

