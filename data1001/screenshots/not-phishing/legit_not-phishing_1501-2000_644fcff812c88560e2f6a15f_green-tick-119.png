        padding-left: 1rem;
        width: auto;
    }

    .iltc-content .logo-sec {
        width: auto;
    }

    .iltc-sec .iltc-btn {
        justify-content: flex-end;
        margin-right: 0;
    }

    .il-header .top-menu-wrap.pad-Top {
        padding-top: 7rem;
    }
}

