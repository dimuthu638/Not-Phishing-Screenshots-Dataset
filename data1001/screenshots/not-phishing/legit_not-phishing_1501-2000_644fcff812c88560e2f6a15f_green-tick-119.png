#spnRetrieveQuote {
cursor: pointer;}
.bounceEffect {
            animation: bounce 1s;
            -webkit-animation: bounce 1s;
            -moz-animation: bounce 1s;
            -o-animation: bounce 1s;
        }

        @-webkit-keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                -webkit-transform: translateY(0);
            }

            40% {
                -webkit-transform: translateY(-30px);
            }

            60% {
                -webkit-transform: translateY(-15px);
            }
        }

        @-moz-keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                -moz-transform: translateY(0);
            }

            40% {
                -moz-transform: translateY(-30px);
            }

            60% {
                -moz-transform: translateY(-15px);
            }
        }

        @-o-keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                -o-transform: translateY(0);
            }

            40% {
                -o-transform: translateY(-30px);
            }

            60% {
                -o-transform: translateY(-15px);
            }
        }

        @keyframes bounce {

            0%,
            20%,
            50%,
            80%,
            100% {
                transform: translateY(0);
            }

            40% {
                transform: translateY(-30px);
            }

            60% {
                transform: translateY(-15px);
            }
        }



@media (max-width: 768px) {
.more-quotes-wrapper .close {
     position: absolute;
    right: 30px;
    top: 35px;
    display: block;
opacity:1!important;
}
}

@media (max-width: 480px) {
.more-quotes-wrapper .close {
    right: 20px;
    top: 20px;
}
}

</style>


<script>
  $("#moreQuote").click(function(){
if($(window).width()<767){
$(".more-quotes-wrapper").addClass("animate__animated animate__shakeX")
}
setTimeout(function(){ 
    $(".more-quotes-wrapper").removeClass("animate__animated animate__shakeX")
 }, 2500);
});

 $(document).ready(function () {
            resizeDiv();
            $(window).resize(function (event) {
                resizeDiv();
            });
            function resizeDiv() {
                if (parseInt($(document).width()) > 768) {
                    $("#spnRetrieveQuote").addClass('big-device').removeClass('small-device');
                    $(".more-quotes-button").click(function () {
                        $('.more-quotes-wrapper').addClass('bounceInUp');
                    });
                }
                else {
                    $("#spnRetrieveQuote").addClass('small-device').removeClass('big-device');
                    $(".more-quotes-button").click(function () {
                        $('.more-quotes-wrapper').removeClass('bounceInUp');
                    });
                }
            }
            $(".more-quotes-wrapper").hide();
            $(".panel-close").click(function () {
                $(".toggle-panel-wrapper").hide();
            });

            $("body").on("click", ".continue-journey-m .panel-close", function () {
                $(".more-quotes-button").toggleClass('arrowToggle');
                $(".more-quotes-wrapper").toggle();
                if ($(".backdrop").length) {
                    $(".backdrop").remove();
                }
                else {
                    $(".toggle-panel-wrapper").prepend("<div class='backdrop'></div>");
                }
            });
            $(".blue-strip").click(function (e) {
                $(".more-quotes-button").toggleClass('arrowToggle');
                $(".more-quotes-wrapper").toggle();
                if ($(".backdrop").length) {
                    $(".backdrop").remove();
                }
                else {
                    $(".toggle-panel-wrapper").prepend("<div class='backdrop'></div>");
                }
                e.stopPropagation();

            });

            $(".more-quotes-wrapper").click(function (e) {
                e.stopPropagation();
            });

            $(document).click(function () {            
                $(".more-quotes-wrapper").hide();
                if ($(".backdrop").length) {
                    $(".backdrop").remove();
                    $(".more-quotes-button").toggleClass('arrowToggle');
                }
            });

            $(".continue-journey-m .close").click(function (e) {
                $(".more-quotes-wrapper").hide();
                if ($(".backdrop").length) {
                    $(".backdrop").remove();
                }
                else {
                    $(".toggle-panel-wrapper").prepend("<div class='backdrop'></div>");
                }
            });
            $(".big-device").click(function () {
                $(".toggle-panel-wrapper").toggleClass('bounceEffect');
                setTimeout(function () {
                    $(".toggle-panel-wrapper").removeClass('bounceEffect', {}, 500)
                }, 1000);
            });
        });

</script>

