    margin: 0;
}

.iltc-sec .iltc-content {
    display: flex;
    justify-content: space-between;
    flex-direction: row;
    width: 75%;
}

.iltc-content .content-sec {
    padding-left: 10px;
}

.iltc-sec .iltc-btn {
    width: 25%;
    display: flex;
    align-items: end;
}

.iltc-wrapper .iltc-sec {
    display: flex;
    justify-content: space-between;
    flex-direction: row;
}

.iltc-btn .install-btn a {
    border: 1px solid #ec6625;
    font-size: 1.2rem;
    color: #ec6625;
    font-weight: bold;
    padding: 7px 0;
