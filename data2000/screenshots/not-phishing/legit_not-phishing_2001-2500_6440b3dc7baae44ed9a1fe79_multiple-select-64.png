        <script>
        $(document).ready(function () {
            var paths = window.location.pathname.split('/');
            var path = paths[paths.length - 1] !== "" ? paths[paths.length - 1] : paths[paths.length - 2];
            path = 'us' + '/' + 'en' + '/' + path;

            $('#ulMenu').find('>li').removeClass('active');
            $('#ulMenu').find('>li  a[href="' + path + '"]').addClass('active');

            $('#topBar').find('>li').removeClass('active');
            $('#topBar').find('>li  a[href="' + path + '"]').addClass('active');

            $('#searchform a.search-btn').click(function () {
                $('#searchform').submit();
            });
            $('#searchform').submit(function () {
                return $.trim($('#search').val()) === '' ? false : true;
            });

            if ('False' === 'False') {
                //open cookie popup code
                $('#cookie-popup').show();
            } else {
                $('#cookie-popup').hide();
            }
        });

        function funAccept() {
            $.ajax({
                url: virtualDir + territory +"/"+ language + "/Home/AcceptCookie",
                type: 'POST',
                success: function (response) {
                    // close cookie popup code
                    $('#cookie-popup').hide();
                }
            });
        }
        </script>
        
