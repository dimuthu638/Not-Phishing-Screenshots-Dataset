<body id="BodySeries">
    <div class="page-wrapper">

        <!-- Header section starts from here -->
        <header data-ng-controller="HeaderFrontController">
            <div id="CurrentTerritory" class="modal divTerritory">
                <div class="modal-content">
                    <div class="clearfix fix-wrap">

                        <span class="close">&times;</span>
                        <div class="modalTitle">
                            <span>Current Territory</span>
                            <b style="color: black;">United States</b>
                        </div>

                        <div>
                            <div class="drop-down form-label">
                                <div class="selected">
                                    <a id="TerritoryGroup" class="empty">&nbsp;</a>
                                    <span class="label">Group</span>
                                </div>

                                <div class="options">
                                    <div class="ms-search"><label for="hTerritoryGroupList" class="hidden">Search Group</label><input type="text" id="hTerritoryGroupList" autocomplete="off" spellcheck="false" data-ng-model="searchTerritoriesGroup" placeholder="Search..."></div>
                                    <ul class="cmn-list">
                                        <li data-ng-repeat="tg in territoryGroupList | filter: searchTerritoriesGroup" data-ng-click="loadTerritories(tg)">{{tg.name}}</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="drop-down form-label">
                                <div class="selected">
                                    <a id="SelTerritories" class="empty">&nbsp;</a>
                                    <span class="label">Territories</span>
                                </div>
                                <div class="options">
                                    <div class="ms-search"><label for="hTerritoryList" class="hidden">Search Territories</label><input type="text" id="hTerritoryList" autocomplete="off" spellcheck="false" data-ng-model="searchTerritories" placeholder="Search..."></div>
                                    <ul class="cmn-list">
                                        <li data-ng-repeat="tr in territoryList  | filter: searchTerritories" data-ng-click="onSelectTerritory(tr)">{{tr.name}}</li>
                                    </ul>
                                </div>
                            </div>
                            <input id="searchButton" type="button" class="btn-primary btnselectTerritory" ng-disabled="isDisabled" data-ng-click="setTerritory()" value="Select">
                            <label for="searchButton" class="hidden">Search</label>
                        </div>
                    </div>
                </div>
            </div>

            <div class="nav-brand">
                <a href="/us/en" class="logo">
                    <img src="https://media.press.amazonstudios.com/client/img/white-amazon-logo.svg?v=285" width="195" alt="Prime Video Press Header Logo" />
                </a>
                <a href="javascript:;" class="navbar-toggle" title="Hamburger Nav"><span class="hidden">Hamburger Nav</span></a>

                    <span class="links register-link"><a href="us/en/register">Register</a></span>
                    <span class="links"><a href="us/en/login">Login</a></span>

            </div>

            <div class="navbar">
                <div class="topBar">
                    <ul id="topBar" class="f-right">
                        
                            <li class="country">
                                <span class="label mob-view">Location:</span>
                                <a href="javascript:;" id="selLocation" data-ng-click="loadTerritoryGroups()" data-id="CurrentTerritory" class="openModal">
                                    <span>United States</span>
                                </a>
                            </li>
                            <li ng-hide="!isDisplayLang">
                                <span class="label mob-view">Language:</span>
                                <div class="drop-down" id="selLanguage">
                                    <div class="selected">
                                        <a href="javascript:;" class="empty">English</a>
                                    </div>
                                    <div class="options">
                                        <ul>
                                            <li data-ng-repeat="language in languages" data-ng-click="setLanguage(language)">{{language.name}}</li>
                                        </ul>
                                    </div>
                                </div>
                            </li>

                            <li class="register-link"><a href="us/en/register">Register</a></li>
                            <li class="login-link"><a href="us/en/login">Login</a></li>

                            <li class="web-view"><a href="https://app.screeners.com/" target="_blank">Screening Room</a></li>


                    </ul>
