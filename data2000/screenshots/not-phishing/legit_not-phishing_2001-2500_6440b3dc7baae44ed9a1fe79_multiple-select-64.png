    <script>
        var virtualDir = '/';
        var language = 'en';
        var languageId = 1;
        var territory = 'us';
        var territoryId = 237;
        var isMovieSite = 'False';
        var isSeriesSite = 'True';
        var isLoggedIn = 'False';
        var environment = 'Production';
        var isSports = 'True';
        var isEncryptionEnable = 'True';
        document.addEventListener('contextmenu', event => event.preventDefault());

    </script>

    
    <script>
        (function (d, s, id) {
            var js, fjs = d.getElementsByTagName(s)[0];
            if (d.getElementById(id)) return;
