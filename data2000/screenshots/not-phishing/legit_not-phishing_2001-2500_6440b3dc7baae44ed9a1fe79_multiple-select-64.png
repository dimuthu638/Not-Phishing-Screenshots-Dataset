            fjs.parentNode.insertBefore(js, fjs);
        }(document, 'script', 'facebook-jssdk'));</script>

    <title>Amazon Original Series &amp; Movies Press Site | Amazon Studios</title>
    <meta name="description" content="Welcome to Amazon Studio. Amazon Studios provides the information, upcoming events, and press release about the latest Amazon web series, videos or movies as well. Find out more information on the Amazon Studio press." />
    


