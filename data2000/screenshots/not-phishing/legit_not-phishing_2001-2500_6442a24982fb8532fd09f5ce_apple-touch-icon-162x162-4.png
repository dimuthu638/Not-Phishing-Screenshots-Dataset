<!DOCTYPE html><html lang="en" ><head ><script data-hk="0-0-0-0-0-0-0-0-0-7-17-0">if (window.matchMedia("(prefers-color-scheme: dark)").matches); document.documentElement.classList.add('dark')</script><script data-hk="0-0-0-0-0-0-0-0-0-7-17-1">
        try {
          const mediaQuery = '(prefers-color-scheme: dark)';
          const preference = localStorage.getItem("post-user-preferred-theme");
          if(!preference || preference === "device_settings") {
            document.documentElement.classList.toggle('dark', window.matchMedia(mediaQuery).matches);
          } else if(preference === "dark") {
            document.documentElement.classList.add('dark');
          } else {
            document.documentElement.classList.remove('dark');
          }
        } catch (e) {}
