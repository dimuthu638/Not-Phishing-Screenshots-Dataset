				<div class="elementor-element elementor-element-95bba76 elementor-widget elementor-widget-heading" data-id="95bba76" data-element_type="widget" data-widget_type="heading.default">
				<div class="elementor-widget-container">
			<h2 class="elementor-heading-title elementor-size-default">Our CEO, Thomas Pash</h2>		</div>
				</div>
				<section class="elementor-section elementor-inner-section elementor-element elementor-element-8b9a29d elementor-section-boxed elementor-section-height-default elementor-section-height-default" data-id="8b9a29d" data-element_type="section">
