    <!--contenido-->
    <div id="container" class="clear container class03">
    <div class="content">
    <div class="container">
    <div class="row">
    <div class="col-12 p-0 headers">
    <h1>Some important notes on security</h1>
    </div>
    <div class="col-12 p-0" style="margin-top: -6px">
    <p class="body-text line-16">The security of your accounts is an absolute priority for us. That's why we are concerned about this matter and work on a daily basis to guarantee the utmost security of your bank accounts.</p>
    </div>
    <div class="col-12 p-0 mobile-img">
    <div class="img-banner">
    <div class="black-cover-over">&#160;</div>
    <img alt="banner sabadell" src="https://ems.bancsabadell.com/repository/banner_candado.jpg" /></div>
    </div>
    <div class="col-12 p-0 up-col">
    <div class="row">
    <div class="col-md-6 col-sm-6 col-12">
    <div class="cuadro cuadro-segundafila card-float-right" style="border-top: #006dff 3px solid"><a class="content_btn_uno" href="/cs/Satellite/SabAtl/Tu_Seguridad_Nuestro_Compromiso/6000020152359/en/">
    <div class="row" style="padding-bottom: 0px; padding-top: 0px; padding-left: 20px; padding-right: 20px">
    <h2 class="hidden-mobile">Your security, our commitment</h2>
    <h2 class="show-mobile col-9 line-17" style="margin: 10px 0px 0px">Your security, our commitment</h2>
    <div class="show-mobile col-3" style="margin: 0px"><img class="icon-arrow-right" alt="arrow right" src="https://ems.bancsabadell.com/repository/arrow_right.svg" /></div>
    <h3 class="hidden-mobile">This is how we work to protect your accounts from cyber attacks.<br />
    <span class="hidden-mobile"><br />
    &#160; </span></h3>
    </div>
    </a><a class="enlace_btn enlace_btn_border hidden-mobile" href="/cs/Satellite/SabAtl/Tu_Seguridad_Nuestro_Compromiso/6000020152359/en/">Find out more </a></div>
    </div>
    <div class="col-md-6 col-sm-6 col-12">
    <div class="cuadro cuadro-segundafila" style="border-top: #006dff 3px solid"><a class="content_btn_uno" href="/cs/Satellite/SabAtl/Amenazas_Comunes/6000020153745/en/">
    <div class="row show-mobile" style="padding-bottom: 0px; padding-top: 0px; padding-left: 20px; padding-right: 20px">
    <h2 class="hidden-mobile">Some common threats</h2>
    <h2 class="show-mobile col-9" style="margin: 14px 0px 0px">Some common threats</h2>
    <div class="show-mobile col-3" style="margin: 0px"><img class="icon-arrow-right" alt="arrow right" src="https://ems.bancsabadell.com/repository/arrow_right.svg" /></div>
    <h3 class="hidden-mobile">Do you know the methods that cyber criminals tend to use to steal bank data? We'll explain some of these here. <span class="hidden-mobile"><br />
    &#160; </span></h3>
    </div>
