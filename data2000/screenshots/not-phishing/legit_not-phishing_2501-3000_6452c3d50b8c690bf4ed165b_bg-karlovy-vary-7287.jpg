<script>
        function render(template, options) {
            return template.replace(/\{\{\s?([\w.]+)\s?\}\}/g, (match, variable) => {
                return variable.split('.').reduce((previous, current) => {
                    return previous[current]
                }, options) || ''
            })
        }

	function isRecommRef(o) {
		return o.length==3 && o[0] !=="0" && !isNaN(parseInt(o[1])) && o[2] !="";
	}

	function getRecDataCol() {
        	client = client || new recombee.ApiClient(
            		'czech-news-center-prod',
            		'70U0WxdYzaEMPtAX0IfhiEhiMo6JcI1NtbHvH0nTn38eORv4PDkPTQ1ngsvCBuGf',
            		{
                		//'region': 'eu-west'
				'baseUri': 'client-rapi-cnc.recombee.com'
            		}
		);

	        client.send(new recombee.RecommendItemsToUser(localStorage.getItem("biskoId"), 10, {
			'scenario': 'autorevue-urcite-si-prectete',
			'returnProperties': true
        	})).then(function (res) {
                	var recommItem = document.getElementsByClassName("recommItemCol")[0];
                	var template = recommItem.outerHTML;
			ops = res.recommId;
			res.recomms.forEach(function (item, idx) {
                    		item.values.date = new Date(item.values.published_at * 1000).toLocaleDateString("default");
                    		item.values.premium = item.values.is_premium ? "ano" : "ne";
                    		item.values.gtmcls = "gtm-list-i";
                    		item.values.articleId = String(item.id).split("_")[1];
                    		item.values.srv = String(item.id).split("_")[0];

                    		var html = render(template, item);
                    		html = html.replace("data-image", "class='lazy' data-src");
		    		html = html.replace("h=169", "h=55");
		    		html = html.replace("w=300", "w=110");
                    		recommItem.insertAdjacentHTML('afterend', html);
                    		var items = document.getElementsByClassName("recommItemCol");
                    		recommItem = items[items.length - 1];
                    		recommItem.style.display = "block";
                	});
			TriggerLazyLoad();
			let rollers = [].slice.call(document.querySelectorAll("div.bx-sky-roller"));
			rollers.forEach(function(roller) {
				var rParent = roller.parentNode;
				rParent.dataset.ad_pos_top = parseInt(roller.getBoundingClientRect().top) - parseInt(rParent.getBoundingClientRect().top);
				rParent.dataset.ad_height = parseInt(roller.getBoundingClientRect().height);
			});
		}).catch(function (error) {
		});
	}

	window.addEventListener('load', getRecDataCol);

	function TrBee(o){
		TrackDelivery("Kliknutí RECbee", "");
		o.href = o.href + (String(o.href).indexOf("?")==-1 ? "?recombee=" : "&recombee=") + (ops !=null ? ops : "0") + "-" + o.dataset.id + "-" + o.dataset.srv;
	};

	function TrackDelivery(action, suffix){
		var tLayout = "|sloupec";
		layout.tracker.track("Určitě si přečtěte", action, undefined, window.location.hostname+tLayout+suffix, null);
	}

  	window.didomiOnReady = window.didomiOnReady || [];
  	window.didomiOnReady.push(function (Didomi) {
		TrackDelivery("Zobrazení stránky RECbee", "")
	});
</script>

