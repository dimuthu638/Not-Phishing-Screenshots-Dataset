<script>
        function fetchLikeCount(url) {
            return $.Deferred(function(defer) {
                $.ajax({
                    dataType: 'jsonp',
                    url: 'https://api.facebook.com/method/fql.query?callback=callback',
                    data: {
                        query: 'SELECT like_count FROM link_stat WHERE url="' + url + '"',
                        format: 'JSON'
                    }
                }).then(function(res) {
                    try {
                        var count = res[0].like_count;
                        var display_count = '';
                        count = parseInt(count, 10);
                        if (count > 100000000) {
                            count = count / 100000000;
                            count = count.toFixed(1);
                            display_count = count + '억';
                        } else if (count > 10000) {
                            count = count / 10000;
                            //count=count.toFixed(1); //반올림됨
                            count = (Math.floor(count * 10) / 10);
                            display_count = count + ' 만';
                        } else {
                            display_count = count;
                        }
                        defer.resolve(display_count);
                    } catch (e) {
                        reject();
                    }
                }, reject);
                function reject() {
                    defer.reject(';(');
                };
            }).promise();
        }
        $(function() {
            var $res = $('.resfb');
            fetchLikeCount('https://www.facebook.com/dothome.co.kr').always(function(res) {
                $res.text(res);
            });
            $(".my_gnb_line").mouseenter(function(){
                $('.all_menu_bg').stop().slideDown();
            });
            $(".my_gnb_line").mouseleave(function(){
                $('.all_menu_bg').stop().slideUp();
            });
            $(".dropdown_domain_section").mouseenter(function(){
                $(".dropdown_domain").addClass('open')
            });
            $(".dropdown_web_section").mouseenter(function() {
                $(".dropdown_web").addClass('open')
            });
             $(".dropdown_builder_section").mouseenter(function() {
                $(".dropdown_builder").addClass('open')
            });
            $(".dropdown_server_section").mouseenter(function() {
                $(".dropdown_server").addClass('open')
            });
            $(".dropdown_webmail_section").mouseenter(function() {
                $(".dropdown_webmail").addClass('open')
            });
            $(".dropdown_security_section").mouseenter(function() {
                $(".dropdown_security").addClass('open')
            });
            $(".dropdown_domain_section").mouseleave(function() {
                $(".dropdown_domain").removeClass('open')
            });
            $(".dropdown_web_section").mouseleave(function() {
                $(".dropdown_web").removeClass('open')
            });
            $(".dropdown_builder_section").mouseleave(function() {
                $(".dropdown_builder").removeClass('open')
            });
            $(".dropdown_server_section").mouseleave(function() {
                $(".dropdown_server").removeClass('open')
            });
            $(".dropdown_webmail_section").mouseleave(function() {
                $(".dropdown_webmail").removeClass('open')
            });
            $(".dropdown_security_section").mouseleave(function() {
                $(".dropdown_security").removeClass('open')
            });
        });
    </script>
