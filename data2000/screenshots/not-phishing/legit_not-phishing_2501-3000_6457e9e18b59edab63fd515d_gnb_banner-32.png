            <script>
$(document).on('click', '.main-menu-btn', function () {
    if($(this).hasClass('active')){
        $('.gnb-back').removeClass('active');
        $('.main-menu-btn').removeClass('active');
        $('.menu-open .submenu-wrap').removeClass('active');
        $('.menu-open').removeClass('active');
    }else{
        var selectMenu = $(this).parent().index();
        $('.main-menu-btn').removeClass('active');
        $('.menu-open .submenu-wrap').removeClass('active');

        $(this).addClass('active');
        $('.menu-open .submenu-wrap').eq(selectMenu).addClass('active');
        $('.menu-open').addClass('active');
        $('.gnb-back').addClass('active');
    }
});
$(document).on('click', '.gnb .menu-open a', function () {
    $('.gnb-back').removeClass('active');
    $('.main-menu-btn').removeClass('active');
    $('.menu-open .submenu-wrap').removeClass('active');
    $('.menu-open').removeClass('active');
});
$(document).on('click', '.gnb .menu-open-m #m_mail a, .gnb .menu-open-m #m_security a', function () {
    $('.menu-open-m').removeClass('active');
    $('.menu-toggle').removeClass('active');
    $('.m-open-menu').removeClass('active');
    $('.gnb-logo').removeClass('off');
});
$(document).on('click', '.gnb-back', function () {
    $(this).removeClass('active');
    $('.main-menu-btn').removeClass('active');
    $('.menu-open .submenu-wrap').removeClass('active');
    $('.menu-open').removeClass('active');
    
});
$(document).on('click', '.menu-toggle', function () {
    if($(this).hasClass('active')){
        $('.menu-open-m').removeClass('active');
        $(this).removeClass('active');
        $('.m-open-menu').removeClass('active');
        $('.gnb-logo').removeClass('off');
    }else{
        $('.menu-open-m').addClass('active'); 
        $(this).addClass('active');
        $('.m-open-menu').addClass('active');
        $('.gnb-logo').addClass('off');
    }
    
});
</script>
