2Fhumor","active":true,"tags":["PR_ALL","PR_COMMENT_ALL"],"ownerCandidates":[]},"parent":{"type":"comment","id":"57xdmg","created":"2023-04-19T15:20:08.000Z","body":"Es que ustedes son muy estupidos y solo leen titulos. Las diferencias son varias.  1 tambien subian impuestos y servicios. 2 los SUELDOS estaban CONGELADOS. 3 el dolar que subia era el OFICIAL. 4 Nos endeudaban CONSTANTEMENTE sin ver nosotros un solo dolar\u002Fpeso. Por eso hoy no hay tal indignacion. Y por ultimo y de lo mas importante, ese dolar blue\u002Filegal, solo lo crea la derecha con todo su aparato para desestabilziar al gobierno de turno que no sigue sus intereses. Siempre fue asi.","attachment":null,"active":true,"softDeleted":false,"hidden":false,"nsfw":false,"toxicity":0.45757914}}],"after":"57xg8l","before":""},"channel":{"loaded":false,"loading":false,"items":[],"after":"","before":""}}},"orphan":{"country":""},"chat":{"feed":{"loaded":false,"loading":false,"items":[],"count":0},"creatingRoom":false,"conversations":{},"messages":{},"activeConversation":null,"historyType":"conversations"},"activity":{"loaded":false,"loading":false,"items":[],"after":"","before":""},"notifier":{"playing":false,"timestamp":null},"feeds":{"list":{"globalHome":{"q":"","page":0,"sort":"created-desc","period":null,"count":20,"after":"57x6uq","before":"57xdfd","seed":null,"referrer":null,"filter":"article","from":"all","additionalQueryParams":{},"items":["57xdfd","57x7or","57xe9f","57xdjz","57x7fk","57x7uo","57x9i1","57x7tv","57x7oh","57xb12","57xb10","57x9lb","57xa37","57x9vo","57x9xy","57x727","57x9g3","57x7v9","57x721","57x6uq"],"loaded":true,"totalCount":288,"loading":false,"loadingMore":false,"url":"\u002Ffeed\u002Flist\u002FglobalHome"},"topsImagesHome":{"q":"","page":0,"sort":"tops","period":"today","count":3,"after":"57wq0q","before":"57ws1f","seed":null,"referrer":null,"filter":"image","from":"all","additionalQueryParams":{},"items":["57ws1f","57wmxe","57wq0q"],"loaded":true,"totalCount":303,"loading":