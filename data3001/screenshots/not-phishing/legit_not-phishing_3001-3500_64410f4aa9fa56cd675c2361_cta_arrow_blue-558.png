blockquote {
    font-family: Georgia, serif;
    font-size: 18px;
    font-style: italic;
    width: auto;
    padding: 0.25em 40px;
    line-height: 1.45;
    position: relative;
    color: #383838;
    background: #F9E344;
}
 
blockquote:before {
    display: block;
    content: "\201C";
    font-size: 80px;
    position: absolute;
    left: -10px;
    top: -10px;
    color: #7a7a7a;
}
 
blockquote cite {
    color: #999999;
    font-size: 14px;
    display: block;
    margin-top: 5px;
}
  
blockquote cite:before {
    content: "\2014 \2009";
}

