			<style>
				.cosyAlert-container {
					z-index: 9999999999 !important;
				}
				.cosyAlert {
					margin: 0px !important;
					padding: 5px !important;
					margin-bottom: 10px !important;
					-webkit-box-shadow: 2px 2px 5px 0px rgba(51,51,51,0.53) !important;
					-moz-box-shadow: 2px 2px 5px 0px rgba(51,51,51,0.53) !important;
					box-shadow: 2px 2px 5px 0px rgba(51,51,51,0.53) !important;
				}
				.cosyAlert .close {
					display: none;
				}
				.cosyAlert table {
					margin: 0;
				}
				.cosyAlert td {
					border: none;
					padding: 0;
				}
				.alert_message_type {
					padding: 5px;
					border-radius: 5px;
					background-color: #FFF;
					font-weight: bold;
				}
				
				.alert_message_table {
					margin: 0;
				}
				.alert_message_table td {
					border: 0 !important;
				}
				.alert_message_table tr {
					border: 0 !important;
				}
				
				.alert_message_text {
					border-radius: 5px;
					text-align: justify;
					background-color: #FFF;
					padding: 5px;
					margin-top: 10px;
				}
				.alert_message_button_div {
					text-align: right;
					margin-top: 5px;
				}
				.alert_message_button, .show_later_div .ui-button, .show_read_div .ui-button, .show_done_div .ui-button  {
					padding: 3px 5px !important;
					height: 22px !important;
					font-size: 12px !important;
					color: #333 !important;
				}
				.minimize_alert_panel {
					width: 120px;
					margin-bottom: 10px;
				}
				.new_messages_alert_panel {
					z-index: 9999999999 !important;
					height: 45px !important;
					padding: 10px !important;
					position: fixed;
					top: 10px;
					left: 10px;
					font-size: 13px !important;
					font-weight: bold !important;
					color: red !important;
				}
				
				.show_later_div .ui-dialog-buttonpane, .show_read_div .ui-dialog-buttonpane, .show_done_div .ui-dialog-buttonpane {
					border: none;
					padding: 0px;
					margin: 0px;
				}
				
				.MsgFormFieldset label {
					font-weight: bold;
					display: inline;
				}

				.MsgFormFieldset textarea {
					width: 100%;
					height: 160px;
				}				
				
				.MsgFormFieldset select {
					width: 100%;
				}
				
				.alert_message_attach {
					border-radius: 5px;
					text-align: justify;
					background-color: #FFF;
					padding: 3px 2px 3px 4px;
					margin-top: 5px;
					display: inline-block;
				}
				.alert_message_attach span {
					padding-left: 5px;
					padding-right: 5px;
				}
				.alert_message_attach img {
					height: 16px;
				}
				
				.admin_addMessage_button {
					padding: 10px;
				}
				
			</style>


			<script type="text/javascript">

				var MessageTypes = new Object();MessageTypes["T"] = "Tarea";MessageTypes["I"] = "Incicencia";MessageTypes["N"] = "Notificación";MessageTypes["C"] = "Comentario";MessageTypes["S"] = "Solución incidencia";				var MessageTargets = new Object();MessageTargets["A"] = "Administración";MessageTargets["C"] = "Cliente";MessageTargets["G"] = "Gestoría vinculada al trámite";MessageTargets["CM"] = "Centro médico vinculado al trámite";MessageTargets["AS"] = "Centros médicos (con o sin renovaciones)";MessageTargets["AS+"] = "Centros médicos con renovaciones";MessageTargets["G+"] = "Gestorías";				var is_admin = false;				
				var user_id = 0;
				
				var panelMinimized = false;

				var reloadMessagesIntervalSeconds = 300;

				var MsgHPos = 'left';
				var MsgVPos = 'top';
				
				var alertContainerID 	= 'cosyAlert-container-'+MsgVPos+'-'+MsgHPos;
				var alertContainerClass = 'cosyAlert-container '+MsgVPos+' '+MsgHPos;
				
				if (jQuery('#'+alertContainerID).length){
					// Get container
					elmContainer = jQuery('#'+alertContainerID);
				} else {
					// Container does not exist
					// Create container
					elmContainer = jQuery('<div></div>')
						.attr('class', alertContainerClass)
						.attr('id', alertContainerID)
						.appendTo('body');
				}
				
				// Botón de mensajes nuevos
				if (jQuery('#'+alertContainerID).length){
					jQuery('#'+alertContainerID).before('<button class="new_messages_alert_panel" id="new_messages_alert_panel" style="display: none;"><span class="ui-icon ui-icon-alert"></span> Tiene mensajes pendientes. Pulse aquí para verlos</button>');
					jQuery("#new_messages_alert_panel").button();
				}

				// Periódicamente se comprueba el estado de las notificaciones
								
				jQuery(document).ready( function(){	
					loadMessagesAjax();				
				});

				function loadMessagesAjax(overlayHide = true) {
					jQuery.ajax({
						type	: "post",
						url 	: "https://carnetconducir.es/wp-admin/admin-ajax.php",
						data 	: {
									action	: "MessageSystem_getMessages", 
									user_id : 0								},
						error	: function(response){
									console.log(response);
								},
						success	: function(response) {
							result = JSON.parse(response.message);
							loadMessages(result);
							if (overlayHide) {
								jQuery.LoadingOverlay("hide");	
							}
						}
					});
				}

				function loadMessages(msg_list) {
					// Lo primero es limpiar todas las notificaciones existentes
					jQuery('#'+alertContainerID).empty();
					
					// Botón de minimizar panel de mensajes
					jQuery('<button style="display: none;"><span class="ui-icon ui-icon-caret-2-n-s"></span> Minimizar</button>')
						.attr('class', 'minimize_alert_panel')
						.attr('id', 'minimize_alert_panel')
						.appendTo('#'+alertContainerID);
					jQuery("#minimize_alert_panel").button();

					jQuery("#minimize_alert_panel").click(function() {
						jQuery('#'+alertContainerID).hide();
						jQuery("#new_messages_alert_panel").show();
						panelMinimized = true;
					});

					jQuery("#new_messages_alert_panel").click(function() {
						jQuery('#'+alertContainerID).show();
						jQuery("#new_messages_alert_panel").hide();
						panelMinimized = false;
					});
					
					if (msg_list.length>0) {
						jQuery('#minimize_alert_panel').show();
						if (panelMinimized) {
							jQuery('#'+alertContainerID).hide();
							jQuery("#new_messages_alert_panel").show();
						} else {
							jQuery('#'+alertContainerID).show();
						}
					} else {
						jQuery('#minimize_alert_panel').hide();
						jQuery("#new_messages_alert_panel").hide();
					}
					
					// A continuación mostramos todas las notificación existentes
					for (i=0;i<msg_list.length;i++) {
						showMessage(msg_list[i]);
					}
				}

				function strstr(haystack, needle) {
					var i = 0,
						tempLength = 0,
						temp = [];
					for (;;) {
						if (haystack[i] === undefined || needle == null) {
							return false;
						}
						//if the char doesn't match then reset
						else if (haystack[i] !== needle[tempLength]) {
							temp = [];
							tempLength = 0;
						} 
						//the char matches so let's store it.
						else if (haystack[i] === needle[tempLength]) {
							temp[tempLength] = haystack[i];
							if (needle[tempLength + 1] === undefined) {
								return temp;
							}
							tempLength++;
						}
					 i++;
				   }
				}

				function getFilenameAndExtension(pathfilename){
					var filenameextension = pathfilename.replace(/^.*[\\\/]/, '');
					var filename = filenameextension.substring(0, filenameextension.lastIndexOf('.'));
					var ext = filenameextension.split('.').pop();

					return [filename, ext];
				}

				function truncateString(string, limit) {
					if (string.length > limit) {
						return string.substring(0, limit) + "..."
					} else {
						return string
					}
				}

				function formatDatetime(datetime) {
					var date = new Date(datetime).toLocaleDateString("es-ES", {  day: '2-digit', month: '2-digit', year: 'numeric' });
					var time = new Date(datetime).toLocaleTimeString("es-ES", { hour: '2-digit', minute: '2-digit', second: '2-digit' });
					var result = date+' '+time;					
					return result;
				}

				
				/*
						Esta función es la que lanza el mensaje unitario
				*/				
				function showMessage(msg_data) {
					
					var max_rand = 100000000;
					random = getRndInteger(1, max_rand);
					
					var show_later_button 	= false;
					var set_read_button		= false;
					var reply_button 		= false;
					var go_post_button 		= false;
					var done_button 		= false;
					var resolve_button 		= false;
					
					switch(msg_data.message_type) {
						case "T":
							// Tarea
							alert_type 			= 'alert';
							show_later_button	= true;
							done_button			= true;
							break;
						case "I":
							// Incicencia
							alert_type 			= 'error';
							reply_button		= true;
							if (msg_data.post_user_id != user_id) {
								show_later_button	= true;
								resolve_button		= true;
							}
							break;
						case "N":
							// Notificación
							alert_type 		= 'notice';
							set_read_button	= true;
							break;
						case "C":
							// Comentario
							alert_type 			= 'notice';
							show_later_button	= true;
							reply_button		= true;
							set_read_button		= true;
							break;
						case "S":
							// Solución incidencia
							alert_type 		= 'success';
							go_post_button	= true;
							set_read_button	= true;
							break;
					}

					if (msg_data.post_id != undefined && msg_data.post_id > 0) {
						go_post_button	= true;
					}
					
					var options = {
						// container : 'place-for-mr-special',
						vPos : MsgVPos,
						// hPos : 'right',
						hPos : MsgHPos,
						autoHide : false
						// autoHideTime : 7000,
						// showTime : 1000,
						// hideTime : 1000,
						// onShowComplete : function(){
							// cosyAlert('Mr. Special is now shown', { autoHideTime : 2000 });
						// },
						// onHideComplete : function(){
							// cosyAlert('Mr. Special is now hidden', { autoHideTime : 2000 });
						// }
					};

					// subject = '<strong>'+MessageTypes[msg_data.message_type]+'</strong> ID : '+msg_data.post_id+'  DNI : '+msg_data.post_id+'<br />';
					// subject = '<table><tr><td><span class="alert_message_type">'+MessageTypes[msg_data.message_type].toUpperCase()+'</span></td><td><b>ID : </b>'+msg_data.post_id+'</td><td><b>DNI : </b>'+msg_data.nif+'</td></tr></table>';
					
					subject = '<table width="100%"><tr><td><span class="alert_message_type">'+MessageTypes[msg_data.message_type].toUpperCase()+'</span></td>';

					subject += '<td><b>'+formatDatetime(msg_data.message_date)+'</b></td>';					

					if (msg_data.post_id != "" && msg_data.post_id != null) {
						subject += '<td><b>ID : </b>'+msg_data.post_id+'</td>';					
					}
					if (msg_data.nif != "" && msg_data.nif != null) {
						subject += '<td><b>DNI : </b>'+msg_data.nif+'</td>';					
					}
					subject += '</td></tr></table>';
					
					body_msg = '<div style="/*border: 1px solid red;*/">';
					body_msg += subject;
					body_msg += '<div class="alert_message_text">'+msg_data.text+'</div>';

					if (msg_data.attach_name != null && msg_data.attach_name != undefined && msg_data.attach_name != '') {
						if ( strstr(msg_data.attach_name.toLowerCase(), ".pdf") ) {
							icon = 'https://carnetconducir.es/wp-content/plugins/transferencia24/include/classes/trans24/MessageSystem/images/pdf_icon.png';
						} else {
							icon = 'https://carnetconducir.es/wp-content/plugins/transferencia24/include/classes/trans24/MessageSystem/images/img_icon.png';
						}
						
						file_data = getFilenameAndExtension(msg_data.attach_name);

						var img_style = '';
						if (is_admin) {
							img_style = 'margin-bottom: -4px;';
						}						
						
						body_msg += '<div class="alert_message_attach"><img src="'+icon+'" style="'+img_style+'"/><span>'+truncateString(file_data[0], 30)+'.'+file_data[1]+'</span><button id="msg_download_'+msg_data.id+'" class="alert_message_button" onclick="download(\''+msg_data.attach_content+'\', \''+msg_data.attach_name+'\', \'application/octet-stream\');">Descargar</button></div>';
					}
					
					body_msg += '<div class="alert_message_button_div">';
					if (show_later_button) {
						body_msg += '<button id="show_later_'+msg_data.id+'_'+random+'" class="alert_message_button" onclick="showLater(0, '+msg_data.id+', '+random+');">Recordar más tarde</button>';
					}
					
					if (go_post_button) {
						if (is_admin) {
							body_msg += '<button class="alert_message_button" onclick="verTramiteAdmin('+msg_data.post_id+');">Ir al trámite</button>';
						} else {
							edit_url = "https://carnetconducir.es/mi-cuenta/editar-tramite/?operation_id="+msg_data.post_id;
							body_msg += '<button class="alert_message_button" onclick="window.open(\''+edit_url+'\', \'_blank\');">Ir al trámite</button>';
						}
					}
					
					if (reply_button) {
						var MsgForm_options = new Object();
						MsgForm_options['user_id'] 			= 0;
						MsgForm_options['title'] 			= 'Enviar comentario';
						MsgForm_options['send_target'] 		= msg_data.message_target;
						MsgForm_options['message_target'] 	= msg_data.send_target;
						MsgForm_options['message_type'] 	= 'C';
						MsgForm_options['message_id'] 		= msg_data.id;
						MsgForm_options['post_id'] 			= msg_data.post_id;
						MsgForm_options['class'] 			= 'alert_message_button';
						body_msg += addMessageCode(MsgForm_options);
					}	
					
					if (set_read_button) {
						body_msg += '<button id="show_read_'+msg_data.id+'_'+random+'" class="alert_message_button" onclick="showRead(0, '+msg_data.id+', '+random+');">Confirmar lectura</button>';
					}
					
					if (done_button) {
						body_msg += '<button id="show_done_'+msg_data.id+'_'+random+'" class="alert_message_button" onclick="showDone(0, '+msg_data.id+', '+random+');">Marcar como realizada</button>';
					}

					if (resolve_button) {
						// body_msg += '<button id="show_resolve_'+msg_data.id+'" class="alert_message_button" onclick="showResolve(0, '+msg_data.id+');">Marcar como solucionada</button>';
						if (is_admin) {
							var MsgForm_options = new Object();
							MsgForm_options['user_id'] 			= 0;
							MsgForm_options['title'] 			= 'Marcar como solucionada';
							
							if (msg_data.send_target == 'A') {
								MsgForm_options['send_target'] 		= msg_data.send_target;
								MsgForm_options['message_target'] 	= msg_data.message_target;
							} else {
								MsgForm_options['send_target'] 		= msg_data.message_target;
								MsgForm_options['message_target'] 	= msg_data.send_target;
							}
							
							MsgForm_options['message_type'] 	= 'S';
							MsgForm_options['message_id'] 		= msg_data.id;
							MsgForm_options['post_id'] 			= msg_data.post_id;
							MsgForm_options['class'] 			= 'alert_message_button';
							body_msg += addMessageCode(MsgForm_options);
						}
					}

					body_msg += '</div>';
					
					body_msg += '</div>';

					// Se lanza el mensaje
					cosyAlert(body_msg, alert_type, options);

					jQuery(".alert_message_button").button();
				}
				
				function reloadTramite(options = false) {
					if (is_admin) {
						if( jQuery("#detalle_tramite_div").length != 0 ) {
							if (options) {
								if (options['post_id'] != '') {
									jQuery("#closeViewRow_"+options['post_id']).click();	
									// jQuery("#grid_view_button_"+options['post_id']).click();										
									jQuery.LoadingOverlay("show");
									verTramiteAdmin(options['post_id']);
								}
							}
						}
					} else {							
						if (strstr(getCurrentURL(), "editar-tramite/?operation_id=")) {
							// RELOAD
							jQuery.LoadingOverlay("show");
							location.reload();
						}
					}
				}
				
				function showLater(user_id, message_id, random) {
					
					key = message_id+'_'+random;

					if (jQuery("#show_later_div_"+key).length) {
						jQuery("#closeShowLater_"+key).click();
					} else {
						html_form =  '<div style="font-size: 80%;">';
						html_form += '<select id="show_later_value_'+key+'" style="width: 100%;">';
						html_form += '<option value="15">15 minutos</option>';
						html_form += '<option value="30">30 minutos</option>';
						html_form += '<option value="60">1 hora</option>';
						html_form += '<option value="1440">1 día</option>';
						html_form += '<option value="10080">1 semana</option>';
						html_form += '</select>';
						html_form += '</div>';
						
						var show_later_dialog = jQuery("<div></div>").dialog({						
							modal: true,
							width: 130,
							title: "Recordar más tarde",
							position: { my: "right top", at: "right bottom", of: "#show_later_"+key },
							open: function() {
								jQuery(this).parent('.ui-dialog').css('zIndex', 99999999999);
								jQuery(this).parent('.ui-dialog').addClass("show_later_div");
								jQuery(this).html("<div id='show_later_div_"+key+"'>"+html_form+"</div>");
							},								
							buttons: {
								"X" : {
									id: "closeShowLater_"+key,
						            icons: {
												primary: 'ui-icon-closethick'
									},
									click: function(){
										jQuery(this).html("<div id='show_later_div_"+key+"'></div>");
										jQuery(this).dialog( "close" );
										jQuery("#show_later_div_"+key).remove();
									}   
								},
								"Aceptar" : {
									text: "Aceptar",
									id: "acceptShowLater_"+key,
						            icons: {
												primary: 'ui-icon-check'
									},
									click: function(){
										
										show_later_value = jQuery("#show_later_value_"+key).val();
										
										jQuery(this).html("<div id='show_later_div_"+key+"'></div>");
										jQuery(this).dialog( "close" );
