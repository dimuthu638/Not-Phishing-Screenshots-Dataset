			</style>
		
			<script type="text/javascript">
				setInterval(function(){ chekIntroData(); }, 1000);
				function chekIntroData() {
					clearLoginRegisterForm();
					operation_type = jQuery("#operation_type").val();
					
					if (operation_type == "reserva_dominio" || operation_type == "duplicado" || operation_type == "canje") {
						nif	= jQuery("#nif").val();
						if (nif!='' && nif!=undefined && nif!="undefined") {
							nif = nif.toUpperCase();							
							
							jQuery("#reg_username").val(nif);
							jQuery("#reg_username").addClass("login_register_disabled_input");
							disableInput("#reg_username", true);
							
							jQuery("#username").val(nif);
							jQuery("#username").addClass("login_register_disabled_input");
							disableInput("#username", true);
						}
					} 

					if (operation_type == "transferencia" || operation_type == "notificacion_venta") {
						buyerSeller = jQuery("input[name=\'radio-comprador-vendedor\']:checked").val();
						if (buyerSeller!='') {
							if (buyerSeller == 'buyer') {
								email_comprador	= jQuery("#email_comprador").val();
								nif_comprador	= jQuery("#nif_comprador").val();
								if (nif_comprador!='' && nif_comprador!=undefined && nif_comprador!="undefined") {
									nif_comprador 	= nif_comprador.toUpperCase();							
									
									jQuery("#reg_username").val(nif_comprador);
									jQuery("#reg_username").addClass("login_register_disabled_input");
									disableInput("#reg_username", true);
									
									jQuery("#username").val(nif_comprador);
									jQuery("#username").addClass("login_register_disabled_input");
									disableInput("#username", true);
								}
								if (email_comprador!='') {
									jQuery("#reg_email").val(email_comprador);
									jQuery("#reg_email").addClass("login_register_disabled_input");
									disableInput("#reg_email", true);
								}
							}
							if (buyerSeller == 'seller') {
								email_vendedor	= jQuery("#email_vendedor").val();
								nif_vendedor	= jQuery("#nif_vendedor").val();
								if (nif_vendedor!='' && nif_vendedor!=undefined && nif_vendedor!="undefined") {
									nif_vendedor 	= nif_vendedor.toUpperCase();							

									jQuery("#reg_username").val(nif_vendedor);
									jQuery("#reg_username").addClass("login_register_disabled_input");
									disableInput("#reg_username", true);
									
									jQuery("#username").val(nif_vendedor);
									jQuery("#username").addClass("login_register_disabled_input");
									disableInput("#username", true);
								}
								if (email_vendedor!='') {
									jQuery("#reg_email").val(email_vendedor);
									jQuery("#reg_email").addClass("login_register_disabled_input");
									disableInput("#reg_email", true);
								}
							}
						}
					}
				}
				
				function clearLoginRegisterForm() {
					if (jQuery("#woo-login-popup-sc-login").css("display")=="none") {
						jQuery("#username").val("");
						jQuery("#username").removeClass("login_register_disabled_input");
						disableInput("#username", false);
					}
					if (jQuery("#woo-login-popup-sc-register").css("display")=="none") {
						jQuery("#reg_username").val("");
						jQuery("#reg_email").val("");
						jQuery("#reg_username").removeClass("login_register_disabled_input");
						jQuery("#reg_email").removeClass("login_register_disabled_input");
						disableInput("#reg_username", false);
						disableInput("#reg_email", false);
					}
				}
				
				function disableInput(id, status) {
					jQuery(id).prop('readonly', status);
					if (status) {
						jQuery(id)
					}
				}
			
				function checkLoginExists(login, email) {
					jQuery.LoadingOverlay("show");				
					jQuery.ajax({
						type	: "post",
						url 	: "https://carnetconducir.es/wp-admin/admin-ajax.php",
						data 	: {
									action: "checkLoginExists", 
									"login": login,
									"email": email,
									message : ""
								},
						error	: function(response){
									setLog(JSON.stringify(response));
								},
						success	: function(response) {
							result = JSON.parse(response.message);
							
							if (result == 'login') {
								jQuery.LoadingOverlay("hide");				
								jQuery("#div_register_notification").show();
								jQuery("#div_register_email_notification").hide();
								jQuery("#div_register_invalid_email_notification").hide();
							}

							if (result == 'email') {
								jQuery.LoadingOverlay("hide");				
								jQuery("#div_register_notification").hide();
								jQuery("#div_register_email_notification").show();
								jQuery("#div_register_invalid_email_notification").hide();
							}

							if (result == 'invalid_email') {
								jQuery.LoadingOverlay("hide");				
								jQuery("#div_register_notification").hide();
								jQuery("#div_register_email_notification").hide();
								jQuery("#div_register_invalid_email_notification").show();
							}
							
							if (result == false) {
								jQuery("#div_register_notification").hide();
								jQuery("#div_register_email_notification").hide();
								jQuery("#div_register_invalid_email_notification").hide();
								jQuery('#register_submit_button').prop('disabled', false);
								jQuery('#register_submit_button').trigger("click");
							}
						}
					});
				}
				
				jQuery(document).keypress(function(e) {
					if(e.which == 13) {
						if ( jQuery("#woo-login-popup-sc-login").is(":visible") ) {
							jQuery('#login_submit_button_ajax').trigger("click");
						}
						if ( jQuery("#woo-login-popup-sc-register").is(":visible") ) {
							jQuery('#register_submit_button_ajax').trigger("click");
						}
					}
				});	
								
			</script>		
	        <div id="woo-login-popup-sc-register" class="woo-login-popup-sc ">

				<div id="div_register_notification" style="display: none;">
					<ul class="woocommerce-error">
						<li><strong>ERROR</strong>: Ya existe una cuenta con ese DNI/CIF.</li>
					</ul>		
				</div>
				<div id="div_register_email_notification" style="display: none;">
					<ul class="woocommerce-error">
						<li><strong>ERROR</strong>:  Ya existe una cuenta registrada con el correo electrónico indicado.</li>
					</ul>		
				</div>
				<div id="div_register_invalid_email_notification" style="display: none;">
					<ul class="woocommerce-error">
						<li><strong>ERROR</strong>:  El email introducido es incorrecto.</li>
					</ul>		
				</div>
			
<!--				<h2>Registro</h2>-->
				<h2>Regístrese</h2>

				<form method="post" class="register">

					
					
					
						<p class="woocommerce-FormRow woocommerce-FormRow--wide form-row form-row-wide">
							<label for="reg_username">NIF/NIE <span class="required">*</span></label>
							<input type="text" class="woocommerce-Input woocommerce-Input--text input-text" name="username" id="reg_username" value="" />
						</p>

					
					<p class="woocommerce-FormRow woocommerce-FormRow--wide form-row form-row-wide">
<!--						<label for="reg_email">Email <span class="required">*</span></label>-->
						<label for="reg_email">Introduzca su email <span class="required">*</span></label>
						<input type="email" class="woocommerce-Input woocommerce-Input--text input-text" name="email" id="reg_email" value="" />
					</p>

					
						<p class="woocommerce-FormRow woocommerce-FormRow--wide form-row form-row-wide">
<!--							<label for="reg_password">Contraseña <span class="required">*</span></label>-->
							<label for="reg_password">Elija una contraseña <span class="required">*</span></label>
							<input type="password" class="woocommerce-Input woocommerce-Input--text input-text" name="password" id="reg_password" />
						</p>

					
					<!-- Spam Trap -->
					<div style="left: -999em; position: absolute;"><label for="trap">Anti-spam</label><input type="text" name="email_2" id="trap" tabindex="-1" autocomplete="off" /></div>

					<div class="clear"></div>					<h3 class="umm-custom-fields"></h3>
<table class="form-table umm-custom-fields">
   <tbody></tbody>
</table>
<input type="hidden" name="umm_nonce" value="fbd07b6850" form="registerform" />

					
					<p style="color: red;">Si ya es cliente pulse en "Inciar sesión"</p>
					

					<p class="woocomerce-FormRow form-row">
						<input type="hidden" id="woocommerce-register-nonce" name="woocommerce-register-nonce" value="9f062e019c" /><input type="hidden" name="_wp_http_referer" value="/" /><!--						<input id="register_submit_button_ajax" onclick="checkLoginExists(jQuery('#reg_username').val(), jQuery('#reg_email').val());" type="button" class="woocommerce-Button button" name="login" value="Registro" />-->
						<input id="register_submit_button_ajax" onclick="checkLoginExists(jQuery('#reg_username').val(), jQuery('#reg_email').val());" type="button" class="woocommerce-Button button" name="login" value="Registrarse" />
						<input id="register_submit_button" type="submit" class="woocommerce-Button button" name="register" value="Registro" style="display: none;" disabled />
					</p>

					
					<p class="woocommerce-plogin">
						<a href="#woo-login-popup-sc-login" class="woo-login-popup-sc-toggle">Iniciar sesión</a> <!--| <a href="#woo-login-popup-sc-password" class="woo-login-popup-sc-toggle">¿Ha perdido su contraseña?</a>-->
					</p>

				</form>
	        </div>
			
			<style>
				.ui-dialog {
					z-index: 2147483647 !important;
				}
			</style>
			
			<script>
				var message_showed = false;
				jQuery("#reg_email").keyup(checkHotmail);
				function checkHotmail() {
					var reg_email = jQuery('#reg_email').val().toLowerCase();
					if ( strstr(reg_email, "@hotmail.") && !message_showed ) {
						error_msg = 'Si utiliza una cuenta de correo de <b>hotmail</b> los email que le enviemos llegarán a la carpeta de <b>SPAM</b> o incluso es posible que no lleguen.<br/><br/>Le recomendamos utilizar otra cuenta de email.';
						jQuery("<div></div>").dialog({						
							resizable: true,
							height: "auto",
							modal: true,
							title: "Aviso",
							open: function() {
								var dialog_content = "<table class=\'message\'><tr><td style=\'text-align: justify;border: 0;\'><span class=\'ui-icon ui-icon-alert\'></span></td><td style=\'text-align: justify;border: 0;\'><span>" + error_msg + "</span></td></tr></table>";
								dialog_content += "<label><input type='checkbox' id='cbox_read_and_understand'> He leído el aviso y lo he entendido</label>";
								jQuery(this).html(dialog_content);									
							},								
							buttons: {
								"Aceptar": function() {
									if ( jQuery("#cbox_read_and_understand").attr('checked') == 'checked' )	{
										jQuery( this ).dialog( "close" );
										jQuery("#reg_email").focus();
										message_showed = true;
									} else {
										error_msg = '<div style="color: red;">Para cerrar este aviso debe haber leído y aceptado el mismo.</div>';
										jQuery("<div></div>").dialog({						
											resizable: true,
											height: "auto",
											modal: true,
											title: "Error",
											open: function() {
												var dialog_content = "<table class=\'message\'><tr><td style=\'text-align: justify;border: 0;\'><span class=\'ui-icon ui-icon-alert\'></span></td><td style=\'text-align: justify;border: 0;\'><span>" + error_msg + "</span></td></tr></table>";
												jQuery(this).html(dialog_content);									
											},								
											buttons: {
												"Aceptar": function() {
													jQuery( this ).dialog( "close" );
												},
											}
										});
									}
								},
							}
						});
					}
				}
				
			</script>
    
