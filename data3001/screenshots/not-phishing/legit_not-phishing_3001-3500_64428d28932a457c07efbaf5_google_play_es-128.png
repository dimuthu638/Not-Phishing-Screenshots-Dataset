				function verTramiteAdmin(post_id) {
					
					jQuery.LoadingOverlaySetup({
						image           : "https://carnetconducir.es/wp-content/plugins/transferencia24/images/loadingOverlay.gif",
						maxSize         : "80px",
						minSize         : "20px",
						resizeInterval  : 0,
						size            : "50%"
					});
					
					jQuery.LoadingOverlay("show");				
					
					jQuery.ajax({
						type	: "post",
						url 	: "https://carnetconducir.es/wp-admin/admin-ajax.php",
						data 	: {
									action		: "detalleTramite", 
									"post_id"	: post_id,
									message 	: "",
								},
						error	: function(response){
									jQuery.LoadingOverlay("hide");				
								},
						success	: function(response) {
							detalle_tramite = JSON.parse(response.message);
							jQuery("<div id='detalle_tramite_div'></div>").dialog({						
								resizable: true,
								width: 1000,
								height: 800,
								modal: true,
								title: "Detalles del trámite",
								open: function() {
									// jQuery('.ui-dialog').css('z-index',99999999999);
									jQuery(this).html("<div id='detalle_tramite_div'></div>");
									jQuery(this).html('<div id="detalle_tramite_div">'+detalle_tramite+'</div>');
									jQuery.LoadingOverlay("hide");				
									jQuery.LoadingOverlay("hide");				
								},								
								buttons: {
									"Cerrar" : {
										text: "Cerrar",
										id: "closeViewRow_"+post_id,
										click: function(){
											jQuery(this).html("<div id='detalle_tramite_div'></div>");
											jQuery(this).dialog( "close" );
											jQuery("#detalle_tramite_div").remove();
										}   
									} 
								}
							});
						}
					});
				}

				function getRndInteger(min, max) {
					return Math.floor(Math.random() * (max - min) ) + min;
				}

				function getCurrentURL() {
					return window.location.href;
				}
				
				function encodeBase64(data) {
					if (typeof btoa === "function") {
						return btoa(data);
					} else if (typeof Buffer === "function") {
						return Buffer.from(data, "utf-8").toString("base64");
					} else {
						throw new Error("Failed to determine the platform specific encoder");
					}
				}

				function decodeBase64(data) {
					if (typeof atob === "function") {
						return atob(data);
					} else if (typeof Buffer === "function") {
						return Buffer.from(data, "base64").toString("utf-8");
					} else {
						throw new Error("Failed to determine the platform specific decoder");
					}
				}

				function addMessageCode(options) {
					var max_rand = 100000000;
					key = 'MS_addMessage_'+getRndInteger(1, max_rand)+'_'+getRndInteger(1, max_rand);
					
					return '<button id="'+key+'_button" title="'+options['title']+'" class="'+options['class']+'" onclick="addMessageForm(\''+key+'\', \''+encodeBase64(JSON.stringify(options))+'\');">'+options['title']+'</button>';
				}

				function addMessageForm(key, options_encoded) {
					
					jQuery.LoadingOverlaySetup({
						image           : "https://carnetconducir.es/wp-content/plugins/transferencia24/images/loadingOverlay.gif",
						maxSize         : "80px",
						minSize         : "20px",
						resizeInterval  : 0,
						size            : "50%"
					});
					
					var options = JSON.parse(decodeBase64(options_encoded))
					var hide_target = false;
					var hide_type	= false;
					
					form_content = '<fieldset class="MsgFormFieldset">';
					form_content += '<div id="message_target_div_'+key+'">';
					form_content += '<label for="message_target_'+key+'">Destinatario de la notificación</label>';
					form_content += '<select name="message_target_'+key+'" id="message_target_'+key+'">';
					form_content += '<option value="">- SELECCIONE EL DESTINATARIO -</option>';
					
					var targetsList = MessageTargets;
					if (options["message_target"] != undefined) {
						if ( Array.isArray(options["message_target"]) ) {
							var targetsList = new Object();
							for (i=0;i<options["message_target"].length;i++) {
								targetsList[options["message_target"][i]] = MessageTargets[options["message_target"][i]];
							}	
						}
					}
					Object.keys(targetsList).forEach(for_key => {
						selected = ""
						if (options["message_target"] != undefined) {
							if ( !Array.isArray(options["message_target"]) ) {
								if ( options['message_target'] != '' && options['message_target'] == for_key ) {
									selected 	= "selected";
									hide_target = true;
								}
							}
						}
						form_content += '<option value="'+for_key+'" '+selected+'>'+targetsList[for_key]+'</option>';
					});						
					
					form_content += '</select>';
					form_content += '</div>';

					form_content += '<div id="message_type_div_'+key+'">';
					form_content += '<label for="message_type_'+key+'">Tipo de notificación</label>';
					form_content += '<select name="message_type_'+key+'" id="message_type_'+key+'">';
					form_content += '<option value="">- SELECCIONE EL TIPO DE NOTIFICACIÓN -</option>';
					
					var MessageTypesList = MessageTypes;
					if (options["message_type"] != undefined) {
						if ( Array.isArray(options["message_type"]) ) {
							var MessageTypesList = new Object();
							for (i=0;i<options["message_type"].length;i++) {
								MessageTypesList[options["message_type"][i]] = MessageTypes[options["message_type"][i]];
							}	
						}
					}
					Object.keys(MessageTypesList).forEach(for_key => {
						selected = ""
						if (options["message_type"] != undefined) {
							if ( !Array.isArray(options["message_type"]) ) {
								if ( options['message_type'] != '' && options['message_type'] == for_key ) {
									selected 	= "selected";
									hide_type = true;
								}
							}
						}
						form_content += '<option value="'+for_key+'" '+selected+'>'+MessageTypesList[for_key]+'</option>';
					});						
					form_content += '</select>';
					form_content += '</div>';
						
					form_content += '<label for="message_text_'+key+'">Descripción de la notificación</label>';
					form_content += '<textarea name="message_text_'+key+'" id="message_text_'+key+'"></textarea>';
					
					form_content += '<div class="Msg_AttachFile">';
					form_content += '<label for="Msg_AttachFile_'+key+'">Adjunte un archivo</label>';
					form_content += '<input type="file" id="Msg_AttachFile_'+key+'" name="Msg_AttachFile_'+key+'" accept="image/png, image/jpeg, image/jpg, application/pdf">';
					form_content += '<input type="hidden" name="Msg_AttachFileName_'+key+'" id="Msg_AttachFileName_'+key+'">';
					form_content += '<input type="hidden" name="Msg_AttachFileContent_'+key+'" id="Msg_AttachFileContent_'+key+'">';
					form_content += '</div>';
					
					form_content += '</fieldset>';


					jQuery("<div id='"+key+"_div'></div>").dialog({						
								resizable: true,
								width: 400,
								modal: true,
								position: {
									my: "center",
									at: "center",
									of: window
								},								
								title: options['title'],
								open: function() {
									// jQuery(".ui-dialog").css("z-index",99999999999);
									// jQuery("#"+key).css("z-index",99999999999);
									
									// jQuery(this).html("<div id='"+key+"_div'></div>"+form_content+"</div>");
									jQuery(this).html(form_content);
									
									if (hide_target) {
										jQuery("#message_target_div_"+key).hide();
									}
									if (hide_type) {
										jQuery("#message_type_div_"+key).hide();
									}
									
									jQuery("body").css('min-height', '850px');
									
									var win = jQuery(window);
									jQuery(this).parent().css({
										position: 'absolute',
										left: (win.width() - jQuery(this).parent().innerWidth()) / 2,
										top: jQuery(this).parent().position().top - jQuery(this).outerHeight() / 2
									});	

									// Anexar archivo - START
									const fileInput = document.querySelector('input[id="Msg_AttachFile_'+key+'"]');
									const reader = new FileReader();

									function handleEvent(event) {
										if (event.type === "loadend") {
											jQuery("#Msg_AttachFileContent_"+key).val(reader.result);						
										}
									}

									function addListeners(reader) {
										reader.addEventListener('loadend', handleEvent);
									}

									function handleSelected(e) {
										const selectedFile = fileInput.files[0];
										if (selectedFile) {
											jQuery("#Msg_AttachFileName_"+key).val(selectedFile.name);	

											var ext = selectedFile.name.split('.').pop().toLowerCase();
											if (ext == 'png' || ext == 'jpg' || ext == 'jpeg' || ext == 'pdf') {
												addListeners(reader);
												reader.readAsDataURL(selectedFile);
											} else {
												alert("Tipo de archivo no válido.");
												fileInput.value = "";
											}
										}
									}

									fileInput.addEventListener('change', handleSelected);
									// Anexar archivo - END
								},								
								buttons: {
									"Cancelar" : {
										text: "Cancelar",
										id: "cancel_"+key,
										click: function(){
											jQuery(this).dialog( "close" );
											jQuery("#"+key+"_div").remove();
										}   
									},
									"Enviar mensaje" : {
										text: options['title'],
										id: "ok_"+key,
										click: function(){

											jQuery.LoadingOverlay("show");
											
											options['message_type'] 			= jQuery("#message_type_"+key).val();
											options['message_target'] 			= jQuery("#message_target_"+key).val();
											options['message_text'] 			= jQuery("#message_text_"+key).val();
											options['message_attach_name'] 		= jQuery("#Msg_AttachFileName_"+key).val();
											options['message_attach_content'] 	= jQuery("#Msg_AttachFileContent_"+key).val();

											if (options['message_type']=="S") {
												if (options['message_text']=="") {
													options['message_text'] = "Incicencia solucionada";
												}
											}
											
											validate = MS_ValidateMessageForm(options);

											if (!validate['error']) {
												MS_SendMessage(options);
												jQuery(this).dialog( "close" );
											} else {
												jQuery.LoadingOverlay("hide");
												var dialog_content = "<table><tr><td style=\'border: none;\'><span class=\'ui-icon ui-icon-circle-close\'></span></td><td style=\'text-align: justify; border: none;\'><span>" + validate['text'] + "</span></td></tr></table>";
												jQuery("<div id='"+key+"_validate_div'></div>").dialog({						
													resizable: true,
													modal: true,
													title: options['title']+" - Error",
													open: function() {
														// jQuery(".ui-dialog").css("z-index",99999999999);
														// jQuery("#"+key+"_validate_div").css("z-index",99999999999);
														jQuery(this).html("<div id='"+key+"_validate_div'></div>"+dialog_content+"</div>");
														
														var win = jQuery(window);
														jQuery(this).parent().css({
															position: 'absolute',
															left: (win.width() - jQuery(this).parent().outerWidth()) / 2,
															top: (win.height() - jQuery(this).parent().outerHeight()) / 2
														});	
													},								
													buttons: {
														"Aceptar" : {
															text: "Aceptar",
															click: function(){
																jQuery(this).dialog( "close" );
															}   
														}
													}
												});
											}
										}   
									} 
								}
					});
				}
				
				
				
				function MS_ValidateMessageForm(options) {
					var result 		= new Object;
					result['error'] = false;
					result['text'] 	= '';
			
					if (!result['error'] && options['message_target']=="") {
						result['error'] = true;
						result['text'] 	= "Por favor, seleccione el destinatario de la notificación.";
					}
					if (!result['error'] && options['message_type']=="") {
						result['error'] = true;
						result['text'] 	= "Por favor, seleccione el tipo de notificación.";
					}
					
					if (!result['error'] && options['message_text']=="") {
						result['error'] = true;
						result['text'] 	= "Por favor, introduzca el texto de la notificación.";
					}

					return result;					
				}
				
				
				
				// function MS_SendMessage(user_id, post_id, message_type, message_target, text) {
				function MS_SendMessage(options) {
					jQuery.ajax({
						type	: "post",
						url 	: "https://carnetconducir.es/wp-admin/admin-ajax.php",
						data 	: {
									action						: "MessageSystem_SendMessage", 
									"user_id" 					: options['user_id'],
									"post_id" 					: options['post_id'],
									"send_target"				: options['send_target'],
									"message_type" 				: options['message_type'],
									"message_target" 			: options['message_target'],
									"text" 						: options['message_text'],
									"parent_message_id"			: options['message_id'],
									"message_attach_name" 		: options['message_attach_name'],
									"message_attach_content" 	: options['message_attach_content'],
								},
						error	: function(response){
									console.log(response);
								},
						success	: function(response) {
							// if (options['message_type']=='S' || options['message_type']=='I') {
								loadMessagesAjax();
							// } else {
								// loadMessagesAjax(false);
							// }
							reloadTramite(options);
						}
					});	
				}				

			</script>
				<div class="woo-login-popup-sc-modal-overlay "></div>
		<div class="woo-login-popup-sc-modal woo-login-popup-sc-modal-on ">
