				<div class="woo-login-popup-sc-left">
										
		<script type="text/javascript">
			function checkLogin(login, password) {
				jQuery.LoadingOverlay("show");				
				jQuery.ajax({
					type	: "post",
					url 	: "https://carnetconducir.es/wp-admin/admin-ajax.php",
					data 	: {
								action: "checkLogin", 
								"login": login,
								"password": password,
								message : ""
							},
					error	: function(response){
								setLog(JSON.stringify(response));
							},
					success	: function(response) {
						result = JSON.parse(response.message);
						if (result == true) {
							jQuery("#div_login_notification").hide();
							jQuery('#login_submit_button').prop('disabled', false);
							jQuery('#login_submit_button').trigger("click");
						} else {
							jQuery.LoadingOverlay("hide");
							jQuery("#div_login_notification").show();
						}
					}
				});
			}
			
			// jQuery(document).keypress(function(e) {
				// if(e.which == 13) {
					// jQuery('#login_submit_button_ajax').trigger("click");
				// }
			// });			
		</script>
		<div id="woo-login-popup-sc-login" class="woo-login-popup-sc woo-login-popup-sc-show ">
