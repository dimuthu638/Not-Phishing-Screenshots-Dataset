		#tpblurfix{filter:blur(20px)}
		@font-face{font-family:'Material Icons'; font-style:normal; font-weight:400;  src:url(//fonts.gstatic.com/s/materialicons/v41/flUhRq6tzZclQEJ-Vdg-IuiaDsNcIhQ8tQ.woff2) format('woff2')}rs-module .material-icons{font-family:'Material Icons'; font-weight:normal; font-style:normal;font-size:inherit; display:inline-block;  text-transform:none; letter-spacing:normal; word-wrap:normal; white-space:nowrap; direction:ltr; vertical-align:top; line-height:inherit;  font-feature-settings:'liga'; -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility; -moz-osx-font-smoothing:grayscale}
		.rs-gradientbox{border-width:20px; border-style:solid;border-image-source:-moz-linear-gradient(top,rgba(94,53,177,1) 0%,rgba(247,52,94,1) 100%); border-image-source:-webkit-linear-gradient(top,rgba(94,53,177,1) 0%,rgba(247,52,94,1) 100%); border-image-source:linear-gradient(to bottom,rgba(94,53,177,1) 0%,rgba(247,52,94,1) 100%);border-image-slice:1}
		.rs-listsmall{font-size:16px; font-weight:300}.rs-listicon{background:#f7345e; width:30px; height:30px; text-align:center; line-height:30px !important; border-radius:15px; margin-top:-4px; margin-right:10px}.rs-listelement{display:inline-block; width:80%}
</style>
