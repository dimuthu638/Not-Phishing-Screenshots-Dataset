 if (bannerItem.querySelectorAll('.background-layer')[1].style.backgroundImage.includes('sil-supur-kampanyasi/414x434.png')) {
        bannerItem.querySelector('.banner-text a').setAttribute('href', 'https://www.turktelekom.com.tr/m/mobil/bana_ozel');  }
        if (bannerItem.querySelectorAll('.background-layer')[1].style.backgroundImage.includes('Kades')) {
