ce_cuadrado">Calcular</span> </a> <a class="cuadrado" href="/web/genesis/tarificador/hogar"> <span class="cuadrado_title">Hogar</span> <span class="mt icon icon-home cuadrado_img "></span> <span class="texto_enlace_cuadrado">Calcular</span> </a> <a class="cuadrado" href="/web/genesis/tarificador/seguro-vida"> <span class="cuadrado_title">Vida</span> <span class="mt icon icon-heart cuadrado_img "></span> <span class="texto_enlace_cuadrado">Calcular</span> </a> </div> <div class="hero_home_img_rizo hide_for_mobile hide_for_tablet"> <img alt="Rizo_Home_2020" data-src="/image/journal/article?img_id=28464763&t=1671088725889" class="lazyload" /> </div> </div> </section> <style type="text/css">.top-bar{padding:0 0 0!important}.hero_home_img_desktop img{height:477px;width:100%}.hero_home_img_mobile img{display:none}.hero_home_2020 .hero_home_title{text-transform:none;color:#203763;font-family:Sansation;font-size:36px;font-weight:bold;position:absolute;top:0;margin-bottom:35px;margin-top:55px}.hero_home_2020 .hero_home_img_rizo img{height:445px;width:354px;margin-top:42px;margin-right:97px;position:absolute;top:35px;right:0}.cuadrado_wrapper{margin-left:84px;position:absolute;top:131px;display:flex;flex-flow:row wrap;justify-content:space-evenly;align-items:stretch;align-content:flex-start;text-align:center}a.cuadrado{display:inline-block;margin:.35rem;width:140px;border-radius:3px;background-color:#fff;box-shadow:inset 1px 1px 0 #f6f6f6,inset -1px -1px 0 #f6f6f6,0 20px 20px 0 rgba(0,0,0,0.07);text-align:center;flex-basis:auto}.cuadrado_title{text-align:center;display:block;color:#333;font-family:'Open Sans';font-weight:600;font-size:16px;top:17px;position:relative}.texto_enlace_cuadrado{background-color:#e85b02;color:#fff;font-family:Sansation;font-weight:bold;padding:13px 0 12px;text-transform:uppercase;display:block;margin:12px 0 0;border-radius:0 0 3px 3px}.cuadrado_img{font-size:2.5rem;background-repeat:no-repeat}a.cuadrado:hover{box-shadow:0 20px 20px 0 rgba(0,0,0,0.3)}@media only screen and (max-width:768px){.hero_home_img_desktop img{height:537px;display:none}.hero_home_img_mobile img{height:537px;width:100%;display:block}.hero_home_2020 .hero_home_title{margin-left:unset;margin-right:10px;font-size:24px;position:absolute;margin-top:31px;margin-bottom:26px;text-align:center}.cuadrado_wrapper{margin:0;position:absolute;top:107px;text-align:center;left:0;margin-bottom:60px}.journal-content-article .wrapper{padding:0 15px}}@media only screen and (max-width:1200px){.hero_home_img_rizo{display:none}</style> </div> </div> </div> <!-- END SHOW CONTENT PORTLET --> </div> </section> <div class="body-container"> <section class="web-main white-slab" role=""> <div class="content"> <div class="columns-1" id="main-content" role="main"> <div class="portlet-layout row-fluid"> <div class="portlet-column portlet-column-only span12" id="column-1"> <div class="portlet-dropzone portlet-column-content portlet-column-content-only" id="layout-column_column-1"> <div class="portlet-boundary portlet-boundary_56_ portlet-static portlet-static-end portlet-borderless portlet-journal-content " id="p_p_id_56_INSTANCE_GvX9RAM30sdL_" > <span id="p_56_INSTANCE_GvX9RAM30sdL"></span> <div class="portlet-borderless-container" > <div class="portlet-body"> <div class="journal-content-article"> <script type="application/ld+json">{"@context":"http://schema.org","@type":"InsuranceAgency","name":"Génesis Seguros","url":"https://www.genesis.es/","image":"https://www.genesis.es/GenesisPublicPortalTheme/images/sites/genesis/logo-blue.png","logo":"https://www.genesis.es/GenesisPublicPortalTheme/images/sites/genesis/logo-blue.png","telephone":"+34913422520","email":"contacto@genesis.es","address":{"@type":"PostalAddress","addressLocality":"Madrid, España","postalCode":"28042","streetAddress":"Paseo Doce Estrellas ,4"},"contactPoint":[{"@type":"ContactPoint","telephone":"+34913422520","url":"https://www.genesis.es/informacion-clientes/contactanos","contactType":"customer servi