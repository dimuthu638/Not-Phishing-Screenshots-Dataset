    <!-- Left sidebar -->
    <div class="row justify-content-center" id="temp-id-for-adblock-will-be-deleted">
        <div class="col-auto bg-light rounded p-1 bleft text-center sticky-top" style="height: 620px; min-width: 300px; z-index: 99;">
            <div>
                <button type="button" class="close text-light mb-2" data-toggle="tooltip" data-placement="top" title="Закрыть рекламу">
                    <span>&times;</span>
                </button>
                    <div class="embed-responsive d-flex justify-content-center" style="width: 300px; height: 600px;">
                        <iframe src='https://static.fastpic.org/v_left_one.html?17' class="embed-responsive-item" scrolling='no' allowfullscreen></iframe>
                    </div>

                <!--                <div class="embed-responsive d-flex justify-content-center" style="width: 300px; height: 300px;">-->
                <!--                    <iframe src='https://static.fastpic.org/v_al300.html?11' class="embed-responsive-item" scrolling='no' allowfullscreen></iframe>-->
                <!--                </div>-->
            </div>
        </div>
        <div class="col bg-dark rounded p-1 m-1 d-flex justify-content-center" id="temp">
            <div id="picContainer" class="text-center">


                <div class="spinner1">
