<main role="main" class="container py-1 bg-black" id="mainContainer">
    <script type='text/javascript'>
        // adbetnet fix
        setInterval(() => {
            if ($('#mainContainer').css('max-width') === '1200px') {
                $('#mainContainer').css('max-width', 1245)
            }
        }, 100);

        function humanFileSize(bytes, si=false, dp=1) {
            const thresh = si ? 1000 : 1024;

            if (Math.abs(bytes) < thresh) {
                return bytes + ' B';
            }

            const units = si
                ? ['kB', 'MB', 'GB', 'TB', 'PB', 'EB', 'ZB', 'YB']
                : ['KiB', 'MiB', 'GiB', 'TiB', 'PiB', 'EiB', 'ZiB', 'YiB'];
            let u = -1;
            const r = 10**dp;

            do {
                bytes /= thresh;
                ++u;
            } while (Math.round(Math.abs(bytes) * r) / r >= thresh && u < units.length - 1);


            return bytes.toFixed(dp) + ' ' + units[u];
        }

        async function fetchImageSize() {
            const fileImg = await fetch($('.image').attr('src')).then(r => r.blob());
            let filesize = humanFileSize(fileImg.size);
            $('.resolution').append('<img src="//static.fastpic.org/v2/images/file-image-regular.svg" class="d-inline-block align-top ml-2" alt="" style="width: 15px; height: 15px; position: relative; top: 5px;"> FileSize: ' + filesize);
        }

        $(document).ready(function(){
            // show embed code
            $('.show-code-button').click(function(event){
                $('.show-code-content').removeClass("d-none");
                $('.hotlink-warn').addClass('hidden');
                $(this).hide();
                event.preventDefault();
                event.stopPropagation();
            });
            $('.show-code-content').find('input').click(function(){ this.focus(); this.select(); return false; });

            // copy to clipboard button
            var copy = new ClipboardJS('.btn-copy,.btn-copy-textarea', {
                target: function(trigger) {
                    return trigger.previousElementSibling;
                }
            });

            // image loading spinner1
            $('.image').imagesLoaded().progress(function(instance, image){
                if (image.isLoaded) {
                    $('.spinner1').css({ 'min-height' : '', 'background-image': 'url()'});
                    $('.resolution').html('<img src="//static.fastpic.org/v2/images/magnifying-glass-solid.svg" class="d-inline-block align-top text-white-50" alt="" style="width: 15px; height: 15px; position: relative; top: 5px;"> Resolution: ' + $('.image').prop('naturalWidth') + 'x' + $('.image').prop('naturalHeight'));
                    fetchImageSize();
                } else {
                    $(image.img).attr('src', '//static.fastpic.org/not_found.gif');
                }
            });

            $('.close').each(function () {
                $(this).attr({
                    'data-toggle': "tooltip",
                    'data-placement': "top",
                    'title': "Закрыть рекламу"
                });
                $(this).click(function () {
                    $(this).parent().hide().removeClass('d-lg-block');
                });
            });

            // enable tooltips
            $('[data-toggle="tooltip"]').tooltip();


            $.get('/viewed.php?url=' + window.location.pathname + '&ref=' + encodeURI(document.referrer));
        });
    </script>
    <!-- Top Teasers -->
