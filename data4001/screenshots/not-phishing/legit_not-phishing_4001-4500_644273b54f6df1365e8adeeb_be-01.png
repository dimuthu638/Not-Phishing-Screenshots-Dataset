box-shadow: 5px 5px 10px 0px rgba(0,0,0,0.3);
 z-index: 99;
transition: 0.3s;
}

.account_fund_icon .tooltiptext {
  visibility: hidden;
	right: 70px;
    top: 10px;
  width: 130px;
  background-color: black;
  color: #fff;
  text-align: center;
  border-radius: 6px;
  padding: 5px 0;

