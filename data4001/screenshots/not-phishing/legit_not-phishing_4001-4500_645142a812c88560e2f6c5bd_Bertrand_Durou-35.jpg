				<div id="FOOTER" class="col-md-12">
					
					
					<div id="MPFooter" class="row">
						<div class="Footer col-md-12">
							<div id="FooterContent">
	
							<div class="ContentItemHtml l1-nav"><div class="HtmlContent"><div class="ibm-sitenav-menu-container"><button type="button" onclick="closeNav();"><i class="ft ft-close"></i></button>
<div class="ibm-sitenav-menu-name"><a href="https://community.ibm.com/community/user/home" rel="home">IBM Community Home</a></div>
<div class="ibm-sitenav-menu-list">
<ul id="primary-menu" class="menu">
<li class="menu-item menu-item-has-children"><a href="#" tabindex="-1">Browse</a>
<ul class="sub-menu">
<li class="sub-menu-item"><a href="https://community.ibm.com/community/user/discussions"><span>Discussions</span></a></li>
<li class="sub-menu-item"><a href="https://community.ibm.com/community/user/all-resources"><span>Resources</span></a></li>
