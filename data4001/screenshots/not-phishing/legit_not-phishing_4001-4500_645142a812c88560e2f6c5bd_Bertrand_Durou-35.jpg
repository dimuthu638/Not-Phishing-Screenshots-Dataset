<script charset="utf-8">$(document).ready(function () {
	var $successPanelDiv = $("#FlashMessageContainer div.SuccessPanel");
       /// Only apply for blog posts and discussion messages
	if($successPanelDiv.length === 1 && ($("#FlashMessageContainer div.SuccessPanel:contains('Thank you for submitting your blog.')").length === 1) ||  ($("#FlashMessageContainer div.SuccessPanel:contains('Thank you for submitting your message.')").length === 1)){
		$successPanelDiv.hide();
		
		/// Clone the original panel and show it
		var $cloned = $successPanelDiv.clone()
					 .attr({"id":"FlashMessageClone"})
					 .appendTo("#FlashMessageContainer")
					 .show();
	}
 });</script>
