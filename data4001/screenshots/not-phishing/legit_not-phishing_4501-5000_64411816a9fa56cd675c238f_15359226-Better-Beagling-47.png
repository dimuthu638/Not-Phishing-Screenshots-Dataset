<script>


function addCommas(nStr)
{
	nStr += '';
	x = nStr.split('.');
	x1 = x[0];
	x2 = x.length > 1 ? '.' + x[1] : '';
	var rgx = /(\d+)(\d{3})/;
	while (rgx.test(x1)) {
		x1 = x1.replace(rgx, '$1' + ',' + '$2');
	}
	return x1 + x2;
}




$(document).ready(function(){


if( /Android|webOS|iPhone|iPad|iPod|BlackBerry|IEMobile|Opera Mini/i.test(navigator.userAgent) ) {
$("#purchase").text("Purchase & Download");
}

if($( window ).width()<=800) {
$("#purchase").text("Purchase & Download");
}

$(window).resize(function(){
	if ($(window).width() <= 800){	
		$("#purchase").text("Purchase & Download");
	}
	else {
	$("#purchase").text("Purchase & Download Media Contacts List");
	}
});

	$('#calx').calx({});
	$('.fancybox').fancybox({
    helpers : {
        overlay : {
            css : {
                'background' : 'rgba(0, 0, 0, 0.85)'
            }
        }
    }
	});
	
	
	$('.outletscount, .contactscount').each(function() {
	$(this).html(
	addCommas($(this).html())
	);
	});
	


  $(".fancybox").fancybox({
    'width'  : 800,           // set the width
    'height' : 600,           // set the height
    'autoSize'   : false
  });

});
 

$(function() {
  $('a[href*=#]:not([href=#modalPreview])').click(function() {
    if (location.pathname.replace(/^\//,'') == this.pathname.replace(/^\//,'') && location.hostname == this.hostname) {
      var target = $(this.hash);
      target = target.length ? target : $('[name=' + this.hash.slice(1) +']');
      if (target.length) {
        $('html,body').animate({
          scrollTop: target.offset().top
        }, 1000);
        return false;
      }
    }
  });
});



//These JS Files can be loaded at the end


$( "input" ).click(function() {

if($("#retailtotal").text()=="$0") {$("#retailtotal").css("display","none");}
else {$("#retailtotal").css("display","inline-block");}

if($("#savings").text()=="$0") {$("#savings-container").css("display","none");}
else {$("#savings-container").css("display","inline-block");}

// Get names of lists
var pp_list = "";
var selected = [];	
$('input:checked').each(function() {
    selected.push($(this).attr('placeholder'));
});
jQuery.each(selected, function( i, val ) {
  if (pp_list != "") {pp_list = val + ",%20" + pp_list;}
  else {pp_list = val;}
});
// Get names of lists

var pp_link = "";
var pp_prefix = "https://www.paypal.com/cgi-bin/webscr?business=billing@mediacontacts.co&cmd=_xclick&currency_code=USD&amount=";
var pp_amount = $('#raw-total').val();
var pp_desc = "&item_name=Media%20Contacts:%20"+pp_list;

pp_link = pp_prefix+pp_amount+pp_desc;

$("#purchase").attr("href", pp_link);

});
 


function load(city){
   $(".modalPreview").load("/app/module-form-ajax.inc.php?state="+city);

}


