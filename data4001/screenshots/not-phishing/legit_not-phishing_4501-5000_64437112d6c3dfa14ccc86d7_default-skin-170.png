								html += '<div id="rsearch-'+i+'" class="hidden"><h2><span class="glyphicon glyphicon-search" aria-hidden="true"></span> <a class="title" href="/?q='+encodeURI(recentsearches[i]).replace(/%20/g, '+')+'&sort=StartTimeNewest" target="_blank" rel="nofollow" onclick="ga(\'send\', \'event\', \'homepage\', \'click\', \'recentsearchesTitle\')">'+escapeHtml(recentsearches[i])+'</a> - Newly Listed <a href="#clearrecentsearch" onclick="ga(\'send\', \'event\', \'homepage\', \'click\', \'clearrecentsearch\');clearrecentsearch(\''+recentsearches[i].replace(/\\/g, '\\\\').replace(/'/g, "\\'").replace(/"/g, '&quot;')+'\');$(this).parent().parent().fadeOut(\'fast\');return false;" class="pull-right text-muted" title="Clear">&times;</a></h2><ul class="items list-unstyled"></ul></div>';
							}
							$('#rsearches').append(html);
							for(var i=0, len=urls.length; i<len; i++)
							{
								$.getJSON(urls[i], (function(){
									var searchnum = i;
									return function(data)
									{
										if(typeof data.itemSummaries!=='undefined' && typeof data.itemSummaries==='object')
										{
											var html = '';
											var newlylisted = (api.indexOf('&sortOrder=StartTimeNewest')!=-1) ? true : false;
newlylisted = true;
											var watchcount = (api.indexOf('&sortOrder=WatchCountDecreaseSort')!=-1) ? true : false;
watchcount = false;
