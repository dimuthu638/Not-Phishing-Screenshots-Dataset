//								urls.push('https://api.picclick.com/services/search/FindingService/v1?OPERATION-NAME=findItemsAdvanced&keywords='+encodeURIComponent(recentsearches[i])+'&paginationInput.entriesPerPage=25&sortOrder=StartTimeNewest&SERVICE-VERSION='+VERSIONFINDING+'&GLOBAL-ID='+GLOBALID+'&RESPONSE-DATA-FORMAT=JSON&REST-PAYLOAD&itemFilter(0).name=HideDuplicateItems&itemFilter(0).value=true'+(($.cookie('AvailableTo')!=undefined) ? '&itemFilter('+j+').name=AvailableTo&itemFilter('+(j++)+').value='+encodeURIComponent($.cookie('AvailableTo')) : '&itemFilter('+j+').name=AvailableTo&itemFilter('+(j++)+').value='+encodeURIComponent('US'))+(($.cookie('sort')=='BidCountMost' || $.cookie('type')=='Auction' || $.cookie('type')=='AuctionWithoutBids' || $.cookie('type')=='AuctionWithBids') ? '&itemFilter('+j+').name=ListingType&itemFilter('+j+').value(0)=Auction&itemFilter('+(j++)+').value(1)=AuctionWithBIN' : '')+(($.cookie('type')=='AuctionWithoutBids') ? '&itemFilter('+j+').name=MaxBids&itemFilter('+(j++)+').value=0' : '')+(($.cookie('type')=='AuctionWithBids') ? '&itemFilter('+j+').name=MinBids&itemFilter('+(j++)+').value=1' : '')+(($.cookie('type')=='BuyItNow') ? '&itemFilter('+j+').name=ListingType&itemFilter('+j+').value(0)=AuctionWithBIN&itemFilter('+(j++)+').value(1)=FixedPrice' : '')+(($.cookie('type')=='BestOfferOnly') ? '&itemFilter('+j+').name=BestOfferOnly&itemFilter('+j+').value=true' : '')+(($.cookie('sort')=='DistanceNearest') ? '&buyerPostalCode='+encodeURIComponent($.cookie('buyerPostalCode')) : ''));
