<script>
  
  function validateBannerCount(nodeId) {
    
    var bannercount = sessionStorage.getItem("bannercount");
    if (!bannercount) { return true; }
    var nodeIds = bannercount.split(",");
    
    return (nodeIds.indexOf(nodeId) > -1) ? false : true;
  }
  
  $(document).ready(function () {
    $(".BannerCount").click(function () {
      var nodeId = $(this).attr("data-nodeId");
      console.log(nodeId);
      if (validateBannerCount(nodeId)) {
        $.get(`/customapi/banner/CountBanner?nodeId=${nodeId}`, function (data) {
          var bannercount = sessionStorage.getItem("bannercount");
          if (!bannercount) {
            sessionStorage.setItem("bannercount", nodeId);
          }
          else {
            bannercount += "," + nodeId;
            sessionStorage.setItem("bannercount", bannercount);
          }
        });
      }
    });
  });
</script></div>
</div>
