.tabs {
  top:50%;
  left:50%;
  width:100%;
  height:400px;
  padding:20px 30px;
  overflow:hidden;
}
.tabs .tab-header {
  height:60px;
  display:flex;
  align-items:center;
}
.tabs .tab-header > div {
  width:calc(100% / 4);
  text-align:center;
  color:#fff;
  font-weight:600;
  cursor:pointer;
  font-size:14px;
  outline:none;
  line-height: 1.1 !important; font-weight: 600 !important; font-size: 22px !important; text-align: left;
}
.tabs .tab-header > div > i {
  display:block;
  margin-bottom:5px;
}
.tabs .tab-header > div.active {
  color:#fff;
}
.tabs .tab-indicator {
  position:relative;
  width:calc(100% / 4);
  height:5px;
  background:#00acee;
  background: linear-gradient(4deg, rgba(118,101,192,1) 0%, rgba(101,125,192,1) 99%);
  left:0px;
  border-radius:5px;
  transition:all 500ms ease-in-out;
}
.tabs .tab-body {
  position:relative;
  height:calc(100% - 60px);
  padding:10px 5px;
  margin-top: 0px;
}
.tabs .tab-body > div {
  position:absolute;
  top:-200%;
  transition:opacity 500ms ease-in-out 0ms,
    transform 500ms ease-in-out 0ms;
}
.tabs .tab-body > div.active {
  top:0px;
}
.step {
    height: auto !important;
    padding-left:35px !important;
	margin-bottom:10px!important;
}
.step:hover {
 background: rgb(53,190,144)  !important;
    background: linear-gradient(305deg, rgba(53,190,144,1) 0%, rgba(164,38,255,1) 100%)  !important;
    border-image: url('/wp-content/uploads/2020/03/btn.png') 1  !important;
}
.step p:first-child {
	line-height:1.2 !important;
	font-weight:600;
}
.step:nth-child(1){
	font-weight: 300;
}
@media (min-width: 1400px) and (max-width: 1920px) {
    .step {
        width: 80% !important;
    }
}
@media (min-width: 300px) and (max-width: 1000px) {
    .step {
       font-weight: 100% !important;
    }
}
.earth-container{position:relative;z-index:1}.earth-container::before{content:"";display:block;padding-top:100%}.earth-container>canvas{position:absolute;top:0;left:0;z-index:1000;user-select:none}.earth-draggable{cursor:all-scroll;cursor:-webkit-grab;cursor:grab}.earth-dragging *{cursor:all-scroll;cursor:-webkit-grabbing!important;cursor:grabbing!important}.earth-clickable{cursor:pointer}.earth-overlay{position:absolute;top:0;left:0;user-select:none;pointer-events:none;transform-origin:0 0}.earth-overlay a,.earth-overlay input,.earth-overlay button{pointer-events:all}.earth-hittest{position:fixed;width:200vh;max-width:100%;top:0;left:0;z-index:999999}.earth-hittest svg{max-width:100%;height:auto;display:block;margin:0;opacity:0}
  
