  /* HTML Set up */
  footer {
    background: #212331;
    color: #d2dfe9;
    margin: 0;
    @import 'https://fonts.googleapis.com/css?family=Open+Sans';
    font-family: "Open Sans", sans-serif;
  }
  footer .centered {
    max-width: 1200px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
  }
  footer .centered .footer-logo {
    width: 0%;
  }
  footer .centered .footer-logo img.logo {
    padding: 20px 20px 20px 100px;
    max-width: 100%;
  }
  footer .centered .footer-contact {
    width: 10%;
  }
  footer .centered .footer-navigation {
    width: 100%;
  }
  footer .centered .footer-navigation .footer-links-holder {
    width: 25%;
    position: relative;
    float: left;
    margin: 10;
  }
  footer .centered .footer-navigation .footer-links-holder .footer-links {
    margin: 5;
    padding: 0;
    list-style: none;
    -webkit-transition: max-height 0.25s;
    transition: max-height 0.25s;
    text-decoration: none;
  }
  footer .bottom-bar {
    position: relative;
    text-align: center;
    font-size: 0.8em;
    text-transform: uppercase;
    background: #000;
    padding: 15px 0;
  }

  /* Responsive Tablet Sizes */
  @media only screen and (max-width: 749px) {
    footer .centered {
      flex-wrap: wrap;
    }
    footer .centered .footer-logo {
      max-width: 250px;
      width: 50%;
    }
    footer .centered .footer-contact {
      width: 50%;
      padding: 0 20px;
    }
    footer .centered .footer-navigation {
      width: 100%;
    }
    footer .centered .footer-navigation .footer-links-holder {
      padding: 0 20px;
    }
  }
  /* Responsive Mobile Sizes */
  @media only screen and (max-width: 767px) {
    footer .centered .footer-logo {
      width: 100%;
      margin: 0 auto;
    }
    footer .centered .footer-contact {
      width: 100%;
    }
    footer .centered .footer-navigation .footer-links-holder {
      width: 100%;
      padding: 0;
      padding-bottom: 0px !important;
      /* border-bottom: solid 1px gray; */
          margin-bottom: 10px;
    }
    footer .centered .footer-navigation .footer-links-holder .menuHeader {
      margin: 0;
      padding: 10px 20px;
      /* border-top: #000 1px solid; */
      cursor: pointer;
      margin-top: 0px !important;
      padding-top: 0px !important;
      color: #3FDA2B !important;
      /* Down Arrows */
      border-bottom: solid 1px #4e4e4e;
      margin-right: 25px;
    }
    footer .centered .footer-navigation .footer-links-holder .menuHeader::after {
      float: right;
      margin-right: 10px;
      content: "";
      display: inline-block;
      vertical-align: middle;
      margin-top: 7px;
      padding-bottom: 0px;
      margin-bottom: 0px;
      width: 7px;
      height: 7px;
      /* border-top: 2px solid #fff;
      border-right: 2px solid #fff;
      -moz-transform: rotate(135deg);
      -ms-transform: rotate(135deg);
      -webkit-transform: rotate(135deg);
      transform: rotate(135deg); */
      -webkit-transition: transform 0.25s;
      transition: transform 0.25s;
      content: '\002B'; /* Unicode character for "plus" sign (+) */
      float: right;
      margin-left: 5px;
      color: #3FDA2B !important;
      font-size: 20px;
    }
    footer .centered .footer-navigation .footer-links-holder .footer-links {
      max-height: 0;
      overflow: hidden;
      padding: 0 20px;
      color:#b0b7bd !important;
      margin-top: 0px  !important;
    }
    footer .centered .footer-navigation .footer-links-holder.active .menuHeader:after {
      /* -moz-transform: rotate(-45deg);
      -ms-transform: rotate(-45deg);
      -webkit-transform: rotate(-45deg);
      transform: rotate(-45deg); */
      content: "\2212"; /* Unicode character for "minus" sign (-) */
      color: #3FDA2B !important;
      font-size: 20px;
    }
    footer .centered .footer-navigation .footer-links-holder.active .footer-links {
      max-height: 10000px;
      color:#ffffff !important;
    }
    footer .centered .footer-navigation .footer-links-holder.active .footer-links a{
