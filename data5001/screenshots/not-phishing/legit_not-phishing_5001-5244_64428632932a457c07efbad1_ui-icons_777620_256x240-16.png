/*** GURUCUL RISK ANALYTICS ***/

.graDiagram .wpb_wrapper {
    max-width: 900px;
    margin: 0 auto;
}
.gra-container {
    background-color: #000000;
    padding: 10px 20px;
    text-align: center;
}
.gra-container > h2 {
    color: #fff;
    line-height: 0px !important;
}
.gra-icons {
    display: flex;
    flex-flow: row nowrap;
    justify-content: center;
    align-items: center  !important;
    text-align: center;
}
.gra-icons > img {
    flex: 0 1 50px;
    max-width: 50px  !important;
    max-height: 50px  !important;
}
.gra-icons > div {
    flex: 0 1 300px;
    max-width: 300px;
    justify-content: center;
    align-items: center;
}
.gra-icons > div > img {
    max-width: 80px  !important;
}
.gra-icons > div > span {
    color: #fff;
    font-size: 16px;
    display: block;
}
.real-time-analytics {
    background-color: #000;
    padding: 20px;
    position: relative;
}
.real-time-analytics:before {
    content: ' ';
    width: 60px;
    height: 120px;
    background-color: #fff;
    display: block;
    position:  absolute;
    transform: rotate(-40deg);
    top: 0;
    left: -20px;
}
.real-time-analytics:after {
    content: '';
    width: 60px;
    height: 120px;
    background-color: #fff;
    display: block;
    position:  absolute;
    transform: rotate(40deg);
    top: 0;
    right: -20px;
}

.real-time-analytics > h3 {
    color: #fff;
}
.gra-arrows {
    display: flex;
    flex-flow: row nowrap;
    justify-content: center;
    margin-top: -4px;
}
.gra-arrows > div {
    flex: 0 1 200px;
    margin: 0 20px;
    text-align: center;
}
.gra-arrows > div > img {
    max-width: 80px  !important;
    display: block;
    margin: 0 auto;
}
.gra-arrows > div > span {
    display: block;
    color: #8c0000;
}
