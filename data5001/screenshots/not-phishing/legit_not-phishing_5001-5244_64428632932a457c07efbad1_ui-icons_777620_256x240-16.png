    -webkit-transition: color 0.25s, background 0.25s;
    transition: color 0.25s, background 0.25s;
    letter-spacing: 0.25px;
  }
  footer a:hover {
    opacity: 0.9;
  }
  /* Misc CSS */
  .clearfix:before, .clearfix:after {
    content: " ";
    display: block;
    overflow: hidden;
    visibility: hidden;
    width: 0;
    height: 0;
    clear: both;
