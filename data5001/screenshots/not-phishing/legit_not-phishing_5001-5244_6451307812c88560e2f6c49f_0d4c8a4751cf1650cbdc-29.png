			</script><meta http-equiv="X-UA-Compatible" content="IE=edge,chrome=1"/><meta http-equiv="Content-Type" content="text/html; charset=utf-8"/><meta name="viewport" content="user-scalable=no, width=device-width, initial-scale=1.0"/><link rel="shortcut icon" type="image/x-icon" href="//img.imgsmail.ru/r/favicon/favicon.ico"/><meta name="theme-color" content="#005ff9"/><title>Account Mail.Ru</title><script type="application/javascript" crossorigin="anonymous">;(function (window) {
try {
	var loadRadarFrom = "unkn";
	var loadRadarEmail = "";
	var loadRadarPrntpgid = "";/* global loadRadarFrom, loadRadarEmail, loadRadarPrntpgid */
var email = loadRadarEmail;
var from = loadRadarFrom || 'unkn';
var parent_pgid = loadRadarPrntpgid;
var p2 = window.location.pathname.split('/').join('_');

var src1 = '//stat.radar.imgsmail.ru/update?p=account&t=rawload_stat&v=1&email=' + email + '&i=' + p2 + ':1';
if (parent_pgid) {
	src1 += '&parent_pgid=' + parent_pgid;
}
(new Image()).src = src1;

if (window.location.pathname.match(/^\/user\/phones/)) {
	var p = window.location.pathname.split('/');
	p.push(from);
	p.push('rawload');
	p.push('stat');
	var src2 = '//stat.radar.imgsmail.ru/update?p=account&t=' + p.join('_') + '&v=1&email=' + email;
	if (parent_pgid) {
		src2 += '&parent_pgid=' + parent_pgid;
	}
	(new Image()).src = src2;
}
} catch (e) { /* ignore */ }
