                            }
                            function initCarousel() {
                                let carouselAlign = checkAlign();
                                if (typeof defaultAlign==='undefined') {
                                    defaultAlign = carouselAlign;
                                }
                                return $('#carouselControls-6451da13f0e7b.main-carousel1').flickity({
