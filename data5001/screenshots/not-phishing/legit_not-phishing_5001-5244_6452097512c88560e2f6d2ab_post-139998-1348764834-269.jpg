                                carouselEl = initCarousel();
                            });
                            $(window).resize(function () {
                                let newAlign = checkAlign();
                                if (defaultAlign!==newAlign) {
                                    defaultAlign = newAlign;
                                    if (typeof carouselEl!=='undefined') {
                                        carouselEl.flickity('destroy');
                                    }
                                    carouselEl = initCarousel();
