    <script>
        window.lang = $('html').attr('lang');
        $(document).on('ready', function() {
            callCookies();
            if($('.cc-cookies').length>0){
                var btnConfig='<a href="/en-us/content/cookies" class="cc-cookie-config">Cookies settings</a>';
                var contCookie=$('.cc-cookies>.step1').html();
                var contCookie2='<div class="step2"><h3>Cookies settings panel</h3><p>This is the advanced settings system for own and third-party cookies. Here you can modify parameters that will directly affect your browsing experience on this website.</p><ul><li><b>Technical cookies (required)</b><p>These cookies are important to give you secure access to areas with personal information or to recognise you when you log on.</p></li><ul><li><b>Customisation Cookies</b><p>These cookies are related to general characteristics such as, for example, the browser you use, and provide you with a personalised experience and content.</p></li></ul><div class="check checkPerso"><b>I do not want Customisation cookies</b> (Your selection will mean that we cannot offer you customised browsing and content)</div><ul><li><b>Analytics Cookies</b><p>They allow anonymous measurement of the number of visits or the activity. They enable us to improve constantly your browsing experience. They will allow you to enjoy continuous improvement in your browsing experience.</p></li></ul><div class="check checkAnalytics"><b>I do not want Analytics cookies</b> (Your selection will mean that we cannot offer you continuous improvement in your browsing experience.)</div><ul><li><b>Advertising Cookies</b><p>They allow us to show you personalised advertising that is relevant to you. Thanks to these cookies you will not see adverts which do not interest you. You will enjoy advertising adapted to you and your preferences.</p></li></ul><div class="check checkPubli"><b>I do not want Advertising cookies</b> (Your selection will mean that you do not benefit from customised advertising, and will only see generic adverts).</div></div>';
                var btnAccept=$('.cc-cookies>a');
                $('.cc-cookies').html("<div class='contCookie'></div>");
                $('.cc-cookies .contCookie').append('<div class="step1">'+contCookie+'</div>');
                $('.cc-cookies .contCookie').prepend(contCookie2);
                $('.cc-cookies .contCookie').append(btnConfig);
                $('.cc-cookies .contCookie').append(btnAccept);
                $('.cc-cookies .cc-cookie-config').click(function(){
                    if($('.step2').hasClass('active')==false){
                        $('.step2').addClass('active');
                        $(this).html('Consult List of Cookies');
                        $('.cc-cookies .step1').hide();
                        $('.cc-cookies .step2').show();
                        $('.cc-cookie-accept').html('Save settings');
                        return false;
                    }else{
                        return true;
                    }
                });
                $('.cc-cookie-accept, .cc-cookie-decline').click(function (e) {
                    e.preventDefault();
                    if ($(this).is('[href$=#decline]')) {
                        $.cookie("cc_cookie_accept", null, {
                            path: '/'
                        });
                        $.cookie("cc_cookie_decline", "cc_cookie_decline", {
                            expires: 365,
                            path: '/'
                        });
                        $.cookie("cc_cookie_before", "cc_cookie_before", {
                            expires: 365,
                            path: '/'
                        });
                        if ("") {
                            // kill google analytics cookies
                            $.cookie("__utma", null, {
                                domain: '.' + "",
                                path: '/'
                            });
                            $.cookie("__utmb", null, {
                                domain: '.' + "",
                                path: '/'
                            });
                            $.cookie("__utmc", null, {
                                domain: '.' + "",
                                path: '/'
                            });
                            $.cookie("__utmz", null, {
                                domain: '.' + "",
                                path: '/'
                            });
                        }
                    } else {
                        //console.log("ok");
                        $.cookie("cc_cookie_decline", null, {
                            path: '/'
                        });
                        $.cookie("cc_cookie_accept", "cc_cookie_accept", {
                            expires: 365,
                            path: '/'
                        });
                        $.cookie("cc_cookie_before", "cc_cookie_before", {
                            expires: 365,
                            path: '/'
                        });
                        if($('.checkPerso').hasClass('active')==false){
                            $.cookie("cc_cookie_perso", "cc_cookie_perso", {
                                expires: 365,
                                path: '/'
                            });
                        }else{
                            $.cookie("cc_cookie_perso", null, {
                                path: '/'
                            });
                        }
                        if($('.checkAnalytics').hasClass('active')==false){
                            $.cookie("cc_cookie_analytics", "cc_cookie_analytics", {
                                expires: 365,
                                path: '/'
                            });
                        }else{
                            $.cookie("cc_cookie_analytics", null, {
                                path: '/'
                            });
                        }
                        if($('.checkPubli').hasClass('active')==false){
                            $.cookie("cc_cookie_publi", "cc_cookie_publi", {
                                expires: 365,
                                path: '/'
                            });
                        }else{
                            $.cookie("cc_cookie_publi", null, {
                                path: '/'
                            });
                        }
                    }
                    $(".cc-cookies").fadeOut(function () {
                        // reload page to activate cookies
                        location.reload();
                    });
                });
                $('.cc-cookies .check').click(function(){
                    $(this).toggleClass('active');
                    $('.cc-cookie-accept').addClass('modif');
                    /*if($(this).hasClass('active')==true){
                        $('.cc-cookie-accept').addClass('cc-cookie-decline');
                        $('.cc-cookie-accept').attr('href','#decline');
                        $('.cc-cookie-accept').removeClass('cc-cookie-accept');
                    }else{
                        $('.cc-cookie-decline').addClass('cc-cookie-accept');
                        $('.cc-cookie-decline').attr('href','#accept');
                        $('.cc-cookie-decline').removeClass('cc-cookie-decline');
                    }*/
                });
            }
            if(jQuery.cookie("cc_cookie_before") == "cc_cookie_before") {
                if(jQuery.cookie("cc_cookie_perso") == "cc_cookie_perso") {
                    $('.checkPerso').removeClass('active');
                }else{
                    $('.checkPerso').addClass('active');
                }
                if(jQuery.cookie("cc_cookie_publi") == "cc_cookie_publi") {
                    $('.checkPubli').removeClass('active');
                }else{
                    $('.checkPubli').addClass('active');
                }
                if(jQuery.cookie("cc_cookie_analytics") == "cc_cookie_analytics") {
                    $('.checkAnalytics').removeClass('active');
                }else{
                    $('.checkAnalytics').addClass('active');
                }
            }else{
                $('.checkPerso').removeClass('active');
                $('.checkPubli').removeClass('active');
                $('.checkAnalytics').removeClass('active');
            }
            if($.cookie('cc_cookie_accept')=='cc_cookie_accept'){
                if(jQuery.cookie("cc_cookie_publi") == "cc_cookie_publi") {
                    //console.log("publi ok");
                    //Google Tag Manager
                    /*if($(html).attr('lang')=="tr-tr"){
                        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                        })(window,document,'script','dataLayer','AW-10854341330');
                    }else{*/
                        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                        })(window,document,'script','dataLayer','GTM-57TFGDQ');
                    //}
                }
                if(jQuery.cookie("cc_cookie_analytics") == "cc_cookie_analytics") {
                    //console.log("analytics ok");
                    //Yandex.Metrika counter
                    (function (d, w, c) {
                        (w[c] = w[c] || []).push(function() {
                            try {
                                w.yaCounter42684554 = new Ya.Metrika({
                                    id:42684554,
                                    clickmap:true,
                                    trackLinks:true,
                                    accurateTrackBounce:true
                                });
                            } catch(e) { }
                        });

                        var n = d.getElementsByTagName("script")[0],
                            s = d.createElement("script"),
                            f = function () { n.parentNode.insertBefore(s, n); };
                        //s.type = "text/javascript";
                        s.async = true;
                        s.src = "https://mc.yandex.ru/metrika/watch.js";

                        if (w.opera == "[object Opera]") {
                            d.addEventListener("DOMContentLoaded", f, false);
                        } else { f(); }
                    })(document, window, "yandex_metrika_callbacks");
                    if($('html').attr('lang')=="tr-tr"){
                        (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
                        new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
                        j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
                        'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
                        })(window,document,'script','dataLayer','GTM-TPCXFR6');
                    }
                }
            }
            $('a.cc-cookie-reset2').click(function (f) {
                //f.preventDefault();
                $.cookie("cc_cookie_accept", null, {
                    path: '/'
                });
                $.cookie("cc_cookie_decline", null, {
                    path: '/'
                });
                // reload page to activate cookies
                return true;
            });
        });
        function callCookies(){
            $.cookieCuttr({
                cookieAnalytics: false,
                cookieDeclineButton: false,
                //cookieDeclineButtonText: 'DO NOT USE COOKIES',
                cookieAcceptButtonText: 'Accept cookies',
                cookieNotificationLocationBottom: true,
                cookiePolicyLink: '/en-us/content/cookies',
                cookieMessage: "<div class='step1'>Cookies are important for you, they influence on your browsing experience, they help us to protect your privacy and allow us to proceed with your requests that you demand through the website. We use our own and third party cookies to analyze our services and provide you with advertising related to your preferences on the basis of a profile made with your browsing habits (for example, visited pages). If you consent to its installation, click on 'Accept Cookies', or you can also set your preferences by pressing 'Cookie settings'. More information in our <a href='{{cookiePolicyLink}}' title='Cookies policy'>Cookies policy</a>.</div>"
            });
        }
    </script>
